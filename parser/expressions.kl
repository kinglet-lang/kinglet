// Expression parser: precedence-climbing expression parser for Kinglet,
// mirroring the C++ parser in kinglet-bootstrap/src/parser/parser.cc.

import {
  "ast.kl"
  "helpers.kl"
  "//lexer/token.kl"
}

using ast {
  Expr, TypeExpr, BinaryOp, UnaryOp, AssignOp,
  MatchArm, FieldInit, make_type
};
using token { TokenType, Token };

Expr expression(Parser p) => assignment(p);

string assign_target_name(Expr e) {
  return e match {
    Expr::Ident(let name, let _l, let _c) => name,
    _ => "<error>",
  };
}

Expr assignment(Parser p) {
  Expr left = ternary(p);
  if (is_assign_op(peek_tok(p).type)) {
    Token op = advance_tok(p);
    Expr value = assignment(p);
    AssignOp aop = token_to_assign_op(op.type);
    // Simple name assignment
    string name = assign_target_name(left);
    if (name != "<error>") {
      return Expr::Assign(name, aop, value, expr_line(left), expr_col(left));
    }
    // Field assignment: obj.field = value
    if (left match {
      Expr::FieldAccess(_, let fname, let fl, let fc) => true,
      _ => false,
    }) {
      string fname = left match {
        Expr::FieldAccess(_, let fn2, _, _) => fn2,
        _ => "",
      };
      Expr obj = left match {
        Expr::FieldAccess(let o, _, _, _) => o,
        _ => left,
      };
      return Expr::FieldAssign(obj, fname, value, expr_line(left), expr_col(left));
    }
    // Index assignment: arr[idx] = value
    if (left match {
      Expr::Index(_, _, _, _) => true,
      _ => false,
    }) {
      if (aop != AssignOp::Assign) {
        error_at(p, op, "Compound assignment to indexed expression is not supported.");
        return Expr::Assign("<error>", aop, value, expr_line(left), expr_col(left));
      }
      Expr obj = left match {
        Expr::Index(let o, _, _, _) => o,
        _ => left,
      };
      Expr idx = left match {
        Expr::Index(_, let i, _, _) => i,
        _ => left,
      };
      return Expr::IndexAssign(obj, idx, value, expr_line(left), expr_col(left));
    }
    // Fallback: treat as simple assign (error recovery)
    return Expr::Assign("<error>", aop, value, expr_line(left), expr_col(left));
  }
  return left;
}

// Ternary: cond ? then : else — right-associative.
// Sits between assignment (above) and coalesce (below).
Expr ternary(Parser p) {
  Expr expr = coalesce(p);
  if (match_tt(p, TokenType::Question)) {
    Token q = previous(p);
    Expr then_expr = expression(p);
    consume(p, TokenType::Colon, "Expected ':' in ternary expression.");
    Expr else_expr = ternary(p);
    return Expr::Ternary(expr, then_expr, else_expr, q.line, q.col);
  }
  return expr;
}

// lhs ?: rhs  and  lhs ?: let e => rhs  — right-associative (Elvis operator).
// Sits between assignment (above) and pipeline (below).
Expr coalesce(Parser p) {
  Expr left = pipeline(p);
  if (!match_tt(p, TokenType::QuestionColon)) { return left; }
  Token qq = previous(p);
  string err_binding = "";
  if (match_tt(p, TokenType::Let)) {
    Token e = consume(p, TokenType::Identifier, "Expected error binding name after 'let' in '?: let'.");
    err_binding = e.lexeme;
    consume(p, TokenType::FatArrow, "Expected '=>' after error binding name.");
  }
  Expr right = coalesce(p);
  return Expr::NullCoalesce(left, err_binding, right, qq.line, qq.col);
}

Expr pipeline(Parser p) {
  Expr left = logical_or(p);
  while (match_tt(p, TokenType::PipeGreater)) {
    Token op = previous(p);
    Expr func = logical_or(p);
    Expr[] args = [];
    args.push(left);
    TypeExpr[] ta = [];
    left = Expr::Call(func, ta, args, op.line, op.col);
  }
  return left;
}

Expr logical_or(Parser p) {
  Expr left = logical_and(p);
  while (match_tt(p, TokenType::PipePipe)) {
    Token op = previous(p);
    Expr right = logical_and(p);
    left = Expr::Binary(left, BinaryOp::Or, right, op.line, op.col);
  }
  return left;
}

Expr logical_and(Parser p) {
  Expr left = bit_or(p);
  while (match_tt(p, TokenType::AmpAmp)) {
    Token op = previous(p);
    Expr right = bit_or(p);
    left = Expr::Binary(left, BinaryOp::And, right, op.line, op.col);
  }
  return left;
}

Expr bit_or(Parser p) {
  Expr left = bit_xor(p);
  while (match_tt(p, TokenType::Pipe)) {
    Token op = previous(p);
    Expr right = bit_xor(p);
    left = Expr::Binary(left, BinaryOp::BitOr, right, op.line, op.col);
  }
  return left;
}

Expr bit_xor(Parser p) {
  Expr left = bit_and(p);
  while (match_tt(p, TokenType::Caret)) {
    Token op = previous(p);
    Expr right = bit_and(p);
    left = Expr::Binary(left, BinaryOp::BitXor, right, op.line, op.col);
  }
  return left;
}

Expr bit_and(Parser p) {
  Expr left = equality(p);
  while (match_tt(p, TokenType::Amp)) {
    Token op = previous(p);
    Expr right = equality(p);
    left = Expr::Binary(left, BinaryOp::BitAnd, right, op.line, op.col);
  }
  return left;
}

Expr equality(Parser p) {
  Expr left = comparison(p);
  while (peek_tok(p).type == TokenType::EqualEqual || peek_tok(p).type == TokenType::BangEqual) {
    Token op = advance_tok(p);
    Expr right = comparison(p);
    left = Expr::Binary(left, token_to_binary_op(op.type), right, op.line, op.col);
  }
  return left;
}

bool is_cmp_op_token(TokenType t) {
  if (t == TokenType::Less)         { return true; }
  if (t == TokenType::LessEqual)    { return true; }
  if (t == TokenType::Greater)      { return true; }
  if (t == TokenType::GreaterEqual) { return true; }
  return false;
}

// Chained comparisons (P0893): `1 <= x <= 10` desugars to `1 <= x && x <= 10`.
// Mirrors kinglet-bootstrap/src/parser/parser.cc Parser::comparison().
Expr comparison(Parser p) {
  Expr left = shift(p);

  if (!is_cmp_op_token(peek_tok(p).type)) {
    return left;
  }

  Token op1 = advance_tok(p);
  BinaryOp bin_op1 = token_to_binary_op(op1.type);
  int mid_start = p.current;
  Expr mid = shift(p);

  if (!is_cmp_op_token(peek_tok(p).type)) {
    return Expr::Binary(left, bin_op1, mid, op1.line, op1.col);
  }

  int saved = p.current;
  p.current = mid_start;
  Expr mid_copy = shift(p);
  p.current = saved;

  Expr left_cmp = Expr::Binary(left, bin_op1, mid, op1.line, op1.col);

  Token op2 = advance_tok(p);
  BinaryOp bin_op2 = token_to_binary_op(op2.type);
  Expr right_term = shift(p);
  Expr right_cmp = Expr::Binary(mid_copy, bin_op2, right_term, op2.line, op2.col);

  return Expr::Binary(left_cmp, BinaryOp::And, right_cmp, op1.line, op1.col);
}

Expr shift(Parser p) {
  Expr left = term(p);
  while (peek_tok(p).type == TokenType::LessLess || peek_tok(p).type == TokenType::GreaterGreater) {
    Token op = advance_tok(p);
    Expr right = term(p);
    left = Expr::Binary(left, token_to_binary_op(op.type), right, op.line, op.col);
  }
  return left;
}

Expr term(Parser p) {
  Expr left = factor(p);
  while (peek_tok(p).type == TokenType::Plus || peek_tok(p).type == TokenType::Minus) {
    Token op = advance_tok(p);
    Expr right = factor(p);
    left = Expr::Binary(left, token_to_binary_op(op.type), right, op.line, op.col);
  }
  return left;
}

Expr factor(Parser p) {
  Expr left = unary(p);
  while (peek_tok(p).type == TokenType::Star || peek_tok(p).type == TokenType::Slash ||
         peek_tok(p).type == TokenType::Percent) {
    Token op = advance_tok(p);
    Expr right = unary(p);
    left = Expr::Binary(left, token_to_binary_op(op.type), right, op.line, op.col);
  }
  return left;
}

Expr unary(Parser p) {
  // try expr — soft keyword: if peek is Identifier "try", parse as TryExpr
  if (check(p, TokenType::Identifier) && peek_tok(p).lexeme == "try") {
    Token tt = advance_tok(p);
    Expr value = unary(p);
    return Expr::TryExpr(value, tt.line, tt.col);
  }
  if (peek_tok(p).type == TokenType::Bang || peek_tok(p).type == TokenType::Minus ||
      peek_tok(p).type == TokenType::Tilde) {
    Token op = advance_tok(p);
    Expr right = unary(p);
    return Expr::Unary(token_to_unary_op(op.type), right, op.line, op.col);
  }
  return call_chain(p);
}

bool expr_is_ident(Expr e) {
  return e match { Expr::Ident(_, _, _) => true, _ => false, };
}

// True when callee is an identifier followed by <...>(  (explicit generic call).
bool looks_like_generic_call(Parser p, Expr callee) {
  if (!expr_is_ident(callee)) { return false; }
  if (!check(p, TokenType::Less) || p.pending_greater) { return false; }
  int saved = p.current;
  advance_tok(p);
  int depth = 1;
  while (p.current < p.tokens.len() && depth > 0) {
    TokenType t = p.tokens[p.current].type;
    if (t == TokenType::Less)              { depth = depth + 1; }
    else if (t == TokenType::Greater)      { depth = depth - 1; }
    else if (t == TokenType::GreaterGreater) { depth = depth - 2; }
    else if (t == TokenType::Semicolon || t == TokenType::Eof) { break; }
    p.current = p.current + 1;
  }
  bool ok = depth == 0 && p.current < p.tokens.len() &&
            p.tokens[p.current].type == TokenType::LeftParen;
  p.current = saved;
  return ok;
}

TypeExpr[] parse_call_type_args(Parser p) {
  TypeExpr[] type_args = [];
  advance_tok(p);
  TypeExpr inner = parse_type_expr(p);
  type_args.push(inner);
  while (match_tt(p, TokenType::Comma)) {
    TypeExpr more = parse_type_expr(p);
    type_args.push(more);
  }
  consume_type_greater(p);
  return type_args;
}

Expr call_chain(Parser p) {
  Expr expr = primary(p);
  while (true) {
    int el = expr_line(expr);
    int ec = expr_col(expr);
    if (looks_like_generic_call(p, expr)) {
      TypeExpr[] ta = parse_call_type_args(p);
      consume(p, TokenType::LeftParen, "Expected '(' after type arguments.");
      Expr[] args = [];
      if (!check(p, TokenType::RightParen)) {
        args.push(expression(p));
        while (match_tt(p, TokenType::Comma)) {
          args.push(expression(p));
        }
      }
      consume(p, TokenType::RightParen, "Expected ')' after arguments.");
      expr = Expr::Call(expr, ta, args, el, ec);
    } else if (match_tt(p, TokenType::LeftParen)) {
      Expr[] args = [];
      if (!check(p, TokenType::RightParen)) {
        args.push(expression(p));
        while (match_tt(p, TokenType::Comma)) {
          args.push(expression(p));
        }
      }
      consume(p, TokenType::RightParen, "Expected ')' after arguments.");
      TypeExpr[] ta = [];
      expr = Expr::Call(expr, ta, args, el, ec);
    } else if (match_tt(p, TokenType::Dot)) {
      Token field = consume(p, TokenType::Identifier, "Expected field name after '.'.");
      expr = Expr::FieldAccess(expr, field.lexeme, el, ec);
    } else if (match_tt(p, TokenType::LeftBracket)) {
      Expr index = expression(p);
      consume(p, TokenType::RightBracket, "Expected ']' after index.");
      expr = Expr::Index(expr, index, el, ec);
    } else if (match_tt(p, TokenType::Match)) {
      expr = match_expression(p, expr);
    } else if (check(p, TokenType::Question)) {
      // Disambiguate postfix `?` (propagate) from ternary `? :`.
      // If the token after `?` can start an expression, leave `?` for
      // the ternary parser at a higher precedence level.
      if (p.current + 1 < p.tokens.len()) {
        TokenType next = p.tokens[p.current + 1].type;
        if (next == TokenType::Identifier ||
            next == TokenType::Integer || next == TokenType::FloatLit ||
            next == TokenType::StringLit || next == TokenType::CharLit ||
            next == TokenType::True || next == TokenType::False || next == TokenType::Null_ ||
            next == TokenType::LeftParen || next == TokenType::LeftBracket ||
            next == TokenType::LeftBrace ||
            next == TokenType::Minus || next == TokenType::Bang || next == TokenType::Tilde ||
            next == TokenType::Int || next == TokenType::Float || next == TokenType::Double ||
            next == TokenType::Bool || next == TokenType::String || next == TokenType::Void ||
            next == TokenType::Char || next == TokenType::Byte) {
          break; // ternary — don't consume `?`
        }
      }
      advance_tok(p); // consume `?` as propagate
      expr = Expr::Propagate(expr, el, ec);
    } else {
      break;
    }
  }
  return expr;
}

bool starts_type_method(Parser p) {
  TokenType t = peek_tok(p).type;
  if (t != TokenType::Int && t != TokenType::Float && t != TokenType::Double &&
      t != TokenType::Bool && t != TokenType::String && t != TokenType::Byte) {
    return false;
  }
  return check_at(p, 1, TokenType::ColonColon) && check_at(p, 2, TokenType::Identifier);
}

Expr type_method_expr(Parser p) {
  Token tt = advance_tok(p);   // type keyword
  advance_tok(p);              // ::
  Token method = advance_tok(p); // method name
  consume(p, TokenType::LeftParen, "Expected '(' after type-qualified method.");
  Expr[] args = [];
  if (!check(p, TokenType::RightParen)) {
    args.push(expression(p));
    while (match_tt(p, TokenType::Comma)) {
      args.push(expression(p));
    }
  }
  consume(p, TokenType::RightParen, "Expected ')' after type-qualified method arguments.");
  return Expr::Call(Expr::NsAccess(tt.lexeme, method.lexeme, tt.line, tt.col), [], args, tt.line, tt.col);
}

bool starts_cast(Parser p) {
  TokenType t = peek_tok(p).type;
  if (t != TokenType::Int && t != TokenType::Float && t != TokenType::Double &&
      t != TokenType::Bool && t != TokenType::String && t != TokenType::Byte) {
    return false;
  }
  return check_at(p, 1, TokenType::LeftParen);
}

Expr cast_expr(Parser p) {
  Token tt = advance_tok(p);
  TypeExpr target = make_type(tt.lexeme);
  consume(p, TokenType::LeftParen, "Expected '(' in cast.");
  Expr value = expression(p);
  consume(p, TokenType::RightParen, "Expected ')' after cast value.");
  return Expr::Cast(target, value, tt.line, tt.col);
}

bool first_char_is_upper(string s) {
  if (s.len() == 0) { return false; }
  string c = s.slice(0, 1);
  return c >= "A" && c <= "Z";
}

bool looks_like_struct_lit(Parser p, string ident_name) {
  if (!first_char_is_upper(ident_name)) { return false; }
  if (!check(p, TokenType::LeftBrace)) { return false; }
  return !check_at(p, 1, TokenType::RightBrace);
}

Expr parse_struct_literal(Parser p, TypeExpr ty, Token start) {
  consume(p, TokenType::LeftBrace, "Expected '{' for struct literal.");
  FieldInit[] fields = [];
  while (!check(p, TokenType::RightBrace) && !is_at_end(p)) {
    Expr v = expression(p);
    FieldInit fi = FieldInit { "", v };
    fields.push(fi);
    if (!check(p, TokenType::RightBrace)) {
      consume(p, TokenType::Comma, "Expected ',' between struct fields.");
    }
  }
  consume(p, TokenType::RightBrace, "Expected '}' after struct literal.");
  return Expr::StructLit(ty, fields, start.line, start.col);
}

Expr primary(Parser p) {
  if (starts_type_method(p)) { return type_method_expr(p); }
  if (starts_cast(p)) { return cast_expr(p); }
  if (match_tt(p, TokenType::Integer)) {
    Token t = previous(p);
    return Expr::IntLit(t.int_value, t.line, t.col);
  }
  if (match_tt(p, TokenType::CharLit)) {
    Token t = previous(p);
    return Expr::CharLit(t.int_value, t.line, t.col);
  }
  if (match_tt(p, TokenType::FloatLit)) {
    Token t = previous(p);
    return Expr::FloatLit(t.float_value, t.line, t.col);
  }
  if (match_tt(p, TokenType::StringLit)) {
    Token t = previous(p);
    return Expr::StringLit(strip_string_quotes(t.lexeme), t.line, t.col);
  }
  if (match_tt(p, TokenType::True))  { Token t = previous(p); return Expr::BoolLit(true,  t.line, t.col); }
  if (match_tt(p, TokenType::False)) { Token t = previous(p); return Expr::BoolLit(false, t.line, t.col); }
  if (match_tt(p, TokenType::Null_)) {
    Token t = previous(p);
    return Expr::NullLit(t.line, t.col);
  }
  if (match_tt(p, TokenType::LeftBracket)) {
    Token lb = previous(p);
    Expr[] elems = [];
    if (!check(p, TokenType::RightBracket)) {
      elems.push(expression(p));
      while (match_tt(p, TokenType::Comma)) {
        elems.push(expression(p));
      }
    }
    consume(p, TokenType::RightBracket, "Expected ']' after array literal.");
    return Expr::ArrayLit(elems, lb.line, lb.col);
  }
  if (match_tt(p, TokenType::LeftBrace)) {
    Token lb = previous(p);
    Expr[] keys = [];
    Expr[] values = [];
    if (!check(p, TokenType::RightBrace)) {
      keys.push(expression(p));
      consume(p, TokenType::Colon, "Expected ':' between map key and value.");
      values.push(expression(p));
      while (match_tt(p, TokenType::Comma)) {
        if (check(p, TokenType::RightBrace)) { break; } // trailing comma
        keys.push(expression(p));
        consume(p, TokenType::Colon, "Expected ':' between map key and value.");
        values.push(expression(p));
      }
    }
    consume(p, TokenType::RightBrace, "Expected '}' after map literal.");
    return Expr::MapLit(keys, values, lb.line, lb.col);
  }
  if (match_tt(p, TokenType::LeftParen)) {
    Expr e = expression(p);
    consume(p, TokenType::RightParen, "Expected ')' after expression.");
    return e;
  }
  if (match_tt(p, TokenType::Identifier)) {
    Token id = previous(p);
    if (match_tt(p, TokenType::ColonColon)) {
      Token member = consume(p, TokenType::Identifier, "Expected member name after '::'.");
      return Expr::NsAccess(id.lexeme, member.lexeme, id.line, id.col);
    }
    if (looks_like_struct_lit(p, id.lexeme)) {
      return parse_struct_literal(p, make_type(id.lexeme), id);
    }
    return Expr::Ident(id.lexeme, id.line, id.col);
  }
  Token bad = peek_tok(p);
  error_at(p, bad, "Expected expression.");
  advance_tok(p);
  return Expr::None;
}

Expr match_expression(Parser p, Expr value) {
  Token mt = previous(p);
  consume(p, TokenType::LeftBrace, "Expected '{' after 'match'.");
  MatchArm[] arms = [];
  while (!check(p, TokenType::RightBrace) && !is_at_end(p)) {
    Expr pat = parse_pattern(p);
    Expr g = Expr::None;
    if (match_tt(p, TokenType::If)) {
      consume(p, TokenType::LeftParen, "Expected '(' after 'if' in guard.");
      g = expression(p);
      consume(p, TokenType::RightParen, "Expected ')' after guard condition.");
    }
    consume(p, TokenType::FatArrow, "Expected '=>' after match pattern.");
    Expr body = expression(p);
    MatchArm arm = MatchArm { pat, g, body };
    arms.push(arm);
    if (!check(p, TokenType::RightBrace)) {
      consume(p, TokenType::Comma, "Expected ',' after match arm.");
    }
  }
  consume(p, TokenType::RightBrace, "Expected '}' after match arms.");
  return Expr::Match(value, arms, mt.line, mt.col);
}

Expr parse_pattern(Parser p) {
  if (match_tt(p, TokenType::Let)) {
    Token n = consume(p, TokenType::Identifier, "Expected variable name after 'let'.");
    return Expr::BindingPat(n.lexeme, n.line, n.col);
  }
  if (match_tt(p, TokenType::LeftBracket)) {
    Token lb = previous(p);
    Expr[] elems = [];
    while (!check(p, TokenType::RightBracket) && !is_at_end(p)) {
      if (match_tt(p, TokenType::Let)) {
        Token n = consume(p, TokenType::Identifier, "Expected variable name after 'let'.");
        elems.push(Expr::BindingPat(n.lexeme, n.line, n.col));
      } else {
        elems.push(expression(p));
      }
      if (!check(p, TokenType::RightBracket)) {
        consume(p, TokenType::Comma, "Expected ',' between array pattern elements.");
      }
    }
    consume(p, TokenType::RightBracket, "Expected ']' after array pattern.");
    return Expr::ArrayPat(elems, lb.line, lb.col);
  }
  if (check(p, TokenType::Identifier) && check_at(p, 1, TokenType::ColonColon)) {
    Token enum_tok = advance_tok(p);
    advance_tok(p);
    Token variant = consume(p, TokenType::Identifier, "Expected variant name after '::'.");
    Expr[] fields = [];
    if (match_tt(p, TokenType::LeftParen)) {
      while (!check(p, TokenType::RightParen) && !is_at_end(p)) {
        if (match_tt(p, TokenType::Let)) {
          Token n = consume(p, TokenType::Identifier, "Expected variable name after 'let'.");
          fields.push(Expr::BindingPat(n.lexeme, n.line, n.col));
        } else {
          fields.push(expression(p));
        }
        if (!check(p, TokenType::RightParen)) {
          consume(p, TokenType::Comma, "Expected ',' between enum pattern fields.");
        }
      }
      consume(p, TokenType::RightParen, "Expected ')' after enum pattern fields.");
    }
    return Expr::EnumPat(enum_tok.lexeme, variant.lexeme, fields, enum_tok.line, enum_tok.col);
  }
  return expression(p);
}
