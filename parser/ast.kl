// AST nodes for the self-hosted Kinglet parser.
//
// Tagged unions are encoded as enums with payload variants (Kinglet has no
// `union` keyword). Variant params are positional types; field meaning is
// fixed by position and documented per variant below.
//
// Recursive nesting (Expr inside Expr, Stmt inside Stmt) relies on the
// bootstrap compiler's forward-decl pre-pass.

export module ast;
pub enum BinaryOp {
  Add, Sub, Mul, Div, Mod,
  Eq, Neq, Lt, Gt, Le, Ge,
  And, Or,
  BitAnd, BitOr, BitXor, Shl, Shr,
}

pub enum UnaryOp { Neg, Not, BitNot, }

pub enum AssignOp { Assign, AddAssign, SubAssign, MulAssign, DivAssign, }

pub struct TypeExpr {
  string name;
  string[] type_args;
}

pub TypeExpr make_type(string name) => TypeExpr { name, [] };

// Expression node. Variant payloads, in order:
//
//   IntLit(value, width_suffix, line, col)
//   FloatLit(value, width_suffix, line, col)
//   StringLit(value, line, col)
//   BoolLit(value, line, col)
//   Ident(name, line, col)
//   Unary(op, right, line, col)
//   Binary(left, op, right, line, col)
//   Assign(name, op, value, line, col)
//   Call(callee, type_args, args, line, col)
//   BindingPat(name, line, col)              // `let x` inside a match pattern
//   ArrayPat(elements, line, col)            // `[a, b, c]` pattern
//   EnumPat(enum_name, variant, fields, line, col)
//   StructPat(struct_name, fields, line, col)  // Point { let x, y: 0 }
//   Match(value, arms, line, col)
//   Cast(target, value, line, col)             // fallback is now handled by ??
//   NsAccess(ns, member, line, col)            // io::out
//   FieldAccess(object, field, line, col)
//   Index(object, index, line, col)
//   StructLit(struct_type, fields, line, col)
//   ArrayLit(elements, line, col)
//   NullCoalesce(left, err_binding, right, line, col)  // left ?: right  or  left ?: |e| right
//   TryExpr(value, line, col)                   // try expr — Ok(v)→v, Err→early return
//   None                                       // sentinel for "no expression"
pub enum Expr {
  IntLit(int, string, int, int),
  CharLit(int, int, int),          // value, line, col
  FloatLit(float, string, int, int),
  StringLit(string, int, int),
  NullLit(int, int),               // line, col
  BoolLit(bool, int, int),
  Ident(string, int, int),
  Unary(UnaryOp, Expr, int, int),
  Binary(Expr, BinaryOp, Expr, int, int),
  Assign(string, AssignOp, Expr, int, int),
  Call(Expr, TypeExpr[], Expr[], int, int),
  BindingPat(string, int, int),
  ArrayPat(Expr[], int, int),
  EnumPat(string, string, Expr[], int, int),
  StructPat(string, FieldInit[], int, int),
  Match(Expr, MatchArm[], int, int),
  Cast(TypeExpr, Expr, int, int),
  NsAccess(string, string, int, int),
  FieldAccess(Expr, string, int, int),
  FieldAssign(Expr, string, Expr, int, int),    // object, field_name, value, line, col
  Index(Expr, Expr, int, int),
  IndexAssign(Expr, Expr, Expr, int, int),      // object, index, value, line, col
  StructLit(TypeExpr, FieldInit[], int, int),
  ArrayLit(Expr[], int, int),
  MapLit(Expr[], Expr[], int, int),             // keys, values, line, col
  NullCoalesce(Expr, string, Expr, int, int),
  Ternary(Expr, Expr, Expr, int, int),          // condition, then_expr, else_expr, line, col
  Propagate(Expr, int, int),                    // value, line, col
  TryExpr(Expr, int, int),
  None,
}

pub struct MatchArm {
  Expr pattern;
  Expr guard_expr;
  Expr body;
}

pub struct FieldInit {
  string name;
  Expr value;
}

pub struct Parameter {
  TypeExpr type;
  string name;
}

// Statement node. Variant payloads, in order:
//
//   ExprStmt(expr, line, col)
//   ReturnStmt(value, line, col)             // value may be Expr::None
//   VarDecl(storage, type, name, init, line, col)
//   Block(statements, line, col)
//   If(condition, then_branch, else_branch, line, col)  // else_branch may be Stmt::None
//   Guard(condition, else_body, line, col)
//   While(condition, body, line, col)
//   For(init, condition, step, body, line, col)         // any of init/condition/step may be None
//   Break(line, col)
//   Continue(line, col)
//   None                                                 // sentinel for "no statement"
pub struct CatchArm {
  TypeExpr error_type;
  string binding_name;
  Stmt body;
}

pub enum Stmt {
  ExprStmt(Expr, int, int),
  ReturnStmt(Expr, int, int),
  VarDecl(string, TypeExpr, string, Expr, int, int),
  Block(Stmt[], int, int),
  If(Expr, Stmt, Stmt, int, int),
  Guard(Expr, Stmt, int, int),
  While(Expr, Stmt, int, int),
  For(Stmt, Expr, Stmt, Stmt, int, int),
  Break(int, int),
  Continue(int, int),
  TryCatch(Stmt, CatchArm[], int, int),   // body, catches, line, col
  None,
}

pub struct FieldDef {
  TypeExpr type;
  string name;
}

pub struct EnumVariant {
  string name;
  TypeExpr[] param_types;
}

pub struct ConceptMethod {
  TypeExpr return_type;
  string name;
  Parameter[] params;
}

pub struct WhereClause {
  string concept_name;
  string[] type_args;
}

// Declaration node. Variant payloads, in order:
//
//   FunctionDecl(name, return_type, type_params, params, where_clauses, body, is_public, line, col)
//   StructDecl(name, type_params, fields, is_public, line, col)
//   EnumDecl(name, variants, is_public, line, col)
//   ConceptDecl(name, type_params, methods, is_public, line, col)
//   ImportDecl(path, alias, selected, line, col)
//   LogicalImportDecl(module_id, line, col)
//   ExportModuleDecl(name, line, col)
//   ImportBlockDecl(paths, aliases, line, col)  — import { "p1" as a \n "p2" }
//   UsingDecl(namespace_name, is_namespace, selected, wildcard, line, col)
pub enum Decl {
  FunctionDecl(string, TypeExpr, string[], Parameter[], WhereClause[], Stmt, bool, int, int),
  StructDecl(string, string[], FieldDef[], bool, int, int),
  EnumDecl(string, EnumVariant[], bool, int, int),
  ConceptDecl(string, string[], ConceptMethod[], bool, int, int),
  ImportDecl(string, string, string[], int, int),
  LogicalImportDecl(string, int, int),
  ExportModuleDecl(string, int, int),
  ImportBlockDecl(string[], string[], int, int),
  UsingDecl(string, bool, string[], bool, int, int),
  TopLevelStmt(Stmt, int, int),
}

pub struct Program {
  Decl[] declarations;
}
