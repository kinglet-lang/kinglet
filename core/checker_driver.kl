// CLI entry points for `--check` mode. Wires lexer + parser + checker
// and prints diagnostics; the type checker itself lives in
// `../checker/checker.kl`.

export module core.checker_driver;

import lexer.token;
import lexer.scanner;
import parser.ast;
import parser.helpers;
import parser;
import checker;
using io;
using namespace lexer.scanner;
using namespace lexer.token;
using namespace parser.ast;
using namespace parser.helpers;
using namespace checker;

pub int run_checker(Program prog) {
  Checker c = make_checker("check");
  int err_count = check_program(c, prog);
  for (int i = 0; i < c.errors.len(); i = i + 1) {
    CheckError e = c.errors[i];
    if (e.is_warning) {
      io::err.line("{}:{}: warning: {}", e.line, e.col, e.message);
    } else {
      io::err.line("{}:{}: {}", e.line, e.col, e.message);
    }
  }
  return err_count;
}

pub int run_check(string source) {
  Token[] tokens = scan(source);
  if (emit_lexer_errors(tokens) > 0) { return 65; }
  Parser p = make_parser(tokens);
  Program prog = parser::parse_program(p);
  if (p.errors.len() > 0) {
    for (int i = 0; i < p.errors.len(); i = i + 1) {
      ParseError e = p.errors[i];
      io::err.line("{}:{}: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  int err_count = run_checker(prog);
  if (err_count > 0) {
    io::err.line("{} type error(s)", err_count);
    return 65;
  }
  io::out.line("OK: no type errors");
  return 0;
}
