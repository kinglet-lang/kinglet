using io;
using fs;
using sys;

import {
  "//lexer/token.kl"
  "//lexer/scanner.kl"
  "//parser/ast.kl"
  "//parser/helpers.kl"
  "//parser/parser.kl"
  "//codegen/compiler_state.kl"
  "//codegen/compiler.kl"
  "//codegen/disasm.kl"
  "//codegen/bytecode.kl"
  "ast_printer.kl"
  "checker_driver.kl"
}

using scanner { scan };
using token { Token };
using ast { Program };
using helpers { Parser, ParseError };
using compiler_state { Compiler, CompileError, make_compiler };
using compiler { compile_program };

int run_bytecode(string source, string path) {
  Token[] tokens = scan(source);
  Parser p = helpers::make_parser(tokens);
  Program prog = parser::parse_program(p);
  if (p.errors.len() > 0) {
    for (int i = 0; i < p.errors.len(); i = i + 1) {
      ParseError e = p.errors[i];
      io::err.line("{}:{}: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  Compiler co = make_compiler();
  int errs = compile_program(co, prog, path);
  if (errs > 0) {
    for (int i = 0; i < co.errors.len(); i = i + 1) {
      CompileError e = co.errors[i];
      io::err.line("{}:{}: compile error: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  string out = disasm::disassemble(co.chunk);
  io::out(out);
  return 0;
}

int run_save_bytecode(string source, string source_path, string save_path, bool strip_debug) {
  Token[] tokens = scan(source);
  Parser p = helpers::make_parser(tokens);
  Program prog = parser::parse_program(p);
  if (p.errors.len() > 0) {
    for (int i = 0; i < p.errors.len(); i = i + 1) {
      ParseError e = p.errors[i];
      io::err.line("{}:{}: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  Compiler co = make_compiler();
  int errs = compile_program(co, prog, source_path);
  if (errs > 0) {
    for (int i = 0; i < co.errors.len(); i = i + 1) {
      CompileError e = co.errors[i];
      io::err.line("{}:{}: compile error: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  bytecode::serialize_chunk(co.chunk, save_path, strip_debug);
  return 0;
}

int main() {
  string[] argv = sys::args();
  if (argv.len() < 1) {
    io::err.line("usage: kinglet [--ast | --check | --bytecode | --save-bytecode <out>] [--strip-debug] <source.kl>");
    return 64;
  }
  bool dump_ast = false;
  bool do_check = false;
  bool dump_bc = false;
  bool save_bc = false;
  bool strip_debug = false;
  string path = "";
  string save_path = "";
  for (int i = 0; i < argv.len(); i = i + 1) {
    if (argv[i] == "--ast") {
      dump_ast = true;
    } else if (argv[i] == "--check") {
      do_check = true;
    } else if (argv[i] == "--bytecode") {
      dump_bc = true;
    } else if (argv[i] == "--save-bytecode") {
      save_bc = true;
      i = i + 1;
      if (i < argv.len()) { save_path = argv[i]; }
    } else if (argv[i] == "--strip-debug") {
      strip_debug = true;
    } else {
      path = argv[i];
    }
  }
  if (path.len() == 0) {
    io::err.line("usage: kinglet [--ast | --check | --bytecode | --save-bytecode <out>] [--strip-debug] <source.kl>");
    return 64;
  }
  string source = fs::__read(path);
  if (source == null) {
    io::err.line("cannot read file: {}", path);
    return 66;
  }
  if (dump_ast) {
    return ast_printer::run_ast(source);
  }
  if (do_check) {
    return checker_driver::run_check(source);
  }
  if (dump_bc) {
    return run_bytecode(source, path);
  }
  if (save_bc) {
    return run_save_bytecode(source, path, save_path, strip_debug);
  }
  return ast_printer::run_tokens(source);
}
