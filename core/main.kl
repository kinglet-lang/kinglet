export module core.main;

import lexer.token;
import lexer.scanner;
import parser.ast;
import parser.helpers;
import parser;
import compiler.compiler_state;
import compiler;
import compiler.disasm;
import compiler.bytecode;
import compiler.ll_emit;
import core.ast_printer;
import core.checker_driver;
using io;
using fs;
using sys;

using namespace lexer.scanner;
using namespace lexer.token;
using namespace parser.ast;
using namespace parser.helpers;
using namespace compiler.compiler_state;
using namespace compiler;

int run_bytecode(string source, string path) {
  Token[] tokens = scan(source);
  if (emit_lexer_errors(tokens) > 0) { return 65; }
  Parser p = parser::helpers::make_parser(tokens);
  Program prog = parser::parse_program(p);
  if (p.errors.len() > 0) {
    for (int i = 0; i < p.errors.len(); i = i + 1) {
      ParseError e = p.errors[i];
      io::err.line("{}:{}: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  Compiler co = make_compiler();
  int errs = compile_program(co, prog, path);
  if (errs > 0) {
    for (int i = 0; i < co.errors.len(); i = i + 1) {
      CompileError e = co.errors[i];
      io::err.line("{}:{}: compile error: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  string out = compiler::disasm::disassemble(co.chunk);
  io::out(out);
  return 0;
}

int run_save_bytecode(string source, string source_path, string save_path, bool strip_debug) {
  Token[] tokens = scan(source);
  if (emit_lexer_errors(tokens) > 0) { return 65; }
  Parser p = parser::helpers::make_parser(tokens);
  Program prog = parser::parse_program(p);
  if (p.errors.len() > 0) {
    for (int i = 0; i < p.errors.len(); i = i + 1) {
      ParseError e = p.errors[i];
      io::err.line("{}:{}: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  Compiler co = make_compiler();
  int errs = compile_program(co, prog, source_path);
  if (errs > 0) {
    for (int i = 0; i < co.errors.len(); i = i + 1) {
      CompileError e = co.errors[i];
      io::err.line("{}:{}: compile error: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  compiler::bytecode::serialize_chunk(co.chunk, save_path, strip_debug);
  return 0;
}

int run_emit_ll(string source, string source_path, string ll_path) {
  Token[] tokens = scan(source);
  if (emit_lexer_errors(tokens) > 0) { return 65; }
  Parser p = parser::helpers::make_parser(tokens);
  Program prog = parser::parse_program(p);
  if (p.errors.len() > 0) {
    for (int i = 0; i < p.errors.len(); i = i + 1) {
      ParseError e = p.errors[i];
      io::err.line("{}:{}: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  Compiler co = make_compiler();
  int errs = compile_program(co, prog, source_path);
  if (errs > 0) {
    for (int i = 0; i < co.errors.len(); i = i + 1) {
      CompileError e = co.errors[i];
      io::err.line("{}:{}: compile error: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  string ll = compiler::ll_emit::emit_ll(co.kir);
  fs::__write(ll_path, ll);
  return 0;
}

int arg_start(string[] argv) {
  if (argv.len() == 0) {
    return 0;
  }
  string a0 = argv[0];
  if (a0.len() == 0 || a0.slice(0, 1) == "-") {
    return 0;
  }
  if (a0.len() >= 3 && a0.slice(a0.len() - 3, a0.len()) == ".kl") {
    return 0;
  }
  return 1;
}

int main() {
  string[] argv = sys::args();
  int start = arg_start(argv);
  if (argv.len() < start + 1) {
    io::err.line("usage: kinglet [--ast | --check | --bytecode | --save-bytecode <out>] [--strip-debug] <source.kl>");
    return 64;
  }
  bool dump_ast = false;
  bool do_check = false;
  bool dump_bc = false;
  bool save_bc = false;
  bool strip_debug = false;
  string path = "";
  string save_path = "";
  bool emit_ll = false;
  string ll_path = "";
  for (int i = start; i < argv.len(); i = i + 1) {
    if (argv[i] == "--ast") {
      dump_ast = true;
    } else if (argv[i] == "--check") {
      do_check = true;
    } else if (argv[i] == "--bytecode") {
      dump_bc = true;
    } else if (argv[i] == "--save-bytecode") {
      save_bc = true;
      i = i + 1;
      if (i < argv.len()) { save_path = argv[i]; }
    } else if (argv[i] == "--emit-ll") {
      emit_ll = true;
      i = i + 1;
      if (i < argv.len()) { ll_path = argv[i]; }
    } else if (argv[i] == "--strip-debug") {
      strip_debug = true;
    } else {
      path = argv[i];
    }
  }
  if (path.len() == 0) {
    io::err.line("usage: kinglet [--ast | --check | --bytecode | --save-bytecode <out>] [--strip-debug] <source.kl>");
    return 64;
  }
  string source = fs::__read(path);
  if (source == null) {
    io::err.line("cannot read file: {}", path);
    return 66;
  }
  if (dump_ast) {
    return core::ast_printer::run_ast(source);
  }
  if (do_check) {
    return core::checker_driver::run_check(source);
  }
  if (dump_bc) {
    return run_bytecode(source, path);
  }
  if (save_bc) {
    return run_save_bytecode(source, path, save_path, strip_debug);
  }
  if (emit_ll) {
    return run_emit_ll(source, path, ll_path);
  }
  return core::ast_printer::run_tokens(source);
}
