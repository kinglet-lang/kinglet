// Self-hosted Kinglet type checker.
//
// Walks a Program AST (parser/ast.kl) and reports type errors.
// CLI entry points live in core/checker_driver.kl.

export module checker;

import parser.ast;
import stdlib.manifest;
using namespace parser.ast;

// Flat type representation (no recursive Type fields — avoids infinite init).

pub enum TypeKind {
  Int, Float, Bool, String, Void, Unknown, Null,
  Array, Map, Struct, Enum,
}

pub struct Type {
  TypeKind kind;
  string tag;
  bool nullable;
}

pub struct StructField {
  string name;
  string type_enc;
}

pub struct StructInfo {
  string name;
  StructField[] fields;
  string[] type_params;
}

pub struct FuncSig {
  string name;
  Type[] param_types;
  Type ret_type;
}

pub struct EnumVariantInfo {
  string name;
  string[] payload_encs;
}

pub struct EnumInfo {
  string name;
  EnumVariantInfo[] variants;
}

pub struct NativeUsingAlias {
  string short_name;
  string ns;
  string member;
}

pub Type type_int()     => Type { TypeKind::Int,     "int64", false };
pub Type type_float()   => Type { TypeKind::Float,   "float32", false };
pub Type type_double()  => Type { TypeKind::Float,   "float64", false };
pub Type type_bool()    => Type { TypeKind::Bool,    "", false };
pub Type type_string()  => Type { TypeKind::String,  "", false };
pub Type type_void()    => Type { TypeKind::Void,    "", false };
pub Type type_unknown() => Type { TypeKind::Unknown, "", false };
pub Type type_null()    => Type { TypeKind::Null,    "", false };

pub Type type_array(string elem_enc) => Type { TypeKind::Array, elem_enc, false };
pub Type type_map(string key_enc, string val_enc) => Type { TypeKind::Map, key_enc + ":" + val_enc, false };
pub Type type_struct(string name) => Type { TypeKind::Struct, name, false };
pub Type type_enum(string name) => Type { TypeKind::Enum, name, false };

string int_type_name(Type t) {
  if (t.tag == "int64") { return "int"; }
  if (t.tag == "uint8") { return "byte"; }
  if (t.tag == "int8")  { return "char"; }
  if (t.tag.len() > 0)  { return t.tag; }
  return "int";
}

string float_type_name(Type t) {
  if (t.tag == "float32") { return "float"; }
  if (t.tag == "float64") { return "double"; }
  if (t.tag.len() > 0)    { return t.tag; }
  return "float";
}

pub string type_kind_name(Type t) {
  return t.kind match {
    TypeKind::Int     => int_type_name(t),
    TypeKind::Float   => float_type_name(t),
    TypeKind::Bool    => "bool",
    TypeKind::String  => "string",
    TypeKind::Void    => "void",
    TypeKind::Unknown => "unknown",
    TypeKind::Null    => "null",
    TypeKind::Array   => "array",
    TypeKind::Map     => "map",
    TypeKind::Struct  => t.tag,
    TypeKind::Enum    => t.tag,
  };
}

string canonical_type_tag(Type t) {
  if (t.tag.len() > 0) { return t.tag; }
  return t.kind match {
    TypeKind::Int   => "int64",
    TypeKind::Float => "float32",
    _               => type_kind_name(t),
  };
}

// Full surface encoding for container element types (e.g. Array<int32>, Array<Array<int32>>).
pub string type_encode(Type t) {
  return t.kind match {
    TypeKind::Int     => canonical_type_tag(t),
    TypeKind::Float   => canonical_type_tag(t),
    TypeKind::Bool    => "bool",
    TypeKind::String  => "string",
    TypeKind::Array   => "Array<" + t.tag + ">",
    TypeKind::Map     => "Map<" + t.tag + ">",
    TypeKind::Struct  => t.tag,
    TypeKind::Enum    => t.tag,
    _                 => type_kind_name(t),
  };
}

bool int_tags_equal(string a, string b) {
  if (a.len() == 0) { a = "int64"; }
  if (b.len() == 0) { b = "int64"; }
  return a == b;
}

bool integer_assignable(Type from, Type to) {
  if (from.kind != TypeKind::Int || to.kind != TypeKind::Int) { return false; }
  string ft = from.tag;
  string tt = to.tag;
  if (ft.len() == 0) { ft = "int64"; }
  if (tt.len() == 0) { tt = "int64"; }
  if (ft == tt) { return true; }
  if (ft == "int32" && tt == "int64") { return true; }
  return false;
}

bool float_assignable(Type from, Type to) {
  if (from.kind != TypeKind::Float || to.kind != TypeKind::Float) { return false; }
  string ft = from.tag;
  string tt = to.tag;
  if (ft.len() == 0) { ft = "float32"; }
  if (tt.len() == 0) { tt = "float32"; }
  if (ft == tt) { return true; }
  if (ft == "float32" && tt == "float64") { return true; }
  return false;
}

bool types_assignable(Type from, Type to) {
  if (from.kind == TypeKind::Int && to.kind == TypeKind::Int) {
    return integer_assignable(from, to);
  }
  if (from.kind == TypeKind::Float && to.kind == TypeKind::Float) {
    return float_assignable(from, to);
  }
  if (from.kind == TypeKind::Struct && to.kind == TypeKind::Struct) {
    return from.tag == to.tag;
  }
  if (from.kind == TypeKind::Array && to.kind == TypeKind::Array) {
    if (from.tag == to.tag) { return true; }
    if (from.tag == "int32" && to.tag == "int") { return true; }
    if (from.tag == "float32" && to.tag == "float") { return true; }
    return false;
  }
  return types_compatible(from, to);
}

bool types_compatible(Type a, Type b) {
  if (a.kind == TypeKind::Unknown) { return true; }
  if (b.kind == TypeKind::Unknown) { return true; }
  if (a.kind == TypeKind::Null || b.kind == TypeKind::Null) { return true; }
  if (a.kind == TypeKind::Int && b.kind == TypeKind::Int) {
    return true;
  }
  if (a.kind == TypeKind::Int && b.kind == TypeKind::Float) { return true; }
  if (a.kind == TypeKind::Float && b.kind == TypeKind::Int) { return true; }
  if (a.kind == TypeKind::Float && b.kind == TypeKind::Float) {
    string at = a.tag;
    string bt = b.tag;
    if (at.len() == 0) { at = "float32"; }
    if (bt.len() == 0) { bt = "float32"; }
    if (at == bt) { return true; }
    if (at == "float32" || bt == "float32") { return true; }
    return false;
  }
  if (a.kind == TypeKind::Struct && b.kind == TypeKind::Struct) { return a.tag == b.tag; }
  if (a.kind == TypeKind::Enum && b.kind == TypeKind::Enum) { return a.tag == b.tag; }
  if (a.kind == TypeKind::Array && b.kind == TypeKind::Array) { return a.tag == b.tag; }
  if (a.kind == TypeKind::Map && b.kind == TypeKind::Map) { return a.tag == b.tag; }
  return a.kind == b.kind;
}

bool is_numeric(Type t) {
  if (t.kind == TypeKind::Int) { return true; }
  if (t.kind == TypeKind::Float) { return true; }
  return false;
}

string type_expr_encode(TypeExpr t) {
  if (t.type_args.len() == 0) { return t.name; }
  string out = t.name + "<";
  for (int i = 0; i < t.type_args.len(); i = i + 1) {
    if (i > 0) { out = out + ","; }
    out = out + t.type_args[i];
  }
  return out + ">";
}

// scope stack & checker state

pub struct Binding {
  string name;
  Type type;
  TypeExpr declared_type;
  int scope_depth;
}

pub struct CheckError {
  int line;
  int col;
  string message;
  bool is_warning;
}

pub struct Checker {
  Binding[] bindings;
  int[] scope_starts;
  CheckError[] errors;
  string file;
  StructInfo[] structs;
  EnumInfo[] enums;
  FuncSig[] funcs;
  string[] concepts;
  NativeUsingAlias[] native_usings;
  int loop_depth;
  bool has_expected_return;
  Type expected_return;
}

pub Checker make_checker(string file) {
  return Checker { [], [], [], file, [], [], [], [], [], 0, false, type_void() };
}

void push_scope(Checker c) { c.scope_starts.push(c.bindings.len()); }

void pop_scope(Checker c) {
  if (c.scope_starts.len() == 0) { return; }
  int start = c.scope_starts[c.scope_starts.len() - 1];
  c.scope_starts.pop();
  while (c.bindings.len() > start) { c.bindings.pop(); }
}

int current_scope_start(Checker c) {
  if (c.scope_starts.len() == 0) { return 0; }
  return c.scope_starts[c.scope_starts.len() - 1];
}

pub void add_error(Checker c, int line, int col, string msg) {
  c.errors.push(CheckError { line, col, msg, false });
}

pub void add_warning(Checker c, int line, int col, string msg) {
  c.errors.push(CheckError { line, col, msg, true });
}

void declare_var(Checker c, string name, Type t, int line, int col) {
  declare_var_typed(c, name, t, empty_type_expr(), line, col);
}

void declare_var_typed(Checker c, string name, Type t, TypeExpr declared, int line, int col) {
  int start = current_scope_start(c);
  for (int i = start; i < c.bindings.len(); i = i + 1) {
    if (c.bindings[i].name == name) {
      add_error(c, line, col, "Variable '" + name + "' already declared in this scope.");
      return;
    }
  }
  c.bindings.push(Binding { name, t, declared, c.scope_starts.len() });
}

bool var_exists(Checker c, string name) {
  int i = c.bindings.len() - 1;
  while (i >= 0) {
    if (c.bindings[i].name == name) { return true; }
    i = i - 1;
  }
  return false;
}

Type lookup_var(Checker c, string name) {
  int i = c.bindings.len() - 1;
  while (i >= 0) {
    if (c.bindings[i].name == name) { return c.bindings[i].type; }
    i = i - 1;
  }
  return type_unknown();
}

StructInfo lookup_struct_info(Checker c, string name) {
  for (int i = 0; i < c.structs.len(); i = i + 1) {
    if (c.structs[i].name == name) { return c.structs[i]; }
  }
  return StructInfo { "", [], [] };
}

bool enum_exists(Checker c, string name) {
  for (int i = 0; i < c.enums.len(); i = i + 1) {
    if (c.enums[i].name == name) { return true; }
  }
  return false;
}

bool native_namespace_open(Checker c, string ns) {
  for (int i = 0; i < c.native_usings.len(); i = i + 1) {
    if (c.native_usings[i].ns == ns) { return true; }
  }
  return false;
}

TypeExpr empty_type_expr() {
  return TypeExpr { "", [] };
}

TypeExpr lookup_var_type_expr(Checker c, string name) {
  for (int i = c.bindings.len() - 1; i >= 0; i = i - 1) {
    if (c.bindings[i].name == name) {
      return c.bindings[i].declared_type;
    }
  }
  return empty_type_expr();
}

Type resolve_generic_field_type(Checker c, StructInfo info, string field_name, TypeExpr inst) {
  for (int i = 0; i < info.fields.len(); i = i + 1) {
    if (info.fields[i].name != field_name) { continue; }
    string enc = info.fields[i].type_enc;
    for (int j = 0; j < info.type_params.len(); j = j + 1) {
      if (info.type_params[j] == enc && j < inst.type_args.len()) {
        return resolve_type_name(c, inst.type_args[j]);
      }
    }
    return resolve_type_name(c, enc);
  }
  return type_unknown();
}

bool struct_exists(Checker c, string name) {
  for (int i = 0; i < c.structs.len(); i = i + 1) {
    if (c.structs[i].name == name) { return true; }
  }
  return false;
}

void register_struct_info(Checker c, StructInfo info) {
  c.structs.push(info);
}

void register_enum_info(Checker c, EnumInfo info) {
  c.enums.push(info);
}

EnumVariantInfo lookup_enum_variant(Checker c, string enum_name, string variant_name) {
  for (int i = 0; i < c.enums.len(); i = i + 1) {
    if (c.enums[i].name != enum_name) { continue; }
    for (int j = 0; j < c.enums[i].variants.len(); j = j + 1) {
      if (c.enums[i].variants[j].name == variant_name) {
        return c.enums[i].variants[j];
      }
    }
  }
  return EnumVariantInfo { "", [] };
}

void register_func(Checker c, FuncSig sig) { c.funcs.push(sig); }

bool func_exists(Checker c, string name) {
  for (int i = 0; i < c.funcs.len(); i = i + 1) {
    if (c.funcs[i].name == name) { return true; }
  }
  return false;
}

FuncSig lookup_func(Checker c, string name) {
  for (int i = 0; i < c.funcs.len(); i = i + 1) {
    if (c.funcs[i].name == name) { return c.funcs[i]; }
  }
  return FuncSig { "", [], type_void() };
}

bool is_auto_type(TypeExpr t) {
  if (t.type_args.len() != 0) { return false; }
  return t.name == "auto";
}

Type make_int_tag(string tag) => Type { TypeKind::Int, tag, false };
Type make_float_tag(string tag) => Type { TypeKind::Float, tag, false };

Type resolve_scalar_name(string name) {
  if (name == "int")     { return type_int(); }
  if (name == "int8")    { return make_int_tag("int8"); }
  if (name == "int16")   { return make_int_tag("int16"); }
  if (name == "int32")   { return make_int_tag("int32"); }
  if (name == "int64")   { return type_int(); }
  if (name == "uint8")   { return make_int_tag("uint8"); }
  if (name == "uint16")  { return make_int_tag("uint16"); }
  if (name == "uint32")  { return make_int_tag("uint32"); }
  if (name == "uint64")  { return make_int_tag("uint64"); }
  if (name == "float")   { return type_float(); }
  if (name == "float32") { return type_float(); }
  if (name == "float64") { return type_double(); }
  if (name == "double")  { return type_double(); }
  if (name == "bool")    { return type_bool(); }
  if (name == "string")  { return type_string(); }
  if (name == "void")    { return type_void(); }
  if (name == "byte")    { return make_int_tag("uint8"); }
  if (name == "char")    { return make_int_tag("int8"); }
  return type_unknown();
}

Type default_int_literal_type(int value) {
  if (value >= -2147483648 && value <= 2147483647) {
    return make_int_tag("int32");
  }
  return type_int();
}

Type int_literal_type_from_suffix(string suffix, int value) {
  if (suffix.len() == 0) { return default_int_literal_type(value); }
  if (suffix == "i8") { return make_int_tag("int8"); }
  if (suffix == "i16") { return make_int_tag("int16"); }
  if (suffix == "i32") { return make_int_tag("int32"); }
  if (suffix == "i64") { return type_int(); }
  if (suffix == "u8") { return make_int_tag("uint8"); }
  if (suffix == "u16") { return make_int_tag("uint16"); }
  if (suffix == "u32") { return make_int_tag("uint32"); }
  if (suffix == "u64") { return make_int_tag("uint64"); }
  return default_int_literal_type(value);
}

Type float_literal_type_from_suffix(string suffix) {
  if (suffix == "f32") { return type_float(); }
  if (suffix == "f64") { return type_double(); }
  return type_float();
}

// Parse surface encodings produced by parser type_to_string (e.g. Array<int32>).
Type resolve_encoded_type(Checker c, string encoded) {
  if (encoded.len() >= 7) {
    string head = encoded.slice(0, 6);
    if (head == "Array<") {
      string tail = encoded.slice(encoded.len() - 1, encoded.len());
      if (tail == ">") {
        string inner = encoded.slice(6, encoded.len() - 1);
        return type_array(inner);
      }
    }
  }
  Type scalar = resolve_scalar_name(encoded);
  if (scalar.kind != TypeKind::Unknown) { return scalar; }
  if (enum_exists(c, encoded)) { return type_enum(encoded); }
  if (struct_exists(c, encoded)) { return type_struct(encoded); }
  return type_unknown();
}

Type resolve_type_name(Checker c, string encoded) {
  return resolve_encoded_type(c, encoded);
}

Type resolve_type_expr(Checker c, TypeExpr t) {
  if (is_auto_type(t)) { return type_unknown(); }
  if (t.name == "Array" && t.type_args.len() == 1) {
    return type_array(t.type_args[0]);
  }
  if (t.name == "Map" && t.type_args.len() == 2) {
    return type_map(t.type_args[0], t.type_args[1]);
  }
  if (t.name == "Nullable" && t.type_args.len() == 1) {
    Type inner = resolve_encoded_type(c, t.type_args[0]);
    inner.nullable = true;
    return inner;
  }
  Type scalar = resolve_scalar_name(t.name);
  if (scalar.kind != TypeKind::Unknown) { return scalar; }
  if (enum_exists(c, t.name)) { return type_enum(t.name); }
  if (t.type_args.len() > 0) {
    if (struct_exists(c, t.name)) { return type_struct(t.name); }
    return type_unknown();
  }
  if (struct_exists(c, t.name)) { return type_struct(t.name); }
  return type_unknown();
}

// binary-op helpers

bool is_arithmetic_op(BinaryOp op) {
  return op match {
    BinaryOp::Add => true, BinaryOp::Sub => true, BinaryOp::Mul => true,
    BinaryOp::Div => true, BinaryOp::Mod => true, _ => false,
  };
}

bool is_comparison_op(BinaryOp op) {
  return op match {
    BinaryOp::Eq => true, BinaryOp::Neq => true, BinaryOp::Lt => true,
    BinaryOp::Gt => true, BinaryOp::Le => true, BinaryOp::Ge => true, _ => false,
  };
}

bool is_logical_op(BinaryOp op) {
  return op match { BinaryOp::And => true, BinaryOp::Or => true, _ => false, };
}

bool is_bitwise_op(BinaryOp op) {
  return op match {
    BinaryOp::BitAnd => true, BinaryOp::BitOr => true, BinaryOp::BitXor => true,
    BinaryOp::Shl => true, BinaryOp::Shr => true, _ => false,
  };
}

bool op_is_add(BinaryOp op) {
  return op match { BinaryOp::Add => true, _ => false, };
}

// expression checking

Type check_expr(Checker c, Expr e) {
  return e match {
    Expr::IntLit(let v, let suf, _, _)   => int_literal_type_from_suffix(suf, v),
    Expr::FloatLit(_, let suf, _, _)     => float_literal_type_from_suffix(suf),
    Expr::StringLit(_, _, _)    => type_string(),
    Expr::BoolLit(_, _, _)      => type_bool(),
    Expr::NullLit(_, _)         => type_null(),
    Expr::CharLit(_, _, _)      => type_int(),
    Expr::Ident(let n, let l, let co) => check_ident(c, n, l, co),
    Expr::Unary(let op, let r, let l, let co) => check_unary(c, op, r, l, co),
    Expr::Binary(let lhs, let op, let rhs, let l, let co) => check_binary(c, lhs, op, rhs, l, co),
    Expr::Assign(let n, let op, let v, let l, let co) => check_assign(c, n, op, v, l, co),
    Expr::Call(let callee, let ta, let args, let l, let co) => check_call(c, callee, ta, args, l, co),
    Expr::ArrayLit(let elems, let l, let co) => check_array_lit(c, elems, l, co),
    Expr::Index(let obj, let idx, let l, let co) => check_index(c, obj, idx, l, co),
    Expr::IndexAssign(let obj, let idx, let val, let l, let co) => check_index_assign(c, obj, idx, val, l, co),
    Expr::StructLit(let ty, let fields, let l, let co) => check_struct_lit(c, ty, fields, l, co),
    Expr::FieldAccess(let obj, let field, let l, let co) => check_field_access(c, obj, field, l, co),
    Expr::FieldAssign(let obj, let field, let val, let l, let co) => check_field_assign(c, obj, field, val, l, co),
    Expr::NsAccess(let ns, let member, let l, let co) => check_ns_access(c, ns, member, l, co),
    Expr::Ternary(let cond, let th, let el, let l, let co) => check_ternary(c, cond, th, el, l, co),
    Expr::NullCoalesce(let left, let _eb, let right, let l, let co) => check_coalesce(c, left, right, l, co),
    Expr::Cast(let target, let val, let l, let co) => check_cast(c, target, val, l, co),
    Expr::Match(let val, let arms, let l, let co) => check_match(c, val, arms, l, co),
    _ => type_unknown(),
  };
}

bool is_native_namespace(string ns) {
  return stdlib::manifest::is_native_namespace(ns);
}

bool is_native_member(string ns, string member) {
  return stdlib::manifest::is_native_member(ns, member);
}

NativeUsingAlias no_native_alias() {
  return NativeUsingAlias { "", "", "" };
}

void register_native_using_alias(Checker c, string short_name, string ns, string member) {
  c.native_usings.push(NativeUsingAlias { short_name, ns, member });
}

NativeUsingAlias resolve_native_using_alias(Checker c, string short_name) {
  for (int i = 0; i < c.native_usings.len(); i = i + 1) {
    if (c.native_usings[i].short_name == short_name) {
      return c.native_usings[i];
    }
  }
  return no_native_alias();
}

string expr_ident_name(Expr e) {
  return e match { Expr::Ident(let n, _, _) => n, _ => "", };
}

Type check_native_member_access(Checker c, string ns, string member, string field, int line, int col) {
  if (ns == "io") {
    if (member == "out" && field == "line") { return type_void(); }
    if (member == "err" && field == "line") { return type_void(); }
    if (member == "in" && field == "secret") { return type_void(); }
  }
  add_error(c, line, col, "Unknown method '" + field + "' on native '" + ns + "::" + member + "'.");
  return type_unknown();
}

Type check_native_member_call(Checker c, string ns, string member, string field, Expr[] args, int line, int col) {
  if (ns == "io" && member == "out" && field == "line") {
    for (int i = 0; i < args.len(); i = i + 1) {
      Type _at = check_expr(c, args[i]);
    }
    return type_void();
  }
  if (ns == "io" && member == "err" && field == "line") {
    for (int i = 0; i < args.len(); i = i + 1) {
      Type _at = check_expr(c, args[i]);
    }
    return type_void();
  }
  if (ns == "io" && member == "in" && field == "secret") {
    for (int i = 0; i < args.len(); i = i + 1) {
      Type _at = check_expr(c, args[i]);
    }
    return type_string();
  }
  return check_native_member_access(c, ns, member, field, line, col);
}

Type check_ident(Checker c, string name, int line, int col) {
  if (name == "null") { return type_null(); }
  if (var_exists(c, name)) { return lookup_var(c, name); }
  NativeUsingAlias alias = resolve_native_using_alias(c, name);
  if (alias.short_name.len() > 0) { return type_unknown(); }
  add_error(c, line, col, "Undeclared variable '" + name + "'.");
  return type_unknown();
}

Type check_unary(Checker c, UnaryOp op, Expr r, int line, int col) {
  Type rt = check_expr(c, r);
  return op match {
    UnaryOp::Neg    => check_neg(c, rt, line, col),
    UnaryOp::Not    => type_bool(),
    UnaryOp::BitNot => check_bitnot(c, rt, line, col),
  };
}

Type check_neg(Checker c, Type rt, int line, int col) {
  if (rt.kind == TypeKind::Unknown) { return type_int(); }
  if (is_numeric(rt)) { return rt; }
  add_error(c, line, col, "Cannot negate non-numeric type '" + type_kind_name(rt) + "'.");
  return type_int();
}

Type check_bitnot(Checker c, Type rt, int line, int col) {
  if (rt.kind == TypeKind::Unknown) { return type_int(); }
  if (rt.kind != TypeKind::Int) {
    add_error(c, line, col, "Bitwise NOT requires an integer operand.");
  }
  return type_int();
}

Type check_binary(Checker c, Expr lhs, BinaryOp op, Expr rhs, int line, int col) {
  Type l = check_expr(c, lhs);
  Type r = check_expr(c, rhs);
  if (is_arithmetic_op(op)) { return check_arithmetic(c, op, l, r, line, col); }
  if (is_comparison_op(op)) { return check_comparison(c, l, r, line, col); }
  if (is_logical_op(op))    { return type_bool(); }
  if (is_bitwise_op(op))    { return check_bitwise(c, l, r, line, col); }
  return type_unknown();
}

Type check_arithmetic(Checker c, BinaryOp op, Type l, Type r, int line, int col) {
  if (op_is_add(op) && (l.kind == TypeKind::String || r.kind == TypeKind::String)) {
    return type_string();
  }
  if (l.kind == TypeKind::Unknown || r.kind == TypeKind::Unknown) { return type_int(); }
  if (!is_numeric(l) || !is_numeric(r)) {
    add_error(c, line, col, "Arithmetic operands must be numeric.");
    return type_int();
  }
  if (l.kind == TypeKind::Float || r.kind == TypeKind::Float) {
    if (l.kind == TypeKind::Float && r.kind == TypeKind::Float && l.tag == r.tag && l.tag.len() > 0) {
      return l;
    }
    if (float_type_name(l) == "float64" || float_type_name(r) == "float64") {
      return type_double();
    }
    return type_float();
  }
  if (l.kind == TypeKind::Int && r.kind == TypeKind::Int && l.tag == r.tag && l.tag.len() > 0) {
    return l;
  }
  return type_int();
}

Type check_comparison(Checker c, Type l, Type r, int line, int col) {
  if (!types_compatible(l, r)) {
    add_error(c, line, col,
      "Cannot compare '" + type_kind_name(l) + "' and '" + type_kind_name(r) + "'.");
  }
  return type_bool();
}

Type check_bitwise(Checker c, Type l, Type r, int line, int col) {
  if (l.kind == TypeKind::Unknown || r.kind == TypeKind::Unknown) { return type_int(); }
  if (l.kind != TypeKind::Int || r.kind != TypeKind::Int) {
    add_error(c, line, col, "Bitwise operators require integer operands.");
  }
  return type_int();
}

Type check_assign(Checker c, string name, AssignOp op, Expr value, int line, int col) {
  Type vt = check_expr(c, value);
  if (!var_exists(c, name)) {
    add_error(c, line, col, "Undeclared variable '" + name + "'.");
    return vt;
  }
  Type target = lookup_var(c, name);
  bool is_plain = op match { AssignOp::Assign => true, _ => false, };
  if (is_plain) {
    if (!types_assignable(vt, target)) {
      add_error(c, line, col,
        "Cannot assign '" + type_kind_name(vt) + "' to variable '" + name + "' of type '" + type_kind_name(target) + "'.");
    }
  }
  return target;
}

string callee_name(Expr callee) {
  return callee match { Expr::Ident(let n, _, _) => n, _ => "", };
}

Type check_call(Checker c, Expr callee, TypeExpr[] type_args, Expr[] args, int line, int col) {
  bool is_field = callee match {
    Expr::FieldAccess(let _o, let _f, let _l, let _c) => true,
    _ => false,
  };
  if (is_field) {
    return callee match {
      Expr::FieldAccess(let obj, let method, let fl, let fc) =>
        check_method_call(c, obj, method, args, fl, fc),
      _ => type_unknown(),
    };
  }
  bool is_ns = callee match {
    Expr::NsAccess(let _ns, let _m, let _l, let _c) => true,
    _ => false,
  };
  if (is_ns) {
    return callee match {
      Expr::NsAccess(let ns, let member, let nl, let nc) =>
        check_ns_qualified_call(c, ns, member, args, nl, nc),
      _ => type_unknown(),
    };
  }
  string fname = callee_name(callee);
  if (fname.len() == 0) {
    check_expr(c, callee);
    return type_unknown();
  }
  if (!func_exists(c, fname) && !var_exists(c, fname)) {
    NativeUsingAlias alias = resolve_native_using_alias(c, fname);
    if (alias.short_name.len() > 0) {
      for (int i = 0; i < args.len(); i = i + 1) {
        Type _at = check_expr(c, args[i]);
      }
      return type_void();
    }
  }
  if (!func_exists(c, fname)) {
    add_error(c, line, col, "Undeclared variable '" + fname + "'.");
    return type_unknown();
  }
  FuncSig sig = lookup_func(c, fname);
  if (args.len() != sig.param_types.len()) {
    add_error(c, line, col, "Wrong number of arguments.");
    return sig.ret_type;
  }
  for (int i = 0; i < args.len(); i = i + 1) {
    Type at = check_expr(c, args[i]);
    if (!types_assignable(at, sig.param_types[i])) {
      add_error(c, line, col, "Argument type mismatch.");
    }
  }
  return sig.ret_type;
}

bool concept_exists(Checker c, string name) {
  for (int i = 0; i < c.concepts.len(); i = i + 1) {
    if (c.concepts[i] == name) { return true; }
  }
  return false;
}

string type_match_key(Type t) {
  if (t.kind == TypeKind::Struct) { return t.tag; }
  return type_kind_name(t);
}

FuncSig lookup_concept_impl(Checker c, string method, Type arg_ty) {
  string key = type_match_key(arg_ty);
  for (int i = 0; i < c.funcs.len(); i = i + 1) {
    FuncSig sig = c.funcs[i];
    if (sig.name != method) { continue; }
    if (sig.param_types.len() == 0) { continue; }
    if (type_match_key(sig.param_types[0]) == key) { return sig; }
  }
  return FuncSig { "", [], type_void() };
}

Type check_native_qualified_call(Checker c, string ns, string member, Expr[] args, int line, int col) {
  if (ns == "fs" && member == "__read") {
    if (args.len() != 1) {
      add_error(c, line, col, "fs::__read expects exactly one argument.");
    } else {
      Type at = check_expr(c, args[0]);
      if (at.kind != TypeKind::String && at.kind != TypeKind::Unknown) {
        add_error(c, line, col, "fs::__read expects a string path.");
      }
    }
    return type_string();
  }
  if (ns == "fs" && member == "__write") {
    if (args.len() != 2) {
      add_error(c, line, col, "fs::__write expects exactly two arguments.");
    } else {
      Type p = check_expr(c, args[0]);
      Type ctt = check_expr(c, args[1]);
      if (p.kind != TypeKind::String && p.kind != TypeKind::Unknown) {
        add_error(c, line, col, "fs::__write expects a string path.");
      }
      if (ctt.kind != TypeKind::String && ctt.kind != TypeKind::Unknown) {
        add_error(c, line, col, "fs::__write expects string content.");
      }
    }
    return type_void();
  }
  if (ns == "io" && (member == "out" || member == "err" || member == "outln" || member == "errln")) {
    for (int i = 0; i < args.len(); i = i + 1) {
      Type _at = check_expr(c, args[i]);
    }
    return type_void();
  }
  if (ns == "io" && member == "in") {
    for (int i = 0; i < args.len(); i = i + 1) {
      Type _at = check_expr(c, args[i]);
    }
    return type_string();
  }
  if (ns == "sys" && member == "args") {
    if (args.len() != 0) {
      add_error(c, line, col, "sys::args expects no arguments.");
    }
    return type_array("string");
  }
  add_error(c, line, col, "Unknown native member '" + ns + "::" + member + "'.");
  return type_unknown();
}

Type check_enum_variant_call(Checker c, string ns, string member, Expr[] args, int line, int col) {
  EnumVariantInfo variant = lookup_enum_variant(c, ns, member);
  if (variant.name.len() == 0) {
    add_error(c, line, col, "Enum '" + ns + "' has no variant '" + member + "'.");
    return type_enum(ns);
  }
  if (args.len() != variant.payload_encs.len()) {
    add_error(c, line, col, "Wrong number of arguments for enum variant '" + member + "'.");
    return type_enum(ns);
  }
  for (int i = 0; i < args.len(); i = i + 1) {
    Type at = check_expr(c, args[i]);
    Type expected = resolve_type_name(c, variant.payload_encs[i]);
    if (!types_compatible(at, expected)) {
      add_error(c, line, col, "Enum variant argument type mismatch.");
    }
  }
  return type_enum(ns);
}

Type check_ns_qualified_call(Checker c, string ns, string member, Expr[] args, int line, int col) {
  if (concept_exists(c, ns)) {
    return check_qualified_call(c, ns, member, args, line, col);
  }
  if (enum_exists(c, ns)) {
    return check_enum_variant_call(c, ns, member, args, line, col);
  }
  if (is_native_namespace(ns) && native_namespace_open(c, ns) && is_native_member(ns, member)) {
    return check_native_qualified_call(c, ns, member, args, line, col);
  }
  add_error(c, line, col, "Unknown namespace '" + ns + "'.");
  return type_unknown();
}

Type check_qualified_call(Checker c, string ns, string member, Expr[] args, int line, int col) {
  if (!concept_exists(c, ns)) {
    add_error(c, line, col, "Unknown namespace '" + ns + "'.");
    return type_unknown();
  }
  if (args.len() == 0) {
    add_error(c, line, col, "Concept method '" + ns + "::" + member + "' expects at least one argument.");
    return type_unknown();
  }
  Type arg_ty = check_expr(c, args[0]);
  FuncSig sig = lookup_concept_impl(c, member, arg_ty);
  if (sig.name.len() == 0) {
    add_error(c, line, col, "No implementation of '" + ns + "::" + member + "' for type '" + type_match_key(arg_ty) + "'.");
    return type_unknown();
  }
  if (args.len() != sig.param_types.len()) {
    add_error(c, line, col, "Wrong number of arguments.");
    return sig.ret_type;
  }
  for (int i = 0; i < args.len(); i = i + 1) {
    Type at = check_expr(c, args[i]);
    if (!types_assignable(at, sig.param_types[i])) {
      add_error(c, line, col, "Argument type mismatch.");
    }
  }
  return sig.ret_type;
}

Type check_array_lit(Checker c, Expr[] elems, int line, int col) {
  if (elems.len() == 0) { return type_array(""); }
  Type first = check_expr(c, elems[0]);
  for (int i = 1; i < elems.len(); i = i + 1) {
    Type et = check_expr(c, elems[i]);
    if (!types_compatible(first, et)) {
      add_error(c, line, col, "Array elements must have compatible types.");
      return type_array("");
    }
  }
  return type_array(type_encode(first));
}

Type check_index(Checker c, Expr obj, Expr idx, int line, int col) {
  Type ot = check_expr(c, obj);
  Type it = check_expr(c, idx);
  if (ot.kind == TypeKind::Map) {
    Type key_ty = resolve_encoded_type(c, map_key_enc(ot));
    if (key_ty.kind == TypeKind::String) {
      if (it.kind != TypeKind::String && it.kind != TypeKind::Unknown) {
        add_error(c, line, col, "Map key must be string.");
      }
    } else if (it.kind != TypeKind::Int && it.kind != TypeKind::Unknown) {
      add_error(c, line, col, "Map key must be int.");
    }
    return resolve_encoded_type(c, map_val_enc(ot));
  }
  if (ot.kind == TypeKind::String) {
    if (it.kind != TypeKind::Int && it.kind != TypeKind::Unknown) {
      add_error(c, line, col, "String index must be int.");
    }
    return type_int();
  }
  if (it.kind != TypeKind::Int && it.kind != TypeKind::Unknown) {
    add_error(c, line, col, "Array index must be int.");
  }
  if (ot.kind != TypeKind::Array && ot.kind != TypeKind::Unknown) {
    add_error(c, line, col, "Cannot index non-array type.");
    return type_unknown();
  }
  if (ot.kind == TypeKind::Array) {
    return resolve_encoded_type(c, ot.tag);
  }
  return type_unknown();
}

Type check_index_assign(Checker c, Expr obj, Expr idx, Expr val, int line, int col) {
  Type ot = check_expr(c, obj);
  Type _it = check_expr(c, idx);
  Type vt = check_expr(c, val);
  if (ot.kind == TypeKind::Array) {
    Type elem = resolve_type_name(c, ot.tag);
    if (!types_compatible(vt, elem)) {
      add_error(c, line, col, "Array element type mismatch.");
    }
  }
  return vt;
}

Type check_struct_lit(Checker c, TypeExpr ty, FieldInit[] fields, int line, int col) {
  Type st = resolve_type_expr(c, ty);
  if (st.kind != TypeKind::Struct && st.kind != TypeKind::Unknown) {
    add_error(c, line, col, "Expected struct type for struct literal.");
    return st;
  }
  StructInfo info = lookup_struct_info(c, st.tag);
  if (st.kind == TypeKind::Struct && fields.len() != info.fields.len()) {
    add_error(c, line, col, "Struct field count mismatch.");
  }
  for (int i = 0; i < fields.len(); i = i + 1) {
    Type ft = check_expr(c, fields[i].value);
    if (i < info.fields.len()) {
      Type expected = resolve_type_name(c, info.fields[i].type_enc);
      if (!types_compatible(ft, expected)) {
        add_error(c, line, col, "Struct field type mismatch.");
      }
    }
  }
  return st;
}

Type lookup_field_type(Checker c, StructInfo info, string field) {
  for (int i = 0; i < info.fields.len(); i = i + 1) {
    if (info.fields[i].name == field) {
      return resolve_type_name(c, info.fields[i].type_enc);
    }
  }
  return type_unknown();
}

string map_key_enc(Type m) {
  int i = 0;
  while (i < m.tag.len()) {
    if (m.tag.slice(i, i + 1) == ":") {
      return m.tag.slice(0, i);
    }
    i = i + 1;
  }
  return "string";
}

string map_val_enc(Type m) {
  int i = 0;
  while (i < m.tag.len()) {
    if (m.tag.slice(i, i + 1) == ":") {
      return m.tag.slice(i + 1, m.tag.len());
    }
    i = i + 1;
  }
  return "int";
}

void check_string_operand(Checker c, Type at, int line, int col, string ctx) {
  if (at.kind != TypeKind::String && at.kind != TypeKind::Unknown) {
    add_error(c, line, col, ctx + " must be string.");
  }
}

void check_int_operand(Checker c, Type at, int line, int col, string ctx) {
  if (at.kind != TypeKind::Int && at.kind != TypeKind::Unknown) {
    add_error(c, line, col, ctx + " must be int.");
  }
}

Type check_array_builtin_method(Checker c, Type ot, string method, Expr[] args, int line, int col) {
  if (method == "len") {
    if (args.len() > 0) { add_error(c, line, col, "len() takes no arguments."); }
    return type_int();
  }
  if (method == "push") {
    if (args.len() != 1) {
      add_error(c, line, col, "push() takes exactly 1 argument.");
    } else if (ot.kind == TypeKind::Array) {
      Type at = check_expr(c, args[0]);
      Type elem = resolve_type_name(c, ot.tag);
      if (!types_assignable(at, elem)) {
        add_error(c, line, col, "Array element type mismatch.");
      }
    } else {
      Type _at = check_expr(c, args[0]);
    }
    return type_void();
  }
  if (method == "pop") {
    if (args.len() > 0) { add_error(c, line, col, "pop() takes no arguments."); }
    if (ot.kind == TypeKind::Array) { return resolve_type_name(c, ot.tag); }
    return type_unknown();
  }
  if (method == "remove") {
    if (args.len() != 1) {
      add_error(c, line, col, "remove() takes exactly 1 argument.");
    } else {
      Type at = check_expr(c, args[0]);
      check_int_operand(c, at, line, col, "remove() index");
    }
    if (ot.kind == TypeKind::Array) { return resolve_type_name(c, ot.tag); }
    return type_unknown();
  }
  if (method == "contains") {
    if (args.len() != 1) {
      add_error(c, line, col, "contains() takes exactly 1 argument.");
    } else {
      Type _at = check_expr(c, args[0]);
    }
    return type_bool();
  }
  if (method == "clear" || method == "reverse") {
    if (args.len() > 0) {
      add_error(c, line, col, method + "() takes no arguments.");
    }
    return type_void();
  }
  if (method == "insert") {
    if (args.len() != 2) {
      add_error(c, line, col, "insert() takes exactly 2 arguments.");
    } else {
      Type idx = check_expr(c, args[0]);
      check_int_operand(c, idx, line, col, "insert() index");
      Type _v = check_expr(c, args[1]);
    }
    return type_void();
  }
  if (method == "index_of") {
    if (args.len() != 1) {
      add_error(c, line, col, "index_of() takes exactly 1 argument.");
    } else {
      Type _at = check_expr(c, args[0]);
    }
    return type_int();
  }
  if (method == "slice") {
    if (args.len() != 2) {
      add_error(c, line, col, "slice() takes exactly 2 arguments.");
    } else {
      Type s = check_expr(c, args[0]);
      Type e = check_expr(c, args[1]);
      check_int_operand(c, s, line, col, "slice() start");
      check_int_operand(c, e, line, col, "slice() end");
    }
    if (ot.kind == TypeKind::Array) { return type_array(ot.tag); }
    return type_unknown();
  }
  if (method == "resize") {
    if (args.len() != 2) {
      add_error(c, line, col, "resize() takes exactly 2 arguments.");
    } else {
      Type count = check_expr(c, args[0]);
      check_int_operand(c, count, line, col, "resize() count");
      if (ot.kind == TypeKind::Array) {
        Type elem = resolve_type_name(c, ot.tag);
        Type fill = check_expr(c, args[1]);
        if (!types_compatible(fill, elem)) {
          add_error(c, line, col, "Array element type mismatch.");
        }
      } else {
        Type _fill = check_expr(c, args[1]);
      }
    }
    return type_void();
  }
  add_error(c, line, col, "Array has no method '" + method + "'.");
  return type_unknown();
}

Type check_map_builtin_method(Checker c, Type ot, string method, Expr[] args, int line, int col) {
  if (method == "len") {
    if (args.len() > 0) { add_error(c, line, col, "len() takes no arguments."); }
    return type_int();
  }
  if (method == "has") {
    if (args.len() != 1) {
      add_error(c, line, col, "has() takes exactly 1 argument.");
    } else {
      Type _k = check_expr(c, args[0]);
    }
    return type_bool();
  }
  if (method == "keys") {
    if (args.len() > 0) { add_error(c, line, col, "keys() takes no arguments."); }
    if (ot.kind == TypeKind::Map) {
      return type_array(map_key_enc(ot));
    }
    return type_array("string");
  }
  if (method == "remove") {
    if (args.len() != 1) {
      add_error(c, line, col, "remove() takes exactly 1 argument.");
    } else {
      Type _k = check_expr(c, args[0]);
    }
    return type_void();
  }
  add_error(c, line, col, "Map has no method '" + method + "'.");
  return type_unknown();
}

Type check_string_builtin_method(Checker c, Type ot, string method, Expr[] args, int line, int col) {
  if (method == "len") {
    if (args.len() > 0) { add_error(c, line, col, "len() takes no arguments."); }
    return type_int();
  }
  if (method == "contains" || method == "starts_with" || method == "ends_with") {
    if (args.len() != 1) {
      add_error(c, line, col, method + "() takes exactly 1 argument.");
    } else {
      Type at = check_expr(c, args[0]);
      check_string_operand(c, at, line, col, method + "() argument");
    }
    return type_bool();
  }
  if (method == "index_of") {
    if (args.len() != 1) {
      add_error(c, line, col, "index_of() takes exactly 1 argument.");
    } else {
      Type at = check_expr(c, args[0]);
      check_string_operand(c, at, line, col, "index_of() argument");
    }
    return type_int();
  }
  if (method == "slice") {
    if (args.len() != 2) {
      add_error(c, line, col, "slice() takes exactly 2 arguments.");
    } else {
      Type s = check_expr(c, args[0]);
      Type e = check_expr(c, args[1]);
      check_int_operand(c, s, line, col, "slice() start");
      check_int_operand(c, e, line, col, "slice() end");
    }
    return type_string();
  }
  if (method == "replace") {
    if (args.len() != 2) {
      add_error(c, line, col, "replace() takes exactly 2 arguments.");
    } else {
      Type a = check_expr(c, args[0]);
      Type b = check_expr(c, args[1]);
      check_string_operand(c, a, line, col, "replace() argument");
      check_string_operand(c, b, line, col, "replace() argument");
    }
    return type_string();
  }
  if (method == "split") {
    if (args.len() != 1) {
      add_error(c, line, col, "split() takes exactly 1 argument.");
    } else {
      Type at = check_expr(c, args[0]);
      check_string_operand(c, at, line, col, "split() argument");
    }
    return type_array("string");
  }
  if (method == "trim" || method == "to_upper" || method == "to_lower") {
    if (args.len() > 0) {
      add_error(c, line, col, method + "() takes no arguments.");
    }
    return type_string();
  }
  add_error(c, line, col, "String has no method '" + method + "'.");
  return type_unknown();
}

bool is_string_only_builtin(string method) {
  if (method == "starts_with") { return true; }
  if (method == "ends_with") { return true; }
  if (method == "replace") { return true; }
  if (method == "split") { return true; }
  if (method == "trim") { return true; }
  if (method == "to_upper") { return true; }
  if (method == "to_lower") { return true; }
  return false;
}

bool is_map_only_builtin(string method) {
  if (method == "has") { return true; }
  if (method == "keys") { return true; }
  return false;
}

bool is_array_only_builtin(string method) {
  if (method == "push") { return true; }
  if (method == "pop") { return true; }
  if (method == "clear") { return true; }
  if (method == "insert") { return true; }
  if (method == "reverse") { return true; }
  if (method == "resize") { return true; }
  return false;
}

Type check_method_call(Checker c, Expr obj, string method, Expr[] args, int line, int col) {
  bool obj_is_ns = obj match { Expr::NsAccess(_, _, _, _) => true, _ => false, };
  if (obj_is_ns) {
    return obj match {
      Expr::NsAccess(let ns, let member, let nl, let nc) =>
        check_native_member_call(c, ns, member, method, args, nl, nc),
      _ => type_unknown(),
    };
  }
  Type ot = check_expr(c, obj);
  if (ot.kind == TypeKind::Array) {
    return check_array_builtin_method(c, ot, method, args, line, col);
  }
  if (ot.kind == TypeKind::Map) {
    return check_map_builtin_method(c, ot, method, args, line, col);
  }
  if (ot.kind == TypeKind::String) {
    return check_string_builtin_method(c, ot, method, args, line, col);
  }
  if (ot.kind == TypeKind::Unknown) {
    if (is_string_only_builtin(method)) {
      return check_string_builtin_method(c, ot, method, args, line, col);
    }
    if (is_map_only_builtin(method)) {
      return check_map_builtin_method(c, ot, method, args, line, col);
    }
    if (is_array_only_builtin(method)) {
      return check_array_builtin_method(c, ot, method, args, line, col);
    }
    if (method == "len") {
      if (args.len() > 0) { add_error(c, line, col, "len() takes no arguments."); }
      return type_int();
    }
    if (method == "contains") {
      if (args.len() != 1) {
        add_error(c, line, col, "contains() takes exactly 1 argument.");
      } else {
        Type _at = check_expr(c, args[0]);
      }
      return type_bool();
    }
    if (method == "index_of") {
      if (args.len() != 1) {
        add_error(c, line, col, "index_of() takes exactly 1 argument.");
      } else {
        Type _at = check_expr(c, args[0]);
      }
      return type_int();
    }
    if (method == "slice") {
      if (args.len() != 2) {
        add_error(c, line, col, "slice() takes exactly 2 arguments.");
      } else {
        Type s = check_expr(c, args[0]);
        Type e = check_expr(c, args[1]);
        check_int_operand(c, s, line, col, "slice() start");
        check_int_operand(c, e, line, col, "slice() end");
      }
      return type_unknown();
    }
    if (method == "remove") {
      if (args.len() != 1) {
        add_error(c, line, col, "remove() takes exactly 1 argument.");
      } else {
        Type _at = check_expr(c, args[0]);
      }
      return type_unknown();
    }
    return type_unknown();
  }
  if (ot.kind == TypeKind::Struct) {
    FuncSig sig = lookup_func(c, ot.tag + "::" + method);
    if (sig.name.len() > 0) {
      int expected = sig.param_types.len() - 1;
      if (args.len() != expected) {
        add_error(c, line, col, "Wrong number of arguments.");
        return sig.ret_type;
      }
      for (int i = 0; i < args.len(); i = i + 1) {
        Type at = check_expr(c, args[i]);
        if (!types_compatible(at, sig.param_types[i + 1])) {
          add_error(c, line, col, "Argument type mismatch.");
        }
      }
      return sig.ret_type;
    }
  }
  add_error(c, line, col, "Unknown method '" + method + "' on '" + type_kind_name(ot) + "'.");
  return type_unknown();
}

Type check_field_access(Checker c, Expr obj, string field, int line, int col) {
  string oname = expr_ident_name(obj);
  if (oname.len() > 0 && !var_exists(c, oname)) {
    NativeUsingAlias alias = resolve_native_using_alias(c, oname);
    if (alias.short_name.len() > 0) {
      return check_native_member_access(c, alias.ns, alias.member, field, line, col);
    }
  }
  Type ot = check_expr(c, obj);
  if (ot.kind != TypeKind::Struct && ot.kind != TypeKind::Unknown) {
    add_error(c, line, col, "Cannot access field on non-struct type.");
    return type_unknown();
  }
  if (ot.kind == TypeKind::Struct) {
    StructInfo info = lookup_struct_info(c, ot.tag);
    Type ft = lookup_field_type(c, info, field);
    if (ft.kind == TypeKind::Unknown && info.type_params.len() > 0) {
      if (oname.len() > 0) {
        TypeExpr decl_ty = lookup_var_type_expr(c, oname);
        if (decl_ty.type_args.len() > 0) {
          ft = resolve_generic_field_type(c, info, field, decl_ty);
        }
      }
    }
    if (ft.kind == TypeKind::Unknown) {
      add_error(c, line, col, "Struct '" + ot.tag + "' has no field '" + field + "'.");
    }
    return ft;
  }
  return type_unknown();
}

Type check_field_assign(Checker c, Expr obj, string field, Expr val, int line, int col) {
  Type ot = check_expr(c, obj);
  Type vt = check_expr(c, val);
  if (ot.kind == TypeKind::Struct) {
    StructInfo info = lookup_struct_info(c, ot.tag);
    Type ft = lookup_field_type(c, info, field);
    if (ft.kind == TypeKind::Unknown) {
      add_error(c, line, col, "Struct '" + ot.tag + "' has no field '" + field + "'.");
    } else if (!types_compatible(vt, ft)) {
      add_error(c, line, col, "Field assignment type mismatch.");
    }
  }
  return vt;
}

Type check_ns_access(Checker c, string ns, string member, int line, int col) {
  if (enum_exists(c, ns)) { return type_enum(ns); }
  return type_unknown();
}

Type check_ternary(Checker c, Expr cond, Expr th, Expr el, int line, int col) {
  Type _ct = check_expr(c, cond);
  Type tt = check_expr(c, th);
  Type et = check_expr(c, el);
  if (!types_compatible(tt, et)) {
    add_error(c, line, col, "Ternary branches have incompatible types.");
  }
  return tt;
}

Type check_coalesce(Checker c, Expr left, Expr right, int line, int col) {
  Type _lt = check_expr(c, left);
  return check_expr(c, right);
}

Type check_cast(Checker c, TypeExpr target, Expr val, int line, int col) {
  Type _vt = check_expr(c, val);
  return resolve_type_expr(c, target);
}

Type unify_match_types(Checker c, Type acc, Type next, int line, int col) {
  if (acc.kind == TypeKind::Unknown) { return next; }
  if (next.kind == TypeKind::Unknown) { return acc; }
  if (types_compatible(acc, next)) { return acc; }
  add_error(c, line, col, "Match arms have incompatible types.");
  return acc;
}

void bind_struct_pattern(Checker c, Expr pattern, Type scrutinee) {
  string struct_name = pattern match {
    Expr::StructPat(let n, _, _, _) => n,
    _ => "",
  };
  FieldInit[] pfields = pattern match {
    Expr::StructPat(_, let fs, _, _) => fs,
    _ => [],
  };
  if (scrutinee.kind != TypeKind::Struct || scrutinee.tag != struct_name) {
    add_error(c, 0, 0, "Struct pattern '" + struct_name + "' does not match scrutinee type.");
    return;
  }
  StructInfo info = lookup_struct_info(c, struct_name);
  for (int i = 0; i < pfields.len(); i = i + 1) {
    string field_name = pfields[i].name;
    int field_idx = i;
    if (field_name.len() > 0) {
      field_idx = -1;
      for (int j = 0; j < info.fields.len(); j = j + 1) {
        if (info.fields[j].name == field_name) {
          field_idx = j;
          break;
        }
      }
      if (field_idx < 0) {
        add_error(c, 0, 0, "Struct '" + struct_name + "' has no field '" + field_name + "'.");
        continue;
      }
    } else if (field_idx >= info.fields.len()) {
      add_error(c, 0, 0, "Struct pattern has too many fields for '" + struct_name + "'.");
      continue;
    }
    Type field_type = resolve_type_name(c, info.fields[field_idx].type_enc);
    Expr fp = pfields[i].value;
    if (fp match { Expr::BindingPat(let n, let l, let co) => true, _ => false, }) {
      string n = fp match { Expr::BindingPat(let n, let _l, let _c) => n, _ => "", };
      int l = fp match { Expr::BindingPat(let _n, let ln, let _c) => ln, _ => 0, };
      int co = fp match { Expr::BindingPat(let _n, let _l, let cn) => cn, _ => 0, };
      declare_var(c, n, field_type, l, co);
      continue;
    }
    if (fp match { Expr::Ident(let n, _, _) => n == "_", _ => false, }) {
      continue;
    }
    Type pt = check_expr(c, fp);
    if (!types_compatible(pt, field_type)) {
      add_error(c, 0, 0, "Struct field pattern type mismatch.");
    }
  }
}

void bind_enum_pattern(Checker c, Expr pattern) {
  bool is_pat = pattern match {
    Expr::EnumPat(let _en, let _vn, let _fs, let _l, let _c) => true,
    _ => false,
  };
  if (!is_pat) { return; }
  string enum_name = pattern match {
    Expr::EnumPat(let en, let _vn, let _fs, let _l, let _c) => en,
    _ => "",
  };
  string variant_name = pattern match {
    Expr::EnumPat(let _en, let vn, let _fs, let _l, let _c) => vn,
    _ => "",
  };
  Expr[] fields = pattern match {
    Expr::EnumPat(let _en, let _vn, let fs, let _l, let _c) => fs,
    _ => [],
  };
  EnumVariantInfo variant = lookup_enum_variant(c, enum_name, variant_name);
  for (int i = 0; i < fields.len(); i = i + 1) {
    bool is_bind = fields[i] match {
      Expr::BindingPat(let _n, let _l, let _c) => true,
      _ => false,
    };
    if (!is_bind) { continue; }
    string n = fields[i] match {
      Expr::BindingPat(let n, let _l, let _c) => n,
      _ => "",
    };
    int l = fields[i] match {
      Expr::BindingPat(let _n, let ln, let _c) => ln,
      _ => 0,
    };
    int co = fields[i] match {
      Expr::BindingPat(let _n, let _l, let cn) => cn,
      _ => 0,
    };
    Type pt = type_unknown();
    if (i < variant.payload_encs.len()) {
      pt = resolve_type_name(c, variant.payload_encs[i]);
    }
    declare_var(c, n, pt, l, co);
  }
}

void bind_match_pattern(Checker c, Expr pattern, Type scrutinee, int line, int col) {
  bool is_binding = pattern match {
    Expr::BindingPat(let _n, let _l, let _c) => true,
    _ => false,
  };
  if (is_binding) {
    string n = pattern match {
      Expr::BindingPat(let n, let _l, let _c) => n,
      _ => "",
    };
    int l = pattern match {
      Expr::BindingPat(let _n, let ln, let _c) => ln,
      _ => 0,
    };
    int co = pattern match {
      Expr::BindingPat(let _n, let _l, let cn) => cn,
      _ => 0,
    };
    declare_var(c, n, scrutinee, l, co);
    return;
  }
  bool is_enum = pattern match {
    Expr::EnumPat(let _en, let _vn, let _fs, let _l, let _c) => true,
    _ => false,
  };
  if (is_enum) {
    bind_enum_pattern(c, pattern);
    return;
  }
  bool is_struct = pattern match {
    Expr::StructPat(_, _, _, _) => true,
    _ => false,
  };
  if (is_struct) {
    bind_struct_pattern(c, pattern, scrutinee);
    return;
  }
  bool is_ident = pattern match {
    Expr::Ident(let _n, let _l, let _c) => true,
    _ => false,
  };
  if (is_ident) {
    string n = pattern match {
      Expr::Ident(let n, let _l, let _c) => n,
      _ => "",
    };
    int l = pattern match {
      Expr::Ident(let _n, let ln, let _c) => ln,
      _ => 0,
    };
    int co = pattern match {
      Expr::Ident(let _n, let _l, let cn) => cn,
      _ => 0,
    };
    if (n != "_") {
      add_error(c, l, co, "Expected a pattern, got identifier '" + n + "'.");
    }
    return;
  }
  Type _pt = check_expr(c, pattern);
}

Type check_match_arm(Checker c, MatchArm arm, Type scrutinee, int line, int col) {
  push_scope(c);
  bind_match_pattern(c, arm.pattern, scrutinee, line, col);
  if (arm.guard_expr match { Expr::None => false, _ => true, }) {
    Type gt = check_expr(c, arm.guard_expr);
    if (gt.kind != TypeKind::Bool && gt.kind != TypeKind::Int && gt.kind != TypeKind::Unknown) {
      add_error(c, line, col, "Match guard must be 'bool'.");
    }
  }
  Type bt = check_expr(c, arm.body);
  pop_scope(c);
  return bt;
}

bool match_arm_has_guard(MatchArm arm) {
  return arm.guard_expr match { Expr::None => false, _ => true, };
}

bool match_pattern_is_catchall(Expr pattern) {
  if (pattern match { Expr::BindingPat(_, _, _) => true, _ => false, }) {
    return true;
  }
  if (pattern match { Expr::Ident(let n, _, _) => n == "_", _ => false, }) {
    return true;
  }
  return false;
}

bool match_arm_is_catchall(MatchArm arm) {
  if (match_arm_has_guard(arm)) { return false; }
  return match_pattern_is_catchall(arm.pattern);
}

bool match_pattern_is_true_lit(Expr pattern) {
  return pattern match { Expr::BoolLit(let v, _, _) => v, _ => false, };
}

bool match_pattern_is_false_lit(Expr pattern) {
  return pattern match { Expr::BoolLit(let v, _, _) => !v, _ => false, };
}

string match_pattern_enum_variant(Expr pattern) {
  return pattern match {
    Expr::EnumPat(let _en, let vn, let _fs, let _l, let _c) => vn,
    _ => "",
  };
}

string[] enum_variant_names(Checker c, string enum_name) {
  string[] out = [];
  for (int i = 0; i < c.enums.len(); i = i + 1) {
    if (c.enums[i].name != enum_name) { continue; }
    for (int j = 0; j < c.enums[i].variants.len(); j = j + 1) {
      out.push(c.enums[i].variants[j].name);
    }
    break;
  }
  return out;
}

string[] remove_string(string[] names, string target) {
  string[] out = [];
  for (int i = 0; i < names.len(); i = i + 1) {
    if (names[i] != target) { out.push(names[i]); }
  }
  return out;
}

bool pattern_is_null_literal(Expr pattern) {
  return pattern match { Expr::NullLit(_, _) => true, _ => false, };
}

bool payload_pattern_is_exhaustive(Checker c, Expr pattern, Type payload_type) {
  if (match_pattern_is_catchall(pattern)) { return true; }
  if (payload_type.kind == TypeKind::Bool) { return false; }
  if (payload_type.kind == TypeKind::Int) { return false; }
  if (payload_type.kind == TypeKind::Float) { return false; }
  if (payload_type.kind == TypeKind::String) { return false; }
  if (payload_type.kind == TypeKind::Enum) {
    if (!(pattern match { Expr::EnumPat(_, _, _, _, _) => true, _ => false, })) {
      return false;
    }
    string en = pattern match {
      Expr::EnumPat(let n, _, _, _, _) => n,
      _ => "",
    };
    if (en != payload_type.tag) { return false; }
    string vn = pattern match {
      Expr::EnumPat(_, let n, _, _, _) => n,
      _ => "",
    };
    Expr[] fs = pattern match {
      Expr::EnumPat(_, _, let f, _, _) => f,
      _ => [],
    };
    EnumVariantInfo variant = lookup_enum_variant(c, en, vn);
    if (variant.name.len() == 0) { return false; }
    if (variant.payload_encs.len() == 0) { return true; }
    if (fs.len() != variant.payload_encs.len()) { return false; }
    for (int i = 0; i < fs.len(); i = i + 1) {
      Type pt = resolve_type_name(c, variant.payload_encs[i]);
      if (!payload_pattern_is_exhaustive(c, fs[i], pt)) { return false; }
    }
    return true;
  }
  return false;
}

void check_bool_exhaustive(Checker c, MatchArm[] arms, int line, int col) {
  bool has_true = false;
  bool has_false = false;
  for (int i = 0; i < arms.len(); i = i + 1) {
    MatchArm arm = arms[i];
    if (match_arm_is_catchall(arm)) {
      has_true = true;
      has_false = true;
      break;
    }
    if (match_pattern_is_true_lit(arm.pattern)) { has_true = true; }
    if (match_pattern_is_false_lit(arm.pattern)) { has_false = true; }
  }
  if (has_true && has_false) { return; }
  string missing = "";
  if (!has_true) { missing = "true"; }
  if (!has_false) {
    if (missing.len() > 0) { missing = missing + ", "; }
    missing = missing + "false";
  }
  add_error(c, line, col, "Non-exhaustive match on bool. Missing case(s): " + missing + ".");
}

void check_enum_exhaustive(Checker c, Type scrutinee, MatchArm[] arms, int line, int col) {
  string[] uncovered = enum_variant_names(c, scrutinee.tag);
  if (uncovered.len() == 0) { return; }
  string[] partial_payload = [];
  for (int i = 0; i < arms.len(); i = i + 1) {
    MatchArm arm = arms[i];
    if (match_arm_is_catchall(arm)) {
      uncovered = [];
      break;
    }
    if (!(arm.pattern match { Expr::EnumPat(_, _, _, _, _) => true, _ => false, })) {
      continue;
    }
    string vn = match_pattern_enum_variant(arm.pattern);
    string en = arm.pattern match {
      Expr::EnumPat(let n, _, _, _, _) => n,
      _ => "",
    };
    Expr[] fs = arm.pattern match {
      Expr::EnumPat(_, _, let f, _, _) => f,
      _ => [],
    };
    if (en != scrutinee.tag) { continue; }
    EnumVariantInfo variant = lookup_enum_variant(c, en, vn);
    if (variant.name.len() == 0) { continue; }
    if (variant.payload_encs.len() == 0) {
      uncovered = remove_string(uncovered, vn);
      continue;
    }
    if (fs.len() != variant.payload_encs.len()) {
      partial_payload.push(vn);
      continue;
    }
    bool all_exhaustive = true;
    for (int j = 0; j < fs.len(); j = j + 1) {
      Type pt = resolve_type_name(c, variant.payload_encs[j]);
      if (!payload_pattern_is_exhaustive(c, fs[j], pt)) {
        all_exhaustive = false;
        break;
      }
    }
    if (all_exhaustive) {
      uncovered = remove_string(uncovered, vn);
    } else {
      partial_payload.push(vn);
    }
  }
  if (partial_payload.len() > 0) {
    string partial = "";
    for (int i = 0; i < partial_payload.len(); i = i + 1) {
      if (partial.len() > 0) { partial = partial + ", "; }
      partial = partial + partial_payload[i];
    }
    add_error(c, line, col, "Non-exhaustive payload pattern for variant(s): " + partial + ".");
    return;
  }
  if (uncovered.len() == 0) { return; }
  string missing = "";
  for (int i = 0; i < uncovered.len(); i = i + 1) {
    if (missing.len() > 0) { missing = missing + ", "; }
    missing = missing + uncovered[i];
  }
  add_error(c, line, col, "Non-exhaustive match. Missing variant(s): " + missing + ".");
}

void check_nullable_exhaustive(Checker c, Type scrutinee, MatchArm[] arms, int line, int col) {
  for (int i = 0; i < arms.len(); i = i + 1) {
    if (match_arm_is_catchall(arms[i])) { return; }
  }
  bool has_null = false;
  bool has_non_null_binding = false;
  MatchArm[] non_null_arms = [];
  for (int i = 0; i < arms.len(); i = i + 1) {
    MatchArm arm = arms[i];
    if (pattern_is_null_literal(arm.pattern)) {
      has_null = true;
      continue;
    }
    non_null_arms.push(arm);
    if (match_pattern_is_catchall(arm.pattern) && !match_arm_has_guard(arm)) {
      has_non_null_binding = true;
    }
  }
  if (!has_null) {
    add_error(c, line, col, "Non-exhaustive match on nullable type. Missing case: null.");
    return;
  }
  if (has_non_null_binding) { return; }
  if (non_null_arms.len() == 0) {
    add_error(c, line, col, "Non-exhaustive match on nullable type. Missing non-null case.");
    return;
  }
  Type inner = scrutinee;
  inner.nullable = false;
  if (inner.kind == TypeKind::Bool) {
    check_bool_exhaustive(c, non_null_arms, line, col);
    return;
  }
  if (inner.kind == TypeKind::Enum) {
    check_enum_exhaustive(c, inner, non_null_arms, line, col);
    return;
  }
  add_error(c, line, col, "Non-exhaustive match on nullable type. Missing non-null case.");
}

bool match_arms_have_catchall(MatchArm[] arms) {
  for (int i = 0; i < arms.len(); i = i + 1) {
    if (match_arm_is_catchall(arms[i])) { return true; }
  }
  return false;
}

void check_scalar_catchall_exhaustive(Checker c, MatchArm[] arms, string type_label, int line, int col) {
  if (match_arms_have_catchall(arms)) { return; }
  add_error(c, line, col,
    "Non-exhaustive match on " + type_label + ". Add a catch-all pattern (`_` or `let x`).");
}

bool struct_pattern_is_exhaustive(Checker c, Expr pattern, Type struct_type) {
  if (!(pattern match { Expr::StructPat(let n, _, _, _) => n == struct_type.tag, _ => false, })) {
    return false;
  }
  FieldInit[] pfields = pattern match {
    Expr::StructPat(_, let fs, _, _) => fs,
    _ => [],
  };
  StructInfo info = lookup_struct_info(c, struct_type.tag);
  if (pfields.len() != info.fields.len()) { return false; }
  for (int i = 0; i < pfields.len(); i = i + 1) {
    string field_name = pfields[i].name;
    int field_idx = i;
    if (field_name.len() > 0) {
      field_idx = -1;
      for (int j = 0; j < info.fields.len(); j = j + 1) {
        if (info.fields[j].name == field_name) {
          field_idx = j;
          break;
        }
      }
      if (field_idx < 0) { return false; }
    }
    Type ft = resolve_type_name(c, info.fields[field_idx].type_enc);
    if (!payload_pattern_is_exhaustive(c, pfields[i].value, ft)) { return false; }
  }
  return true;
}

void check_struct_exhaustive(Checker c, Type scrutinee, MatchArm[] arms, int line, int col) {
  if (match_arms_have_catchall(arms)) { return; }
  bool saw_partial = false;
  for (int i = 0; i < arms.len(); i = i + 1) {
    if (!(arms[i].pattern match { Expr::StructPat(let n, _, _, _) => n == scrutinee.tag, _ => false, })) {
      continue;
    }
    if (struct_pattern_is_exhaustive(c, arms[i].pattern, scrutinee)) { return; }
    saw_partial = true;
  }
  if (saw_partial) {
    add_error(c, line, col, "Non-exhaustive struct pattern for '" + scrutinee.tag + "'.");
    return;
  }
  add_error(c, line, col,
    "Non-exhaustive match on struct " + scrutinee.tag +
    ". Add a catch-all or destructure all fields with binding/wildcard patterns.");
}

void check_match_arm_warnings(Checker c, MatchArm[] arms) {
  bool past_catchall = false;
  string[] seen_enum = [];
  bool seen_null = false;
  for (int i = 0; i < arms.len(); i = i + 1) {
    MatchArm arm = arms[i];
    int pl = 0;
    int pc = 0;
    if (arm.pattern match { Expr::EnumPat(_, _, _, let l, let c) => true, _ => false, }) {
      pl = arm.pattern match { Expr::EnumPat(_, _, _, let l, _) => l, _ => 0, };
      pc = arm.pattern match { Expr::EnumPat(_, _, _, _, let c) => c, _ => 0, };
    } else if (arm.pattern match { Expr::StructPat(_, _, let l, let c) => true, _ => false, }) {
      pl = arm.pattern match { Expr::StructPat(_, _, let l, _) => l, _ => 0, };
      pc = arm.pattern match { Expr::StructPat(_, _, _, let c) => c, _ => 0, };
    } else if (arm.pattern match { Expr::Ident(_, let l, let c) => true, _ => false, }) {
      pl = arm.pattern match { Expr::Ident(_, let l, _) => l, _ => 0, };
      pc = arm.pattern match { Expr::Ident(_, _, let c) => c, _ => 0, };
    } else if (arm.pattern match { Expr::BindingPat(_, let l, let c) => true, _ => false, }) {
      pl = arm.pattern match { Expr::BindingPat(_, let l, _) => l, _ => 0, };
      pc = arm.pattern match { Expr::BindingPat(_, _, let c) => c, _ => 0, };
    }
    if (past_catchall) {
      add_warning(c, pl, pc, "Unreachable match arm.");
      continue;
    }
    if (match_arm_is_catchall(arm)) {
      past_catchall = true;
      continue;
    }
    if (!match_arm_has_guard(arm)) {
      if (pattern_is_null_literal(arm.pattern)) {
        if (seen_null) {
          add_warning(c, pl, pc, "Duplicate match arm for 'null'.");
        }
        seen_null = true;
      }
      if (arm.pattern match { Expr::EnumPat(let en, let vn, _, _, _) => true, _ => false, }) {
        string en = arm.pattern match { Expr::EnumPat(let n, _, _, _, _) => n, _ => "", };
        string vn = arm.pattern match { Expr::EnumPat(_, let n, _, _, _) => n, _ => "", };
        string key = en + "::" + vn;
        bool dup = false;
        for (int j = 0; j < seen_enum.len(); j = j + 1) {
          if (seen_enum[j] == key) { dup = true; break; }
        }
        if (dup) {
          add_warning(c, pl, pc, "Duplicate match arm for variant '" + vn + "'.");
        } else {
          seen_enum.push(key);
        }
      }
    }
  }
}

void check_match_exhaustive(Checker c, Type scrutinee, MatchArm[] arms, int line, int col) {
  if (scrutinee.nullable) {
    check_nullable_exhaustive(c, scrutinee, arms, line, col);
    return;
  }
  if (scrutinee.kind == TypeKind::Bool) {
    check_bool_exhaustive(c, arms, line, col);
    return;
  }
  if (scrutinee.kind == TypeKind::Enum) {
    check_enum_exhaustive(c, scrutinee, arms, line, col);
    return;
  }
  if (scrutinee.kind == TypeKind::Int || scrutinee.kind == TypeKind::Float) {
    check_scalar_catchall_exhaustive(c, arms, "int", line, col);
    return;
  }
  if (scrutinee.kind == TypeKind::String) {
    check_scalar_catchall_exhaustive(c, arms, "string", line, col);
    return;
  }
  if (scrutinee.kind == TypeKind::Struct) {
    check_struct_exhaustive(c, scrutinee, arms, line, col);
  }
}

Type check_match(Checker c, Expr val, MatchArm[] arms, int line, int col) {
  Type vt = check_expr(c, val);
  if (arms.len() == 0) { return type_unknown(); }
  Type result = type_unknown();
  for (int i = 0; i < arms.len(); i = i + 1) {
    Type bt = check_match_arm(c, arms[i], vt, line, col);
    result = unify_match_types(c, result, bt, line, col);
  }
  check_match_exhaustive(c, vt, arms, line, col);
  check_match_arm_warnings(c, arms);
  return result;
}

// statements

void check_void() { return; }

void check_expr_stmt(Checker c, Expr e) {
  Type _t = check_expr(c, e);
}

bool expr_is_none(Expr e) {
  return e match { Expr::None => true, _ => false, };
}

void check_return(Checker c, Expr v, int line, int col) {
  if (!c.has_expected_return) {
    if (!expr_is_none(v)) { check_expr_stmt(c, v); }
    return;
  }
  if (expr_is_none(v)) {
    if (c.expected_return.kind != TypeKind::Void) {
      add_error(c, line, col, "Return type mismatch.");
    }
    return;
  }
  Type vt = check_expr(c, v);
  if (!types_assignable(vt, c.expected_return)) {
    add_error(c, line, col, "Return type mismatch.");
  }
}

void check_break(Checker c, int line, int col) {
  if (c.loop_depth == 0) { add_error(c, line, col, "'break' outside of loop."); }
}

void check_continue(Checker c, int line, int col) {
  if (c.loop_depth == 0) { add_error(c, line, col, "'continue' outside of loop."); }
}

void check_var_decl(Checker c, TypeExpr t, string n, Expr init, int line, int col) {
  Type declared = resolve_type_expr(c, t);
  bool auto_typed = is_auto_type(t);
  Type final_type = declared;
  bool has_init = init match { Expr::None => false, _ => true, };
  if (auto_typed && !has_init) {
    add_error(c, line, col, "Auto variable '" + n + "' requires an initializer.");
    declare_var(c, n, type_unknown(), line, col);
    return;
  }
  if (has_init) {
    Type init_type = check_expr(c, init);
    if (auto_typed) {
      final_type = init_type;
    } else if (!types_assignable(init_type, declared)) {
      add_error(c, line, col,
        "Cannot assign '" + type_kind_name(init_type) + "' to variable '" + n + "' of type '" + type_kind_name(declared) + "'.");
    }
  }
  declare_var_typed(c, n, final_type, t, line, col);
}

void check_stmt(Checker c, Stmt s) {
  s match {
    Stmt::ExprStmt(let e, _, _) => check_expr_stmt(c, e),
    Stmt::ReturnStmt(let v, let l, let co) => check_return(c, v, l, co),
    Stmt::VarDecl(_, let t, let n, let init, let l, let co) => check_var_decl(c, t, n, init, l, co),
    Stmt::Block(let stmts, _, _) => check_block(c, stmts),
    Stmt::If(let cond, let th, let el, let l, let co) => check_if(c, cond, th, el, l, co),
    Stmt::Guard(let cond, let body, _, _) => check_guard(c, cond, body),
    Stmt::While(let cond, let body, _, _) => check_while(c, cond, body),
    Stmt::For(let init, let cond, let step, let body, _, _) => check_for(c, init, cond, step, body),
    Stmt::Break(let l, let co) => check_break(c, l, co),
    Stmt::Continue(let l, let co) => check_continue(c, l, co),
    Stmt::TryCatch(let body, _, _, _) => check_stmt(c, body),
    Stmt::None => check_void(),
  };
}

void check_block(Checker c, Stmt[] stmts) {
  push_scope(c);
  for (int i = 0; i < stmts.len(); i = i + 1) { check_stmt(c, stmts[i]); }
  pop_scope(c);
}

void check_if(Checker c, Expr cond, Stmt th, Stmt el, int line, int col) {
  Type ct = check_expr(c, cond);
  if (ct.kind != TypeKind::Bool && ct.kind != TypeKind::Int && ct.kind != TypeKind::Unknown) {
    add_error(c, line, col, "If condition must be 'bool'.");
  }
  Type then_type = branch_result_type(c, th);
  Type else_type = branch_result_type(c, el);
  if (then_type.kind != TypeKind::Void && else_type.kind != TypeKind::Void &&
      !types_compatible(then_type, else_type)) {
    add_error(c, line, col, "If branches have incompatible types.");
  }
}

Type branch_result_type(Checker c, Stmt s) {
  if (s match { Stmt::Block(_, _, _) => true, _ => false, }) {
    return s match { Stmt::Block(let stmts, _, _) => block_result_type(c, stmts), _ => type_void(), };
  }
  if (s match { Stmt::None => true, _ => false, }) { return type_void(); }
  check_stmt_void(c, s);
  return type_void();
}

Type check_stmt_void(Checker c, Stmt s) {
  check_stmt(c, s);
  return type_void();
}

Type block_result_type(Checker c, Stmt[] stmts) {
  push_scope(c);
  Type last = type_void();
  for (int i = 0; i < stmts.len(); i = i + 1) {
    Stmt s = stmts[i];
    if (i == stmts.len() - 1) {
      if (s match { Stmt::ExprStmt(_, _, _) => true, _ => false, }) {
        last = s match { Stmt::ExprStmt(let e, _, _) => check_expr(c, e), _ => type_void(), };
      } else {
        check_stmt_void(c, s);
        last = type_void();
      }
    } else {
      check_stmt(c, s);
    }
  }
  pop_scope(c);
  return last;
}

void check_guard(Checker c, Expr cond, Stmt body) {
  Type _ct = check_expr(c, cond);
  check_stmt(c, body);
}

void check_while(Checker c, Expr cond, Stmt body) {
  Type _ct = check_expr(c, cond);
  c.loop_depth = c.loop_depth + 1;
  check_stmt(c, body);
  c.loop_depth = c.loop_depth - 1;
}

void check_for(Checker c, Stmt init, Expr cond, Stmt step, Stmt body) {
  push_scope(c);
  check_stmt(c, init);
  Type _ct = check_expr(c, cond);
  c.loop_depth = c.loop_depth + 1;
  check_stmt(c, step);
  check_stmt(c, body);
  c.loop_depth = c.loop_depth - 1;
  pop_scope(c);
}

// declarations

void forward_enum(Checker c, string name, EnumVariant[] variants) {
  EnumVariantInfo[] vis = [];
  for (int i = 0; i < variants.len(); i = i + 1) {
    string[] encs = [];
    for (int j = 0; j < variants[i].param_types.len(); j = j + 1) {
      encs.push(type_expr_encode(variants[i].param_types[j]));
    }
    vis.push(EnumVariantInfo { variants[i].name, encs });
  }
  register_enum_info(c, EnumInfo { name, vis });
}

void open_native_namespace(Checker c, string ns) {
  string[] members = stdlib::manifest::native_members_of(ns);
  for (int i = 0; i < members.len(); i = i + 1) {
    register_native_using_alias(c, members[i], ns, members[i]);
  }
}

void apply_using_decl(Checker c, string module_id, bool is_ns) {
  if (is_native_namespace(module_id) && is_ns) {
    open_native_namespace(c, module_id);
    return;
  }
}

void register_using_decl(Checker c, Decl d) {
  d match {
    Decl::UsingDecl(let n, let is_ns, let _l, let _c) =>
      apply_using_decl(c, n, is_ns),
    Decl::UsingAliasDecl(_, _, _, _) => check_void(),
    _ => check_void(),
  };
}

void forward_decl(Checker c, Decl d) {
  d match {
    Decl::StructDecl(let n, let tps, let fields, let _is_pub, let _l, let _c) =>
      forward_struct(c, n, tps, fields),
    Decl::EnumDecl(let n, let variants, let _is_pub, let _l, let _c) =>
      forward_enum(c, n, variants),
    _ => check_void(),
  };
}

void forward_struct(Checker c, string name, string[] type_params, FieldDef[] fields) {
  StructField[] sfields = [];
  for (int i = 0; i < fields.len(); i = i + 1) {
    string enc = type_expr_encode(fields[i].type);
    sfields.push(StructField { fields[i].name, enc });
  }
  register_struct_info(c, StructInfo { name, sfields, type_params });
}

void register_decl(Checker c, Decl d) {
  d match {
    Decl::FunctionDecl(let n, let rt, let _tps, let params, let _w, let _b, let _is_pub, let l, let col) =>
      register_function_sig(c, n, rt, params, l, col),
    Decl::ConceptDecl(let n, let _tps, let _methods, let _is_pub, let _l, let _c) =>
      c.concepts.push(n),
    _ => check_void(),
  };
}

void register_function_sig(Checker c, string n, TypeExpr rt, Parameter[] params, int line, int col) {
  Type[] pts = [];
  for (int i = 0; i < params.len(); i = i + 1) {
    pts.push(resolve_type_expr(c, params[i].type));
  }
  Type ret = resolve_type_expr(c, rt);
  register_func(c, FuncSig { n, pts, ret });
  if (params.len() > 0) {
    string receiver = params[0].type.name;
    StructInfo info = lookup_struct_info(c, receiver);
    if (info.name.len() > 0) {
      register_func(c, FuncSig { receiver + "::" + n, pts, ret });
    }
  }
}

void check_decl(Checker c, Decl d) {
  d match {
    Decl::FunctionDecl(let _n, let rt, let _tps, let params, let _w, let body, let _is_pub, let l, let co) =>
      check_function(c, rt, params, body, l, co),
    Decl::TopLevelStmt(let s, _, _) => check_stmt(c, s),
    _ => check_void(),
  };
}

void check_function(Checker c, TypeExpr rt, Parameter[] params, Stmt body, int line, int col) {
  push_scope(c);
  for (int i = 0; i < params.len(); i = i + 1) {
    declare_var(c, params[i].name, resolve_type_expr(c, params[i].type), 0, 0);
  }
  c.has_expected_return = true;
  c.expected_return = resolve_type_expr(c, rt);
  check_stmt(c, body);
  c.has_expected_return = false;
  c.expected_return = type_void();
  pop_scope(c);
}

pub int check_program(Checker c, Program prog) {
  push_scope(c);
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    register_using_decl(c, prog.declarations[i]);
  }
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    forward_decl(c, prog.declarations[i]);
  }
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    register_decl(c, prog.declarations[i]);
  }
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    check_decl(c, prog.declarations[i]);
  }
  pop_scope(c);
  int n = 0;
  for (int i = 0; i < c.errors.len(); i = i + 1) {
    if (!c.errors[i].is_warning) { n = n + 1; }
  }
  return n;
}
