// Self-hosted Kinglet type checker.
//
// Walks a Program and reports type errors. Operates on a private mirror
// of the AST types declared in parser/ast.kl — same shape, same names,
// distinct module-scope copies. The bootstrap compiler matches enum
// variants and struct field meta by name across modules, so values built
// in parser.kl line up with the mirrors here. We do NOT import ast.kl
// directly: doing so triggers the same duplicate-pub-function bug
// documented at the top of parser/parser.kl when ast.kl has already been
// pulled in transitively.
//
// Phase 1 expansion: Char/Null/Function/Struct/Enum/Array/Map type kinds,
// type detail storage, struct/enum/using declaration registration.

using io;

// --- AST mirror (kept in sync with parser/ast.kl by position) -------------

enum BinaryOp {
  Add, Sub, Mul, Div, Mod,
  Eq, Neq, Lt, Gt, Le, Ge,
  And, Or,
  BitAnd, BitOr, BitXor, Shl, Shr,
}

enum UnaryOp { Neg, Not, BitNot, }

enum AssignOp { Assign, AddAssign, SubAssign, MulAssign, DivAssign, }

struct TypeExpr {
  string name;
  string[] type_args;
}

enum Expr {
  IntLit(int, int, int),
  FloatLit(float, int, int),
  StringLit(string, int, int),
  BoolLit(bool, int, int),
  Ident(string, int, int),
  Unary(UnaryOp, Expr, int, int),
  Binary(Expr, BinaryOp, Expr, int, int),
  Assign(string, AssignOp, Expr, int, int),
  Call(Expr, TypeExpr[], Expr[], int, int),
  BindingPat(string, int, int),
  ArrayPat(Expr[], int, int),
  EnumPat(string, string, Expr[], int, int),
  Match(Expr, MatchArm[], int, int),
  Cast(TypeExpr, Expr, int, int),
  NsAccess(string, string, int, int),
  FieldAccess(Expr, string, int, int),
  Index(Expr, Expr, int, int),
  StructLit(TypeExpr, FieldInit[], int, int),
  ArrayLit(Expr[], int, int),
  NullCoalesce(Expr, string, Expr, int, int),
  TryExpr(Expr, int, int),
  None,
}

struct MatchArm {
  Expr pattern;
  Expr guard_expr;
  Expr body;
}

struct FieldInit {
  string name;
  Expr value;
}

struct Parameter {
  TypeExpr type;
  string name;
}

enum Stmt {
  ExprStmt(Expr, int, int),
  ReturnStmt(Expr, int, int),
  VarDecl(string, TypeExpr, string, Expr, int, int),
  Block(Stmt[], int, int),
  If(Expr, Stmt, Stmt, int, int),
  Guard(Expr, Stmt, int, int),
  While(Expr, Stmt, int, int),
  For(Stmt, Expr, Stmt, Stmt, int, int),
  Break(int, int),
  Continue(int, int),
  None,
}

struct FieldDef {
  TypeExpr type;
  string name;
}

struct EnumVariant {
  string name;
  TypeExpr[] param_types;
}

enum Decl {
  FunctionDecl(string, TypeExpr, string[], Parameter[], Stmt, bool, int, int),
  StructDecl(string, string[], FieldDef[], bool, int, int),
  EnumDecl(string, EnumVariant[], bool, int, int),
  ImportDecl(string, string, string[], int, int),
  UsingDecl(string, bool, int, int),
  TopLevelStmt(Stmt, int, int),
}

struct Program {
  Decl[] declarations;
}

// --- type system ----------------------------------------------------------

pub enum TypeKind {
  Int, Float, Bool, String, Void, Unknown,
  Char, Null, Function, Struct, Enum, Array, Map,
}

pub struct Type {
  TypeKind kind;
  string name;       // struct/enum/function name; "" for primitives
  int type_id;       // index into Checker detail tables; 0 = no detail
}

pub Type type_int()     => Type { TypeKind::Int, "", 0 };
pub Type type_float()   => Type { TypeKind::Float, "", 0 };
pub Type type_bool()    => Type { TypeKind::Bool, "", 0 };
pub Type type_string()  => Type { TypeKind::String, "", 0 };
pub Type type_void()    => Type { TypeKind::Void, "", 0 };
pub Type type_unknown() => Type { TypeKind::Unknown, "", 0 };
pub Type type_char()    => Type { TypeKind::Char, "", 0 };
pub Type type_null()    => Type { TypeKind::Null, "", 0 };

pub string type_name(Type t) {
  return t.kind match {
    TypeKind::Int      => "int",
    TypeKind::Float    => "float",
    TypeKind::Bool     => "bool",
    TypeKind::String   => "string",
    TypeKind::Void     => "void",
    TypeKind::Unknown  => "unknown",
    TypeKind::Char     => "char",
    TypeKind::Null     => "null",
    TypeKind::Function => t.name,
    TypeKind::Struct   => t.name,
    TypeKind::Enum     => t.name,
    TypeKind::Array    => "array",
    TypeKind::Map      => "map",
  };
}

// Unknown is bidirectionally compatible so we don't cascade errors after a
// first failure has already poisoned a subexpression's type.
bool types_compatible(Type a, Type b) {
  if (a.kind == TypeKind::Unknown) { return true; }
  if (b.kind == TypeKind::Unknown) { return true; }
  // Struct/Enum: name equality
  if (a.kind == TypeKind::Struct && b.kind == TypeKind::Struct) {
    return a.name == b.name;
  }
  if (a.kind == TypeKind::Enum && b.kind == TypeKind::Enum) {
    return a.name == b.name;
  }
  return a.kind == b.kind;
}

bool is_numeric(Type t) {
  if (t.kind == TypeKind::Int) { return true; }
  if (t.kind == TypeKind::Float) { return true; }
  if (t.kind == TypeKind::Char) { return true; }
  return false;
}

// --- type detail storage --------------------------------------------------

struct StructFieldInfo {
  string name;
  Type field_type;
}

struct EnumVariantInfo {
  string name;
  Type[] param_types;
}

struct FuncSignature {
  Type[] param_types;
  Type return_type;
}

// --- scope stack & checker state ------------------------------------------

pub struct Binding {
  string name;
  Type type;
  int scope_depth;
}

pub struct CheckError {
  int line;
  int col;
  string message;
}

pub struct Checker {
  Binding[] bindings;           // flat stack across all open scopes
  int[] scope_starts;           // bindings.len() snapshot at each push_scope()
  CheckError[] errors;
  string file;

  // Type detail tables, indexed by type_id (1-based).
  // type_id 0 is reserved for "primitive, no detail needed".
  string[] type_names;                  // type_names[type_id] = registered name
  StructFieldInfo[][] struct_fields;    // struct_fields[type_id] = field list
  EnumVariantInfo[][] enum_variants;    // enum_variants[type_id] = variant list
  FuncSignature[] func_signatures;      // func_signatures[type_id] = signature
  Type[] array_element_types;           // array_element_types[type_id] = element type
  int next_type_id;                     // allocator counter, starts at 1

  // Namespace tracking for `using` declarations.
  string[] used_namespaces;             // "io", "fs", "sys"
}

pub Checker make_checker(string file) {
  Binding[] b = [];
  int[] s = [];
  CheckError[] e = [];
  string[] tn = [];
  StructFieldInfo[][] sf = [];
  EnumVariantInfo[][] ev = [];
  FuncSignature[] fs = [];
  Type[] aet = [];
  string[] un = [];
  return Checker { b, s, e, file, tn, sf, ev, fs, aet, 1, un };
}

void push_scope(Checker c) {
  c.scope_starts.push(c.bindings.len());
}

void pop_scope(Checker c) {
  if (c.scope_starts.len() == 0) { return; }
  int start = c.scope_starts[c.scope_starts.len() - 1];
  c.scope_starts.pop();
  while (c.bindings.len() > start) {
    c.bindings.pop();
  }
}

int current_scope_start(Checker c) {
  if (c.scope_starts.len() == 0) { return 0; }
  return c.scope_starts[c.scope_starts.len() - 1];
}

void add_error(Checker c, int line, int col, string msg) {
  CheckError e = CheckError { line, col, msg };
  c.errors.push(e);
}

void declare_var(Checker c, string name, Type t, int line, int col) {
  int start = current_scope_start(c);
  for (int i = start; i < c.bindings.len(); i = i + 1) {
    if (c.bindings[i].name == name) {
      add_error(c, line, col, "Variable '" + name + "' already declared in this scope.");
      return;
    }
  }
  Binding b = Binding { name, t, c.scope_starts.len() };
  c.bindings.push(b);
}

bool var_exists(Checker c, string name) {
  int i = c.bindings.len() - 1;
  while (i >= 0) {
    if (c.bindings[i].name == name) { return true; }
    i = i - 1;
  }
  return false;
}

Type lookup_var(Checker c, string name) {
  int i = c.bindings.len() - 1;
  while (i >= 0) {
    if (c.bindings[i].name == name) { return c.bindings[i].type; }
    i = i - 1;
  }
  return type_unknown();
}

// --- type id allocation ---------------------------------------------------

int alloc_type_id(Checker c) {
  int id = c.next_type_id;
  c.next_type_id = c.next_type_id + 1;
  return id;
}

Type lookup_type_by_name(Checker c, string name) {
  for (int i = 0; i < c.type_names.len(); i = i + 1) {
    if (c.type_names[i] == name) {
      int id = i + 1;  // type_ids are 1-based
      // Determine kind by which detail table has data
      if (id < c.struct_fields.len() + 1 && c.struct_fields[id].len() >= 0) {
        // Could be struct — check if we have field data
        return Type { TypeKind::Struct, name, id };
      }
      return type_unknown();
    }
  }
  return type_unknown();
}

Type lookup_struct_type(Checker c, string name) {
  for (int i = 0; i < c.type_names.len(); i = i + 1) {
    if (c.type_names[i] == name) {
      int id = i + 1;
      return Type { TypeKind::Struct, name, id };
    }
  }
  return type_unknown();
}

Type lookup_enum_type(Checker c, string name) {
  for (int i = 0; i < c.type_names.len(); i = i + 1) {
    if (c.type_names[i] == name) {
      int id = i + 1;
      return Type { TypeKind::Enum, name, id };
    }
  }
  return type_unknown();
}

// --- type-expression resolution ------------------------------------------

bool is_auto_type(TypeExpr t) {
  if (t.type_args.len() != 0) { return false; }
  return t.name == "auto";
}

Type resolve_type_expr(Checker c, TypeExpr t) {
  if (t.name == "int")    { return type_int(); }
  if (t.name == "auto")   { return type_int(); }   // placeholder until inferred
  if (t.name == "float")  { return type_float(); }
  if (t.name == "double") { return type_float(); }
  if (t.name == "bool")   { return type_bool(); }
  if (t.name == "string") { return type_string(); }
  if (t.name == "void")   { return type_void(); }
  if (t.name == "char")   { return type_char(); }
  // User-defined types
  Type st = lookup_struct_type(c, t.name);
  if (st.kind != TypeKind::Unknown) { return st; }
  Type et = lookup_enum_type(c, t.name);
  if (et.kind != TypeKind::Unknown) { return et; }
  return type_unknown();
}

// --- binary-op classification --------------------------------------------

bool is_arithmetic_op(BinaryOp op) {
  return op match {
    BinaryOp::Add => true,
    BinaryOp::Sub => true,
    BinaryOp::Mul => true,
    BinaryOp::Div => true,
    BinaryOp::Mod => true,
    _ => false,
  };
}

bool is_comparison_op(BinaryOp op) {
  return op match {
    BinaryOp::Eq  => true,
    BinaryOp::Neq => true,
    BinaryOp::Lt  => true,
    BinaryOp::Gt  => true,
    BinaryOp::Le  => true,
    BinaryOp::Ge  => true,
    _ => false,
  };
}

bool is_logical_op(BinaryOp op) {
  return op match {
    BinaryOp::And => true,
    BinaryOp::Or  => true,
    _ => false,
  };
}

bool is_bitwise_op(BinaryOp op) {
  return op match {
    BinaryOp::BitAnd => true,
    BinaryOp::BitOr  => true,
    BinaryOp::BitXor => true,
    BinaryOp::Shl    => true,
    BinaryOp::Shr    => true,
    _ => false,
  };
}

bool op_is_add(BinaryOp op) {
  return op match { BinaryOp::Add => true, _ => false, };
}

// --- expression checking --------------------------------------------------

Type check_expr(Checker c, Expr e) {
  return e match {
    Expr::IntLit(let _v, let _l, let _co)    => type_int(),
    Expr::FloatLit(let _v, let _l, let _co)  => type_float(),
    Expr::StringLit(let _v, let _l, let _co) => type_string(),
    Expr::BoolLit(let _v, let _l, let _co)   => type_bool(),
    Expr::Ident(let n, let l, let co)        => check_ident(c, n, l, co),
    Expr::Unary(let op, let r, let l, let co) => check_unary(c, op, r, l, co),
    Expr::Binary(let lhs, let op, let rhs, let l, let co) => check_binary(c, lhs, op, rhs, l, co),
    Expr::Assign(let n, let _op, let v, let l, let co)    => check_assign(c, n, v, l, co),
    _ => type_unknown(),
  };
}

Type check_ident(Checker c, string name, int line, int col) {
  if (!var_exists(c, name)) {
    add_error(c, line, col, "Undeclared variable '" + name + "'.");
    return type_unknown();
  }
  return lookup_var(c, name);
}

Type check_unary(Checker c, UnaryOp op, Expr r, int line, int col) {
  Type rt = check_expr(c, r);
  return op match {
    UnaryOp::Neg    => check_neg(c, rt, line, col),
    UnaryOp::Not    => type_bool(),
    UnaryOp::BitNot => check_bitnot(c, rt, line, col),
  };
}

Type check_neg(Checker c, Type rt, int line, int col) {
  if (rt.kind == TypeKind::Unknown) { return type_int(); }
  if (is_numeric(rt)) { return rt; }
  add_error(c, line, col, "Cannot negate non-numeric type '" + type_name(rt) + "'.");
  return type_int();
}

Type check_bitnot(Checker c, Type rt, int line, int col) {
  if (rt.kind == TypeKind::Unknown) { return type_int(); }
  if (rt.kind != TypeKind::Int) {
    add_error(c, line, col, "Bitwise NOT requires an integer operand, got '" + type_name(rt) + "'.");
  }
  return type_int();
}

Type check_binary(Checker c, Expr lhs, BinaryOp op, Expr rhs, int line, int col) {
  Type l = check_expr(c, lhs);
  Type r = check_expr(c, rhs);
  if (is_arithmetic_op(op)) { return check_arithmetic(c, op, l, r, line, col); }
  if (is_comparison_op(op)) { return check_comparison(c, l, r, line, col); }
  if (is_logical_op(op))    { return type_bool(); }
  if (is_bitwise_op(op))    { return check_bitwise(c, l, r, line, col); }
  return type_unknown();
}

Type check_arithmetic(Checker c, BinaryOp op, Type l, Type r, int line, int col) {
  if (op_is_add(op) && l.kind == TypeKind::String && r.kind == TypeKind::String) {
    return type_string();
  }
  if (l.kind == TypeKind::Unknown || r.kind == TypeKind::Unknown) { return type_int(); }
  if (!is_numeric(l) || !is_numeric(r)) {
    add_error(c, line, col,
      "Arithmetic operands must be numeric, got '" + type_name(l) + "' and '" + type_name(r) + "'.");
    return type_int();
  }
  if (l.kind == TypeKind::Float || r.kind == TypeKind::Float) { return type_float(); }
  return type_int();
}

Type check_comparison(Checker c, Type l, Type r, int line, int col) {
  if (!types_compatible(l, r)) {
    add_error(c, line, col,
      "Cannot compare '" + type_name(l) + "' and '" + type_name(r) + "'.");
  }
  return type_bool();
}

Type check_bitwise(Checker c, Type l, Type r, int line, int col) {
  if (l.kind == TypeKind::Unknown || r.kind == TypeKind::Unknown) { return type_int(); }
  if (l.kind != TypeKind::Int || r.kind != TypeKind::Int) {
    add_error(c, line, col,
      "Bitwise operators require integer operands, got '" + type_name(l) + "' and '" + type_name(r) + "'.");
  }
  return type_int();
}

Type check_assign(Checker c, string name, Expr value, int line, int col) {
  Type vt = check_expr(c, value);
  if (!var_exists(c, name)) {
    add_error(c, line, col, "Undeclared variable '" + name + "'.");
    return vt;
  }
  Type target = lookup_var(c, name);
  if (!types_compatible(vt, target)) {
    add_error(c, line, col,
      "Cannot assign '" + type_name(vt) + "' to variable '" + name + "' of type '" + type_name(target) + "'.");
  }
  return target;
}

// --- statement checking ---------------------------------------------------

void check_stmt(Checker c, Stmt s) {
  s match {
    Stmt::ExprStmt(let e, let _l, let _co)         => check_expr_stmt(c, e),
    Stmt::ReturnStmt(let v, let _l, let _co)       => check_return(c, v),
    Stmt::VarDecl(let _stor, let t, let n, let init, let l, let co) => check_var_decl(c, t, n, init, l, co),
    Stmt::Block(let stmts, let _l, let _co)        => check_block(c, stmts),
    Stmt::If(let cond, let th, let el, let l, let co) => check_if(c, cond, th, el, l, co),
    Stmt::Guard(let cond, let body, let _l, let _co)  => check_guard(c, cond, body),
    Stmt::While(let cond, let body, let _l, let _co)  => check_while(c, cond, body),
    Stmt::For(let init, let cond, let step, let body, let _l, let _co) => check_for(c, init, cond, step, body),
    Stmt::Break(let _l, let _co)    => check_void(),
    Stmt::Continue(let _l, let _co) => check_void(),
    Stmt::None                       => check_void(),
  };
}

void check_void() { return; }

void check_expr_stmt(Checker c, Expr e) {
  Type _t = check_expr(c, e);
}

void check_return(Checker c, Expr v) {
  v match {
    Expr::None => check_void(),
    _ => check_expr_stmt(c, v),
  };
}

void check_var_decl(Checker c, TypeExpr t, string n, Expr init, int line, int col) {
  Type declared = resolve_type_expr(c, t);
  bool auto_typed = is_auto_type(t);
  Type final_type = declared;
  bool has_init = init match { Expr::None => false, _ => true, };
  if (has_init) {
    Type init_type = check_expr(c, init);
    if (auto_typed) {
      final_type = init_type;
    } else if (!types_compatible(init_type, declared)) {
      add_error(c, line, col,
        "Cannot assign '" + type_name(init_type) + "' to variable '" + n + "' of type '" + type_name(declared) + "'.");
    }
  }
  declare_var(c, n, final_type, line, col);
}

void check_block(Checker c, Stmt[] stmts) {
  push_scope(c);
  for (int i = 0; i < stmts.len(); i = i + 1) {
    check_stmt(c, stmts[i]);
  }
  pop_scope(c);
}

void check_if(Checker c, Expr cond, Stmt th, Stmt el, int line, int col) {
  Type ct = check_expr(c, cond);
  if (ct.kind != TypeKind::Bool && ct.kind != TypeKind::Int && ct.kind != TypeKind::Unknown) {
    add_error(c, line, col, "If condition must be 'bool', got '" + type_name(ct) + "'.");
  }
  Type then_type = branch_result_type(c, th);
  Type else_type = branch_result_type(c, el);
  bool has_then_value = then_type.kind != TypeKind::Void;
  bool has_else_value = else_type.kind != TypeKind::Void;
  if (has_then_value && has_else_value && !types_compatible(then_type, else_type)) {
    add_error(c, line, col,
      "If branches have incompatible types: '" + type_name(then_type) + "' vs '" + type_name(else_type) + "'.");
  }
}

// Branch types: a Block returns the type of its trailing ExprStmt (or void),
// any other Stmt is checked for side effects and contributes void.
Type branch_result_type(Checker c, Stmt s) {
  return s match {
    Stmt::Block(let stmts, let _l, let _co) => block_result_type(c, stmts),
    Stmt::None                               => type_void(),
    _ => check_stmt_void(c, s),
  };
}

Type check_stmt_void(Checker c, Stmt s) {
  check_stmt(c, s);
  return type_void();
}

Type block_result_type(Checker c, Stmt[] stmts) {
  push_scope(c);
  Type last = type_void();
  for (int i = 0; i < stmts.len(); i = i + 1) {
    Stmt s = stmts[i];
    bool is_tail = i == stmts.len() - 1;
    if (is_tail) {
      last = s match {
        Stmt::ExprStmt(let e, let _l, let _co) => check_expr(c, e),
        _ => check_stmt_void(c, s),
      };
    } else {
      check_stmt(c, s);
    }
  }
  pop_scope(c);
  return last;
}

void check_guard(Checker c, Expr cond, Stmt body) {
  Type _ct = check_expr(c, cond);
  check_stmt(c, body);
}

void check_while(Checker c, Expr cond, Stmt body) {
  Type _ct = check_expr(c, cond);
  check_stmt(c, body);
}

void check_for(Checker c, Stmt init, Expr cond, Stmt step, Stmt body) {
  push_scope(c);
  check_stmt(c, init);
  Type _ct = check_expr(c, cond);
  check_stmt(c, step);
  check_stmt(c, body);
  pop_scope(c);
}

// --- declaration registration ---------------------------------------------

void register_decl(Checker c, Decl d) {
  d match {
    Decl::FunctionDecl(let n, let rt, let _tps, let params, let _body, let _is_pub, let line, let col) =>
      register_function(c, n, rt, params, line, col),
    Decl::StructDecl(let n, let _tps, let fields, let _is_pub, let _l, let _co) =>
      register_struct(c, n, fields),
    Decl::EnumDecl(let n, let variants, let _is_pub, let _l, let _co) =>
      register_enum(c, n, variants),
    Decl::UsingDecl(let n, let _is_ns, let _l, let _co) =>
      register_using(c, n),
    _ => check_void(),
  };
}

void register_function(Checker c, string n, TypeExpr rt, Parameter[] params, int line, int col) {
  int id = alloc_type_id(c);
  Type ret = resolve_type_expr(c, rt);

  // Build param types array
  Type[] ptypes = [];
  for (int i = 0; i < params.len(); i = i + 1) {
    ptypes.push(resolve_type_expr(c, params[i].type));
  }
  FuncSignature sig = FuncSignature { ptypes, ret };
  c.func_signatures.push(sig);
  c.type_names.push(n);

  Type fn_type = Type { TypeKind::Function, n, id };
  declare_var(c, n, fn_type, line, col);
}

void register_struct(Checker c, string name, FieldDef[] fields) {
  int id = alloc_type_id(c);

  // Build field info
  StructFieldInfo[] finfo = [];
  for (int i = 0; i < fields.len(); i = i + 1) {
    Type ft = resolve_type_expr(c, fields[i].type);
    finfo.push(StructFieldInfo { fields[i].name, ft });
  }
  c.struct_fields.push(finfo);
  c.type_names.push(name);

  // Register constructor function
  Type[] ptypes = [];
  for (int i = 0; i < fields.len(); i = i + 1) {
    ptypes.push(resolve_type_expr(c, fields[i].type));
  }
  Type struct_type = Type { TypeKind::Struct, name, id };
  FuncSignature sig = FuncSignature { ptypes, struct_type };
  c.func_signatures.push(sig);
  Type fn_type = Type { TypeKind::Function, name, id };
  declare_var(c, name, fn_type, 0, 0);
}

void register_enum(Checker c, string name, EnumVariant[] variants) {
  int id = alloc_type_id(c);

  // Build variant info
  EnumVariantInfo[] vinfo = [];
  for (int i = 0; i < variants.len(); i = i + 1) {
    Type[] ptypes = [];
    for (int j = 0; j < variants[i].param_types.len(); j = j + 1) {
      ptypes.push(resolve_type_expr(c, variants[i].param_types[j]));
    }
    vinfo.push(EnumVariantInfo { variants[i].name, ptypes });
  }
  c.enum_variants.push(vinfo);
  c.type_names.push(name);
}

void register_using(Checker c, string name) {
  // Check for duplicate
  for (int i = 0; i < c.used_namespaces.len(); i = i + 1) {
    if (c.used_namespaces[i] == name) { return; }
  }
  c.used_namespaces.push(name);
}

// --- declaration checking -------------------------------------------------

void check_decl(Checker c, Decl d) {
  d match {
    Decl::FunctionDecl(let _n, let _rt, let _tps, let params, let body, let _is_pub, let _l, let _co) =>
      check_function(c, params, body),
    Decl::TopLevelStmt(let s, let _l, let _co) => check_stmt(c, s),
    _ => check_void(),
  };
}

void check_function(Checker c, Parameter[] params, Stmt body) {
  push_scope(c);
  for (int i = 0; i < params.len(); i = i + 1) {
    Parameter p = params[i];
    Type pt = resolve_type_expr(c, p.type);
    declare_var(c, p.name, pt, 0, 0);
  }
  check_stmt(c, body);
  pop_scope(c);
}

pub int check_program(Checker c, Program prog) {
  push_scope(c);
  // Pre-pass: register top-level names so references resolve in any order.
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    register_decl(c, prog.declarations[i]);
  }
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    check_decl(c, prog.declarations[i]);
  }
  pop_scope(c);
  return c.errors.len();
}

pub int run_checker(Program prog) {
  return check_program(make_checker("check"), prog);
}
