// Native platform API manifest (ADR 0003, layer L1).
//
// Single source of truth for which `ns::member` pairs are platform natives
// (`io` / `fs` / `sys`). The checker and the compiler both read this table
// instead of each carrying a duplicate hardcoded copy.
//
// Scope: this describes the *API surface* only. The member -> opcode lowering
// rule stays in compiler/codegen.kl (`emit_native_call`), per ADR 0003 L1
// ("the compiler hardcodes lowering rules, not the API list").

pub struct NativeMember {
  string ns;
  string member;
}

// The authoritative list. Adding a native member (or namespace) is a one-line
// change here; the checker, alias registration, and existence checks all flow
// from this table.
pub NativeMember[] native_members() {
  NativeMember[] m = [];
  m.push(NativeMember { "io", "out" });
  m.push(NativeMember { "io", "outln" });
  m.push(NativeMember { "io", "err" });
  m.push(NativeMember { "io", "errln" });
  m.push(NativeMember { "io", "in" });
  m.push(NativeMember { "fs", "__read" });
  m.push(NativeMember { "fs", "__write" });
  m.push(NativeMember { "sys", "args" });
  return m;
}

pub bool is_native_namespace(string ns) {
  NativeMember[] m = native_members();
  for (int i = 0; i < m.len(); i = i + 1) {
    if (m[i].ns == ns) { return true; }
  }
  return false;
}

pub bool is_native_member(string ns, string member) {
  NativeMember[] m = native_members();
  for (int i = 0; i < m.len(); i = i + 1) {
    if (m[i].ns == ns && m[i].member == member) { return true; }
  }
  return false;
}

// Member names of a namespace, used by `using namespace ns;` to register
// unqualified aliases for each native member.
pub string[] native_members_of(string ns) {
  string[] names = [];
  NativeMember[] m = native_members();
  for (int i = 0; i < m.len(); i = i + 1) {
    if (m[i].ns == ns) { names.push(m[i].member); }
  }
  return names;
}
