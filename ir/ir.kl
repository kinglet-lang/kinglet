// KIR data definitions — mirrors bootstrap src/ir/kir.h.

export module ir.ir;

pub enum KirOpcode {
  ConstInt,
  ConstFloat,
  ConstBool,
  ConstNull,
  ConstString,
  LoadLocal,
  StoreLocal,
  Pop,
  IAdd,
  ISub,
  IMul,
  IDiv,
  IMod,
  IAnd,
  IOr,
  IXor,
  IShl,
  IShr,
  IEq, INe, ILt, IGt, ILe, IGe,
  INeg, IBNot,
  Call,
  Ret,
  Br,
  CondBr,
  Switch,
  Unreachable,
  Nop,
}

pub enum KirType {
  Void,
  Any,
  Int,
  Float,
  Int8,
  Int16,
  Int32,
  Int64,
  UInt8,
  UInt16,
  UInt32,
  UInt64,
  Float32,
  Float64,
  Bool,
  Null,
  Char,
  String,
  Array,
  Map,
  Struct,
  Enum,
  Fn,
}

pub struct KirInstr {
  KirOpcode op;
  int[] operands;
  int line;
  int col;
  KirType result_type;
}

pub struct KirBasicBlock {
  string label;
  KirInstr[] instrs;
}

pub struct KirFunction {
  string name;
  int param_count;
  string[] param_names;
  KirBasicBlock[] blocks;
  KirType return_type;
  int fn_index;
}

pub struct KirModule {
  KirFunction[] functions;
}
