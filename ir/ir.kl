// KIR data definitions — mirrors bootstrap src/ir/kir.h.

export module ir.ir;

pub enum KirOpcode {
  ConstInt,
  ConstFloat,
  ConstBool,
  ConstNull,
  ConstString,
  LoadLocal,
  StoreLocal,
  Pop, Dup,
  IAdd,
  ISub,
  IMul,
  IDiv,
  IMod,
  IAnd,
  IOr,
  IXor,
  IShl,
  IShr,
  IEq, INe, ILt, IGt, ILe, IGe,
  INeg, IBNot, LNot, IsNull,
  StructNew, FieldGet, FieldSet,
  ArrayNew, IndexGet, ArrayLen,
  IndexSet, ArrayPush, ArrayPop, ArraySlice, ArrayContains,
  StrStartsWith, StrEndsWith, StrReplace, StrSplit, StrTrim, StrToUpper, StrToLower,
  EnumPayloadNew, EnumPayloadGet,
  CastTo,
  NativeOut, NativeOutLn, NativeErr, NativeErrLn, NativeIn, NativeInSecret,
  NativeFsRead, NativeFsWrite, NativeFsListdir, NativeSysArgs,
  Call,
  Ret,
  Br,
  CondBr,
  JmpIfErr, PushHandler, PopHandler, PropagateErr,
  Switch,
  Unreachable,
  EnumVariant,
  EnumVariantPayload,
  Nop,
}

pub enum KirType {
  Void,
  Any,
  Int,
  Float,
  Int8,
  Int16,
  Int32,
  Int64,
  UInt8,
  UInt16,
  UInt32,
  UInt64,
  Float32,
  Float64,
  Bool,
  Null,
  Char,
  String,
  Array,
  Map,
  Struct,
  Enum,
  Fn,
}

bool kir_is_inline_enum_wire(int wire) {
  return ((wire >> 48) & 0xFFFF) == 0xFFFD;
}

int kir_enum_variant_ord(int wire) {
  return wire & 0xFFFF;
}

int kir_opcode_ord(KirOpcode op) {
  // Enum members compile as KL_INLINE_ENUM_MARK wires (0xFFFD<<48 | type | variant).
  if (kir_is_inline_enum_wire(op)) {
    return kir_enum_variant_ord(op);
  }
  // Same 32768+ wire encoding as OpCode; KIR stores plain ordinals in KirInstr.op.
  if (op >= 32768) {
    return op - 32768;
  }
  return op;
}

// Plain ordinal for KirOpcode::EnumVariant (see ir.kl enum order).
int kir_op_enum_variant() { return 70; }

// Store KirType as plain int in KirInstr to avoid struct-literal misalignment when
// the last field would be an enum member (compiles as EnumVariant bytecode).
int kir_type_ord(KirType ty) {
  if (kir_is_inline_enum_wire(ty)) {
    return kir_enum_variant_ord(ty);
  }
  if (ty >= 32768) {
    return ty - 32768;
  }
  return ty;
}

pub struct KirInstr {
  int op;
  int[] operands;
  int line;
  int col;
  int result_type;
}

pub struct KirBasicBlock {
  string label;
  KirInstr[] instrs;
}

pub struct KirFunction {
  string name;
  int param_count;
  string[] param_names;
  KirBasicBlock[] blocks;
  KirType return_type;
  int fn_index;
}

pub struct KirModule {
  KirFunction[] functions;
}

// Field accessors must live in the same module as KirInstr: cross-module
// `arr[i].op` on structs with int[] fields reads the wrong slot (op becomes 72).
pub int kir_instr_op(KirInstr[] arr, int idx) { return arr[idx].op; }
pub int[] kir_instr_operands(KirInstr[] arr, int idx) { return arr[idx].operands; }
pub int kir_instr_line(KirInstr[] arr, int idx) { return arr[idx].line; }
pub int kir_instr_col(KirInstr[] arr, int idx) { return arr[idx].col; }
pub int kir_instr_result_type(KirInstr[] arr, int idx) { return arr[idx].result_type; }
pub KirInstr kir_instr_make(int op, int[] operands, int line, int col, int result_type) {
  return KirInstr { op, operands, line, col, result_type };
}

// Push EnumVariant lowering; must run in this module so KirInstr[] push is not cross-module.
pub void kir_push_enum_variant(KirInstr[] instrs, int packed, int line, int col) {
  // Use plain ordinals: enum members in struct slots miscompile as inline wires.
  instrs.push(kir_instr_make(0, [packed, 1], line, col, 2));
}
