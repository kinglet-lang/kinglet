// KIR data definitions — mirrors bootstrap src/ir/kir.h.

export module ir.ir;

pub enum KirOpcode {
  ConstInt,
  ConstFloat,
  ConstBool,
  ConstNull,
  ConstString,
  LoadLocal,
  StoreLocal,
  Pop,
  IAdd,
  ISub,
  IMul,
  IDiv,
  IMod,
  IAnd,
  IOr,
  IXor,
  IShl,
  IShr,
  Call,
  Ret,
  Br,
  CondBr,
  Switch,
  Unreachable,
  Nop,
}

pub enum KirType {
  Int,
  Void,
}

pub struct KirInstr {
  KirOpcode op;
  int[] operands;
  int line;
  int col;
  KirType result_type;
}

pub struct KirBasicBlock {
  string label;
  KirInstr[] instrs;
}

pub struct KirFunction {
  string name;
  int param_count;
  string[] param_names;
  KirBasicBlock[] blocks;
  KirType return_type;
}

pub struct KirModule {
  KirFunction[] functions;
}
