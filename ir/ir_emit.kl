// Chunk → KIR post-pass; mirrors bootstrap IrBuilder data shapes.

export module ir.ir_emit;

import ir.ir;
import compiler.bytecode;
using namespace ir.ir;
using namespace compiler.bytecode;

pub KirModule empty_module() {
  KirFunction[] fs = [];
  return KirModule { fs };
}

// --- struct-array type encoding for the Pass-1 FieldGet resolver ---
// Pass 1's tstack/local_types hold either a struct_metas index (the value is a
// struct), -1 (non-struct / unknown), or an encoded "array of struct sm". The
// encoding lets IndexGet recover the element struct type so that
// `P p = arr[i]; p.field` resolves the field index instead of collapsing every
// field to index 0 (reading the wrong field).
//   v >= 0x40000000        -> array whose elements are struct (v - 0x40000000 - 1)
//   0 <= v < #struct_metas -> a struct_metas index (value is struct v)
//   v == -1                -> non-struct / unknown
int mk_arr(int sm) { return 0x40000000 | (sm + 1); }
bool is_arr(int v) { return v >= 0x40000000; }
int arr_elem_struct(int v) { return (v - 0x40000000) - 1; }

// Resolve a declared type name ("Scanner", "Token[]", ...) to a tstack
// encoding: struct_metas index for a struct, mk_arr(sm) for "StructName[]",
// else -1. Used to type function-call results and parameters whose declared
// type names the bytecode carries, so `Token[] ts = scan(...); ts[i].field`
// resolves the field index.
int encode_decl_type(string name, Chunk c) {
  bool is_array = false;
  string base = name;
  if (name.ends_with("[]")) {
    is_array = true;
    base = name.slice(0, name.len() - 2);
  }
  for (int sm = 0; sm < c.struct_metas.len(); sm = sm + 1) {
    if (c.struct_metas[sm].name == base) {
      return is_array ? mk_arr(sm) : sm;
    }
  }
  return -1;
}

KirOpcode cmp_kir_op(int op) {
  if (op == vm_opcode_ord(OpCode::Eq)) { return KirOpcode::IEq; }
  if (op == vm_opcode_ord(OpCode::Neq)) { return KirOpcode::INe; }
  if (op == vm_opcode_ord(OpCode::Lt)) { return KirOpcode::ILt; }
  if (op == vm_opcode_ord(OpCode::Gt)) { return KirOpcode::IGt; }
  if (op == vm_opcode_ord(OpCode::Le)) { return KirOpcode::ILe; }
  if (op == vm_opcode_ord(OpCode::Ge)) { return KirOpcode::IGe; }
  return KirOpcode::Nop;
}

KirOpcode bin_kir_op(int op) {
  if (op == vm_opcode_ord(OpCode::Add) || op == vm_opcode_ord(OpCode::AddI32)) { return KirOpcode::IAdd; }
  if (op == vm_opcode_ord(OpCode::Subtract) || op == vm_opcode_ord(OpCode::SubtractI32)) { return KirOpcode::ISub; }
  if (op == vm_opcode_ord(OpCode::Multiply) || op == vm_opcode_ord(OpCode::MultiplyI32)) { return KirOpcode::IMul; }
  if (op == vm_opcode_ord(OpCode::Divide) || op == vm_opcode_ord(OpCode::DivideI32)) { return KirOpcode::IDiv; }
  if (op == vm_opcode_ord(OpCode::Modulo) || op == vm_opcode_ord(OpCode::ModuloI32)) { return KirOpcode::IMod; }
  if (op == vm_opcode_ord(OpCode::BitAnd)) { return KirOpcode::IAnd; }
  if (op == vm_opcode_ord(OpCode::BitOr)) { return KirOpcode::IOr; }
  if (op == vm_opcode_ord(OpCode::BitXor)) { return KirOpcode::IXor; }
  if (op == vm_opcode_ord(OpCode::Shl)) { return KirOpcode::IShl; }
  if (op == vm_opcode_ord(OpCode::Shr)) { return KirOpcode::IShr; }
  return KirOpcode::Nop;
}

// EnumVariant bytecode → KirOpcode::EnumVariant (ll_emit calls kl_enum_inline_packed).
KirInstr enum_variant_kir(Instruction ins) {
  return KirInstr {
    kir_op_enum_variant(),
    [ins.operand],
    ins.line, ins.col, kir_type_ord(KirType::Void),
  };
}

KirInstr to_kir_instr(Chunk c, Instruction ins, int rel_pc) {
  if (ins.op - vm_op_enum_variant() == 0) {
    return enum_variant_kir(ins);
  }
  if (ins.op == vm_opcode_ord(OpCode::Constant)) {
    Constant k = c.constants[ins.operand];
    if (k.kind == ConstKind::Int_) {
      int v = k.int_value;
      return KirInstr { kir_opcode_ord(KirOpcode::ConstInt), [v & 0xFFFFFFFF, (v >> 32) & 0xFFFFFFFF], ins.line, ins.col, kir_type_ord(KirType::Int) };
    }
    if (k.kind == ConstKind::Double_) {
      // Store raw IEEE 754 bits as two 32-bit operands (matches bootstrap kir_to_llvm.cc const_double).
      // We cannot extract bits from a double within Kinglet, so use constant pool index.
      return KirInstr { kir_opcode_ord(KirOpcode::ConstFloat), [ins.operand, 0], ins.line, ins.col, kir_type_ord(KirType::Float) };
    }
    if (k.kind == ConstKind::String_) {
      // Operand is the constant pool index; ll_emit reads the bytes from the
      // Chunk to emit an LLVM string global (via int(s[i]) byte access).
      return KirInstr { kir_opcode_ord(KirOpcode::ConstString), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::String) };
    }
    return KirInstr { kir_opcode_ord(KirOpcode::Nop), [], ins.line, ins.col, kir_type_ord(KirType::Int) };
  }
  if (ins.op == vm_opcode_ord(OpCode::Return_)) {
    return KirInstr { kir_opcode_ord(KirOpcode::Ret), [], ins.line, ins.col, kir_type_ord(KirType::Void) };
  }
  if (ins.op == vm_opcode_ord(OpCode::Jmp)) {
    int target = rel_pc + 1 + ins.operand;
    return KirInstr { kir_opcode_ord(KirOpcode::Br), [target], ins.line, ins.col, kir_type_ord(KirType::Void) };
  }
  if (ins.op == vm_opcode_ord(OpCode::JmpFalse)) {
    int target = rel_pc + 1 + ins.operand;
    return KirInstr { kir_opcode_ord(KirOpcode::CondBr), [target], ins.line, ins.col, kir_type_ord(KirType::Void) };
  }
  if (ins.op == vm_opcode_ord(OpCode::StoreLocal)) { return KirInstr { kir_opcode_ord(KirOpcode::StoreLocal), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::LoadLocal)) { return KirInstr { kir_opcode_ord(KirOpcode::LoadLocal), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::Pop)) { return KirInstr { kir_opcode_ord(KirOpcode::Pop), [], ins.line, ins.col, kir_type_ord(KirType::Void) }; }
  if (ins.op == vm_opcode_ord(OpCode::Dup)) { return KirInstr { kir_opcode_ord(KirOpcode::Dup), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::Negate)) { return KirInstr { kir_opcode_ord(KirOpcode::INeg), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::BitNot)) { return KirInstr { kir_opcode_ord(KirOpcode::IBNot), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::Not_)) { return KirInstr { kir_opcode_ord(KirOpcode::LNot), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::Null_)) { return KirInstr { kir_opcode_ord(KirOpcode::ConstNull), [], ins.line, ins.col, kir_type_ord(KirType::Null) }; }
  if (ins.op == vm_opcode_ord(OpCode::IsNull)) { return KirInstr { kir_opcode_ord(KirOpcode::IsNull), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::ArrayNew)) { return KirInstr { kir_opcode_ord(KirOpcode::ArrayNew), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::IndexGet)) { return KirInstr { kir_opcode_ord(KirOpcode::IndexGet), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::ArrayLen)) { return KirInstr { kir_opcode_ord(KirOpcode::ArrayLen), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::IndexSet)) { return KirInstr { kir_opcode_ord(KirOpcode::IndexSet), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::ArrayPush)) { return KirInstr { kir_opcode_ord(KirOpcode::ArrayPush), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::ArrayPop)) { return KirInstr { kir_opcode_ord(KirOpcode::ArrayPop), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::ArraySlice)) { return KirInstr { kir_opcode_ord(KirOpcode::ArraySlice), [], ins.line, ins.col, kir_type_ord(KirType::Array) }; }
  if (ins.op == vm_opcode_ord(OpCode::ArrayContains)) { return KirInstr { kir_opcode_ord(KirOpcode::ArrayContains), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::StringStartsWith)) { return KirInstr { kir_opcode_ord(KirOpcode::StrStartsWith), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::StringEndsWith)) { return KirInstr { kir_opcode_ord(KirOpcode::StrEndsWith), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::StringReplace)) { return KirInstr { kir_opcode_ord(KirOpcode::StrReplace), [], ins.line, ins.col, kir_type_ord(KirType::String) }; }
  if (ins.op == vm_opcode_ord(OpCode::StringSplit)) { return KirInstr { kir_opcode_ord(KirOpcode::StrSplit), [], ins.line, ins.col, kir_type_ord(KirType::Array) }; }
  if (ins.op == vm_opcode_ord(OpCode::StringTrim)) { return KirInstr { kir_opcode_ord(KirOpcode::StrTrim), [], ins.line, ins.col, kir_type_ord(KirType::String) }; }
  if (ins.op == vm_opcode_ord(OpCode::StringToUpper)) { return KirInstr { kir_opcode_ord(KirOpcode::StrToUpper), [], ins.line, ins.col, kir_type_ord(KirType::String) }; }
  if (ins.op == vm_opcode_ord(OpCode::StringToLower)) { return KirInstr { kir_opcode_ord(KirOpcode::StrToLower), [], ins.line, ins.col, kir_type_ord(KirType::String) }; }
  if (ins.op == vm_opcode_ord(OpCode::EnumPayloadGet)) { return KirInstr { kir_opcode_ord(KirOpcode::EnumPayloadGet), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::PushHandler)) { return KirInstr { kir_opcode_ord(KirOpcode::PushHandler), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::PopHandler)) { return KirInstr { kir_opcode_ord(KirOpcode::PopHandler), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::PropagateErr)) { return KirInstr { kir_opcode_ord(KirOpcode::PropagateErr), [], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::JmpIfErr)) { return KirInstr { kir_opcode_ord(KirOpcode::JmpIfErr), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::NativeOut)) { return KirInstr { kir_opcode_ord(KirOpcode::NativeOut), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::NativeOutLn)) { return KirInstr { kir_opcode_ord(KirOpcode::NativeOutLn), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::NativeErr)) { return KirInstr { kir_opcode_ord(KirOpcode::NativeErr), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::NativeErrLn)) { return KirInstr { kir_opcode_ord(KirOpcode::NativeErrLn), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::NativeIn)) { return KirInstr { kir_opcode_ord(KirOpcode::NativeIn), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::String) }; }
  if (ins.op == vm_opcode_ord(OpCode::NativeInSecret)) { return KirInstr { kir_opcode_ord(KirOpcode::NativeInSecret), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::String) }; }
  if (ins.op == vm_opcode_ord(OpCode::NativeFsRead)) { return KirInstr { kir_opcode_ord(KirOpcode::NativeFsRead), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::String) }; }
  if (ins.op == vm_opcode_ord(OpCode::NativeFsWrite)) { return KirInstr { kir_opcode_ord(KirOpcode::NativeFsWrite), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::NativeFsListdir)) { return KirInstr { kir_opcode_ord(KirOpcode::NativeFsListdir), [ins.operand], ins.line, ins.col, kir_type_ord(KirType::Array) }; }
  if (ins.op == vm_opcode_ord(OpCode::NativeSysArgs)) { return KirInstr { kir_opcode_ord(KirOpcode::NativeSysArgs), [], ins.line, ins.col, kir_type_ord(KirType::Array) }; }
  if (ins.op == vm_opcode_ord(OpCode::CastTo)) {
    // operand: 0=int, 1=float, 2=string, 3=char/byte
    KirType ct = ins.operand == 1 ? KirType::Float : (ins.operand == 2 ? KirType::String : (ins.operand == 3 ? KirType::Char : KirType::Int));
    return KirInstr { kir_opcode_ord(KirOpcode::CastTo), [ins.operand], ins.line, ins.col, kir_type_ord(ct) };
  }
  if (ins.op == vm_opcode_ord(OpCode::EnumVariantPayload)) {
    int packed = ins.operand;
    int type_idx = packed >> 16;
    int variant_idx = packed & 0xFFFF;
    int param_count = 0;
    if (type_idx >= 0 && type_idx < c.enum_metas.len()) {
      EnumMeta em = c.enum_metas[type_idx];
      if (variant_idx >= 0 && variant_idx < em.variant_param_counts.len()) {
        param_count = em.variant_param_counts[variant_idx];
      }
    }
    // Payload values are already on the stack (pushed before this instruction);
    // EnumPayloadNew pops param_count of them.
    return KirInstr { kir_opcode_ord(KirOpcode::EnumPayloadNew), [packed, param_count], ins.line, ins.col, kir_type_ord(KirType::Enum) };
  }
  if (ins.op == vm_opcode_ord(OpCode::True_)) { return KirInstr { kir_opcode_ord(KirOpcode::ConstInt), [1, 0], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  if (ins.op == vm_opcode_ord(OpCode::False_)) { return KirInstr { kir_opcode_ord(KirOpcode::ConstInt), [0, 0], ins.line, ins.col, kir_type_ord(KirType::Int) }; }
  KirOpcode a = bin_kir_op(ins.op);
  if (a != KirOpcode::Nop) {
    return KirInstr { kir_opcode_ord(a), [], ins.line, ins.col, kir_type_ord(KirType::Int) };
  }
  KirOpcode cmp = cmp_kir_op(ins.op);
  if (cmp != KirOpcode::Nop) {
    return KirInstr { kir_opcode_ord(cmp), [], ins.line, ins.col, kir_type_ord(KirType::Int) };
  }
  return KirInstr { kir_opcode_ord(KirOpcode::Nop), [], ins.line, ins.col, kir_type_ord(KirType::Int) };
}

pub KirModule build_kir_from_chunk(Chunk c) {
  int fn_count = c.functions.len();
  KirFunction[] funcs = [];
  if (fn_count == 0) {
    return KirModule { funcs };
  }
  int[] order = [];
  for (int i = 0; i < fn_count; i = i + 1) {
    order.push(i);
  }
  for (int i = 0; i < fn_count; i = i + 1) {
    int best = i;
    for (int j = i + 1; j < fn_count; j = j + 1) {
      if (c.functions[order[j]].entry < c.functions[order[best]].entry) {
        best = j;
      }
    }
    int tmp = order[i];
    order[i] = order[best];
    order[best] = tmp;
  }
  int instr_count = c.instructions.len();
  for (int k = 0; k < fn_count; k = k + 1) {
    FunctionInfo fi = c.functions[order[k]];
    int start = fi.entry;
    int end = instr_count;
    if (k + 1 < fn_count) {
      end = c.functions[order[k + 1]].entry;
    }
    KirInstr[] instrs = [];
    int[] tstack = [];
    // Per-local struct type index (for FieldGet/FieldSet name resolution),
    // or -1 when the slot holds a non-struct value. Threaded through
    // StoreLocal/LoadLocal so field access works after a store/load round-trip.
    int[] local_types = [];
    for (int lt = 0; lt < 64; lt = lt + 1) { local_types.push(-1); }
    // Seed local slot types from declared type names. Every variable known
    // to codegen (params + locals) is recorded in slot_type_names, so the
    // struct-field resolver does not need a simulated stack — it reads the
    // slot's declared type directly.
    // Fall back to param_type_names when slot_type_names is empty (old bytecode
    // compiled without per-slot type recording).
    if (fi.slot_type_names.len() > 0) {
      for (int ss = 0; ss < fi.slot_type_names.len(); ss = ss + 1) {
        if (ss >= local_types.len()) { break; }
        string tn = fi.slot_type_names[ss];
        if (tn.len() > 0) { local_types[ss] = encode_decl_type(tn, c); }
      }
    } else {
      for (int pp = 0; pp < fi.param_count; pp = pp + 1) {
        if (pp >= local_types.len()) { break; }
        if (pp < fi.param_type_names.len()) {
          local_types[pp] = encode_decl_type(fi.param_type_names[pp], c);
        }
      }
    }
    for (int pc = start; pc < end; pc = pc + 1) {
      Instruction raw = c.instructions[pc];
      if (raw.op == vm_opcode_ord(OpCode::Call)) {
        int fn_idx = -1;
        if (pc > start) {
          Instruction prev = c.instructions[pc - 1];
          if (prev.op == vm_opcode_ord(OpCode::Constant)) {
            Constant pk = c.constants[prev.operand];
            if (pk.kind == ConstKind::Function_) { fn_idx = pk.aux1; }
          }
        }
        instrs.push(KirInstr { kir_opcode_ord(KirOpcode::Call), [raw.operand, fn_idx], raw.line, raw.col, kir_type_ord(KirType::Int) });
        int ac = raw.operand;
        for (int a = 0; a < ac; a = a + 1) { if (tstack.len() > 0) { tstack.pop(); } }
        // Track a struct-typed (or struct-array) return value so the caller can
        // resolve field access on it (e.g. `s = skip(s); s.current`, or
        // `Token[] ts = scan(src); ts[i].type`). encode_decl_type also handles
        // "X[]" return types so IndexGet recovers the element struct.
        int call_sty = -1;
        if (fn_idx >= 0 && fn_idx < c.functions.len()) {
          call_sty = encode_decl_type(c.functions[fn_idx].return_type_name, c);
        }
        tstack.push(call_sty);
      } else if (raw.op == vm_opcode_ord(OpCode::StructNew)) {
        int field_count = raw.operand & 0xFFFF;
        for (int f = 0; f < field_count; f = f + 1) { if (tstack.len() > 0) { tstack.pop(); } }
        instrs.push(KirInstr { kir_opcode_ord(KirOpcode::StructNew), [raw.operand], raw.line, raw.col, kir_type_ord(KirType::Struct) });
        tstack.push(raw.operand >> 16);
      } else if (raw.op == vm_opcode_ord(OpCode::FieldGet) || raw.op == vm_opcode_ord(OpCode::FieldSet)) {
        bool is_set = raw.op == vm_opcode_ord(OpCode::FieldSet);
        int styidx = -1;
        if (tstack.len() > 0) { styidx = tstack[tstack.len() - 1]; }
        if (is_set && tstack.len() > 1) { styidx = tstack[tstack.len() - 2]; }
        int fidx = 0;
        string fname = c.constants[raw.operand].string_value;
        if (styidx >= 0 && styidx < c.struct_metas.len()) {
          string[] fns = c.struct_metas[styidx].field_names;
          for (int fj = 0; fj < fns.len(); fj = fj + 1) {
            if (fns[fj] == fname) { fidx = fj; }
          }
        }
        // Fallback: when the tstack derived styidx fails, scan every known
        // struct. If the field name exists in exactly ONE struct, trust that
        // match. This reliably resolves unique field names ("fn_tail_return",
        // "chunk", "funcs", …) without needing a perfect simulated stack.
        if (fidx == 0 && fname.len() > 0) {
          int found = 0;
          for (int ss = 0; ss < c.struct_metas.len(); ss = ss + 1) {
            string[] sfns = c.struct_metas[ss].field_names;
            for (int sf = 0; sf < sfns.len(); sf = sf + 1) {
              if (sfns[sf] == fname) { fidx = sf; found = found + 1; }
            }
          }
          if (found != 1) { fidx = 0; }
        }
        if (is_set) {
          instrs.push(KirInstr { kir_opcode_ord(KirOpcode::FieldSet), [fidx], raw.line, raw.col, kir_type_ord(KirType::Struct) });
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(styidx);
        } else {
          instrs.push(KirInstr { kir_opcode_ord(KirOpcode::FieldGet), [fidx], raw.line, raw.col, kir_type_ord(KirType::Int) });
          // Propagate the field's declared type so chained access like
          // `p.tokens[i].type` resolves: tokens is "Token[]" -> mk_arr(Token),
          // IndexGet then yields Token, and `.type` resolves its index.
          int field_ty = -1;
          if (styidx >= 0 && styidx < c.struct_metas.len()) {
            string[] ftns = c.struct_metas[styidx].field_type_names;
            if (fidx < ftns.len()) {
              field_ty = encode_decl_type(ftns[fidx], c);
            }
          }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(field_ty);
        }
      } else if (raw.op - vm_op_enum_variant() == 0) {
        kir_push_enum_variant(instrs, raw.operand, raw.line, raw.col);
        tstack.push(-1);
      } else {
        KirInstr ki = to_kir_instr(c, raw, pc - start);
        instrs.push(ki);
        int kop = ki.op;
        if (kop == kir_opcode_ord(KirOpcode::ConstInt) || kop == kir_opcode_ord(KirOpcode::ConstString) || kop == kir_opcode_ord(KirOpcode::ConstFloat) || kop == kir_opcode_ord(KirOpcode::ConstNull)) {
          tstack.push(-1);
        } else if (kop == kir_opcode_ord(KirOpcode::LoadLocal)) {
          int lslot = ki.operands[0];
          int lty = -1;
          if (lslot >= 0 && lslot < local_types.len()) { lty = local_types[lslot]; }
          tstack.push(lty);
        } else if (kop == kir_opcode_ord(KirOpcode::StoreLocal)) {
          // StoreLocal copies (peek); record the value's type into its slot.
          int slslot = ki.operands[0];
          int slty = -1;
          if (tstack.len() > 0) { slty = tstack[tstack.len() - 1]; }
          if (slslot >= 0 && slslot < local_types.len()) { local_types[slslot] = slty; }
        } else if (kop == kir_opcode_ord(KirOpcode::Pop) || kop == kir_opcode_ord(KirOpcode::CondBr)) {
          if (tstack.len() > 0) { tstack.pop(); }
        } else if (kop == kir_opcode_ord(KirOpcode::INeg) || kop == kir_opcode_ord(KirOpcode::IBNot) || kop == kir_opcode_ord(KirOpcode::LNot) || kop == kir_opcode_ord(KirOpcode::CastTo)) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == kir_opcode_ord(KirOpcode::IAdd) || kop == kir_opcode_ord(KirOpcode::ISub) || kop == kir_opcode_ord(KirOpcode::IMul) || kop == kir_opcode_ord(KirOpcode::IDiv) || kop == kir_opcode_ord(KirOpcode::IMod) || kop == kir_opcode_ord(KirOpcode::IAnd) || kop == kir_opcode_ord(KirOpcode::IOr) || kop == kir_opcode_ord(KirOpcode::IXor) || kop == kir_opcode_ord(KirOpcode::IShl) || kop == kir_opcode_ord(KirOpcode::IShr) || kop == kir_opcode_ord(KirOpcode::IEq) || kop == kir_opcode_ord(KirOpcode::INe) || kop == kir_opcode_ord(KirOpcode::ILt) || kop == kir_opcode_ord(KirOpcode::IGt) || kop == kir_opcode_ord(KirOpcode::ILe) || kop == kir_opcode_ord(KirOpcode::IGe)) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == kir_opcode_ord(KirOpcode::ArrayNew)) {
          int ac2 = ki.operands[0];
          // Peek the last element's tracked type before popping, so the array
          // remembers its element struct type (e.g. [P{...}, P{...}] is struct P[]).
          int elem_ty = -1;
          if (ac2 > 0 && tstack.len() > 0) { elem_ty = tstack[tstack.len() - 1]; }
          for (int a2 = 0; a2 < ac2; a2 = a2 + 1) { if (tstack.len() > 0) { tstack.pop(); } }
          if (elem_ty >= 0 && elem_ty < c.struct_metas.len()) {
            tstack.push(mk_arr(elem_ty));
          } else {
            tstack.push(-1);
          }
        } else if (kop == kir_opcode_ord(KirOpcode::IndexGet)) {
          if (tstack.len() > 0) { tstack.pop(); }  // index
          // Recover the element struct type from the array's tracked type so a
          // subsequent FieldGet/StoreLocal resolves fields correctly.
          int arr_ty = -1;
          if (tstack.len() > 0) { arr_ty = tstack[tstack.len() - 1]; }
          if (tstack.len() > 0) { tstack.pop(); }  // array
          if (is_arr(arr_ty)) {
            tstack.push(arr_elem_struct(arr_ty));
          } else {
            tstack.push(-1);
          }
        } else if (kop == kir_opcode_ord(KirOpcode::ArrayLen)) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == kir_opcode_ord(KirOpcode::IndexSet)) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == kir_opcode_ord(KirOpcode::ArrayPush)) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == kir_opcode_ord(KirOpcode::ArrayPop)) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == kir_opcode_ord(KirOpcode::ArraySlice)) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == kir_opcode_ord(KirOpcode::ArrayContains)) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == kir_opcode_ord(KirOpcode::StrStartsWith) || kop == kir_opcode_ord(KirOpcode::StrEndsWith) || kop == kir_opcode_ord(KirOpcode::StrSplit)) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == kir_opcode_ord(KirOpcode::StrReplace)) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == kir_opcode_ord(KirOpcode::StrTrim) || kop == kir_opcode_ord(KirOpcode::StrToUpper) || kop == kir_opcode_ord(KirOpcode::StrToLower)) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        }
      }
    }
    KirBasicBlock[] blocks = [];
    blocks.push(KirBasicBlock { "bb0", instrs });
    string[] pnames = [];
    funcs.push(KirFunction { fi.name, fi.param_count, pnames, blocks, kir_type_ord(KirType::Int), order[k] });
  }
  return KirModule { funcs };
}

// Type inference pass: walks each function's instructions and sets result_type.
// Tracks a typed stack + typed locals to distinguish float vs int operations.
// Returns a new module with result_type populated on each KirInstr.
pub KirModule infer_types(KirModule mod, Chunk ch) {
  KirFunction[] new_fns = [];
  for (int fi = 0; fi < mod.functions.len(); fi = fi + 1) {
    KirFunction kfn = mod.functions[fi];
    KirBasicBlock[] new_blocks = [];
    for (int bi = 0; bi < kfn.blocks.len(); bi = bi + 1) {
      KirBasicBlock bb = kfn.blocks[bi];
      KirInstr[] instrs = bb.instrs;
      int n = instrs.len();
      // Type stack: 0 = Int, 1 = Float
      int[] tstack = [];
      // Local slot types: 0 = Int, 1 = Float
      int[] local_types = [];
      for (int li = 0; li < 64; li = li + 1) { local_types.push(0); }
      KirInstr[] new_instrs = [];
      for (int i = 0; i < n; i = i + 1) {
        int iop = kir_instr_op(instrs, i);
        int[] iops = kir_instr_operands(instrs, i);
        int rtype = kir_instr_result_type(instrs, i);
        if (iop == kir_opcode_ord(KirOpcode::ConstInt)) {
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop - kir_op_enum_variant() == 0) {
          tstack.push(0);
          rtype = kir_type_ord(KirType::Enum);
        } else if (iop == kir_opcode_ord(KirOpcode::ConstFloat)) {
          tstack.push(1);
          rtype = kir_type_ord(KirType::Float);
        } else if (iop == kir_opcode_ord(KirOpcode::ConstBool) || iop == kir_opcode_ord(KirOpcode::ConstNull)) {
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::ConstString)) {
          tstack.push(2);
          rtype = kir_type_ord(KirType::String);
        } else if (iop == kir_opcode_ord(KirOpcode::LoadLocal)) {
          int slot = iops[0];
          int ty = 0;
          if (slot >= 0 && slot < local_types.len()) { ty = local_types[slot]; }
          tstack.push(ty);
          rtype = ty == 1 ? kir_type_ord(KirType::Float) : (ty == 2 ? kir_type_ord(KirType::String) : kir_type_ord(KirType::Int));
        } else if (iop == kir_opcode_ord(KirOpcode::StoreLocal)) {
          int slot = iops[0];
          int ty = 0;
          if (tstack.len() > 0) { ty = tstack[tstack.len() - 1]; }
          if (slot >= 0 && slot < local_types.len()) {
            local_types[slot] = ty;
          }
          rtype = ty == 1 ? kir_type_ord(KirType::Float) : (ty == 2 ? kir_type_ord(KirType::String) : kir_type_ord(KirType::Int));
        } else if (iop == kir_opcode_ord(KirOpcode::Pop)) {
          if (tstack.len() > 0) { tstack.pop(); }
        } else if (iop == kir_opcode_ord(KirOpcode::Dup)) {
          if (tstack.len() > 0) { tstack.push(tstack[tstack.len() - 1]); }
        } else if (iop == kir_opcode_ord(KirOpcode::INeg) || iop == kir_opcode_ord(KirOpcode::IBNot)) {
          int ty = 0;
          if (tstack.len() > 0) { ty = tstack[tstack.len() - 1]; tstack.pop(); }
          tstack.push(ty);
          rtype = ty == 1 ? kir_type_ord(KirType::Float) : kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::LNot)) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::IsNull)) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::CastTo)) {
          // operand: 0=int, 1=float, 2=string, 3=char/byte
          int ck = iops.len() > 0 ? iops[0] : 0;
          if (tstack.len() > 0) { tstack.pop(); }
          int cty = ck == 1 ? 1 : (ck == 2 ? 2 : 0);
          tstack.push(cty);
          rtype = ck == 1 ? kir_type_ord(KirType::Float) : (ck == 2 ? kir_type_ord(KirType::String) : (ck == 3 ? kir_type_ord(KirType::Char) : kir_type_ord(KirType::Int)));
        } else if (iop == kir_opcode_ord(KirOpcode::IAdd) || iop == kir_opcode_ord(KirOpcode::ISub) || iop == kir_opcode_ord(KirOpcode::IMul) || iop == kir_opcode_ord(KirOpcode::IDiv) || iop == kir_opcode_ord(KirOpcode::IMod)) {
          int ty_r = 0;
          int ty_l = 0;
          if (tstack.len() > 0) { ty_r = tstack[tstack.len() - 1]; tstack.pop(); }
          if (tstack.len() > 0) { ty_l = tstack[tstack.len() - 1]; tstack.pop(); }
          int result_ty = 0;
          if (ty_l == 1 || ty_r == 1) { result_ty = 1; }
          // String + String (concat): either operand string -> string result.
          if (iop == kir_opcode_ord(KirOpcode::IAdd) && (ty_l == 2 || ty_r == 2)) { result_ty = 2; }
          tstack.push(result_ty);
          rtype = result_ty == 1 ? kir_type_ord(KirType::Float) : (result_ty == 2 ? kir_type_ord(KirType::String) : kir_type_ord(KirType::Int));
        } else if (iop == kir_opcode_ord(KirOpcode::IEq) || iop == kir_opcode_ord(KirOpcode::INe) || iop == kir_opcode_ord(KirOpcode::ILt) || iop == kir_opcode_ord(KirOpcode::IGt) || iop == kir_opcode_ord(KirOpcode::ILe) || iop == kir_opcode_ord(KirOpcode::IGe)) {
          int ty_r = 0;
          int ty_l = 0;
          if (tstack.len() > 0) { ty_r = tstack[tstack.len() - 1]; tstack.pop(); }
          if (tstack.len() > 0) { ty_l = tstack[tstack.len() - 1]; tstack.pop(); }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::IAnd) || iop == kir_opcode_ord(KirOpcode::IOr) || iop == kir_opcode_ord(KirOpcode::IXor) || iop == kir_opcode_ord(KirOpcode::IShl) || iop == kir_opcode_ord(KirOpcode::IShr)) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::Call)) {
          int argc = iops[0];
          for (int a = 0; a < argc; a = a + 1) { if (tstack.len() > 0) { tstack.pop(); } }
          // Track the callee's return type so a `+` on call results selects
          // string concat (kl_value_add) instead of integer add — e.g.
          // join_parts' recursive `a + b` must concat strings, not add handles.
          int cty = 0;
          int cfn = iops.len() > 1 ? iops[1] : -1;
          if (cfn >= 0 && cfn < ch.functions.len()) {
            string rtn = ch.functions[cfn].return_type_name;
            if (rtn == "string" || rtn == "String") { cty = 2; }
            else if (rtn == "float" || rtn == "double" || rtn == "float32" || rtn == "float64") { cty = 1; }
          }
          tstack.push(cty);
          rtype = cty == 1 ? kir_type_ord(KirType::Float) : (cty == 2 ? kir_type_ord(KirType::String) : kir_type_ord(KirType::Int));
        } else if (iop == kir_opcode_ord(KirOpcode::NativeOut) || iop == kir_opcode_ord(KirOpcode::NativeOutLn) ||
                   iop == kir_opcode_ord(KirOpcode::NativeErr) || iop == kir_opcode_ord(KirOpcode::NativeErrLn) ||
                   iop == kir_opcode_ord(KirOpcode::NativeIn) || iop == kir_opcode_ord(KirOpcode::NativeInSecret)) {
          int argc = iops[0];
          for (int a = 0; a < argc; a = a + 1) { if (tstack.len() > 0) { tstack.pop(); } }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::NativeFsRead) || iop == kir_opcode_ord(KirOpcode::NativeFsListdir)) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::NativeFsWrite)) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::NativeSysArgs)) {
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::Ret)) {
          // no change
        } else if (iop == kir_opcode_ord(KirOpcode::Br) || iop == kir_opcode_ord(KirOpcode::CondBr)) {
          if (iop == kir_opcode_ord(KirOpcode::CondBr)) { if (tstack.len() > 0) { tstack.pop(); } }
        } else if (iop == kir_opcode_ord(KirOpcode::StructNew)) {
          int fc = iops[0] & 0xFFFF;
          for (int f = 0; f < fc; f = f + 1) { if (tstack.len() > 0) { tstack.pop(); } }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Struct);
        } else if (iop == kir_opcode_ord(KirOpcode::FieldGet)) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::FieldSet)) {
          if (tstack.len() > 1) { tstack.pop(); tstack.pop(); }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Struct);
        } else if (iop == kir_opcode_ord(KirOpcode::ArrayNew)) {
          int ac = iops[0];
          for (int a = 0; a < ac; a = a + 1) { if (tstack.len() > 0) { tstack.pop(); } }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Array);
        } else if (iop == kir_opcode_ord(KirOpcode::IndexGet)) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::ArrayLen)) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::ArraySlice)) {
          // Stack order (top..bottom): end, start, obj. The result follows the
          // sliced object: slicing a string yields a string, so a later `+`
          // lowers to kl_value_add (concat) rather than integer add. Without
          // this, `s.slice(a,b) + s.slice(c,d)` emits `add i64` over two heap
          // string handles, producing a garbage pointer that downstream
          // runtime calls dereference and corrupt the heap with.
          int obj_ty = -1;
          if (tstack.len() >= 3) { obj_ty = tstack[tstack.len() - 3]; }
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          if (obj_ty == 2) {
            tstack.push(2);
            rtype = kir_type_ord(KirType::String);
          } else {
            tstack.push(0);
            rtype = kir_type_ord(KirType::Array);
          }
        } else if (iop == kir_opcode_ord(KirOpcode::ArrayContains)) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        } else if (iop == kir_opcode_ord(KirOpcode::EnumPayloadNew)) {
          int epc = iops.len() > 1 ? iops[1] : 0;
          for (int p = 0; p < epc; p = p + 1) { if (tstack.len() > 0) { tstack.pop(); } }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Enum);
        } else if (iop == kir_opcode_ord(KirOpcode::EnumPayloadGet)) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = kir_type_ord(KirType::Int);
        }
        new_instrs.push(kir_instr_make(iop, iops, kir_instr_line(instrs, i), kir_instr_col(instrs, i), rtype));
      }
      new_blocks.push(KirBasicBlock { bb.label, new_instrs });
    }
    new_fns.push(KirFunction { kfn.name, kfn.param_count, kfn.param_names, new_blocks, kfn.return_type, kfn.fn_index });
  }
  return KirModule { new_fns };
}
