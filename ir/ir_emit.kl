// Chunk → KIR post-pass; mirrors bootstrap IrBuilder data shapes.

export module ir.ir_emit;

import ir.ir;
import compiler.bytecode;
using namespace ir.ir;
using namespace compiler.bytecode;

pub KirModule empty_module() {
  KirFunction[] fs = [];
  return KirModule { fs };
}

KirOpcode cmp_kir_op(OpCode op) {
  if (op == OpCode::Eq) { return KirOpcode::IEq; }
  if (op == OpCode::Neq) { return KirOpcode::INe; }
  if (op == OpCode::Lt) { return KirOpcode::ILt; }
  if (op == OpCode::Gt) { return KirOpcode::IGt; }
  if (op == OpCode::Le) { return KirOpcode::ILe; }
  if (op == OpCode::Ge) { return KirOpcode::IGe; }
  return KirOpcode::Nop;
}

KirOpcode bin_kir_op(OpCode op) {
  if (op == OpCode::Add || op == OpCode::AddI32) { return KirOpcode::IAdd; }
  if (op == OpCode::Subtract || op == OpCode::SubtractI32) { return KirOpcode::ISub; }
  if (op == OpCode::Multiply || op == OpCode::MultiplyI32) { return KirOpcode::IMul; }
  if (op == OpCode::Divide || op == OpCode::DivideI32) { return KirOpcode::IDiv; }
  if (op == OpCode::Modulo || op == OpCode::ModuloI32) { return KirOpcode::IMod; }
  if (op == OpCode::BitAnd) { return KirOpcode::IAnd; }
  if (op == OpCode::BitOr) { return KirOpcode::IOr; }
  if (op == OpCode::BitXor) { return KirOpcode::IXor; }
  if (op == OpCode::Shl) { return KirOpcode::IShl; }
  if (op == OpCode::Shr) { return KirOpcode::IShr; }
  return KirOpcode::Nop;
}

KirInstr to_kir_instr(Chunk c, Instruction ins, int rel_pc) {
  if (ins.op == OpCode::EnumVariant_) {
    int v = ins.operand;
    // Tag-only enums use the canonical inline wire format: the 0xFFFD mark in
    // bits 48..63 (kinglet_rt_value.h KL_INLINE_ENUM_MARK) so the runtime
    // (kl_value_eq, kl_value_cmp, printing) treats them as enums, not ints.
    // Low 32 bits carry (type<<16)|variant.
    return KirInstr { KirOpcode::ConstInt, [v & 0xFFFFFFFF, 0xFFFD0000], ins.line, ins.col, KirType::Int };
  }
  if (ins.op == OpCode::Constant) {
    Constant k = c.constants[ins.operand];
    if (k.kind == ConstKind::Int_) {
      int v = k.int_value;
      return KirInstr { KirOpcode::ConstInt, [v & 0xFFFFFFFF, (v >> 32) & 0xFFFFFFFF], ins.line, ins.col, KirType::Int };
    }
    if (k.kind == ConstKind::Double_) {
      // Store raw IEEE 754 bits as two 32-bit operands (matches bootstrap kir_to_llvm.cc const_double).
      // We cannot extract bits from a double within Kinglet, so use constant pool index.
      return KirInstr { KirOpcode::ConstFloat, [ins.operand, 0], ins.line, ins.col, KirType::Float };
    }
    if (k.kind == ConstKind::String_) {
      // Operand is the constant pool index; ll_emit reads the bytes from the
      // Chunk to emit an LLVM string global (via int(s[i]) byte access).
      return KirInstr { KirOpcode::ConstString, [ins.operand], ins.line, ins.col, KirType::String };
    }
    return KirInstr { KirOpcode::Nop, [], ins.line, ins.col, KirType::Int };
  }
  if (ins.op == OpCode::Return_) {
    return KirInstr { KirOpcode::Ret, [], ins.line, ins.col, KirType::Void };
  }
  if (ins.op == OpCode::Jmp) {
    int target = rel_pc + 1 + ins.operand;
    return KirInstr { KirOpcode::Br, [target], ins.line, ins.col, KirType::Void };
  }
  if (ins.op == OpCode::JmpFalse) {
    int target = rel_pc + 1 + ins.operand;
    return KirInstr { KirOpcode::CondBr, [target], ins.line, ins.col, KirType::Void };
  }
  if (ins.op == OpCode::StoreLocal) { return KirInstr { KirOpcode::StoreLocal, [ins.operand], ins.line, ins.col, KirType::Int }; }
  if (ins.op == OpCode::LoadLocal) { return KirInstr { KirOpcode::LoadLocal, [ins.operand], ins.line, ins.col, KirType::Int }; }
  if (ins.op == OpCode::Pop) { return KirInstr { KirOpcode::Pop, [], ins.line, ins.col, KirType::Void }; }
  if (ins.op == OpCode::Dup) { return KirInstr { KirOpcode::Dup, [], ins.line, ins.col, KirType::Int }; }
  if (ins.op == OpCode::Negate) { return KirInstr { KirOpcode::INeg, [], ins.line, ins.col, KirType::Int }; }
  if (ins.op == OpCode::BitNot) { return KirInstr { KirOpcode::IBNot, [], ins.line, ins.col, KirType::Int }; }
  if (ins.op == OpCode::Not_) { return KirInstr { KirOpcode::LNot, [], ins.line, ins.col, KirType::Int }; }
  if (ins.op == OpCode::Null_) { return KirInstr { KirOpcode::ConstNull, [], ins.line, ins.col, KirType::Null }; }
  if (ins.op == OpCode::IsNull) { return KirInstr { KirOpcode::IsNull, [], ins.line, ins.col, KirType::Int }; }
  if (ins.op == OpCode::ArrayNew) { return KirInstr { KirOpcode::ArrayNew, [ins.operand], ins.line, ins.col, KirType::Int }; }
  if (ins.op == OpCode::IndexGet) { return KirInstr { KirOpcode::IndexGet, [], ins.line, ins.col, KirType::Int }; }
  if (ins.op == OpCode::ArrayLen) { return KirInstr { KirOpcode::ArrayLen, [], ins.line, ins.col, KirType::Int }; }
  if (ins.op == OpCode::EnumPayloadGet) { return KirInstr { KirOpcode::EnumPayloadGet, [ins.operand], ins.line, ins.col, KirType::Int }; }
  if (ins.op == OpCode::CastTo) {
    // operand: 0=int, 1=float, 2=string, 3=char/byte
    KirType ct = ins.operand == 1 ? KirType::Float : (ins.operand == 2 ? KirType::String : (ins.operand == 3 ? KirType::Char : KirType::Int));
    return KirInstr { KirOpcode::CastTo, [ins.operand], ins.line, ins.col, ct };
  }
  if (ins.op == OpCode::EnumVariantPayload) {
    int packed = ins.operand;
    int type_idx = packed >> 16;
    int variant_idx = packed & 0xFFFF;
    int param_count = 0;
    if (type_idx >= 0 && type_idx < c.enum_metas.len()) {
      EnumMeta em = c.enum_metas[type_idx];
      if (variant_idx >= 0 && variant_idx < em.variant_param_counts.len()) {
        param_count = em.variant_param_counts[variant_idx];
      }
    }
    // Payload values are already on the stack (pushed before this instruction);
    // EnumPayloadNew pops param_count of them.
    return KirInstr { KirOpcode::EnumPayloadNew, [packed, param_count], ins.line, ins.col, KirType::Enum };
  }
  if (ins.op == OpCode::True_) { return KirInstr { KirOpcode::ConstInt, [1, 0], ins.line, ins.col, KirType::Int }; }
  if (ins.op == OpCode::False_) { return KirInstr { KirOpcode::ConstInt, [0, 0], ins.line, ins.col, KirType::Int }; }
  KirOpcode a = bin_kir_op(ins.op);
  if (a != KirOpcode::Nop) {
    return KirInstr { a, [], ins.line, ins.col, KirType::Int };
  }
  KirOpcode cmp = cmp_kir_op(ins.op);
  if (cmp != KirOpcode::Nop) {
    return KirInstr { cmp, [], ins.line, ins.col, KirType::Int };
  }
  return KirInstr { KirOpcode::Nop, [], ins.line, ins.col, KirType::Int };
}

pub KirModule build_kir_from_chunk(Chunk c) {
  int fn_count = c.functions.len();
  KirFunction[] funcs = [];
  if (fn_count == 0) {
    return KirModule { funcs };
  }
  int[] order = [];
  for (int i = 0; i < fn_count; i = i + 1) {
    order.push(i);
  }
  for (int i = 0; i < fn_count; i = i + 1) {
    int best = i;
    for (int j = i + 1; j < fn_count; j = j + 1) {
      if (c.functions[order[j]].entry < c.functions[order[best]].entry) {
        best = j;
      }
    }
    int tmp = order[i];
    order[i] = order[best];
    order[best] = tmp;
  }
  int instr_count = c.instructions.len();
  for (int k = 0; k < fn_count; k = k + 1) {
    FunctionInfo fi = c.functions[order[k]];
    int start = fi.entry;
    int end = instr_count;
    if (k + 1 < fn_count) {
      end = c.functions[order[k + 1]].entry;
    }
    KirInstr[] instrs = [];
    int[] tstack = [];
    // Per-local struct type index (for FieldGet/FieldSet name resolution),
    // or -1 when the slot holds a non-struct value. Threaded through
    // StoreLocal/LoadLocal so field access works after a store/load round-trip.
    int[] local_types = [];
    for (int lt = 0; lt < 64; lt = lt + 1) { local_types.push(-1); }
    for (int pc = start; pc < end; pc = pc + 1) {
      Instruction raw = c.instructions[pc];
      if (raw.op == OpCode::Call) {
        int fn_idx = -1;
        if (pc > start) {
          Instruction prev = c.instructions[pc - 1];
          if (prev.op == OpCode::Constant) {
            Constant pk = c.constants[prev.operand];
            if (pk.kind == ConstKind::Function_) { fn_idx = pk.aux1; }
          }
        }
        instrs.push(KirInstr { KirOpcode::Call, [raw.operand, fn_idx], raw.line, raw.col, KirType::Int });
        int ac = raw.operand;
        for (int a = 0; a < ac; a = a + 1) { if (tstack.len() > 0) { tstack.pop(); } }
        tstack.push(-1);
      } else if (raw.op == OpCode::StructNew) {
        int field_count = raw.operand & 0xFFFF;
        for (int f = 0; f < field_count; f = f + 1) { if (tstack.len() > 0) { tstack.pop(); } }
        instrs.push(KirInstr { KirOpcode::StructNew, [raw.operand], raw.line, raw.col, KirType::Struct });
        tstack.push(raw.operand >> 16);
      } else if (raw.op == OpCode::FieldGet || raw.op == OpCode::FieldSet) {
        bool is_set = raw.op == OpCode::FieldSet;
        int styidx = -1;
        if (tstack.len() > 0) { styidx = tstack[tstack.len() - 1]; }
        if (is_set && tstack.len() > 1) { styidx = tstack[tstack.len() - 2]; }
        int fidx = 0;
        if (styidx >= 0 && styidx < c.struct_metas.len()) {
          string fname = c.constants[raw.operand].string_value;
          string[] fns = c.struct_metas[styidx].field_names;
          for (int fj = 0; fj < fns.len(); fj = fj + 1) {
            if (fns[fj] == fname) { fidx = fj; }
          }
        }
        if (is_set) {
          instrs.push(KirInstr { KirOpcode::FieldSet, [fidx], raw.line, raw.col, KirType::Struct });
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(styidx);
        } else {
          instrs.push(KirInstr { KirOpcode::FieldGet, [fidx], raw.line, raw.col, KirType::Int });
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        }
      } else {
        KirInstr ki = to_kir_instr(c, raw, pc - start);
        instrs.push(ki);
        KirOpcode kop = ki.op;
        if (kop == KirOpcode::ConstInt || kop == KirOpcode::ConstString || kop == KirOpcode::ConstFloat || kop == KirOpcode::ConstNull) {
          tstack.push(-1);
        } else if (kop == KirOpcode::LoadLocal) {
          int lslot = ki.operands[0];
          int lty = -1;
          if (lslot >= 0 && lslot < local_types.len()) { lty = local_types[lslot]; }
          tstack.push(lty);
        } else if (kop == KirOpcode::StoreLocal) {
          // StoreLocal copies (peek); record the value's type into its slot.
          int slslot = ki.operands[0];
          int slty = -1;
          if (tstack.len() > 0) { slty = tstack[tstack.len() - 1]; }
          if (slslot >= 0 && slslot < local_types.len()) { local_types[slslot] = slty; }
        } else if (kop == KirOpcode::Pop || kop == KirOpcode::CondBr) {
          if (tstack.len() > 0) { tstack.pop(); }
        } else if (kop == KirOpcode::INeg || kop == KirOpcode::IBNot || kop == KirOpcode::LNot || kop == KirOpcode::CastTo) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == KirOpcode::IAdd || kop == KirOpcode::ISub || kop == KirOpcode::IMul || kop == KirOpcode::IDiv || kop == KirOpcode::IMod || kop == KirOpcode::IAnd || kop == KirOpcode::IOr || kop == KirOpcode::IXor || kop == KirOpcode::IShl || kop == KirOpcode::IShr || kop == KirOpcode::IEq || kop == KirOpcode::INe || kop == KirOpcode::ILt || kop == KirOpcode::IGt || kop == KirOpcode::ILe || kop == KirOpcode::IGe) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == KirOpcode::ArrayNew) {
          int ac2 = ki.operands[0];
          for (int a2 = 0; a2 < ac2; a2 = a2 + 1) { if (tstack.len() > 0) { tstack.pop(); } }
          tstack.push(-1);
        } else if (kop == KirOpcode::IndexGet) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        } else if (kop == KirOpcode::ArrayLen) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(-1);
        }
      }
    }
    KirBasicBlock[] blocks = [];
    blocks.push(KirBasicBlock { "bb0", instrs });
    string[] pnames = [];
    funcs.push(KirFunction { fi.name, fi.param_count, pnames, blocks, KirType::Int, order[k] });
  }
  return KirModule { funcs };
}

// Type inference pass: walks each function's instructions and sets result_type.
// Tracks a typed stack + typed locals to distinguish float vs int operations.
// Returns a new module with result_type populated on each KirInstr.
pub KirModule infer_types(KirModule mod, Chunk ch) {
  KirFunction[] new_fns = [];
  for (int fi = 0; fi < mod.functions.len(); fi = fi + 1) {
    KirFunction kfn = mod.functions[fi];
    KirBasicBlock[] new_blocks = [];
    for (int bi = 0; bi < kfn.blocks.len(); bi = bi + 1) {
      KirBasicBlock bb = kfn.blocks[bi];
      KirInstr[] instrs = bb.instrs;
      int n = instrs.len();
      // Type stack: 0 = Int, 1 = Float
      int[] tstack = [];
      // Local slot types: 0 = Int, 1 = Float
      int[] local_types = [];
      for (int li = 0; li < 64; li = li + 1) { local_types.push(0); }
      KirInstr[] new_instrs = [];
      for (int i = 0; i < n; i = i + 1) {
        KirInstr ins = instrs[i];
        KirType rtype = ins.result_type;
        if (ins.op == KirOpcode::ConstInt) {
          tstack.push(0);
          rtype = KirType::Int;
        } else if (ins.op == KirOpcode::ConstFloat) {
          tstack.push(1);
          rtype = KirType::Float;
        } else if (ins.op == KirOpcode::ConstBool || ins.op == KirOpcode::ConstNull) {
          tstack.push(0);
          rtype = KirType::Int;
        } else if (ins.op == KirOpcode::ConstString) {
          tstack.push(2);
          rtype = KirType::String;
        } else if (ins.op == KirOpcode::LoadLocal) {
          int slot = ins.operands[0];
          int ty = 0;
          if (slot >= 0 && slot < local_types.len()) { ty = local_types[slot]; }
          tstack.push(ty);
          rtype = ty == 1 ? KirType::Float : (ty == 2 ? KirType::String : KirType::Int);
        } else if (ins.op == KirOpcode::StoreLocal) {
          int slot = ins.operands[0];
          int ty = 0;
          if (tstack.len() > 0) { ty = tstack[tstack.len() - 1]; }
          if (slot >= 0 && slot < local_types.len()) {
            local_types[slot] = ty;
          }
          rtype = ty == 1 ? KirType::Float : (ty == 2 ? KirType::String : KirType::Int);
        } else if (ins.op == KirOpcode::Pop) {
          if (tstack.len() > 0) { tstack.pop(); }
        } else if (ins.op == KirOpcode::Dup) {
          if (tstack.len() > 0) { tstack.push(tstack[tstack.len() - 1]); }
        } else if (ins.op == KirOpcode::INeg || ins.op == KirOpcode::IBNot) {
          int ty = 0;
          if (tstack.len() > 0) { ty = tstack[tstack.len() - 1]; tstack.pop(); }
          tstack.push(ty);
          rtype = ty == 1 ? KirType::Float : KirType::Int;
        } else if (ins.op == KirOpcode::LNot) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = KirType::Int;
        } else if (ins.op == KirOpcode::IsNull) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = KirType::Int;
        } else if (ins.op == KirOpcode::CastTo) {
          // operand: 0=int, 1=float, 2=string, 3=char/byte
          int ck = ins.operands.len() > 0 ? ins.operands[0] : 0;
          if (tstack.len() > 0) { tstack.pop(); }
          int cty = ck == 1 ? 1 : (ck == 2 ? 2 : 0);
          tstack.push(cty);
          rtype = ck == 1 ? KirType::Float : (ck == 2 ? KirType::String : (ck == 3 ? KirType::Char : KirType::Int));
        } else if (ins.op == KirOpcode::IAdd || ins.op == KirOpcode::ISub || ins.op == KirOpcode::IMul || ins.op == KirOpcode::IDiv || ins.op == KirOpcode::IMod) {
          int ty_r = 0;
          int ty_l = 0;
          if (tstack.len() > 0) { ty_r = tstack[tstack.len() - 1]; tstack.pop(); }
          if (tstack.len() > 0) { ty_l = tstack[tstack.len() - 1]; tstack.pop(); }
          int result_ty = 0;
          if (ty_l == 1 || ty_r == 1) { result_ty = 1; }
          // String + String (concat): either operand string -> string result.
          if (ins.op == KirOpcode::IAdd && (ty_l == 2 || ty_r == 2)) { result_ty = 2; }
          tstack.push(result_ty);
          rtype = result_ty == 1 ? KirType::Float : (result_ty == 2 ? KirType::String : KirType::Int);
        } else if (ins.op == KirOpcode::IEq || ins.op == KirOpcode::INe || ins.op == KirOpcode::ILt || ins.op == KirOpcode::IGt || ins.op == KirOpcode::ILe || ins.op == KirOpcode::IGe) {
          int ty_r = 0;
          int ty_l = 0;
          if (tstack.len() > 0) { ty_r = tstack[tstack.len() - 1]; tstack.pop(); }
          if (tstack.len() > 0) { ty_l = tstack[tstack.len() - 1]; tstack.pop(); }
          tstack.push(0);
          rtype = KirType::Int;
        } else if (ins.op == KirOpcode::IAnd || ins.op == KirOpcode::IOr || ins.op == KirOpcode::IXor || ins.op == KirOpcode::IShl || ins.op == KirOpcode::IShr) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = KirType::Int;
        } else if (ins.op == KirOpcode::Call) {
          int argc = ins.operands[0];
          for (int a = 0; a < argc; a = a + 1) { if (tstack.len() > 0) { tstack.pop(); } }
          tstack.push(0);
          rtype = KirType::Int;
        } else if (ins.op == KirOpcode::Ret) {
          // no change
        } else if (ins.op == KirOpcode::Br || ins.op == KirOpcode::CondBr) {
          if (ins.op == KirOpcode::CondBr) { if (tstack.len() > 0) { tstack.pop(); } }
        } else if (ins.op == KirOpcode::StructNew) {
          int fc = ins.operands[0] & 0xFFFF;
          for (int f = 0; f < fc; f = f + 1) { if (tstack.len() > 0) { tstack.pop(); } }
          tstack.push(0);
          rtype = KirType::Struct;
        } else if (ins.op == KirOpcode::FieldGet) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = KirType::Int;
        } else if (ins.op == KirOpcode::FieldSet) {
          if (tstack.len() > 1) { tstack.pop(); tstack.pop(); }
          tstack.push(0);
          rtype = KirType::Struct;
        } else if (ins.op == KirOpcode::ArrayNew) {
          int ac = ins.operands[0];
          for (int a = 0; a < ac; a = a + 1) { if (tstack.len() > 0) { tstack.pop(); } }
          tstack.push(0);
          rtype = KirType::Array;
        } else if (ins.op == KirOpcode::IndexGet) {
          if (tstack.len() > 0) { tstack.pop(); }
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = KirType::Int;
        } else if (ins.op == KirOpcode::ArrayLen) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = KirType::Int;
        } else if (ins.op == KirOpcode::EnumPayloadNew) {
          int epc = ins.operands.len() > 1 ? ins.operands[1] : 0;
          for (int p = 0; p < epc; p = p + 1) { if (tstack.len() > 0) { tstack.pop(); } }
          tstack.push(0);
          rtype = KirType::Enum;
        } else if (ins.op == KirOpcode::EnumPayloadGet) {
          if (tstack.len() > 0) { tstack.pop(); }
          tstack.push(0);
          rtype = KirType::Int;
        }
        new_instrs.push(KirInstr { ins.op, ins.operands, ins.line, ins.col, rtype });
      }
      new_blocks.push(KirBasicBlock { bb.label, new_instrs });
    }
    new_fns.push(KirFunction { kfn.name, kfn.param_count, kfn.param_names, new_blocks, kfn.return_type, kfn.fn_index });
  }
  return KirModule { new_fns };
}
