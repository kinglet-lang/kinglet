# Compiled bytecode artefacts (slow to produce, easy to regenerate)
*.kbc

# Scratch files used during local development
tmp_*.kl
tmp_*.kbc
err.log

# Editor / agent state
.claude/

# Smoke / scratch drivers (underscore prefix = excluded from suite)
codegen/_*.kl

# backend/vm build output
backend/vm/out/

# CI bootstrap checkout (scripts/ci)
bootstrap/
.cli_kbc_compile.err
.kinglet_build.err

# Build cache and artefacts (ADR 0014 Klos)
.kinglet/

# Root symlink to .kinglet/out/compiler.kbc (created by kinglet build)
compiler.kbc
