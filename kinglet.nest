project "kinglet" version "0.1.0"

modules {
  lexer.token           = "lexer/token.kl"
  lexer.keywords        = "lexer/keywords.kl"
  lexer.scanner         = "lexer/scanner.kl"
  parser.ast             = "parser/ast.kl"
  parser.helpers         = "parser/helpers.kl"
  parser.expressions     = "parser/expressions.kl"
  parser          = "parser/parser.kl"
  compiler.bytecode        = "compiler/bytecode.kl"
  compiler.compiler_state  = "compiler/compiler_state.kl"
  compiler.codegen         = "compiler/codegen.kl"
  compiler.project_config  = "compiler/project_config.kl"
  compiler        = "compiler/compiler.kl"
  compiler.disasm          = "compiler/disasm.kl"
  compiler.ll_emit         = "compiler/ll_emit.kl"
  checker         = "checker/checker.kl"
  core.ast_printer     = "core/ast_printer.kl"
  core.checker_driver  = "core/checker_driver.kl"
  core.main            = "core/main.kl"
  stdlib.manifest        = "stdlib/manifest.kl"
  io              = "stdlib/io/io.kl"
  fs              = "stdlib/fs/fs.kl"
  sys             = "stdlib/sys/sys.kl"
  stdlib.math            = "stdlib/math/math.kl"
  stdlib.map             = "stdlib/map/map.kl"
  stdlib.algorithms      = "stdlib/algorithms/algorithms.kl"
  ir.ir              = "ir/ir.kl"
  ir.ir_print        = "ir/ir_print.kl"
  ir.ir_emit         = "ir/ir_emit.kl"
}

build {
  default = "core.main"
  backend = native
  cache   = ".kinglet/cache"
  out     = ".kinglet/out"
}
