(program
  (function int compute (params (int a) (int b))
    (block
      (return
        (binary -
          (binary *
            (binary +
              (identifier a)
              (identifier b))
            (int-literal 2))
          (binary /
            (identifier a)
            (identifier b))))))
  (function bool check (params (int n))
    (block
      (return
        (binary ||
          (binary &&
            (binary >
              (identifier n)
              (int-literal 0))
            (binary <
              (identifier n)
              (int-literal 100)))
          (binary ==
            (identifier n)
            (unary -
              (int-literal 1)))))))
  (function int main (params)
    (block
      (var type=int name=z
        (call
          (identifier compute)
          (int-literal 3)
          (int-literal 4)))
      (var type=bool name=ok
        (call
          (identifier check)
          (identifier z)))
      (return
        (identifier z)))))
