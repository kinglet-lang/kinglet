(program
  (struct Point
    (int x)
    (int y))
  (enum Shape
    Circle(int)
    Rect(int, int)
    Empty)
  (function int main (params)
    (block
      (var type=Point name=p
        (struct-literal Point
          (field 
            (int-literal 1))
          (field 
            (int-literal 2))))
      (var type=Shape name=s
        (call
          (namespace-access Shape::Rect)
          (int-literal 3)
          (int-literal 4)))
      (var type=int name=sum
        (binary +
          (field-access .x
            (identifier p))
          (field-access .y
            (identifier p))))
      (return
        (identifier sum)))))
