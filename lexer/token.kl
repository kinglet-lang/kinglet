pub enum TokenType {
  // keywords
  Auto, Int, Float, Double, Bool, String, Void, Byte,
  Const,
  Return, If, Else, For, While, Break, Continue, Guard,
  Match, Let, When,
  Pub, Import, Export, Namespace, Using,
  Struct, Enum, Trait, Impl, Self_,
  Spawn, Select,
  True, False, Null_,

  // operators
  Plus, Minus, Star, Slash, Percent,
  Equal, EqualEqual, BangEqual,
  Less, Greater, LessEqual, GreaterEqual,
  AmpAmp, PipePipe, Bang,
  Amp, Pipe, Caret, Tilde, LessLess, GreaterGreater, PipeGreater,
  Arrow, FatArrow, Question, ColonColon, Dot, DotDot, DotDotDot,
  PlusEqual, MinusEqual, StarEqual, SlashEqual,

  // delimiters
  LeftParen, RightParen,
  LeftBrace, RightBrace,
  LeftBracket, RightBracket,
  Comma, Semicolon, Colon,

  // literals
  Integer, FloatLit, StringLit, CharLit,

  // identifier
  Identifier,

  // special
  Eof,
  Error,
}

pub struct Token {
  TokenType type;
  string lexeme;
  int line;
  int col;
  int int_value;
  float float_value;
}
