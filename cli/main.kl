using io;
using fs;
using sys;

import "../lexer/token.kl" { Token, TokenType }
import "../lexer/scanner.kl" { scan }
import "../lexer/keywords.kl" { KeywordEntry, all_keywords }

string tt_name(TokenType t) {
  KeywordEntry[] kws = all_keywords();
  for (int i = 0; i < kws.len(); i = i + 1) {
    if (kws[i].type == t) {
      return kws[i].display;
    }
  }
  return "Error";
}

// Re-escape control chars and quotes so that printing a token's string_value
// stays a single readable line for golden diffing.
string display_string(string s) {
  string out = "";
  int i = 0;
  while (i < s.len()) {
    string c = s.slice(i, i + 1);
    if      (c == "\n") { out = out + "\\n"; }
    else if (c == "\r") { out = out + "\\r"; }
    else if (c == "\t") { out = out + "\\t"; }
    else if (c == "\\") { out = out + "\\\\"; }
    else if (c == "\"") { out = out + "\\\""; }
    else if (c == "\0") { out = out + "\\0"; }
    else                 { out = out + c; }
    i = i + 1;
  }
  return out;
}

void print_token(Token t) {
  string name = tt_name(t.type);
  if (t.type == TokenType::Integer || t.type == TokenType::CharLit) {
    io::out.line("{}:{} {} {} {}", t.line, t.col, name, t.lexeme, t.int_value);
  } else if (t.type == TokenType::FloatLit) {
    io::out.line("{}:{} {} {} {}", t.line, t.col, name, t.lexeme, t.float_value);
  } else if (t.type == TokenType::StringLit) {
    io::out.line("{}:{} {} {} {}", t.line, t.col, name, t.lexeme, display_string(t.string_value));
  } else if (t.type == TokenType::Eof) {
    io::out.line("{}:{} {}", t.line, t.col, name);
  } else if (t.type == TokenType::Error) {
    io::out.line("{}:{} {} {}", t.line, t.col, name, t.lexeme);
  } else {
    io::out.line("{}:{} {} {}", t.line, t.col, name, t.lexeme);
  }
}

int main() {
  string[] argv = sys::args();
  if (argv.len() < 1) {
    io::err.line("usage: kinglet cli/main.kl <source.kl>");
    return 64;
  }
  string path = argv[0];
  string source = fs::__read(path);
  if (source == null) {
    io::err.line("cannot read file: {}", path);
    return 66;
  }

  Token[] tokens = scan(source);
  bool had_error = false;
  for (int i = 0; i < tokens.len(); i = i + 1) {
    Token t = tokens[i];
    print_token(t);
    if (t.type == TokenType::Error) { had_error = true; }
  }
  if (had_error) { return 65; }
  return 0;
}
