using io;
using fs;
using sys;

import "../lexer/scanner.kl" { scan }
import "../lexer/keywords.kl" { KeywordEntry, all_keywords }
import "../parser/parser.kl"
import "../compiler/compiler.kl"
import "../compiler/disasm.kl"
import "../compiler/bytecode.kl"

// AST type definitions are duplicated here from parser/ast.kl so that the
// entry-module pre-pass in the bootstrap typechecker registers stubs
// before resolving variant param types — without that, recursive Expr /
// Stmt / Decl variant params silently resolve to Void when imported,
// breaking `Expr::Unary(let _, let r, ...) => ...` style destructuring.
// The runtime matches enum variants by enum-name + variant-name across
// modules, so values built inside parser.kl line up with these mirror
// definitions.

enum BinaryOp {
  Add, Sub, Mul, Div, Mod,
  Eq, Neq, Lt, Gt, Le, Ge,
  And, Or,
  BitAnd, BitOr, BitXor, Shl, Shr,
}

enum UnaryOp { Neg, Not, BitNot, }

enum AssignOp { Assign, AddAssign, SubAssign, MulAssign, DivAssign, }

struct TypeExpr {
  string name;
  string[] type_args;
}

enum Expr {
  IntLit(int, int, int),
  FloatLit(float, int, int),
  StringLit(string, int, int),
  BoolLit(bool, int, int),
  Ident(string, int, int),
  Unary(UnaryOp, Expr, int, int),
  Binary(Expr, BinaryOp, Expr, int, int),
  Assign(string, AssignOp, Expr, int, int),
  Call(Expr, TypeExpr[], Expr[], int, int),
  BindingPat(string, int, int),
  ArrayPat(Expr[], int, int),
  EnumPat(string, string, Expr[], int, int),
  Match(Expr, MatchArm[], int, int),
  Cast(TypeExpr, Expr, int, int),
  NsAccess(string, string, int, int),
  FieldAccess(Expr, string, int, int),
  Index(Expr, Expr, int, int),
  StructLit(TypeExpr, FieldInit[], int, int),
  ArrayLit(Expr[], int, int),
  NullCoalesce(Expr, string, Expr, int, int),
  TryExpr(Expr, int, int),
  None,
}

struct MatchArm {
  Expr pattern;
  Expr guard_expr;
  Expr body;
}

struct FieldInit {
  string name;
  Expr value;
}

struct Parameter {
  TypeExpr type;
  string name;
}

enum Stmt {
  ExprStmt(Expr, int, int),
  ReturnStmt(Expr, int, int),
  VarDecl(string, TypeExpr, string, Expr, int, int),
  Block(Stmt[], int, int),
  If(Expr, Stmt, Stmt, int, int),
  Guard(Expr, Stmt, int, int),
  While(Expr, Stmt, int, int),
  For(Stmt, Expr, Stmt, Stmt, int, int),
  Break(int, int),
  Continue(int, int),
  None,
}

struct FieldDef {
  TypeExpr type;
  string name;
}

struct EnumVariant {
  string name;
  TypeExpr[] param_types;
}

struct TraitMethod {
  TypeExpr return_type;
  string name;
  Parameter[] params;
}

enum Decl {
  FunctionDecl(string, TypeExpr, string[], Parameter[], Stmt, bool, int, int),
  StructDecl(string, string[], FieldDef[], bool, int, int),
  EnumDecl(string, EnumVariant[], bool, int, int),
  ImportDecl(string, string, string[], int, int),
  UsingDecl(string, bool, int, int),
  TraitDecl(string, TraitMethod[], bool, int, int),
  ImplDecl(string, string, Decl[], bool, int, int),
  TopLevelStmt(Stmt, int, int),
}

struct Program {
  Decl[] declarations;
}

// --- token printer (existing --tokens / default behaviour) -----------------

string tt_name(TokenType t) {
  KeywordEntry[] kws = all_keywords();
  for (int i = 0; i < kws.len(); i = i + 1) {
    if (kws[i].type == t) {
      return kws[i].display;
    }
  }
  return "Error";
}

// Re-escape control chars and quotes so that printing a token's string_value
// stays a single readable line for golden diffing.
string display_string(string s) {
  string out = "";
  int i = 0;
  while (i < s.len()) {
    string c = s.slice(i, i + 1);
    if      (c == "\n") { out = out + "\\n"; }
    else if (c == "\r") { out = out + "\\r"; }
    else if (c == "\t") { out = out + "\\t"; }
    else if (c == "\\") { out = out + "\\\\"; }
    else if (c == "\"") { out = out + "\\\""; }
    else if (c == "\0") { out = out + "\\0"; }
    else                 { out = out + c; }
    i = i + 1;
  }
  return out;
}

void print_token(Token t) {
  string name = tt_name(t.type);
  if (t.type == TokenType::Integer || t.type == TokenType::CharLit) {
    io::out.line("{}:{} {} {} {}", t.line, t.col, name, t.lexeme, t.int_value);
  } else if (t.type == TokenType::FloatLit) {
    io::out.line("{}:{} {} {} {}", t.line, t.col, name, t.lexeme, t.float_value);
  } else if (t.type == TokenType::StringLit) {
    io::out.line("{}:{} {} {} {}", t.line, t.col, name, t.lexeme, display_string(t.string_value));
  } else if (t.type == TokenType::Eof) {
    io::out.line("{}:{} {}", t.line, t.col, name);
  } else if (t.type == TokenType::Error) {
    io::out.line("{}:{} {} {}", t.line, t.col, name, t.lexeme);
  } else {
    io::out.line("{}:{} {} {}", t.line, t.col, name, t.lexeme);
  }
}

int run_tokens(string source) {
  Token[] tokens = scan(source);
  bool had_error = false;
  for (int i = 0; i < tokens.len(); i = i + 1) {
    Token t = tokens[i];
    print_token(t);
    if (t.type == TokenType::Error) { had_error = true; }
  }
  if (had_error) { return 65; }
  return 0;
}

// --- ast printer (--ast flag) ---------------------------------------------

string indent_str(int depth) {
  string s = "";
  int i = 0;
  while (i < depth) { s = s + "  "; i = i + 1; }
  return s;
}

string binary_op_name(BinaryOp op) {
  return op match {
    BinaryOp::Add    => "+",
    BinaryOp::Sub    => "-",
    BinaryOp::Mul    => "*",
    BinaryOp::Div    => "/",
    BinaryOp::Mod    => "%",
    BinaryOp::Eq     => "==",
    BinaryOp::Neq    => "!=",
    BinaryOp::Lt     => "<",
    BinaryOp::Gt     => ">",
    BinaryOp::Le     => "<=",
    BinaryOp::Ge     => ">=",
    BinaryOp::And    => "&&",
    BinaryOp::Or     => "||",
    BinaryOp::BitAnd => "&",
    BinaryOp::BitOr  => "|",
    BinaryOp::BitXor => "^",
    BinaryOp::Shl    => "<<",
    BinaryOp::Shr    => ">>",
  };
}

string unary_op_name(UnaryOp op) {
  return op match {
    UnaryOp::Neg    => "-",
    UnaryOp::Not    => "!",
    UnaryOp::BitNot => "~",
  };
}

string assign_op_name(AssignOp op) {
  return op match {
    AssignOp::Assign    => "=",
    AssignOp::AddAssign => "+=",
    AssignOp::SubAssign => "-=",
    AssignOp::MulAssign => "*=",
    AssignOp::DivAssign => "/=",
  };
}

string type_name(TypeExpr t) {
  string s = t.name;
  if (t.type_args.len() > 0) {
    s = s + "<";
    for (int i = 0; i < t.type_args.len(); i = i + 1) {
      if (i > 0) { s = s + ","; }
      s = s + t.type_args[i];
    }
    s = s + ">";
  }
  return s;
}

void print_expr(Expr e, int depth) {
  string pad = indent_str(depth);
  e match {
    Expr::IntLit(let v, let _l, let _c)    => io::out.line("{}IntLit {}", pad, v),
    Expr::FloatLit(let v, let _l, let _c)  => io::out.line("{}FloatLit {}", pad, v),
    Expr::StringLit(let v, let _l, let _c) => io::out.line("{}StringLit \"{}\"", pad, display_string(v)),
    Expr::BoolLit(let v, let _l, let _c)   => io::out.line("{}BoolLit {}", pad, v),
    Expr::Ident(let n, let _l, let _c)     => io::out.line("{}Ident {}", pad, n),
    Expr::Unary(let op, let r, let _l, let _c) => print_unary(op, r, depth),
    Expr::Binary(let l, let op, let r, let _l, let _c) => print_binary(l, op, r, depth),
    Expr::Assign(let n, let op, let v, let _l, let _c) => print_assign(n, op, v, depth),
    Expr::Call(let callee, let _ta, let args, let _l, let _c) => print_call(callee, args, depth),
    Expr::BindingPat(let n, let _l, let _c) => io::out.line("{}BindingPat {}", pad, n),
    Expr::ArrayPat(let elems, let _l, let _c) => print_array_pat(elems, depth),
    Expr::EnumPat(let en, let v, let fields, let _l, let _c) => print_enum_pat(en, v, fields, depth),
    Expr::Match(let v, let arms, let _l, let _c) => print_match(v, arms, depth),
    Expr::Cast(let t, let v, let _l, let _c) => print_cast(t, v, depth),
    Expr::NullCoalesce(let left, let eb, let right, let _l, let _c) => print_coalesce(left, eb, right, depth),
    Expr::TryExpr(let value, let _l, let _c) => print_try(value, depth),
    Expr::NsAccess(let ns, let m, let _l, let _c) => io::out.line("{}NsAccess {}::{}", pad, ns, m),
    Expr::FieldAccess(let o, let f, let _l, let _c) => print_field_access(o, f, depth),
    Expr::Index(let o, let i, let _l, let _c) => print_index(o, i, depth),
    Expr::StructLit(let t, let fields, let _l, let _c) => print_struct_lit(t, fields, depth),
    Expr::ArrayLit(let elems, let _l, let _c) => print_array_lit(elems, depth),
    Expr::None => io::out.line("{}None", pad),
  };
}

void print_unary(UnaryOp op, Expr r, int depth) {
  io::out.line("{}Unary {}", indent_str(depth), unary_op_name(op));
  print_expr(r, depth + 1);
}

void print_binary(Expr l, BinaryOp op, Expr r, int depth) {
  io::out.line("{}Binary {}", indent_str(depth), binary_op_name(op));
  print_expr(l, depth + 1);
  print_expr(r, depth + 1);
}

void print_assign(string n, AssignOp op, Expr v, int depth) {
  io::out.line("{}Assign {} {}", indent_str(depth), n, assign_op_name(op));
  print_expr(v, depth + 1);
}

void print_call(Expr callee, Expr[] args, int depth) {
  io::out.line("{}Call", indent_str(depth));
  print_expr(callee, depth + 1);
  for (int i = 0; i < args.len(); i = i + 1) {
    print_expr(args[i], depth + 1);
  }
}

void print_array_pat(Expr[] elems, int depth) {
  io::out.line("{}ArrayPat", indent_str(depth));
  for (int i = 0; i < elems.len(); i = i + 1) {
    print_expr(elems[i], depth + 1);
  }
}

void print_enum_pat(string en, string v, Expr[] fields, int depth) {
  io::out.line("{}EnumPat {}::{}", indent_str(depth), en, v);
  for (int i = 0; i < fields.len(); i = i + 1) {
    print_expr(fields[i], depth + 1);
  }
}

void print_match(Expr v, MatchArm[] arms, int depth) {
  io::out.line("{}Match", indent_str(depth));
  print_expr(v, depth + 1);
  for (int i = 0; i < arms.len(); i = i + 1) {
    MatchArm a = arms[i];
    io::out.line("{}Arm", indent_str(depth + 1));
    io::out.line("{}pattern", indent_str(depth + 2));
    print_expr(a.pattern, depth + 3);
    io::out.line("{}guard", indent_str(depth + 2));
    print_expr(a.guard_expr, depth + 3);
    io::out.line("{}body", indent_str(depth + 2));
    print_expr(a.body, depth + 3);
  }
}

void print_cast(TypeExpr t, Expr v, int depth) {
  io::out.line("{}Cast {}", indent_str(depth), type_name(t));
  print_expr(v, depth + 1);
}

void print_coalesce(Expr left, string err_binding, Expr right, int depth) {
  io::out.line("{}?? {}", indent_str(depth), err_binding);
  print_expr(left, depth + 1);
  print_expr(right, depth + 1);
}

void print_try(Expr value, int depth) {
  io::out.line("{}Try", indent_str(depth));
  print_expr(value, depth + 1);
}

void print_field_access(Expr o, string f, int depth) {
  io::out.line("{}FieldAccess .{}", indent_str(depth), f);
  print_expr(o, depth + 1);
}

void print_index(Expr o, Expr i, int depth) {
  io::out.line("{}Index", indent_str(depth));
  print_expr(o, depth + 1);
  print_expr(i, depth + 1);
}

void print_struct_lit(TypeExpr t, FieldInit[] fields, int depth) {
  io::out.line("{}StructLit {}", indent_str(depth), type_name(t));
  for (int i = 0; i < fields.len(); i = i + 1) {
    FieldInit fi = fields[i];
    if (fi.name.len() == 0) {
      io::out.line("{}field", indent_str(depth + 1));
    } else {
      io::out.line("{}field {}", indent_str(depth + 1), fi.name);
    }
    print_expr(fi.value, depth + 2);
  }
}

void print_array_lit(Expr[] elems, int depth) {
  io::out.line("{}ArrayLit", indent_str(depth));
  for (int i = 0; i < elems.len(); i = i + 1) {
    print_expr(elems[i], depth + 1);
  }
}

void print_stmt(Stmt s, int depth) {
  string pad = indent_str(depth);
  s match {
    Stmt::ExprStmt(let e, let _l, let _c) => print_expr_stmt(e, depth),
    Stmt::ReturnStmt(let v, let _l, let _c) => print_return(v, depth),
    Stmt::VarDecl(let stor, let t, let n, let init, let _l, let _c) => print_var_decl(stor, t, n, init, depth),
    Stmt::Block(let stmts, let _l, let _c) => print_block(stmts, depth),
    Stmt::If(let c, let th, let el, let _l, let _c) => print_if(c, th, el, depth),
    Stmt::Guard(let c, let body, let _l, let _c) => print_guard(c, body, depth),
    Stmt::While(let c, let body, let _l, let _c) => print_while(c, body, depth),
    Stmt::For(let init, let c, let step, let body, let _l, let _c) => print_for(init, c, step, body, depth),
    Stmt::Break(let _l, let _c) => io::out.line("{}Break", pad),
    Stmt::Continue(let _l, let _c) => io::out.line("{}Continue", pad),
    Stmt::None => io::out.line("{}None", pad),
  };
}

void print_expr_stmt(Expr e, int depth) {
  io::out.line("{}ExprStmt", indent_str(depth));
  print_expr(e, depth + 1);
}

void print_return(Expr v, int depth) {
  io::out.line("{}Return", indent_str(depth));
  print_expr(v, depth + 1);
}

void print_var_decl(string stor, TypeExpr t, string n, Expr init, int depth) {
  string label = "VarDecl";
  if (stor.len() > 0) { label = stor + " VarDecl"; }
  io::out.line("{}{} {} {}", indent_str(depth), label, type_name(t), n);
  print_expr(init, depth + 1);
}

void print_block(Stmt[] stmts, int depth) {
  io::out.line("{}Block", indent_str(depth));
  for (int i = 0; i < stmts.len(); i = i + 1) {
    print_stmt(stmts[i], depth + 1);
  }
}

void print_if(Expr c, Stmt th, Stmt el, int depth) {
  io::out.line("{}If", indent_str(depth));
  io::out.line("{}cond", indent_str(depth + 1));
  print_expr(c, depth + 2);
  io::out.line("{}then", indent_str(depth + 1));
  print_stmt(th, depth + 2);
  io::out.line("{}else", indent_str(depth + 1));
  print_stmt(el, depth + 2);
}

void print_guard(Expr c, Stmt body, int depth) {
  io::out.line("{}Guard", indent_str(depth));
  io::out.line("{}cond", indent_str(depth + 1));
  print_expr(c, depth + 2);
  io::out.line("{}else", indent_str(depth + 1));
  print_stmt(body, depth + 2);
}

void print_while(Expr c, Stmt body, int depth) {
  io::out.line("{}While", indent_str(depth));
  io::out.line("{}cond", indent_str(depth + 1));
  print_expr(c, depth + 2);
  io::out.line("{}body", indent_str(depth + 1));
  print_stmt(body, depth + 2);
}

void print_for(Stmt init, Expr c, Stmt step, Stmt body, int depth) {
  io::out.line("{}For", indent_str(depth));
  io::out.line("{}init", indent_str(depth + 1));
  print_stmt(init, depth + 2);
  io::out.line("{}cond", indent_str(depth + 1));
  print_expr(c, depth + 2);
  io::out.line("{}step", indent_str(depth + 1));
  print_stmt(step, depth + 2);
  io::out.line("{}body", indent_str(depth + 1));
  print_stmt(body, depth + 2);
}

void print_decl(Decl d, int depth) {
  d match {
    Decl::FunctionDecl(let n, let rt, let tps, let params, let body, let is_pub, let _l, let _c) =>
      print_function_decl(n, rt, tps, params, body, is_pub, depth),
    Decl::StructDecl(let n, let tps, let fields, let is_pub, let _l, let _c) =>
      print_struct_decl(n, tps, fields, is_pub, depth),
    Decl::EnumDecl(let n, let variants, let is_pub, let _l, let _c) =>
      print_enum_decl(n, variants, is_pub, depth),
    Decl::ImportDecl(let path, let alias, let selected, let _l, let _c) =>
      print_import_decl(path, alias, selected, depth),
    Decl::UsingDecl(let n, let is_ns, let _l, let _c) =>
      print_using_decl(n, is_ns, depth),
    Decl::TopLevelStmt(let s, let _l, let _c) =>
      print_top_level_stmt(s, depth),
  };
}

void print_top_level_stmt(Stmt s, int depth) {
  io::out.line("{}TopLevelStmt", indent_str(depth));
  print_stmt(s, depth + 1);
}

string pub_marker(bool is_pub) {
  if (is_pub) { return "pub "; }
  return "";
}

string format_type_params(string[] tps) {
  if (tps.len() == 0) { return ""; }
  string s = "<";
  for (int i = 0; i < tps.len(); i = i + 1) {
    if (i > 0) { s = s + ","; }
    s = s + tps[i];
  }
  return s + ">";
}

void print_function_decl(string n, TypeExpr rt, string[] tps, Parameter[] params, Stmt body, bool is_pub, int depth) {
  io::out.line("{}{}FunctionDecl {} {}{}", indent_str(depth), pub_marker(is_pub), type_name(rt), n, format_type_params(tps));
  for (int i = 0; i < params.len(); i = i + 1) {
    Parameter pr = params[i];
    io::out.line("{}param {} {}", indent_str(depth + 1), type_name(pr.type), pr.name);
  }
  print_stmt(body, depth + 1);
}

void print_struct_decl(string n, string[] tps, FieldDef[] fields, bool is_pub, int depth) {
  io::out.line("{}{}StructDecl {}{}", indent_str(depth), pub_marker(is_pub), n, format_type_params(tps));
  for (int i = 0; i < fields.len(); i = i + 1) {
    FieldDef fd = fields[i];
    io::out.line("{}field {} {}", indent_str(depth + 1), type_name(fd.type), fd.name);
  }
}

void print_enum_decl(string n, EnumVariant[] variants, bool is_pub, int depth) {
  io::out.line("{}{}EnumDecl {}", indent_str(depth), pub_marker(is_pub), n);
  for (int i = 0; i < variants.len(); i = i + 1) {
    EnumVariant ev = variants[i];
    io::out.line("{}variant {}", indent_str(depth + 1), ev.name);
    for (int j = 0; j < ev.param_types.len(); j = j + 1) {
      io::out.line("{}param {}", indent_str(depth + 2), type_name(ev.param_types[j]));
    }
  }
}

void print_import_decl(string path, string alias, string[] selected, int depth) {
  string pad = indent_str(depth);
  if (alias.len() > 0) {
    io::out.line("{}ImportDecl \"{}\" as {}", pad, path, alias);
  } else {
    io::out.line("{}ImportDecl \"{}\"", pad, path);
  }
  for (int i = 0; i < selected.len(); i = i + 1) {
    io::out.line("{}symbol {}", indent_str(depth + 1), selected[i]);
  }
}

void print_using_decl(string n, bool is_ns, int depth) {
  string kind = "using";
  if (is_ns) { kind = "using namespace"; }
  io::out.line("{}{} {}", indent_str(depth), kind, n);
}

int run_ast(string source) {
  Token[] tokens = scan(source);
  Parser p = parser::make_parser(tokens);
  Program prog = parser::parse_program(p);
  if (p.errors.len() > 0) {
    for (int i = 0; i < p.errors.len(); i = i + 1) {
      ParseError e = p.errors[i];
      io::err.line("{}:{}: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  io::out.line("Program");
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    print_decl(prog.declarations[i], 1);
  }
  return 0;
}


// ===== type checker =====
// --- type system ----------------------------------------------------------

pub enum TypeKind {
  Int, Float, Bool, String, Void, Unknown,
}

pub struct Type {
  TypeKind kind;
}

pub Type type_int()     => Type { TypeKind::Int };
pub Type type_float()   => Type { TypeKind::Float };
pub Type type_bool()    => Type { TypeKind::Bool };
pub Type type_string()  => Type { TypeKind::String };
pub Type type_void()    => Type { TypeKind::Void };
pub Type type_unknown() => Type { TypeKind::Unknown };

pub string type_kind_name(Type t) {
  return t.kind match {
    TypeKind::Int     => "int",
    TypeKind::Float   => "float",
    TypeKind::Bool    => "bool",
    TypeKind::String  => "string",
    TypeKind::Void    => "void",
    TypeKind::Unknown => "unknown",
  };
}

// Unknown is bidirectionally compatible so we don't cascade errors after a
// first failure has already poisoned a subexpression's type.
bool types_compatible(Type a, Type b) {
  if (a.kind == TypeKind::Unknown) { return true; }
  if (b.kind == TypeKind::Unknown) { return true; }
  return a.kind == b.kind;
}

bool is_numeric(Type t) {
  if (t.kind == TypeKind::Int) { return true; }
  if (t.kind == TypeKind::Float) { return true; }
  return false;
}

// --- scope stack & checker state ------------------------------------------

pub struct Binding {
  string name;
  Type type;
  int scope_depth;
}

pub struct CheckError {
  int line;
  int col;
  string message;
}

pub struct Checker {
  Binding[] bindings;     // flat stack across all open scopes
  int[] scope_starts;     // bindings.len() snapshot at each push_scope()
  CheckError[] errors;
  string file;
}

pub Checker make_checker(string file) {
  Binding[] b = [];
  int[] s = [];
  CheckError[] e = [];
  return Checker { b, s, e, file };
}

void push_scope(Checker c) {
  c.scope_starts.push(c.bindings.len());
}

void pop_scope(Checker c) {
  if (c.scope_starts.len() == 0) { return; }
  int start = c.scope_starts[c.scope_starts.len() - 1];
  c.scope_starts.pop();
  while (c.bindings.len() > start) {
    c.bindings.pop();
  }
}

int current_scope_start(Checker c) {
  if (c.scope_starts.len() == 0) { return 0; }
  return c.scope_starts[c.scope_starts.len() - 1];
}

void add_error(Checker c, int line, int col, string msg) {
  CheckError e = CheckError { line, col, msg };
  c.errors.push(e);
}

void declare_var(Checker c, string name, Type t, int line, int col) {
  int start = current_scope_start(c);
  for (int i = start; i < c.bindings.len(); i = i + 1) {
    if (c.bindings[i].name == name) {
      add_error(c, line, col, "Variable '" + name + "' already declared in this scope.");
      return;
    }
  }
  Binding b = Binding { name, t, c.scope_starts.len() };
  c.bindings.push(b);
}

bool var_exists(Checker c, string name) {
  int i = c.bindings.len() - 1;
  while (i >= 0) {
    if (c.bindings[i].name == name) { return true; }
    i = i - 1;
  }
  return false;
}

Type lookup_var(Checker c, string name) {
  int i = c.bindings.len() - 1;
  while (i >= 0) {
    if (c.bindings[i].name == name) { return c.bindings[i].type; }
    i = i - 1;
  }
  return type_unknown();
}

// --- type-expression resolution ------------------------------------------

bool is_auto_type(TypeExpr t) {
  if (t.type_args.len() != 0) { return false; }
  return t.name == "auto";
}

Type resolve_type_expr(TypeExpr t) {
  if (t.type_args.len() != 0) { return type_unknown(); }
  if (t.name == "int")    { return type_int(); }
  if (t.name == "auto")   { return type_unknown(); }  // resolved by check_var_decl from initializer
  if (t.name == "float")  { return type_float(); }
  if (t.name == "double") { return type_float(); }
  if (t.name == "bool")   { return type_bool(); }
  if (t.name == "string") { return type_string(); }
  if (t.name == "void")   { return type_void(); }
  return type_unknown();
}

// --- binary-op classification --------------------------------------------

bool is_arithmetic_op(BinaryOp op) {
  return op match {
    BinaryOp::Add => true,
    BinaryOp::Sub => true,
    BinaryOp::Mul => true,
    BinaryOp::Div => true,
    BinaryOp::Mod => true,
    _ => false,
  };
}

bool is_comparison_op(BinaryOp op) {
  return op match {
    BinaryOp::Eq  => true,
    BinaryOp::Neq => true,
    BinaryOp::Lt  => true,
    BinaryOp::Gt  => true,
    BinaryOp::Le  => true,
    BinaryOp::Ge  => true,
    _ => false,
  };
}

bool is_logical_op(BinaryOp op) {
  return op match {
    BinaryOp::And => true,
    BinaryOp::Or  => true,
    _ => false,
  };
}

bool is_bitwise_op(BinaryOp op) {
  return op match {
    BinaryOp::BitAnd => true,
    BinaryOp::BitOr  => true,
    BinaryOp::BitXor => true,
    BinaryOp::Shl    => true,
    BinaryOp::Shr    => true,
    _ => false,
  };
}

bool op_is_add(BinaryOp op) {
  return op match { BinaryOp::Add => true, _ => false, };
}

// --- expression checking --------------------------------------------------

Type check_expr(Checker c, Expr e) {
  return e match {
    Expr::IntLit(let _v, let _l, let _co)    => type_int(),
    Expr::FloatLit(let _v, let _l, let _co)  => type_float(),
    Expr::StringLit(let _v, let _l, let _co) => type_string(),
    Expr::BoolLit(let _v, let _l, let _co)   => type_bool(),
    Expr::Ident(let n, let l, let co)        => check_ident(c, n, l, co),
    Expr::Unary(let op, let r, let l, let co) => check_unary(c, op, r, l, co),
    Expr::Binary(let lhs, let op, let rhs, let l, let co) => check_binary(c, lhs, op, rhs, l, co),
    Expr::Assign(let n, let op, let v, let l, let co)     => check_assign(c, n, op, v, l, co),
    _ => type_unknown(),
  };
}

Type check_ident(Checker c, string name, int line, int col) {
  if (name == "null") { return type_unknown(); }
  if (!var_exists(c, name)) {
    add_error(c, line, col, "Undeclared variable '" + name + "'.");
    return type_unknown();
  }
  return lookup_var(c, name);
}

Type check_unary(Checker c, UnaryOp op, Expr r, int line, int col) {
  Type rt = check_expr(c, r);
  return op match {
    UnaryOp::Neg    => check_neg(c, rt, line, col),
    UnaryOp::Not    => type_bool(),
    UnaryOp::BitNot => check_bitnot(c, rt, line, col),
  };
}

Type check_neg(Checker c, Type rt, int line, int col) {
  if (rt.kind == TypeKind::Unknown) { return type_int(); }
  if (is_numeric(rt)) { return rt; }
  add_error(c, line, col, "Cannot negate non-numeric type '" + type_kind_name(rt) + "'.");
  return type_int();
}

Type check_bitnot(Checker c, Type rt, int line, int col) {
  if (rt.kind == TypeKind::Unknown) { return type_int(); }
  if (rt.kind != TypeKind::Int) {
    add_error(c, line, col, "Bitwise NOT requires an integer operand, got '" + type_kind_name(rt) + "'.");
  }
  return type_int();
}

Type check_binary(Checker c, Expr lhs, BinaryOp op, Expr rhs, int line, int col) {
  Type l = check_expr(c, lhs);
  Type r = check_expr(c, rhs);
  if (is_arithmetic_op(op)) { return check_arithmetic(c, op, l, r, line, col); }
  if (is_comparison_op(op)) { return check_comparison(c, l, r, line, col); }
  if (is_logical_op(op))    { return type_bool(); }
  if (is_bitwise_op(op))    { return check_bitwise(c, l, r, line, col); }
  return type_unknown();
}

Type check_arithmetic(Checker c, BinaryOp op, Type l, Type r, int line, int col) {
  if (op_is_add(op) && (l.kind == TypeKind::String || r.kind == TypeKind::String)) {
    return type_string();
  }
  if (l.kind == TypeKind::Unknown || r.kind == TypeKind::Unknown) { return type_int(); }
  if (!is_numeric(l) || !is_numeric(r)) {
    add_error(c, line, col,
      "Arithmetic operands must be numeric, got '" + type_kind_name(l) + "' and '" + type_kind_name(r) + "'.");
    return type_int();
  }
  if (l.kind == TypeKind::Float || r.kind == TypeKind::Float) { return type_float(); }
  return type_int();
}

Type check_comparison(Checker c, Type l, Type r, int line, int col) {
  if (!types_compatible(l, r)) {
    add_error(c, line, col,
      "Cannot compare '" + type_kind_name(l) + "' and '" + type_kind_name(r) + "'.");
  }
  return type_bool();
}

Type check_bitwise(Checker c, Type l, Type r, int line, int col) {
  if (l.kind == TypeKind::Unknown || r.kind == TypeKind::Unknown) { return type_int(); }
  if (l.kind != TypeKind::Int || r.kind != TypeKind::Int) {
    add_error(c, line, col,
      "Bitwise operators require integer operands, got '" + type_kind_name(l) + "' and '" + type_kind_name(r) + "'.");
  }
  return type_int();
}

Type check_assign(Checker c, string name, AssignOp op, Expr value, int line, int col) {
  Type vt = check_expr(c, value);
  if (!var_exists(c, name)) {
    add_error(c, line, col, "Undeclared variable '" + name + "'.");
    return vt;
  }
  Type target = lookup_var(c, name);
  bool is_plain = op match { AssignOp::Assign => true, _ => false, };
  if (is_plain) {
    if (!types_compatible(vt, target)) {
      add_error(c, line, col,
        "Cannot assign '" + type_kind_name(vt) + "' to variable '" + name + "' of type '" + type_kind_name(target) + "'.");
    }
  } else {
    bool is_add = op match { AssignOp::AddAssign => true, _ => false, };
    if (is_add && target.kind == TypeKind::String && vt.kind == TypeKind::String) {
      // string += string OK
    } else if (!is_numeric(target) || !is_numeric(vt)) {
      add_error(c, line, col,
        "Compound assignment requires numeric operands, got '" +
        type_kind_name(target) + "' and '" + type_kind_name(vt) + "'.");
    }
  }
  return target;
}

// --- statement checking ---------------------------------------------------

void check_stmt(Checker c, Stmt s) {
  s match {
    Stmt::ExprStmt(let e, let _l, let _co)         => check_expr_stmt(c, e),
    Stmt::ReturnStmt(let v, let _l, let _co)       => check_return(c, v),
    Stmt::VarDecl(let _stor, let t, let n, let init, let l, let co) => check_var_decl(c, t, n, init, l, co),
    Stmt::Block(let stmts, let _l, let _co)        => check_block(c, stmts),
    Stmt::If(let cond, let th, let el, let l, let co) => check_if(c, cond, th, el, l, co),
    Stmt::Guard(let cond, let body, let _l, let _co)  => check_guard(c, cond, body),
    Stmt::While(let cond, let body, let _l, let _co)  => check_while(c, cond, body),
    Stmt::For(let init, let cond, let step, let body, let _l, let _co) => check_for(c, init, cond, step, body),
    Stmt::Break(let _l, let _co)    => check_void(),
    Stmt::Continue(let _l, let _co) => check_void(),
    Stmt::None                       => check_void(),
  };
}

void check_void() { return; }

void check_expr_stmt(Checker c, Expr e) {
  Type _t = check_expr(c, e);
}

void check_return(Checker c, Expr v) {
  v match {
    Expr::None => check_void(),
    _ => check_expr_stmt(c, v),
  };
}

void check_var_decl(Checker c, TypeExpr t, string n, Expr init, int line, int col) {
  Type declared = resolve_type_expr(t);
  bool auto_typed = is_auto_type(t);
  Type final_type = declared;
  bool has_init = init match { Expr::None => false, _ => true, };
  if (auto_typed && !has_init) {
    add_error(c, line, col, "Auto variable '" + n + "' requires an initializer.");
    declare_var(c, n, type_unknown(), line, col);
    return;
  }
  if (has_init) {
    Type init_type = check_expr(c, init);
    if (auto_typed) {
      final_type = init_type;
    } else if (!types_compatible(init_type, declared)) {
      add_error(c, line, col,
        "Cannot assign '" + type_kind_name(init_type) + "' to variable '" + n + "' of type '" + type_kind_name(declared) + "'.");
    }
  }
  declare_var(c, n, final_type, line, col);
}

void check_block(Checker c, Stmt[] stmts) {
  push_scope(c);
  for (int i = 0; i < stmts.len(); i = i + 1) {
    check_stmt(c, stmts[i]);
  }
  pop_scope(c);
}

void check_if(Checker c, Expr cond, Stmt th, Stmt el, int line, int col) {
  Type ct = check_expr(c, cond);
  if (ct.kind != TypeKind::Bool && ct.kind != TypeKind::Int && ct.kind != TypeKind::Unknown) {
    add_error(c, line, col, "If condition must be 'bool', got '" + type_kind_name(ct) + "'.");
  }
  Type then_type = branch_result_type(c, th);
  Type else_type = branch_result_type(c, el);
  bool has_then_value = then_type.kind != TypeKind::Void;
  bool has_else_value = else_type.kind != TypeKind::Void;
  if (has_then_value && has_else_value && !types_compatible(then_type, else_type)) {
    add_error(c, line, col,
      "If branches have incompatible types: '" + type_kind_name(then_type) + "' vs '" + type_kind_name(else_type) + "'.");
  }
}

// Branch types: a Block returns the type of its trailing ExprStmt (or void),
// any other Stmt is checked for side effects and contributes void.
Type branch_result_type(Checker c, Stmt s) {
  return s match {
    Stmt::Block(let stmts, let _l, let _co) => block_result_type(c, stmts),
    Stmt::None                               => type_void(),
    _ => check_stmt_void(c, s),
  };
}

Type check_stmt_void(Checker c, Stmt s) {
  check_stmt(c, s);
  return type_void();
}

Type block_result_type(Checker c, Stmt[] stmts) {
  push_scope(c);
  Type last = type_void();
  for (int i = 0; i < stmts.len(); i = i + 1) {
    Stmt s = stmts[i];
    bool is_tail = i == stmts.len() - 1;
    if (is_tail) {
      last = s match {
        Stmt::ExprStmt(let e, let _l, let _co) => check_expr(c, e),
        _ => check_stmt_void(c, s),
      };
    } else {
      check_stmt(c, s);
    }
  }
  pop_scope(c);
  return last;
}

void check_guard(Checker c, Expr cond, Stmt body) {
  Type _ct = check_expr(c, cond);
  check_stmt(c, body);
}

void check_while(Checker c, Expr cond, Stmt body) {
  Type _ct = check_expr(c, cond);
  check_stmt(c, body);
}

void check_for(Checker c, Stmt init, Expr cond, Stmt step, Stmt body) {
  push_scope(c);
  check_stmt(c, init);
  Type _ct = check_expr(c, cond);
  check_stmt(c, step);
  check_stmt(c, body);
  pop_scope(c);
}

// --- declaration checking -------------------------------------------------

void register_decl(Checker c, Decl d) {
  d match {
    Decl::FunctionDecl(let n, let rt, let _tps, let _params, let _body, let _is_pub, let line, let col) =>
      register_function(c, n, rt, line, col),
    _ => check_void(),
  };
}

void register_function(Checker c, string n, TypeExpr rt, int line, int col) {
  Type t = resolve_type_expr(rt);
  declare_var(c, n, t, line, col);
}

void check_decl(Checker c, Decl d) {
  d match {
    Decl::FunctionDecl(let _n, let _rt, let _tps, let params, let body, let _is_pub, let _l, let _co) =>
      check_function(c, params, body),
    Decl::TopLevelStmt(let s, let _l, let _co) => check_stmt(c, s),
    _ => check_void(),
  };
}

void check_function(Checker c, Parameter[] params, Stmt body) {
  push_scope(c);
  for (int i = 0; i < params.len(); i = i + 1) {
    Parameter p = params[i];
    Type pt = resolve_type_expr(p.type);
    declare_var(c, p.name, pt, 0, 0);
  }
  check_stmt(c, body);
  pop_scope(c);
}

pub int check_program(Checker c, Program prog) {
  push_scope(c);
  // Pre-pass: register top-level function names so call-sites resolve in
  // any order. Body checking happens afterwards.
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    register_decl(c, prog.declarations[i]);
  }
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    check_decl(c, prog.declarations[i]);
  }
  pop_scope(c);
  return c.errors.len();
}

pub int run_checker(Program prog) {
  Checker c = make_checker("check");
  int err_count = check_program(c, prog);
  for (int i = 0; i < c.errors.len(); i = i + 1) {
    CheckError e = c.errors[i];
    io::err.line("{}:{}: {}", e.line, e.col, e.message);
  }
  return err_count;
}

int run_check(string source) {
  Token[] tokens = scan(source);
  Parser p = parser::make_parser(tokens);
  Program prog = parser::parse_program(p);
  if (p.errors.len() > 0) {
    for (int i = 0; i < p.errors.len(); i = i + 1) {
      ParseError e = p.errors[i];
      io::err.line("{}:{}: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  int err_count = run_checker(prog);
  if (err_count > 0) {
    io::err.line("{} type error(s)", err_count);
    return 65;
  }
  io::out.line("OK: no type errors");
  return 0;
}

int run_bytecode(string source, string path) {
  Token[] tokens = scan(source);
  Parser p = parser::make_parser(tokens);
  Program prog = parser::parse_program(p);
  if (p.errors.len() > 0) {
    for (int i = 0; i < p.errors.len(); i = i + 1) {
      ParseError e = p.errors[i];
      io::err.line("{}:{}: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  Compiler co = compiler::make_compiler();
  int errs = compiler::compile_program(co, prog, path);
  if (errs > 0) {
    for (int i = 0; i < co.errors.len(); i = i + 1) {
      CompileError e = co.errors[i];
      io::err.line("{}:{}: compile error: {}", e.line, e.col, e.message);
    }
    return 65;
  }
  string out = disasm::disassemble(co.chunk);
  io::out(out);
  return 0;
}

int main() {
  string[] argv = sys::args();
  if (argv.len() < 1) {
    io::err.line("usage: kinglet cli/main.kl [--ast | --check | --bytecode] <source.kl>");
    return 64;
  }
  bool dump_ast = false;
  bool do_check = false;
  bool dump_bc = false;
  string path = "";
  for (int i = 0; i < argv.len(); i = i + 1) {
    if (argv[i] == "--ast") {
      dump_ast = true;
    } else if (argv[i] == "--check") {
      do_check = true;
    } else if (argv[i] == "--bytecode") {
      dump_bc = true;
    } else {
      path = argv[i];
    }
  }
  if (path.len() == 0) {
    io::err.line("usage: kinglet cli/main.kl [--ast | --check | --bytecode] <source.kl>");
    return 64;
  }
  string source = fs::__read(path);
  if (source == null) {
    io::err.line("cannot read file: {}", path);
    return 66;
  }
  if (dump_ast) {
    return run_ast(source);
  }
  if (do_check) {
    return run_check(source);
  }
  if (dump_bc) {
    return run_bytecode(source, path);
  }
  return run_tokens(source);
}
