#!/usr/bin/env bash
# Kinglet project driver (ADR 0014 M0).
#
#   ./kinglet build [--quiet] [--backend native]   Build toolchain artefact
#   ./kinglet ...               Pass through to bootstrap kinglet (VM host)

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_SH="$ROOT/scripts/build/kinglet-build.sh"

pass_through() {
  # shellcheck source=tests/common.sh
  source "$ROOT/tests/common.sh"
  local bootstrap
  bootstrap=$(resolve_bootstrap "$ROOT") || exit 2
  exec "$bootstrap" "$@"
}

case "${1:-}" in
  build)
    shift
    exec bash "$BUILD_SH" "$@"
    ;;
  native)
    shift
    pass_through --backend native "$@"
    ;;
  help|--help|-h)
    cat <<EOF
Usage: kinglet build [--quiet] [--backend native]
       kinglet native -o <out> <file.kl>
       kinglet <bootstrap-args...>

  build   Compile [build].root via Ref compiler; cache in .kinglet/
  native  Shorthand for bootstrap --backend native -o ...
  other   Forwarded to bootstrap kinglet (set KINGLET_BOOTSTRAP to override)

See decisions/0014-compilation-toolchain-architecture.md
EOF
    ;;
  "")
    pass_through
    ;;
  *)
    pass_through "$@"
    ;;
esac
