#!/usr/bin/env bash
# Kinglet project driver (ADR 0014).
#
# User-facing commands are implemented by the bootstrap kinglet binary:
#   init, build, run, <file.kl>, --version, --help
# Dev-only workflows stay in scripts/build/:
#   prove, debug emit-kbc

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROVE_SH="$ROOT/scripts/build/prove.sh"
DEBUG_EMIT_KBC_SH="$ROOT/scripts/build/debug-emit-kbc.sh"

pass_through() {
  # shellcheck source=tests/common.sh
  source "$ROOT/tests/common.sh"
  local bootstrap
  bootstrap=$(resolve_bootstrap "$ROOT") || exit 2
  exec "$bootstrap" "$@"
}

case "${1:-}" in
  prove)
    shift
    exec bash "$PROVE_SH" "$@"
    ;;
  debug)
    shift
    case "${1:-}" in
      emit-kbc)
        shift
        exec bash "$DEBUG_EMIT_KBC_SH" "$@"
        ;;
      *)
        echo "Usage: kinglet debug emit-kbc [--shadow] <out.kbc> <src.kl>" >&2
        exit 2
        ;;
    esac
    ;;
  native)
    shift
    pass_through --backend native "$@"
    ;;
  "")
    pass_through
    ;;
  *)
    pass_through "$@"
    ;;
esac
