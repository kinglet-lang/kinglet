export module compiler.bytecode;
using fs;

// Bytecode data definitions — Kinglet mirror of kinglet-bootstrap/src/vm/chunk.h.
//
// Pure data: opcodes, instructions, the constant pool, and the per-function /
// per-type metadata tables. No emit logic, no execution. The companion module
// compiler/disasm.kl reads these to produce the human-readable text the C++
// `--bytecode` flag emits, which is our golden oracle.
//
// Layout decisions, to keep the self-host bytecode byte-compatible with the
// bootstrap compiler:
//   - OpCode order matches chunk.h line-by-line (so OpCode::Constant is index 0,
//     OpCode::MapLen is index 79).
//   - Each Instruction carries a single int operand (mirrors int32_t on the C++
//     side). Operand meaning is opcode-dependent — see disasm.kl for the table.
//   - The constant pool stores tagged scalars only. Arrays/Maps/Structs/Enums
//     are never placed in the pool by the bootstrap compiler; they are built at
//     runtime via dedicated opcodes. We model the union for completeness so that
//     disasm can print whatever Value::operator<< would produce.

pub enum OpCode {
  // constants
  Constant, Null_, True_, False_,
  // arithmetic
  Add, Subtract, Multiply, Divide, Modulo,
  // unary
  Negate, Not_, BitNot,
  // bitwise
  BitAnd, BitOr, BitXor, Shl, Shr,
  // locals / stack
  LoadLocal, StoreLocal, Pop, Dup,
  // misc
  CastTo, FloatToBits,
  // calls / control
  Call, Return_, Jmp, JmpFalse, JmpIfErr,
  // comparison
  Eq, Neq, Lt, Gt, Le, Ge,
  // native intrinsics (io / fs / sys)
  NativeOut, NativeOutLn, NativeErr, NativeErrLn,
  NativeIn, NativeInSecret,
  NativeFsRead, NativeFsWrite, NativeFsListdir, NativeSysArgs,
  // structs
  StructNew, FieldGet, FieldSet,
  // enums
  EnumVariant_,
  // arrays
  ArrayNew, IndexGet, IndexSet,
  ArrayLen, ArrayPush, ArrayResize, ArrayPop, ArrayRemove,
  ArrayContains, ArrayClear, ArrayInsert, ArrayIndexOf,
  ArraySlice, ArrayReverse,
  // strings
  StringStartsWith, StringEndsWith, StringReplace, StringSplit,
  StringTrim, StringToUpper, StringToLower,
  // enum payloads
  EnumVariantPayload, EnumPayloadGet,
  // maps
  MapNew, MapGet, MapSet, MapHas, MapRemove, MapKeys, MapLen,
  // error handling
  PushHandler, PopHandler, PropagateErr,
  // added after the original VM opcode order
  IsNull, StringToInt, StringToFloat, StringCode, StringCodeAt,
  // int32-width arithmetic (appended; kept in lockstep with bootstrap chunk.h)
  AddI32, SubtractI32, MultiplyI32, DivideI32, ModuloI32,
  DenseArrayNew,
}

// Constant pool entry. Tag dispatches which storage field to read.
//
// The bootstrap compiler only places scalars in the constant pool: ints,
// doubles, booleans (rare — usually emitted via OP_True/OP_False), null
// (emitted via OP_Null), and strings. Function/Struct/Enum/Array/Map
// values are runtime-only. We carry a shape for them anyway so disasm
// has a place to render Value::operator<< for any unexpected entry.
pub enum ConstKind {
  Int_,
  Double_,
  Bool_,
  Char_,
  Null_,
  String_,
  Function_,
  Struct_,
  Enum_,
  Array_,
  Map_,
  NativeFn_,
}

pub struct Constant {
  ConstKind kind;
  int int_value;
  float double_value;
  bool bool_value;
  string string_value;
  // For Function: function table index. For Struct: type_index.
  // For Enum: encoded as enum_type_index * 1000 + variant_index (debug only).
  int aux1;
  int aux2;
}

pub Constant const_int(int v)    => Constant { ConstKind::Int_,    v, 0.0, false, "",  0, 0 };
pub Constant const_double(float v) => Constant { ConstKind::Double_, 0,  v,  false, "",  0, 0 };
pub Constant const_bool(bool v)  => Constant { ConstKind::Bool_,   0, 0.0, v,     "",  0, 0 };
pub Constant const_char(int v)   => Constant { ConstKind::Char_,   v, 0.0, false, "",  0, 0 };
pub Constant const_null()         => Constant { ConstKind::Null_,   0, 0.0, false, "",  0, 0 };
pub Constant const_string(string v) => Constant { ConstKind::String_, 0, 0.0, false, v,   0, 0 };

pub struct Instruction {
  OpCode op;
  int operand;   // index / slot / jump-distance / argc / cast-tag — opcode-dependent
  int line;
  int col;
}

pub Instruction make_insn(OpCode op, int operand, int line, int col) {
  return Instruction { op, operand, line, col };
}

// Function table entry. `entry` is an instruction index (not byte offset).
pub struct FunctionInfo {
  string name;
  int entry;
  int param_count;
  string return_type_name;
  string[] param_type_names;
}

pub struct StructMeta {
  string name;
  string[] field_names;
  string[] field_type_names;
}

pub struct EnumMeta {
  string name;
  string[] variants;
  int[] variant_param_counts;
}

// The whole compiled program. Instructions are a flat stream; functions
// table maps names to entry indices in that stream. Mirrors `class Chunk`
// in chunk.h.
pub struct Chunk {
  Constant[] constants;
  Instruction[] instructions;
  FunctionInfo[] functions;
  StructMeta[] struct_metas;
  EnumMeta[] enum_metas;
}

pub Chunk make_chunk() {
  Constant[] cs = [];
  Instruction[] is = [];
  FunctionInfo[] fs = [];
  StructMeta[] ss = [];
  EnumMeta[] es = [];
  return Chunk { cs, is, fs, ss, es };
}

// Append a constant; return its pool index. Deduplicates identical values.
// Mirrors Chunk::add_constant in the bootstrap compiler.
pub int add_constant(Chunk c, Constant v) {
  for (int i = 0; i < c.constants.len(); i += 1) {
    Constant existing = c.constants[i];
    if (existing.kind != v.kind) { continue; }
    if (v.kind == ConstKind::Int_) {
      if (existing.int_value == v.int_value) { return i; }
    } else if (v.kind == ConstKind::Double_) {
      if (existing.double_value == v.double_value) { return i; }
    } else if (v.kind == ConstKind::Bool_) {
      if (existing.bool_value == v.bool_value) { return i; }
    } else if (v.kind == ConstKind::Char_) {
      if (existing.int_value == v.int_value) { return i; }
    } else if (v.kind == ConstKind::Null_) {
      return i;
    } else if (v.kind == ConstKind::String_) {
      if (existing.string_value == v.string_value) { return i; }
    } else if (v.kind == ConstKind::Function_) {
      if (existing.aux1 == v.aux1) { return i; }
    } else if (v.kind == ConstKind::Enum_) {
      if (existing.aux1 == v.aux1 && existing.aux2 == v.aux2) { return i; }
    }
  }
  c.constants.push(v);
  return c.constants.len() - 1;
}

// Append an instruction with no operand. Mirrors Chunk::write.
pub void write_op(Chunk c, OpCode op, int line, int col) {
  c.instructions.push(Instruction { op, 0, line, col });
}

// Append an instruction with operand. Mirrors Chunk::write_operand.
pub void write_operand(Chunk c, OpCode op, int operand, int line, int col) {
  c.instructions.push(Instruction { op, operand, line, col });
}

// Push constant + emit OP_Constant referring to it. Deduplicates before adding.
// Mirrors Chunk::write_constant.
pub void write_constant(Chunk c, Constant v, int line, int col) {
  int idx = -1;
  for (int i = 0; i < c.constants.len(); i += 1) {
    Constant existing = c.constants[i];
    if (existing.kind != v.kind) { continue; }
    if (v.kind == ConstKind::Int_) {
      if (existing.int_value == v.int_value) { idx = i; break; }
    } else if (v.kind == ConstKind::Double_) {
      if (existing.double_value == v.double_value) { idx = i; break; }
    } else if (v.kind == ConstKind::Bool_) {
      if (existing.bool_value == v.bool_value) { idx = i; break; }
    } else if (v.kind == ConstKind::Char_) {
      if (existing.int_value == v.int_value) { idx = i; break; }
    } else if (v.kind == ConstKind::Null_) {
      idx = i; break;
    } else if (v.kind == ConstKind::String_) {
      if (existing.string_value == v.string_value) { idx = i; break; }
    } else if (v.kind == ConstKind::Function_) {
      if (existing.aux1 == v.aux1) { idx = i; break; }
    } else if (v.kind == ConstKind::Enum_) {
      if (existing.aux1 == v.aux1 && existing.aux2 == v.aux2) { idx = i; break; }
    }
  }
  if (idx < 0) {
    c.constants.push(v);
    idx = c.constants.len() - 1;
  }
  c.instructions.push(Instruction { OpCode::Constant, idx, line, col });
}

pub int add_function(Chunk c, FunctionInfo info) {
  c.functions.push(info);
  return c.functions.len() - 1;
}

pub int add_struct_meta(Chunk c, StructMeta meta) {
  c.struct_metas.push(meta);
  return c.struct_metas.len() - 1;
}

pub int add_enum_meta(Chunk c, EnumMeta meta) {
  c.enum_metas.push(meta);
  return c.enum_metas.len() - 1;
}

// Pre-register CastError at chunk index 0 (bootstrap compiler.cc:26-35).
pub void register_builtin_enums(Chunk c) {
  string[] cast_err_variants = [];
  cast_err_variants.push("Empty");
  cast_err_variants.push("NotANumber");
  cast_err_variants.push("Overflow");
  int[] cast_err_counts = [];
  cast_err_counts.push(0);
  cast_err_counts.push(1);
  cast_err_counts.push(1);
  EnumMeta cast_err = EnumMeta { "CastError", cast_err_variants, cast_err_counts };
  c.enum_metas.push(cast_err);
}

// binary serialization helpers

// Single byte: int → string(byte(v & 0xFF)) produces a one-char string.
// The CastTo opcode handles Int→Char (kind 3) and Char→String (kind 2).

// Helper: convert low byte of int to a single-char string via Char→String cast.
string byte_chr(int v) {
  return string(byte(v & 0xFF));
}

pub string write_u8(string buf, int v) {
  return buf + byte_chr(v);
}

pub string write_u32(string buf, int v) {
  buf = buf + byte_chr(v);
  buf = buf + byte_chr(v >> 8);
  buf = buf + byte_chr(v >> 16);
  buf = buf + byte_chr(v >> 24);
  return buf;
}

pub string write_i32(string buf, int v) {
  return write_u32(buf, v);
}

pub string write_u64(string buf, int v) {
  buf = write_u32(buf, v & 0xFFFFFFFF);
  buf = write_u32(buf, (v >> 32) & 0xFFFFFFFF);
  return buf;
}

pub string write_i64(string buf, int v) {
  return write_u64(buf, v);
}

pub string write_f64(string buf, float v) {
  return write_i64(buf, int::bits(v));
}

// Kinglet >> is logical; Sleb128 needs arithmetic right shift.
int arith_shr7(int v) {
  if (v >= 0) {
    return v >> 7;
  }
  int u = -v;
  int r = u >> 7;
  if ((u & 127) != 0) {
    return -(r + 1);
  }
  return -r;
}

pub string write_sleb128(string buf, int v) {
  bool more = true;
  while (more) {
    int b = v & 0x7F;
    v = arith_shr7(v);
    if ((v == 0 && (b & 0x40) == 0) || (v == -1 && (b & 0x40) != 0)) {
      more = false;
    } else {
      b = b | 0x80;
    }
    buf = buf + byte_chr(b);
  }
  return buf;
}

pub string write_str(string buf, string s) {
  buf = write_u32(buf, s.len());
  for (int i = 0; i < s.len(); i += 1) {
    buf = buf + byte_chr(int(s[i]));
  }
  return buf;
}

// Map ConstKind to ValueType tag used in kbc serialization.
// ConstKind order differs from ValueType: Null_=3 in ConstKind but Null=4 in ValueType.
int const_kind_to_tag(ConstKind k) {
  if (k == ConstKind::Int_)      { return 0; }  // ValueType::Int
  if (k == ConstKind::Double_)   { return 1; }  // ValueType::Double
  if (k == ConstKind::Bool_)     { return 2; }  // ValueType::Bool
  if (k == ConstKind::Char_)     { return 3; }  // ValueType::Char
  if (k == ConstKind::Null_)     { return 4; }  // ValueType::Null
  if (k == ConstKind::String_)   { return 5; }  // ValueType::String
  if (k == ConstKind::Function_) { return 6; }  // ValueType::Function
  if (k == ConstKind::Enum_)     { return 8; }  // ValueType::Enum
  return 0;
}

string serialize_constant(string buf, Constant c) {
  buf = write_u8(buf, const_kind_to_tag(c.kind));
  if (c.kind == ConstKind::Int_) {
    buf = write_i64(buf, c.int_value);
  } else if (c.kind == ConstKind::Double_) {
    buf = write_f64(buf, c.double_value);
  } else if (c.kind == ConstKind::Bool_) {
    if (c.bool_value) { buf = write_u8(buf, 1); }
    else { buf = write_u8(buf, 0); }
  } else if (c.kind == ConstKind::Char_) {
    buf = write_u8(buf, c.int_value & 0xFF);
  } else if (c.kind == ConstKind::Null_) {
    // no data
  } else if (c.kind == ConstKind::String_) {
    buf = write_str(buf, c.string_value);
  } else if (c.kind == ConstKind::Function_) {
    buf = write_i32(buf, c.aux1);
  } else if (c.kind == ConstKind::Enum_) {
    buf = write_i32(buf, c.aux1);
    buf = write_i32(buf, c.aux2);
    buf = write_u32(buf, 0); // payload count — self-host compiler emits no payload constants
  }
  return buf;
}

pub void serialize_chunk(Chunk c, string path, bool strip_debug) {
  string buf = "";

  // Header (16 bytes)
  buf = write_u32(buf, 0x01424B43);   // magic
  buf = write_u32(buf, 2);            // version 2: sleb128 operands (matches C++ VM)
  if (strip_debug) { buf = write_u32(buf, 0); }
  else { buf = write_u32(buf, 1); }   // flags
  buf = write_u32(buf, 0);            // reserved

  // Constants
  buf = write_u32(buf, c.constants.len());
  for (int i = 0; i < c.constants.len(); i += 1) {
    buf = serialize_constant(buf, c.constants[i]);
  }

  // Instructions (v2: sleb128 operands and debug info)
  buf = write_u32(buf, c.instructions.len());
  for (int i = 0; i < c.instructions.len(); i += 1) {
    Instruction insn = c.instructions[i];
    buf = write_u8(buf, int(insn.op));
    buf = write_sleb128(buf, insn.operand);
    if (!strip_debug) {
      buf = write_sleb128(buf, insn.line);
      buf = write_sleb128(buf, insn.col);
    }
  }

  // Functions
  buf = write_u32(buf, c.functions.len());
  for (int i = 0; i < c.functions.len(); i += 1) {
    FunctionInfo f = c.functions[i];
    buf = write_str(buf, f.name);
    buf = write_u64(buf, f.entry);
    buf = write_i32(buf, f.param_count);
  }

  // Struct metas
  buf = write_u32(buf, c.struct_metas.len());
  for (int i = 0; i < c.struct_metas.len(); i += 1) {
    StructMeta s = c.struct_metas[i];
    buf = write_str(buf, s.name);
    buf = write_u32(buf, s.field_names.len());
    for (int j = 0; j < s.field_names.len(); j += 1) {
      buf = write_str(buf, s.field_names[j]);
    }
  }

  // Enum metas
  buf = write_u32(buf, c.enum_metas.len());
  for (int i = 0; i < c.enum_metas.len(); i += 1) {
    EnumMeta e = c.enum_metas[i];
    buf = write_str(buf, e.name);
    buf = write_u32(buf, e.variants.len());
    for (int j = 0; j < e.variants.len(); j += 1) {
      buf = write_str(buf, e.variants[j]);
      buf = write_i32(buf, e.variant_param_counts[j]);
    }
  }

  fs::__write(path, buf);
}
