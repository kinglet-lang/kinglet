// Kinglet self-host bytecode compiler: module loading, registration, and
// the top-level compile pass.  Code generation (emit_*/compile_*) lives in
// codegen.kl; the Compiler struct and pure state helpers live in
// compiler_state.kl.

import {
  "bytecode.kl"
  "compiler_state.kl"
  "codegen.kl"
  "//parser/ast.kl"
  "//parser/helpers.kl"
  "//parser/parser.kl"
  "//lexer/scanner.kl"
  "//lexer/token.kl"
}

using io;
using fs;
using helpers { Parser };
using ast {
  Program, Decl, Stmt, Parameter, FieldDef, EnumVariant, TypeExpr, Expr
};
using compiler_state {
  Compiler, CompileError, ImportState, ImportedFunc,
  FuncEntry, EnumEntry, StructEntry, GlobalConst,
  make_compiler, compile_error,
  compiler_push_scope, compiler_pop_scope,
  declare_local, declare_local_typed, resolve_local, resolve_global_const, resolve_function,
  emit_jump, patch_jump, patch_jump_to,
  is_native_namespace, is_native_member, register_native_using_alias,
  open_native_namespace
};
using scanner { scan, emit_lexer_errors };
using codegen { compile_stmt };

// path helpers

// Walk up from start_dir looking for kinglet.toml. Returns the directory
// containing it, or empty string if not found.
string find_project_root(string start_dir) {
  string dir = start_dir;
  while (dir.len() > 0) {
    string candidate = dir + "/kinglet.toml";
    string content = fs::__read(candidate);
    if (content != null) { return dir; }
    int i = dir.len() - 1;
    while (i >= 0) {
      if (dir.slice(i, i + 1) == "/") {
        dir = dir.slice(0, i);
        break;
      }
      i = i - 1;
    }
    if (i < 0) { break; }
  }
  return "";
}

string dir_of(string path) {
  int i = path.len() - 1;
  while (i >= 0) {
    if (path.slice(i, i + 1) == "/") {
      if (i == 0) { return "/"; }
      return path.slice(0, i);
    }
    i = i - 1;
  }
  return ".";
}

string stem_of(string path) {
  string name = path;
  int i = path.len() - 1;
  while (i >= 0) {
    if (path.slice(i, i + 1) == "/") {
      name = path.slice(i + 1, path.len());
      break;
    }
    i = i - 1;
  }
  int dot = name.len() - 1;
  while (dot >= 0) {
    if (name.slice(dot, dot + 1) == ".") { return name.slice(0, dot); }
    dot = dot - 1;
  }
  return name;
}

string resolve_import_path(string base_dir, string relative, string project_root) {
  // Project-root-relative path: //parser/ast.kl
  if (relative.len() >= 2 && relative[0] == '/' && relative[1] == '/') {
    if (project_root.len() == 0) {
      return "";  // caller should report "no kinglet.toml found"
    }
    string rel = relative.slice(2, relative.len());
    if (project_root[project_root.len() - 1] == '/') {
      return project_root + rel;
    }
    return project_root + "/" + rel;
  }
  // Relative path: ../foo.kl or ./foo.kl or foo.kl
  string[] parts = relative.split("/");
  string[] segments = base_dir.split("/");
  for (int i = 0; i < parts.len(); i = i + 1) {
    if (parts[i] == "..") {
      if (segments.len() > 0) { segments.pop(); }
    } else {
      if (parts[i] != "." && parts[i].len() > 0) {
        segments.push(parts[i]);
      }
    }
  }
  string result = "";
  for (int i = 0; i < segments.len(); i = i + 1) {
    if (i > 0) { result = result + "/"; }
    result = result + segments[i];
  }
  return result;
}

// import helpers

bool str_arr_contains(string[] arr, string val) {
  for (int i = 0; i < arr.len(); i = i + 1) {
    if (arr[i] == val) { return true; }
  }
  return false;
}

bool func_exists(Compiler co, string name) {
  for (int i = 0; i < co.funcs.len(); i = i + 1) {
    if (co.funcs[i].name == name) { return true; }
  }
  return false;
}

bool struct_exists(Compiler co, string name) {
  for (int i = 0; i < co.structs.len(); i = i + 1) {
    if (co.structs[i].name == name) { return true; }
  }
  return false;
}

bool enum_exists(Compiler co, string name) {
  for (int i = 0; i < co.enums.len(); i = i + 1) {
    if (co.enums[i].name == name) { return true; }
  }
  return false;
}

void register_func_alias(Compiler co, string alias_name, int func_index, int const_index, int param_count, string first_param_type) {
  co.funcs.push(FuncEntry { alias_name, func_index, const_index, param_count, first_param_type });
}

void _reg_import_func(Compiler co, string ns, string n, string return_type, Parameter[] params, Stmt body, bool is_pub, int dl, int dc, string[] selected, bool is_sel) {
  if (is_pub && is_sel && !str_arr_contains(selected, n)) { return; }
  string qualified = ns + "::" + n;
  if (!func_exists(co, qualified)) {
    register_compiler_function(co, n, qualified, params.len(), first_param_type_name(params));
    co.imports.pending.push(ImportedFunc { ns, qualified, return_type, params, body, dl, dc });
  }
  int fi = resolve_function(co, qualified);
  if (is_pub && is_sel && !func_exists(co, n)) {
    register_func_alias(co, n, co.funcs[fi].func_index, co.funcs[fi].const_index, params.len(), co.funcs[fi].first_param_type);
  }
  // Bootstrap always overwrites the bare-name alias for private imports
  // (compiler.cc:1930); last module wins via resolve_function reverse scan.
  if (!is_pub) {
    register_func_alias(co, n, co.funcs[fi].func_index, co.funcs[fi].const_index, params.len(), co.funcs[fi].first_param_type);
  }
}

void _reg_import_func_if(Compiler co, string ns, string n, string return_type, Parameter[] params, Stmt body, bool is_pub, int dl, int dc, string[] selected, bool is_sel, bool want_pub) {
  if (is_pub != want_pub) { return; }
  _reg_import_func(co, ns, n, return_type, params, body, is_pub, dl, dc, selected, is_sel);
}

void _reg_import_struct(Compiler co, string n, FieldDef[] fields, bool is_pub, string[] selected, bool is_sel) {
  if (is_sel && is_pub && !str_arr_contains(selected, n)) { return; }
  // Bootstrap always appends pub struct metas (may duplicate names in the
  // chunk table); private structs are skipped once registered.
  if (!is_pub && struct_exists(co, n)) { return; }
  _register_struct_decl(co, n, fields);
}

void _reg_import_enum(Compiler co, string n, EnumVariant[] variants, bool is_pub, string[] selected, bool is_sel) {
  if (is_sel && is_pub && !str_arr_contains(selected, n)) { return; }
  if (!is_pub && enum_exists(co, n)) { return; }
  _register_enum_decl(co, n, variants);
}

void _reg_import_struct_if(Compiler co, string n, FieldDef[] fields, bool is_pub, string[] selected, bool is_sel, bool want_pub) {
  if (is_pub != want_pub) { return; }
  _reg_import_struct(co, n, fields, is_pub, selected, is_sel);
}

void _reg_import_enum_if(Compiler co, string n, EnumVariant[] variants, bool is_pub, string[] selected, bool is_sel, bool want_pub) {
  if (is_pub != want_pub) { return; }
  _reg_import_enum(co, n, variants, is_pub, selected, is_sel);
}

void handle_import_decl(Compiler co, string path, string base_dir, string alias, string[] selected, int line, int col) {
  string err = load_module(co, path, base_dir, alias, selected);
  if (err.len() > 0) { compile_error(co, line, col, err); }
}

void handle_import_block(Compiler co, string[] paths, string[] aliases, string base_dir, int line, int col) {
  for (int i = 0; i < paths.len(); i = i + 1) {
    string alias = "";
    if (i < aliases.len()) { alias = aliases[i]; }
    string[] selected = [];
    string err = load_module(co, paths[i], base_dir, alias, selected);
    if (err.len() > 0) { compile_error(co, line, col, err); return; }
  }
}

string load_module(Compiler co, string import_path, string importing_dir, string alias, string[] selected) {
  string resolved = resolve_import_path(importing_dir, import_path, co.imports.project_root);
  if (resolved.len() == 0 && import_path.len() >= 2 && import_path[0] == '/' && import_path[1] == '/') {
    return "Cannot resolve '//' path: no kinglet.toml found";
  }
  if (str_arr_contains(co.imports.loading_paths, resolved)) {
    return "Circular import: " + import_path;
  }
  if (str_arr_contains(co.imports.loaded_paths, resolved)) { return ""; }
  string source = fs::__read(resolved);
  if (source == null) { return "Cannot read: " + import_path; }
  Token[] tokens = scan(source);
  if (emit_lexer_errors(tokens) > 0) { return "Lexer error in " + import_path; }
  Parser p = helpers::make_parser(tokens);
  Program prog = parser::parse_program(p);
  if (p.errors.len() > 0) { return "Parse error in " + import_path + ": " + p.errors[0].message; }
  string ns = alias;
  if (ns.len() == 0) { ns = stem_of(import_path); }
  co.imports.loading_paths.push(resolved);
  // Transitive imports — single pass in declaration order (matching bootstrap's
  // compiler.cc:42-53) so imported function indices are byte-identical.
  string mod_dir = dir_of(resolved);
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    prog.declarations[i] match {
      Decl::ImportDecl(let ip, let ia, let isel, let _l, let _c) =>
        _handle_transitive(co, ip, mod_dir, ia, isel),
      Decl::ImportBlockDecl(let paths, let aliases, let _l, let _c) =>
        _handle_transitive_block(co, paths, aliases, mod_dir),
      _ => {},
    };
    if (co.errors.len() > 0) { co.imports.loading_paths.pop(); return "transitive error"; }
  }
  // Register declarations. Order matters for bytecode-identity with the
  // bootstrap: process_import_module in compiler.cc registers public
  // functions first (line 1794), then private functions (line 1821), so
  // function indices in the resulting chunk match across compilers.
  bool is_sel = selected.len() > 0;
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    prog.declarations[i] match {
      Decl::FunctionDecl(let n, let rt, let _tps, let params, let _w, let body, let is_pub, let dl, let dc) =>
        _reg_import_func_if(co, ns, n, rt.name, params, body, is_pub, dl, dc, selected, is_sel, true),
      _ => {},
    };
  }
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    prog.declarations[i] match {
      Decl::FunctionDecl(let n, let rt, let _tps, let params, let _w, let body, let is_pub, let dl, let dc) =>
        _reg_import_func_if(co, ns, n, rt.name, params, body, is_pub, dl, dc, selected, is_sel, false),
      _ => {},
    };
  }
  // Register imported structs and enums — pub then private to match bootstrap's
  // process_import_module order (compiler.cc:1834-1894).
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    prog.declarations[i] match {
      Decl::StructDecl(let n, let _tps, let fields, let is_pub, let _l, let _c) =>
        _reg_import_struct_if(co, n, fields, is_pub, selected, is_sel, true),
      _ => {},
    };
  }
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    prog.declarations[i] match {
      Decl::StructDecl(let n, let _tps, let fields, let is_pub, let _l, let _c) =>
        _reg_import_struct_if(co, n, fields, is_pub, selected, is_sel, false),
      _ => {},
    };
  }
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    prog.declarations[i] match {
      Decl::EnumDecl(let n, let variants, let is_pub, let _l, let _c) =>
        _reg_import_enum_if(co, n, variants, is_pub, selected, is_sel, true),
      _ => {},
    };
  }
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    prog.declarations[i] match {
      Decl::EnumDecl(let n, let variants, let is_pub, let _l, let _c) =>
        _reg_import_enum_if(co, n, variants, is_pub, selected, is_sel, false),
      _ => {},
    };
  }
  // Apply this module's own `using mod { sym };` selections so unqualified
  // calls inside its function bodies (compiled later in Pass 2b) resolve to
  // the dependency's qualified function index. Mirrors compiler.cc:1904-1915
  // in the bootstrap.
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    prog.declarations[i] match {
      Decl::UsingDecl(let un, let _is_ns, let usel, let _l, let _c) =>
        register_using_aliases(co, un, usel),
      _ => {},
    };
  }
  co.imports.loading_paths.pop();
  co.imports.loaded_paths.push(resolved);
  co.imports.namespaces.push(ns);
  return "";
}

void _handle_transitive(Compiler co, string ip, string mod_dir, string ia, string[] isel) {
  string err = load_module(co, ip, mod_dir, ia, isel);
  if (err.len() > 0) { compile_error(co, 0, 0, err); }
}

void _handle_transitive_block(Compiler co, string[] paths, string[] aliases, string mod_dir) {
  for (int i = 0; i < paths.len(); i = i + 1) {
    string alias = "";
    if (i < aliases.len()) { alias = aliases[i]; }
    string[] selected = [];
    string err = load_module(co, paths[i], mod_dir, alias, selected);
    if (err.len() > 0) { compile_error(co, 0, 0, err); return; }
  }
}

void process_using_decl(Compiler co, Decl d) {
  d match {
    Decl::UsingDecl(let n, let is_ns, let selected, let _l, let _c) =>
      apply_using_decl(co, n, is_ns, selected),
    _ => skip_decl(co),
  };
}

void apply_using_decl(Compiler co, string n, bool is_ns, string[] selected) {
  if (is_ns && is_native_namespace(n)) {
    open_native_namespace(co, n);
    return;
  }
  if (selected.len() > 0) {
    register_using_aliases(co, n, selected);
  }
}

void register_using_aliases(Compiler co, string ns, string[] selected) {
  for (int i = 0; i < selected.len(); i = i + 1) {
    string sym = selected[i];
    string qualified = ns + "::" + sym;
    int fi = resolve_function(co, qualified);
    if (fi >= 0 && !func_exists(co, sym)) {
      register_func_alias(co, sym, co.funcs[fi].func_index, co.funcs[fi].const_index, co.funcs[fi].param_count, co.funcs[fi].first_param_type);
      continue;
    }
    if (is_native_namespace(ns) && is_native_member(ns, sym)) {
      register_native_using_alias(co, sym, ns, sym);
    }
  }
}

void register_compiler_function(Compiler co, string chunk_name, string lookup_name, int param_count, string first_param_type) {
  // Allocate function table slot (entry to be patched once body emits).
  // chunk_name is the bare name stored in the chunk (bootstrap uses bare names;
  // qualified names only go in the lookup table so serialized output matches).
  FunctionInfo info = FunctionInfo { chunk_name, 0, param_count };
  co.chunk.functions.push(info);
  int func_index = co.chunk.functions.len() - 1;
  // Every function gets a Function_ constant, even at decl time. Mirrors
  // compiler.cc:130 chunk_.add_constant(Value::function_value(idx)).
  Constant fc = Constant {
    ConstKind::Function_,
    0, 0.0, false, "",
    func_index, 0,
  };
  co.chunk.constants.push(fc);
  int const_index = co.chunk.constants.len() - 1;
  FuncEntry fe = FuncEntry { lookup_name, func_index, const_index, param_count, first_param_type };
  co.funcs.push(fe);
}

string first_param_type_name(Parameter[] params) {
  if (params.len() == 0) { return ""; }
  return params[0].type.name;
}

// True if `stmts` ends with a bare expression statement (implicit-return tail).
bool block_last_is_expr(Stmt[] stmts) {
  if (stmts.len() == 0) { return false; }
  return stmts[stmts.len() - 1] match {
    Stmt::ExprStmt(let _e, let _l, let _c) => true,
    _ => false,
  };
}

// True if a function body (a block) ends with a bare expression statement.
bool body_has_tail_expr(Stmt body) {
  return body match {
    Stmt::Block(let stmts, let _bl, let _bc) => block_last_is_expr(stmts),
    _ => false,
  };
}

bool block_last_is_return(Stmt[] stmts) {
  if (stmts.len() == 0) { return false; }
  return stmts[stmts.len() - 1] match {
    Stmt::ReturnStmt(let _v, let _l, let _c) => true,
    _ => false,
  };
}

bool body_has_explicit_return(Stmt body) {
  return body match {
    Stmt::Block(let stmts, let _bl, let _bc) => block_last_is_return(stmts),
    _ => false,
  };
}

void compile_function_body(Compiler co, string name, string ret_type, Parameter[] params, Stmt body, int line, int col) {
  int fi = resolve_function(co, name);
  if (fi < 0) {
    compile_error(co, line, col, "Internal: function '" + name + "' not registered.");
    return;
  }
  // Patch entry to current instruction count, mirroring compile_function in
  // compiler.cc:393.
  co.chunk.functions[co.funcs[fi].func_index].entry = co.chunk.instructions.len();
  // Reset locals; params take slots 0..N-1 at depth 1.
  while (co.locals.len() > 0) { co.locals.pop(); }
  while (co.scope_starts.len() > 0) { co.scope_starts.pop(); }
  co.scope_depth = 0;
  compiler_push_scope(co);
  for (int i = 0; i < params.len(); i = i + 1) {
    Parameter p = params[i];
    declare_local_typed(co, p.name, p.type.name);
  }
  // Implicit return: if the body's last statement is a bare expression and the
  // function is non-void, compile it as the return value (mirrors
  // compiler.cc:367-378). Signalled via co.fn_tail_return, consumed by
  // compile_block on the body's outermost block.
  co.fn_tail_return = !(ret_type == "void") && body_has_tail_expr(body);
  compile_stmt(co, body);
  // Fallthrough safety: implicit null return when the body does not end with return.
  if (co.errors.len() == 0 && !body_has_explicit_return(body)) {
    bytecode::write_op(co.chunk, OpCode::Null_, line, col);
    bytecode::write_op(co.chunk, OpCode::Return_, line, col);
  }
  compiler_pop_scope(co);
}

pub int compile_program(Compiler co, Program prog, string source_path) {
  // Pass 0: collect `using` declarations.
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    Decl d = prog.declarations[i];
    d match {
      Decl::UsingDecl(let n, let _is_ns, let _selected, let _l, let _c) =>
        co.usings.push(n),
      _ => skip_decl(co),
    };
  }
  // Discover project root from kinglet.toml for // path resolution.
  if (source_path.len() > 0) {
    co.imports.project_root = find_project_root(dir_of(source_path));
  }
  // Pass 0a: process imports.
  if (source_path.len() > 0) {
    string base_dir = dir_of(source_path);
    for (int i = 0; i < prog.declarations.len(); i = i + 1) {
      prog.declarations[i] match {
        Decl::ImportDecl(let path, let alias, let selected, let line, let col) =>
          handle_import_decl(co, path, base_dir, alias, selected, line, col),
        Decl::ImportBlockDecl(let paths, let aliases, let line, let col) =>
          handle_import_block(co, paths, aliases, base_dir, line, col),
        _ => {},
      };
      if (co.errors.len() > 0) { return co.errors.len(); }
    }
  }
  // Pass 0c: `using namespace io;` opens native members; `using mod { sym };`
  // lowers imported or native symbols to short-name aliases.
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    process_using_decl(co, prog.declarations[i]);
  }
  // Pass 0b: register struct and enum declarations.
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    Decl d = prog.declarations[i];
    d match {
      Decl::StructDecl(let n, let _tps, let fields, let _is_pub, let _l, let _c) =>
        _register_struct_decl(co, n, fields),
      Decl::EnumDecl(let n, let variants, let _is_pub, let _l, let _c) =>
        _register_enum_decl(co, n, variants),
      _ => skip_decl(co),
    };
  }
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    register_compile_time_decl(co, prog.declarations[i]);
  }
  // Pass 1: register every top-level function, in source order.
  int main_fi = -1;
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    Decl d = prog.declarations[i];
    d match {
      Decl::FunctionDecl(let n, let _rt, let _tps, let params, let _w, let _body, let _is_pub, let _l, let _c) =>
        register_top_function(co, n, params),
      _ => skip_decl(co),
    };
    if (co.errors.len() > 0) { return co.errors.len(); }
  }
  main_fi = resolve_function(co, "main");
  if (main_fi < 0) {
    compile_error(co, 1, 0, "Expected a main function.");
    return co.errors.len();
  }
  // Preamble: load function-value(main); Call 0; Return.
  // Source location is hardcoded to 1:0 to match C++'s preamble_loc{1, 0}.
  Constant main_fc = Constant {
    ConstKind::Function_,
    0, 0.0, false, "",
    co.funcs[main_fi].func_index, 0,
  };
  bytecode::write_constant(co.chunk, main_fc, 1, 0);
  bytecode::write_operand(co.chunk, OpCode::Call, 0, 1, 0);
  bytecode::write_op(co.chunk, OpCode::Return_, 1, 0);
  // Pass 2: compile each function body, in source order.
  for (int i = 0; i < prog.declarations.len(); i = i + 1) {
    Decl d = prog.declarations[i];
    d match {
      Decl::FunctionDecl(let n, let rt, let _tps, let params, let _w, let body, let _is_pub, let l, let c) =>
        compile_function_body(co, n, rt.name, params, body, l, c),
      _ => skip_decl(co),
    };
    if (co.errors.len() > 0) { return co.errors.len(); }
  }
  // Pass 2b: compile imported function bodies.
  // Stable-sort by namespace rank to match bootstrap compiler.cc pass 2b
  // (unordered_map iteration on libc++ / macOS for this module set).
  for (int i = 1; i < co.imports.pending.len(); i = i + 1) {
    ImportedFunc key = co.imports.pending[i];
    int j = i - 1;
    while (j >= 0 && pass2b_ns_rank(co.imports.pending[j].ns) > pass2b_ns_rank(key.ns)) {
      co.imports.pending[j + 1] = co.imports.pending[j];
      j = j - 1;
    }
    co.imports.pending[j + 1] = key;
  }
  for (int i = 0; i < co.imports.pending.len(); i = i + 1) {
    ImportedFunc ifn = co.imports.pending[i];
    compile_function_body(co, ifn.qualified_name, ifn.return_type, ifn.params, ifn.body, ifn.line, ifn.col);
    if (co.errors.len() > 0) { return co.errors.len(); }
  }
  return 0;
}

void maybe_register_global_const(Compiler co, string storage, string name, Expr init) {
  if (storage == "const") {
    co.globals.push(GlobalConst { name, init });
  }
}

void register_compile_time_decl(Compiler co, Decl d) {
  d match {
    Decl::ConceptDecl(let n, let _tps, let _methods, let _is_pub, let _l, let _c) =>
      co.concepts.push(n),
    Decl::TopLevelStmt(let s, let _l, let _c) =>
      register_top_level_stmt_const(co, s),
    _ => skip_decl(co),
  };
}

void register_top_level_stmt_const(Compiler co, Stmt s) {
  s match {
    Stmt::VarDecl(let storage, let _ty, let name, let init, let _vl, let _vc) =>
      maybe_register_global_const(co, storage, name, init),
    _ => {},
  };
}

void register_top_function(Compiler co, string name, Parameter[] params) {
  string receiver = first_param_type_name(params);
  register_compiler_function(co, name, name, params.len(), receiver);
  if (receiver.len() > 0 && resolve_struct(co, receiver) >= 0) {
    int fi = co.funcs.len() - 1;
    register_func_alias(co, receiver + "::" + name,
      co.funcs[fi].func_index, co.funcs[fi].const_index, params.len(), receiver);
  }
}

void _register_struct_decl(Compiler co, string name, FieldDef[] fields) {
  string[] field_names = [];
  for (int i = 0; i < fields.len(); i = i + 1) {
    field_names.push(fields[i].name);
  }
  StructMeta meta = StructMeta { name, field_names };
  int idx = bytecode::add_struct_meta(co.chunk, meta);
  co.structs.push(StructEntry { name, idx });
}

void _register_enum_decl(Compiler co, string name, EnumVariant[] variants) {
  string[] variant_names = [];
  int[] param_counts = [];
  for (int i = 0; i < variants.len(); i = i + 1) {
    variant_names.push(variants[i].name);
    param_counts.push(variants[i].param_types.len());
  }
  EnumMeta meta = EnumMeta { name, variant_names, param_counts };
  int idx = bytecode::add_enum_meta(co.chunk, meta);
  co.enums.push(EnumEntry { name, idx });
}

void skip_decl(Compiler co) { return; }

// libc++ unordered_map iteration order observed when compiling core/main.kl
// with the bootstrap compiler (clang / macOS). Keep in sync if bootstrap
// toolchain changes.
int pass2b_ns_rank(string ns) {
  if (ns == "checker") { return 0; }
  if (ns == "ast_printer") { return 1; }
  if (ns == "scanner") { return 2; }
  if (ns == "disasm") { return 3; }
  if (ns == "ast") { return 4; }
  if (ns == "bytecode") { return 5; }
  if (ns == "codegen") { return 6; }
  if (ns == "compiler") { return 7; }
  if (ns == "checker_driver") { return 8; }
  if (ns == "parser") { return 9; }
  if (ns == "compiler_state") { return 10; }
  if (ns == "helpers") { return 11; }
  if (ns == "expressions") { return 12; }
  if (ns == "keywords") { return 13; }
  return 14;
}

