// Bytecode disassembler — Kinglet mirror of kinglet-bootstrap/src/vm/chunk.cc:79
// (Chunk::disassemble) and chunk.cc:127 (opcode_name).
//
// The output of `disassemble(chunk)` MUST match the bootstrap compiler's
// `--bytecode` flag byte-for-byte for any chunk both compilers can produce.
// That equivalence is the golden contract used to validate self-host codegen
// before we commit to byte-identical bootstrap fixpoint.
//
// Format per instruction (one line, terminated with '\n'):
//
//   <idx>  <line>:<col>  <opname>[ <extras>]
//
// where <extras> is opcode-dependent. See dispatch in `disassemble` below.
//
// Constant printing follows Value::operator<<  (vm/value.cc:100). Strings
// print without quotes, doubles use C++ default precision (6 significant
// digits, no trailing zero), bools as "true"/"false", null as "null".

import {
  "bytecode.kl"
}

using bytecode { OpCode, Instruction, Constant, ConstKind, Chunk };

string opcode_name(OpCode op) {
  if (op == OpCode::Constant) { return "Constant"; }
  if (op == OpCode::Null_)    { return "Null"; }
  if (op == OpCode::True_)    { return "True"; }
  if (op == OpCode::False_)   { return "False"; }
  if (op == OpCode::Add)      { return "Add"; }
  if (op == OpCode::Subtract) { return "Subtract"; }
  if (op == OpCode::Multiply) { return "Multiply"; }
  if (op == OpCode::Divide)   { return "Divide"; }
  if (op == OpCode::Modulo)   { return "Modulo"; }
  if (op == OpCode::Negate)   { return "Negate"; }
  if (op == OpCode::Not_)     { return "Not"; }
  if (op == OpCode::BitNot)   { return "BitNot"; }
  if (op == OpCode::BitAnd)   { return "BitAnd"; }
  if (op == OpCode::BitOr)    { return "BitOr"; }
  if (op == OpCode::BitXor)   { return "BitXor"; }
  if (op == OpCode::Shl)      { return "Shl"; }
  if (op == OpCode::Shr)      { return "Shr"; }
  if (op == OpCode::LoadLocal)  { return "LoadLocal"; }
  if (op == OpCode::StoreLocal) { return "StoreLocal"; }
  if (op == OpCode::Pop)      { return "Pop"; }
  if (op == OpCode::Dup)      { return "Dup"; }
  if (op == OpCode::IsNull)   { return "IsNull"; }
  if (op == OpCode::CastTo)   { return "CastTo"; }
  if (op == OpCode::Call)     { return "Call"; }
  if (op == OpCode::Return_)  { return "Return"; }
  if (op == OpCode::Jmp)      { return "Jmp"; }
  if (op == OpCode::JmpFalse) { return "JmpFalse"; }
  if (op == OpCode::JmpIfErr)    { return "JmpIfErr"; }
  if (op == OpCode::PushHandler) { return "PushHandler"; }
  if (op == OpCode::PopHandler)  { return "PopHandler"; }
  if (op == OpCode::PropagateErr) { return "PropagateErr"; }
  if (op == OpCode::Eq)       { return "Eq"; }
  if (op == OpCode::Neq)      { return "Neq"; }
  if (op == OpCode::Lt)       { return "Lt"; }
  if (op == OpCode::Gt)       { return "Gt"; }
  if (op == OpCode::Le)       { return "Le"; }
  if (op == OpCode::Ge)       { return "Ge"; }
  if (op == OpCode::NativeOut)      { return "NativeOut"; }
  if (op == OpCode::NativeOutLn)    { return "NativeOutLn"; }
  if (op == OpCode::NativeErr)      { return "NativeErr"; }
  if (op == OpCode::NativeErrLn)    { return "NativeErrLn"; }
  if (op == OpCode::NativeIn)       { return "NativeIn"; }
  if (op == OpCode::NativeInSecret) { return "NativeInSecret"; }
  if (op == OpCode::NativeFsRead)   { return "NativeFsRead"; }
  if (op == OpCode::NativeFsWrite)  { return "NativeFsWrite"; }
  if (op == OpCode::NativeSysArgs)  { return "NativeSysArgs"; }
  if (op == OpCode::StructNew) { return "StructNew"; }
  if (op == OpCode::FieldGet)  { return "FieldGet"; }
  if (op == OpCode::FieldSet)  { return "FieldSet"; }
  if (op == OpCode::EnumVariant_) { return "EnumVariant"; }
  if (op == OpCode::ArrayNew)     { return "ArrayNew"; }
  if (op == OpCode::IndexGet)     { return "IndexGet"; }
  if (op == OpCode::IndexSet)     { return "IndexSet"; }
  if (op == OpCode::ArrayLen)      { return "ArrayLen"; }
  if (op == OpCode::ArrayPush)     { return "ArrayPush"; }
  if (op == OpCode::ArrayResize)   { return "ArrayResize"; }
  if (op == OpCode::ArrayPop)      { return "ArrayPop"; }
  if (op == OpCode::ArrayRemove)   { return "ArrayRemove"; }
  if (op == OpCode::ArrayContains) { return "ArrayContains"; }
  if (op == OpCode::ArrayClear)    { return "ArrayClear"; }
  if (op == OpCode::ArrayInsert)   { return "ArrayInsert"; }
  if (op == OpCode::ArrayIndexOf)  { return "ArrayIndexOf"; }
  if (op == OpCode::ArraySlice)    { return "ArraySlice"; }
  if (op == OpCode::ArrayReverse)  { return "ArrayReverse"; }
  if (op == OpCode::StringStartsWith) { return "StringStartsWith"; }
  if (op == OpCode::StringEndsWith)   { return "StringEndsWith"; }
  if (op == OpCode::StringReplace)    { return "StringReplace"; }
  if (op == OpCode::StringSplit)      { return "StringSplit"; }
  if (op == OpCode::StringTrim)       { return "StringTrim"; }
  if (op == OpCode::StringToUpper)    { return "StringToUpper"; }
  if (op == OpCode::StringToLower)    { return "StringToLower"; }
  if (op == OpCode::StringToInt)      { return "StringToInt"; }
  if (op == OpCode::StringToFloat)    { return "StringToFloat"; }
  if (op == OpCode::StringCode)       { return "StringCode"; }
  if (op == OpCode::StringCodeAt)     { return "StringCodeAt"; }
  if (op == OpCode::AddI32)      { return "AddI32"; }
  if (op == OpCode::SubtractI32) { return "SubtractI32"; }
  if (op == OpCode::MultiplyI32) { return "MultiplyI32"; }
  if (op == OpCode::DivideI32)   { return "DivideI32"; }
  if (op == OpCode::ModuloI32)   { return "ModuloI32"; }
  if (op == OpCode::EnumVariantPayload) { return "EnumVariantPayload"; }
  if (op == OpCode::EnumPayloadGet)     { return "EnumPayloadGet"; }
  if (op == OpCode::MapNew)    { return "MapNew"; }
  if (op == OpCode::MapGet)    { return "MapGet"; }
  if (op == OpCode::MapSet)    { return "MapSet"; }
  if (op == OpCode::MapHas)    { return "MapHas"; }
  if (op == OpCode::MapRemove) { return "MapRemove"; }
  if (op == OpCode::MapKeys)   { return "MapKeys"; }
  if (op == OpCode::MapLen)    { return "MapLen"; }
  return "Unknown";
}

// Render a Constant the way C++'s Value::operator<< would. Strings print
// raw (no quotes, no escapes) — this matches `out << value.string_storage`
// in vm/value.cc.
string format_constant(Constant v) {
  if (v.kind == ConstKind::Int_)    { return string(v.int_value); }
  if (v.kind == ConstKind::Double_) { return string(v.double_value); }
  if (v.kind == ConstKind::Bool_)   { if (v.bool_value) { return "true"; } return "false"; }
  if (v.kind == ConstKind::Char_)   { return string(byte(v.int_value)); }
  if (v.kind == ConstKind::Null_)   { return "null"; }
  if (v.kind == ConstKind::String_) { return v.string_value; }
  if (v.kind == ConstKind::Function_) { return "<function:" + string(v.aux1) + ">"; }
  if (v.kind == ConstKind::Struct_)   { return "<struct:"   + string(v.aux1) + ">"; }
  if (v.kind == ConstKind::Enum_) {
    return "<enum:" + string(v.aux1) + ":" + string(v.aux2) + ">";
  }
  if (v.kind == ConstKind::Array_)    { return "[]"; }
  if (v.kind == ConstKind::Map_)      { return "{}"; }
  if (v.kind == ConstKind::NativeFn_) { return "<native-fn>"; }
  return "?";
}

// Cast tag printer for OpCode::CastTo. Mirrors the ternary in chunk.cc:96.
string cast_kind_name(int operand) {
  if (operand == 0) { return "int"; }
  if (operand == 1) { return "float"; }
  if (operand == 2) { return "string"; }
  return "?";
}

bool is_native_call(OpCode op) {
  if (op == OpCode::NativeOut)      { return true; }
  if (op == OpCode::NativeOutLn)    { return true; }
  if (op == OpCode::NativeErr)      { return true; }
  if (op == OpCode::NativeErrLn)    { return true; }
  if (op == OpCode::NativeIn)       { return true; }
  if (op == OpCode::NativeInSecret) { return true; }
  if (op == OpCode::NativeFsRead)   { return true; }
  if (op == OpCode::NativeFsWrite)  { return true; }
  if (op == OpCode::NativeSysArgs)  { return true; }
  return false;
}

// Format a single instruction line — no trailing newline.
//
// Extras dispatch matches chunk.cc:79 case-by-case:
//   Constant       -> " #N (val)"
//   LoadLocal /
//   StoreLocal     -> " slot N"
//   Call           -> " args=N"
//   Jmp / JmpFalse -> " +N"
//   CastTo         -> " -> int|float|string|?"
//   Native*        -> " argc=N"
//   ArrayNew       -> " count=N"
//   MapNew         -> " pairs=N"
//   (others)       -> ""
string format_insn(Chunk c, int idx) {
  Instruction ins = c.instructions[idx];
  string head = string(idx)
              + "  "
              + string(ins.line)
              + ":"
              + string(ins.col)
              + "  "
              + opcode_name(ins.op);
  string operand_s = string(ins.operand);

  if (ins.op == OpCode::Constant) {
    Constant v = c.constants[ins.operand];
    return head + " #" + operand_s + " (" + format_constant(v) + ")";
  }
  if (ins.op == OpCode::LoadLocal || ins.op == OpCode::StoreLocal) {
    return head + " slot " + operand_s;
  }
  if (ins.op == OpCode::Call) {
    return head + " args=" + operand_s;
  }
  if (ins.op == OpCode::Jmp || ins.op == OpCode::JmpFalse) {
    return head + " +" + operand_s;
  }
  if (ins.op == OpCode::CastTo) {
    return head + " -> " + cast_kind_name(ins.operand);
  }
  if (is_native_call(ins.op)) {
    return head + " argc=" + operand_s;
  }
  if (ins.op == OpCode::ArrayNew) {
    return head + " count=" + operand_s;
  }
  if (ins.op == OpCode::MapNew) {
    return head + " pairs=" + operand_s;
  }
  return head;
}

// Disassemble the whole chunk. Each instruction emits one line; the result
// is newline-terminated (matches `out << '\n'` after every instruction in
// chunk.cc). No leading/trailing extra lines.
pub string disassemble(Chunk c) {
  string out = "";
  for (int i = 0; i < c.instructions.len(); i = i + 1) {
    out = out + format_insn(c, i) + "\n";
  }
  return out;
}
