// Bytecode disassembler — Kinglet mirror of kinglet-bootstrap/src/vm/chunk.cc:79
// (Chunk::disassemble) and chunk.cc:127 (opcode_name).
//
// The output of `disassemble(chunk)` MUST match the bootstrap compiler's
// `--bytecode` flag byte-for-byte for any chunk both compilers can produce.
// That equivalence is the golden contract used to validate self-host codegen
// before we commit to byte-identical bootstrap fixpoint.
//
// Format per instruction (one line, terminated with '\n'):
//
//   <idx>  <line>:<col>  <opname>[ <extras>]
//
// where <extras> is opcode-dependent. See dispatch in `disassemble` below.
//
// Constant printing follows Value::operator<<  (vm/value.cc:100). Strings
// print without quotes, doubles use C++ default precision (6 significant
// digits, no trailing zero), bools as "true"/"false", null as "null".

export module compiler.disasm;

import compiler.bytecode;
using namespace compiler.bytecode;

string opcode_name(int op) {
  if (op == vm_opcode_ord(OpCode::Constant)) { return "Constant"; }
  if (op == vm_opcode_ord(OpCode::Null_))    { return "Null"; }
  if (op == vm_opcode_ord(OpCode::True_))    { return "True"; }
  if (op == vm_opcode_ord(OpCode::False_))   { return "False"; }
  if (op == vm_opcode_ord(OpCode::Add))      { return "Add"; }
  if (op == vm_opcode_ord(OpCode::Subtract)) { return "Subtract"; }
  if (op == vm_opcode_ord(OpCode::Multiply)) { return "Multiply"; }
  if (op == vm_opcode_ord(OpCode::Divide))   { return "Divide"; }
  if (op == vm_opcode_ord(OpCode::Modulo))   { return "Modulo"; }
  if (op == vm_opcode_ord(OpCode::Negate))   { return "Negate"; }
  if (op == vm_opcode_ord(OpCode::Not_))     { return "Not"; }
  if (op == vm_opcode_ord(OpCode::BitNot))   { return "BitNot"; }
  if (op == vm_opcode_ord(OpCode::BitAnd))   { return "BitAnd"; }
  if (op == vm_opcode_ord(OpCode::BitOr))    { return "BitOr"; }
  if (op == vm_opcode_ord(OpCode::BitXor))   { return "BitXor"; }
  if (op == vm_opcode_ord(OpCode::Shl))      { return "Shl"; }
  if (op == vm_opcode_ord(OpCode::Shr))      { return "Shr"; }
  if (op == vm_opcode_ord(OpCode::LoadLocal))  { return "LoadLocal"; }
  if (op == vm_opcode_ord(OpCode::StoreLocal)) { return "StoreLocal"; }
  if (op == vm_opcode_ord(OpCode::Pop))      { return "Pop"; }
  if (op == vm_opcode_ord(OpCode::Dup))      { return "Dup"; }
  if (op == vm_opcode_ord(OpCode::IsNull))   { return "IsNull"; }
  if (op == vm_opcode_ord(OpCode::CastTo))   { return "CastTo"; }
  if (op == vm_opcode_ord(OpCode::Call))     { return "Call"; }
  if (op == vm_opcode_ord(OpCode::Return_))  { return "Return"; }
  if (op == vm_opcode_ord(OpCode::Jmp))      { return "Jmp"; }
  if (op == vm_opcode_ord(OpCode::JmpFalse)) { return "JmpFalse"; }
  if (op == vm_opcode_ord(OpCode::JmpIfErr))    { return "JmpIfErr"; }
  if (op == vm_opcode_ord(OpCode::PushHandler)) { return "PushHandler"; }
  if (op == vm_opcode_ord(OpCode::PopHandler))  { return "PopHandler"; }
  if (op == vm_opcode_ord(OpCode::PropagateErr)) { return "PropagateErr"; }
  if (op == vm_opcode_ord(OpCode::Eq))       { return "Eq"; }
  if (op == vm_opcode_ord(OpCode::Neq))      { return "Neq"; }
  if (op == vm_opcode_ord(OpCode::Lt))       { return "Lt"; }
  if (op == vm_opcode_ord(OpCode::Gt))       { return "Gt"; }
  if (op == vm_opcode_ord(OpCode::Le))       { return "Le"; }
  if (op == vm_opcode_ord(OpCode::Ge))       { return "Ge"; }
  if (op == vm_opcode_ord(OpCode::NativeOut))      { return "NativeOut"; }
  if (op == vm_opcode_ord(OpCode::NativeOutLn))    { return "NativeOutLn"; }
  if (op == vm_opcode_ord(OpCode::NativeErr))      { return "NativeErr"; }
  if (op == vm_opcode_ord(OpCode::NativeErrLn))    { return "NativeErrLn"; }
  if (op == vm_opcode_ord(OpCode::NativeIn))       { return "NativeIn"; }
  if (op == vm_opcode_ord(OpCode::NativeInSecret)) { return "NativeInSecret"; }
  if (op == vm_opcode_ord(OpCode::NativeFsRead))   { return "NativeFsRead"; }
  if (op == vm_opcode_ord(OpCode::NativeFsWrite))  { return "NativeFsWrite"; }
  if (op == vm_opcode_ord(OpCode::NativeFsListdir)) { return "NativeFsListdir"; }
  if (op == vm_opcode_ord(OpCode::NativeSysArgs))  { return "NativeSysArgs"; }
  if (op == vm_opcode_ord(OpCode::StructNew)) { return "StructNew"; }
  if (op == vm_opcode_ord(OpCode::FieldGet))  { return "FieldGet"; }
  if (op == vm_opcode_ord(OpCode::FieldSet))  { return "FieldSet"; }
  if (op == vm_opcode_ord(OpCode::EnumVariant_)) { return "EnumVariant"; }
  if (op == vm_opcode_ord(OpCode::ArrayNew))     { return "ArrayNew"; }
  if (op == vm_opcode_ord(OpCode::IndexGet))     { return "IndexGet"; }
  if (op == vm_opcode_ord(OpCode::IndexSet))     { return "IndexSet"; }
  if (op == vm_opcode_ord(OpCode::ArrayLen))      { return "ArrayLen"; }
  if (op == vm_opcode_ord(OpCode::ArrayPush))     { return "ArrayPush"; }
  if (op == vm_opcode_ord(OpCode::ArrayResize))   { return "ArrayResize"; }
  if (op == vm_opcode_ord(OpCode::ArrayPop))      { return "ArrayPop"; }
  if (op == vm_opcode_ord(OpCode::ArrayRemove))   { return "ArrayRemove"; }
  if (op == vm_opcode_ord(OpCode::ArrayContains)) { return "ArrayContains"; }
  if (op == vm_opcode_ord(OpCode::ArrayClear))    { return "ArrayClear"; }
  if (op == vm_opcode_ord(OpCode::ArrayInsert))   { return "ArrayInsert"; }
  if (op == vm_opcode_ord(OpCode::ArrayIndexOf))  { return "ArrayIndexOf"; }
  if (op == vm_opcode_ord(OpCode::ArraySlice))    { return "ArraySlice"; }
  if (op == vm_opcode_ord(OpCode::ArrayReverse))  { return "ArrayReverse"; }
  if (op == vm_opcode_ord(OpCode::StringStartsWith)) { return "StringStartsWith"; }
  if (op == vm_opcode_ord(OpCode::StringEndsWith))   { return "StringEndsWith"; }
  if (op == vm_opcode_ord(OpCode::StringReplace))    { return "StringReplace"; }
  if (op == vm_opcode_ord(OpCode::StringSplit))      { return "StringSplit"; }
  if (op == vm_opcode_ord(OpCode::StringTrim))       { return "StringTrim"; }
  if (op == vm_opcode_ord(OpCode::StringToUpper))    { return "StringToUpper"; }
  if (op == vm_opcode_ord(OpCode::StringToLower))    { return "StringToLower"; }
  if (op == vm_opcode_ord(OpCode::StringToInt))      { return "StringToInt"; }
  if (op == vm_opcode_ord(OpCode::StringToFloat))    { return "StringToFloat"; }
  if (op == vm_opcode_ord(OpCode::StringCode))       { return "StringCode"; }
  if (op == vm_opcode_ord(OpCode::StringCodeAt))     { return "StringCodeAt"; }
  if (op == vm_opcode_ord(OpCode::AddI32))      { return "AddI32"; }
  if (op == vm_opcode_ord(OpCode::SubtractI32)) { return "SubtractI32"; }
  if (op == vm_opcode_ord(OpCode::MultiplyI32)) { return "MultiplyI32"; }
  if (op == vm_opcode_ord(OpCode::DivideI32))   { return "DivideI32"; }
  if (op == vm_opcode_ord(OpCode::ModuloI32))   { return "ModuloI32"; }
  if (op == vm_opcode_ord(OpCode::DenseArrayNew)) { return "DenseArrayNew"; }
  if (op == vm_opcode_ord(OpCode::EnumVariantPayload)) { return "EnumVariantPayload"; }
  if (op == vm_opcode_ord(OpCode::EnumPayloadGet))     { return "EnumPayloadGet"; }
  if (op == vm_opcode_ord(OpCode::MapNew))    { return "MapNew"; }
  if (op == vm_opcode_ord(OpCode::MapGet))    { return "MapGet"; }
  if (op == vm_opcode_ord(OpCode::MapSet))    { return "MapSet"; }
  if (op == vm_opcode_ord(OpCode::MapHas))    { return "MapHas"; }
  if (op == vm_opcode_ord(OpCode::MapRemove)) { return "MapRemove"; }
  if (op == vm_opcode_ord(OpCode::MapKeys))   { return "MapKeys"; }
  if (op == vm_opcode_ord(OpCode::MapLen))    { return "MapLen"; }
  return "Unknown";
}

// Render a Constant the way C++'s Value::operator<< would. Strings print
// raw (no quotes, no escapes) — this matches `out << value.string_storage`
// in vm/value.cc.
string format_constant(Constant v) {
  if (v.kind == ConstKind::Int_)    { return string(v.int_value); }
  if (v.kind == ConstKind::Double_) { return string(v.double_value); }
  if (v.kind == ConstKind::Bool_)   { if (v.bool_value) { return "true"; } return "false"; }
  if (v.kind == ConstKind::Char_)   { return string(byte(v.int_value)); }
  if (v.kind == ConstKind::Null_)   { return "null"; }
  if (v.kind == ConstKind::String_) { return v.string_value; }
  if (v.kind == ConstKind::Function_) { return "<function:" + string(v.aux1) + ">"; }
  if (v.kind == ConstKind::Struct_)   { return "<struct:"   + string(v.aux1) + ">"; }
  if (v.kind == ConstKind::Enum_) {
    return "<enum:" + string(v.aux1) + ":" + string(v.aux2) + ">";
  }
  if (v.kind == ConstKind::Array_)    { return "[]"; }
  if (v.kind == ConstKind::Map_)      { return "{}"; }
  if (v.kind == ConstKind::NativeFn_) { return "<native-fn>"; }
  return "?";
}

// Cast tag printer for OpCode::CastTo. Mirrors the ternary in chunk.cc:96.
string cast_kind_name(int operand) {
  if (operand == 0) { return "int"; }
  if (operand == 1) { return "float"; }
  if (operand == 2) { return "string"; }
  return "?";
}

bool is_native_call(int op) {
  if (op == vm_opcode_ord(OpCode::NativeOut))      { return true; }
  if (op == vm_opcode_ord(OpCode::NativeOutLn))    { return true; }
  if (op == vm_opcode_ord(OpCode::NativeErr))      { return true; }
  if (op == vm_opcode_ord(OpCode::NativeErrLn))    { return true; }
  if (op == vm_opcode_ord(OpCode::NativeIn))       { return true; }
  if (op == vm_opcode_ord(OpCode::NativeInSecret)) { return true; }
  if (op == vm_opcode_ord(OpCode::NativeFsRead))   { return true; }
  if (op == vm_opcode_ord(OpCode::NativeFsWrite))  { return true; }
  if (op == vm_opcode_ord(OpCode::NativeFsListdir)) { return true; }
  if (op == vm_opcode_ord(OpCode::NativeSysArgs))  { return true; }
  return false;
}

// Format a single instruction line — no trailing newline.
//
// Extras dispatch matches chunk.cc:79 case-by-case:
//   Constant       -> " #N (val)"
//   LoadLocal /
//   StoreLocal     -> " slot N"
//   Call           -> " args=N"
//   Jmp / JmpFalse -> " +N"
//   CastTo         -> " -> int|float|string|?"
//   Native*        -> " argc=N"
//   ArrayNew       -> " count=N"
//   MapNew         -> " pairs=N"
//   (others)       -> ""
string format_insn(Chunk c, int idx) {
  Instruction ins = c.instructions[idx];
  string head = string(idx)
              + "  "
              + string(ins.line)
              + ":"
              + string(ins.col)
              + "  "
              + opcode_name(ins.op);
  string operand_s = string(ins.operand);

  if (ins.op == vm_opcode_ord(OpCode::Constant)) {
    Constant v = c.constants[ins.operand];
    return head + " #" + operand_s + " (" + format_constant(v) + ")";
  }
  if (ins.op == vm_opcode_ord(OpCode::LoadLocal) || ins.op == vm_opcode_ord(OpCode::StoreLocal)) {
    return head + " slot " + operand_s;
  }
  if (ins.op == vm_opcode_ord(OpCode::Call)) {
    return head + " args=" + operand_s;
  }
  if (ins.op == vm_opcode_ord(OpCode::Jmp) || ins.op == vm_opcode_ord(OpCode::JmpFalse)) {
    return head + " +" + operand_s;
  }
  if (ins.op == vm_opcode_ord(OpCode::CastTo)) {
    return head + " -> " + cast_kind_name(ins.operand);
  }
  if (is_native_call(ins.op)) {
    return head + " argc=" + operand_s;
  }
  if (ins.op == vm_opcode_ord(OpCode::ArrayNew)) {
    return head + " count=" + operand_s;
  }
  if (ins.op == vm_opcode_ord(OpCode::MapNew)) {
    return head + " pairs=" + operand_s;
  }
  if (ins.op == vm_opcode_ord(OpCode::DenseArrayNew)) {
    int rows = ins.operand / 65536;
    int cols = ins.operand % 65536;
    return head + " rows=" + string(rows) + " cols=" + string(cols);
  }
  return head;
}

// Disassemble the whole chunk. Each instruction emits one line; the result
// is newline-terminated (matches `out << '\n'` after every instruction in
// chunk.cc). No leading/trailing extra lines.
pub string disassemble(Chunk c) {
  string out = "";
  for (int i = 0; i < c.instructions.len(); i = i + 1) {
    out = out + format_insn(c, i) + "\n";
  }
  return out;
}
