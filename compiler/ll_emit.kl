// KIR → textual LLVM IR emitter.

export module compiler.ll_emit;

import ir.ir;
import compiler.bytecode;
using namespace ir.ir;
using namespace compiler.bytecode;

// --- IEEE 754 double → hex literal ---

// Exact IEEE-754 bits of a double, formatted as a 16-digit LLVM hex literal.
// The emitter runs on the VM, which has native floats, so int::bits(d) yields
// the precise i64 bit pattern (kl_float_to_bits) — no manual exponent/mantissa
// extraction. Nibbles are masked low-to-high; 16 iterations drain the value
// so the arithmetic >> never leaks sign bits into the result.
string double_to_hex(float d) {
  int bits = int::bits(d);
  string digits = "0123456789abcdef";
  string hex = "";
  for (int i = 0; i < 16; i = i + 1) {
    int nib = bits & 15;
    hex = digits.slice(nib, nib + 1) + hex;
    bits = bits >> 4;
  }
  return "0x" + hex;
}

// Two lowercase hex digits for a byte value 0..255.
string hex2(int b) {
  string d = "0123456789ABCDEF";
  int hi = (b >> 4) & 15;
  int lo = b & 15;
  return d.slice(hi, hi + 1) + d.slice(lo, lo + 1);
}

// Escape a kinglet string's bytes as LLVM c"..." content: every byte as \HH.
// Byte access uses int(s[i]) (string index -> char -> code), the kinglet design.
string llvm_str_escape(string s) {
  string out = "";
  for (int i = 0; i < s.len(); i = i + 1) {
    out = out + "\\" + hex2(int(s[i]));
  }
  return out;
}

// --- KIR opcode helpers ---

bool is_bin_op(KirOpcode op) {
  return op == KirOpcode::IAdd || op == KirOpcode::ISub || op == KirOpcode::IMul || op == KirOpcode::IDiv || op == KirOpcode::IMod
      || op == KirOpcode::IAnd || op == KirOpcode::IOr || op == KirOpcode::IXor || op == KirOpcode::IShl || op == KirOpcode::IShr;
}

string ll_bin_op(KirOpcode op) {
  if (op == KirOpcode::IAdd) { return "add"; }
  if (op == KirOpcode::ISub) { return "sub"; }
  if (op == KirOpcode::IMul) { return "mul"; }
  if (op == KirOpcode::IDiv) { return "sdiv"; }
  if (op == KirOpcode::IMod) { return "srem"; }
  if (op == KirOpcode::IAnd) { return "and"; }
  if (op == KirOpcode::IOr) { return "or"; }
  if (op == KirOpcode::IXor) { return "xor"; }
  if (op == KirOpcode::IShl) { return "shl"; }
  if (op == KirOpcode::IShr) { return "lshr"; }
  return "add";
}

bool is_cmp(KirOpcode op) {
  return op == KirOpcode::IEq || op == KirOpcode::INe || op == KirOpcode::ILt || op == KirOpcode::IGt || op == KirOpcode::ILe || op == KirOpcode::IGe;
}

int[] compute_leaders(KirInstr[] instrs) {
  int n = instrs.len();
  bool[] marks = [];
  for (int i = 0; i < n; i = i + 1) { marks.push(false); }
  if (n > 0) { marks[0] = true; }
  for (int i = 0; i < n; i = i + 1) {
    KirInstr ins = instrs[i];
    if (ins.op == KirOpcode::Br || ins.op == KirOpcode::CondBr) {
      int target = ins.operands[0];
      if (target >= 0 && target < n) { marks[target] = true; }
      if (i + 1 < n) { marks[i + 1] = true; }
    }
    if (ins.op == KirOpcode::JmpIfErr) {
      int target = ins.operands[0];
      int err_t = i + 1 + target;
      if (err_t >= 0 && err_t < n) { marks[err_t] = true; }
      if (i + 1 < n) { marks[i + 1] = true; }
    }
    if (ins.op == KirOpcode::PropagateErr) {
      if (i + 1 < n) { marks[i + 1] = true; }
    }
    if (ins.op == KirOpcode::PushHandler) {
      int target = ins.operands[0];
      int landing = i + 1 + target;
      if (landing >= 0 && landing < n) { marks[landing] = true; }
    }
    if (ins.op == KirOpcode::Ret) {
      if (i + 1 < n) { marks[i + 1] = true; }
    }
  }
  int[] leaders = [];
  for (int i = 0; i < n; i = i + 1) {
    if (marks[i]) { leaders.push(i); }
  }
  return leaders;
}

string label_for(int[] leaders, int idx) {
  for (int k = 0; k < leaders.len(); k = k + 1) {
    if (leaders[k] == idx) {
      if (k == 0) { return "entry"; }
      return "bb" + string(k);
    }
  }
  return "entry";
}

int count_locals(KirInstr[] instrs) {
  int max_slot = -1;
  for (int i = 0; i < instrs.len(); i = i + 1) {
    KirInstr ins = instrs[i];
    if (ins.op == KirOpcode::StoreLocal || ins.op == KirOpcode::LoadLocal) {
      if (ins.operands[0] > max_slot) { max_slot = ins.operands[0]; }
    }
  }
  return max_slot + 1;
}

string mangle(string name) {
  if (name == "main") { return "kinglet_user_main"; }
  return "kinglet_fn_" + name;
}

string resolve_target(KirModule m, int fn_idx) {
  for (int i = 0; i < m.functions.len(); i = i + 1) {
    if (m.functions[i].fn_index == fn_idx) { return mangle(m.functions[i].name); }
  }
  return "kinglet_fn_unknown";
}

int leader_pos(int[] leaders, int idx) {
  for (int k = 0; k < leaders.len(); k = k + 1) {
    if (leaders[k] == idx) { return k; }
  }
  return 0;
}

string emit_function_body(KirFunction fn, KirModule m, Chunk ch) {
  KirInstr[] instrs = fn.blocks[0].instrs;
  int n = instrs.len();
  int[] leaders = compute_leaders(instrs);
  int nl = leaders.len();
  // Resolve each PropagateErr to its catch landing by simulating the
  // PushHandler/PopHandler stack in source order.
  int[] prop_idx = [];
  int[] prop_catch = [];
  int[] handler_landings = [];
  {
    int[] hstack = [];
    for (int i = 0; i < n; i = i + 1) {
      KirInstr hins = instrs[i];
      if (hins.op == KirOpcode::PushHandler) {
        int landing = i + 1 + hins.operands[0];
        hstack.push(landing);
        handler_landings.push(landing);
      } else if (hins.op == KirOpcode::PopHandler) {
        if (hstack.len() > 0) { hstack.pop(); }
      } else if (hins.op == KirOpcode::PropagateErr) {
        int ct = 0;
        if (hstack.len() > 0) { ct = hstack[hstack.len() - 1]; }
        prop_idx.push(i);
        prop_catch.push(ct);
      }
    }
  }
  int[] edge_pred = [];
  int[] edge_succ = [];
  for (int k = 0; k < nl; k = k + 1) {
    int lend = n;
    if (k + 1 < nl) { lend = leaders[k + 1]; }
    KirInstr last = instrs[lend - 1];
    if (last.op == KirOpcode::Br) {
      edge_pred.push(k);
      edge_succ.push(leader_pos(leaders, last.operands[0]));
    } else if (last.op == KirOpcode::CondBr) {
      edge_pred.push(k);
      edge_succ.push(k + 1);
      edge_pred.push(k);
      edge_succ.push(leader_pos(leaders, last.operands[0]));
    } else if (last.op == KirOpcode::JmpIfErr) {
      int jidx = lend - 1;
      edge_pred.push(k);
      edge_succ.push(k + 1);
      edge_pred.push(k);
      edge_succ.push(leader_pos(leaders, jidx + 1 + last.operands[0]));
    } else if (last.op == KirOpcode::PropagateErr) {
      int pidx = lend - 1;
      int pcatch = 0;
      for (int qi = 0; qi < prop_idx.len(); qi = qi + 1) {
        if (prop_idx[qi] == pidx) { pcatch = prop_catch[qi]; }
      }
      edge_pred.push(k);
      edge_succ.push(k + 1);
      edge_pred.push(k);
      edge_succ.push(leader_pos(leaders, pcatch));
    } else if (last.op != KirOpcode::Ret) {
      if (k + 1 < nl) {
        edge_pred.push(k);
        edge_succ.push(k + 1);
      }
    }
  }
  string[][] exit_stacks = [];
  int[][] exit_types = [];
  for (int k = 0; k < nl; k = k + 1) { exit_stacks.push([]); exit_types.push([]); }
  // Track local slot types: 0=int, 1=float
  int[] local_types = [];
  for (int li = 0; li < 128; li = li + 1) { local_types.push(0); }
  string out = "";
  int reg = 0;
  for (int bi = 0; bi < nl; bi = bi + 1) {
    int lstart = leaders[bi];
    int lend = n;
    if (bi + 1 < nl) { lend = leaders[bi + 1]; }
    int[] pp = [];
    for (int e = 0; e < edge_pred.len(); e = e + 1) {
      if (edge_succ[e] == bi && edge_pred[e] < bi) { pp.push(edge_pred[e]); }
    }
    string[] vstack = [];
    int[] tstack = [];
    string phis = "";
    if (pp.len() == 0) {
      bool is_landing = false;
      for (int hi = 0; hi < handler_landings.len(); hi = hi + 1) {
        if (handler_landings[hi] == lstart) { is_landing = true; }
      }
      // Dead catch (no propagating op inside the try): synthesize the error
      // binding slot so the catch body's StoreLocal can pop.
      if (is_landing) { vstack.push("0"); tstack.push(0); }
    } else if (pp.len() == 1) {
      string[] src = exit_stacks[pp[0]];
      int[] tsrc = exit_types[pp[0]];
      for (int q = 0; q < src.len(); q = q + 1) { vstack.push(src[q]); }
      for (int q = 0; q < tsrc.len(); q = q + 1) { tstack.push(tsrc[q]); }
    } else if (pp.len() > 1) {
      int d = exit_stacks[pp[0]].len();
      for (int j = 0; j < d; j = j + 1) {
        string v = exit_stacks[pp[0]][j];
        int ty = 0;
        if (j < exit_types[pp[0]].len()) { ty = exit_types[pp[0]][j]; }
        bool same = true;
        for (int p = 1; p < pp.len(); p = p + 1) {
          if (exit_stacks[pp[p]][j] != v) { same = false; }
        }
        if (same) {
          vstack.push(v);
          tstack.push(ty);
        } else {
          string r = "%" + string(reg);
          reg = reg + 1;
          string ph = "  " + r + " = phi i64 ";
          for (int p = 0; p < pp.len(); p = p + 1) {
            if (p > 0) { ph = ph + ", "; }
            ph = ph + "[ " + exit_stacks[pp[p]][j] + ", %" + label_for(leaders, leaders[pp[p]]) + " ]";
          }
          phis = phis + ph + "\n";
          vstack.push(r);
          // Merge types: if any pred is float, result is float
          int mty = ty;
          for (int p = 1; p < pp.len(); p = p + 1) {
            if (j < exit_types[pp[p]].len() && exit_types[pp[p]][j] == 1) { mty = 1; }
          }
          tstack.push(mty);
        }
      }
    }
    if (bi > 0) {
      out = out + label_for(leaders, lstart) + ":\n";
    }
    out = out + phis;
    bool terminated = false;
    for (int i = lstart; i < lend; i = i + 1) {
      KirInstr ins = instrs[i];
      if (ins.op == KirOpcode::Ret) {
        if (vstack.len() > 0) {
          string v = vstack[vstack.len() - 1];
          out = out + "  ret i64 " + v + "\n";
        } else {
          out = out + "  ret i64 0\n";
        }
        terminated = true;
      } else if (ins.op == KirOpcode::Br) {
        out = out + "  br label %" + label_for(leaders, ins.operands[0]) + "\n";
        terminated = true;
      } else if (ins.op == KirOpcode::CondBr) {
        string cond = vstack[vstack.len() - 1];
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string t = "%" + string(reg);
        reg = reg + 1;
        out = out + "  " + t + " = icmp ne i64 " + cond + ", 0\n";
        out = out + "  br i1 " + t + ", label %" + label_for(leaders, i + 1) + ", label %" + label_for(leaders, ins.operands[0]) + "\n";
        terminated = true;
      } else if (ins.op == KirOpcode::JmpIfErr) {
        // Peek (no pop): both branches keep the value on the wire.
        string je_top = vstack[vstack.len() - 1];
        string je_is = "%" + string(reg); reg = reg + 1;
        out = out + "  " + je_is + " = call i32 @kl_value_is_err(i64 " + je_top + ")\n";
        string je_c = "%" + string(reg); reg = reg + 1;
        out = out + "  " + je_c + " = icmp ne i32 " + je_is + ", 0\n";
        int je_err = i + 1 + ins.operands[0];
        out = out + "  br i1 " + je_c + ", label %" + label_for(leaders, je_err) + ", label %" + label_for(leaders, i + 1) + "\n";
        terminated = true;
      } else if (ins.op == KirOpcode::PropagateErr) {
        string pe_top = vstack[vstack.len() - 1];
        string pe_is = "%" + string(reg); reg = reg + 1;
        out = out + "  " + pe_is + " = call i32 @kl_value_is_err(i64 " + pe_top + ")\n";
        string pe_c = "%" + string(reg); reg = reg + 1;
        out = out + "  " + pe_c + " = icmp ne i32 " + pe_is + ", 0\n";
        int pe_catch = 0;
        for (int qi = 0; qi < prop_idx.len(); qi = qi + 1) {
          if (prop_idx[qi] == i) { pe_catch = prop_catch[qi]; }
        }
        out = out + "  br i1 " + pe_c + ", label %" + label_for(leaders, pe_catch) + ", label %" + label_for(leaders, i + 1) + "\n";
        terminated = true;
      } else if (ins.op == KirOpcode::PushHandler || ins.op == KirOpcode::PopHandler) {
        // Compile-time handler markers: no IR, no stack effect.
      } else if (ins.op == KirOpcode::ConstInt) {
        int lo = ins.operands[0];
        int hi = ins.operands[1];
        vstack.push(string((hi << 32) | lo));
        tstack.push(0);
      } else if (ins.op == KirOpcode::ConstNull) {
        vstack.push("0");
        tstack.push(0);
      } else if (ins.op == KirOpcode::ConstString) {
        int cs_pool = ins.operands[0];
        int cs_len = 0;
        string cs_global = "";
        if (cs_pool >= 0 && cs_pool < ch.constants.len()) {
          Constant csk = ch.constants[cs_pool];
          if (csk.kind == ConstKind::String_) {
            cs_len = csk.string_value.len();
            cs_global = "@.str." + string(cs_pool);
          }
        }
        string cs_gep = "%" + string(reg); reg = reg + 1;
        out = out + "  " + cs_gep + " = bitcast [" + string(cs_len) + " x i8]* " + cs_global + " to i8*\n";
        string cs_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + cs_r + " = call i64 @kl_string_new(i8* " + cs_gep + ", i32 " + string(cs_len) + ")\n";
        vstack.push(cs_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::ConstFloat) {
        int cidx = ins.operands[0];
        float dbl = ch.constants[cidx].double_value;
        string hex = double_to_hex(dbl);
        string r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + r + " = call i64 @kl_float_new(double " + hex + ")\n";
        vstack.push(r);
        tstack.push(1);
      } else if (is_bin_op(ins.op)) {
        string b = vstack[vstack.len() - 1];
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string a = vstack[vstack.len() - 1];
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        if (ins.result_type == KirType::Float) {
          // Float arithmetic: unbox → fop → box
          string la = "%" + string(reg); reg = reg + 1;
          out = out + "  " + la + " = call double @kl_float_get(i64 " + a + ")\n";
          string rb = "%" + string(reg); reg = reg + 1;
          out = out + "  " + rb + " = call double @kl_float_get(i64 " + b + ")\n";
          string fr = "%" + string(reg); reg = reg + 1;
          string fop = "fadd";
          if (ins.op == KirOpcode::ISub) { fop = "fsub"; }
          if (ins.op == KirOpcode::IMul) { fop = "fmul"; }
          if (ins.op == KirOpcode::IDiv) { fop = "fdiv"; }
          if (ins.op == KirOpcode::IMod) { fop = "frem"; }
          out = out + "  " + fr + " = " + fop + " double " + la + ", " + rb + "\n";
          string r = "%" + string(reg); reg = reg + 1;
          out = out + "  " + r + " = call i64 @kl_float_new(double " + fr + ")\n";
          vstack.push(r);
          tstack.push(1);
        } else if (ins.result_type == KirType::String) {
          // String concat via the runtime's polymorphic add.
          string r = "%" + string(reg); reg = reg + 1;
          out = out + "  " + r + " = call i64 @kl_value_add(i64 " + a + ", i64 " + b + ")\n";
          vstack.push(r);
          tstack.push(0);
        } else {
          string r = "%" + string(reg);
          reg = reg + 1;
          out = out + "  " + r + " = " + ll_bin_op(ins.op) + " i64 " + a + ", " + b + "\n";
          vstack.push(r);
          tstack.push(0);
        }
      } else if (is_cmp(ins.op)) {
        // Check operand types before popping
        int ty_b = 0; if (tstack.len() > 0) { ty_b = tstack[tstack.len() - 1]; }
        string b = vstack[vstack.len() - 1];
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        int ty_a = 0; if (tstack.len() > 0) { ty_a = tstack[tstack.len() - 1]; }
        string a = vstack[vstack.len() - 1];
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        bool is_float_cmp = ty_a == 1 || ty_b == 1;
        if (is_float_cmp) {
          // Float comparison: unbox → fcmp → zext → box
          string la = "%" + string(reg); reg = reg + 1;
          out = out + "  " + la + " = call double @kl_float_get(i64 " + a + ")\n";
          string rb = "%" + string(reg); reg = reg + 1;
          out = out + "  " + rb + " = call double @kl_float_get(i64 " + b + ")\n";
          string c = "%" + string(reg); reg = reg + 1;
          string pred = "oeq";
          if (ins.op == KirOpcode::INe) { pred = "one"; }
          if (ins.op == KirOpcode::ILt) { pred = "olt"; }
          if (ins.op == KirOpcode::IGt) { pred = "ogt"; }
          if (ins.op == KirOpcode::ILe) { pred = "ole"; }
          if (ins.op == KirOpcode::IGe) { pred = "oge"; }
          out = out + "  " + c + " = fcmp " + pred + " double " + la + ", " + rb + "\n";
          string z = "%" + string(reg); reg = reg + 1;
          out = out + "  " + z + " = zext i1 " + c + " to i64\n";
          vstack.push(z);
          tstack.push(0);
        } else {
          // Non-float compares go through the runtime's polymorphic
          // kl_value_eq / kl_value_cmp so enums (inline-marked or heap) and
          // strings compare by value, not by raw bits. Result normalised to
          // i64 0/1 to match the stack convention. Temporaries are allocated
          // in emission order so LLVM instruction numbering stays sequential.
          if (ins.op == KirOpcode::IEq) {
            string c = "%" + string(reg); reg = reg + 1;
            out = out + "  " + c + " = call i32 @kl_value_eq(i64 " + a + ", i64 " + b + ")\n";
            string r = "%" + string(reg); reg = reg + 1;
            out = out + "  " + r + " = zext i32 " + c + " to i64\n";
            vstack.push(r);
          } else if (ins.op == KirOpcode::INe) {
            string c = "%" + string(reg); reg = reg + 1;
            out = out + "  " + c + " = call i32 @kl_value_eq(i64 " + a + ", i64 " + b + ")\n";
            string z = "%" + string(reg); reg = reg + 1;
            out = out + "  " + z + " = icmp eq i32 " + c + ", 0\n";
            string r = "%" + string(reg); reg = reg + 1;
            out = out + "  " + r + " = zext i1 " + z + " to i64\n";
            vstack.push(r);
          } else {
            // Relational: kl_value_cmp returns -1/0/1; compare against 0.
            string c = "%" + string(reg); reg = reg + 1;
            out = out + "  " + c + " = call i32 @kl_value_cmp(i64 " + a + ", i64 " + b + ")\n";
            string pred = "slt";
            if (ins.op == KirOpcode::IGt) { pred = "sgt"; }
            if (ins.op == KirOpcode::ILe) { pred = "sle"; }
            if (ins.op == KirOpcode::IGe) { pred = "sge"; }
            string z = "%" + string(reg); reg = reg + 1;
            out = out + "  " + z + " = icmp " + pred + " i32 " + c + ", 0\n";
            string r = "%" + string(reg); reg = reg + 1;
            out = out + "  " + r + " = zext i1 " + z + " to i64\n";
            vstack.push(r);
          }
          tstack.push(0);
        }
      } else if (ins.op == KirOpcode::IsNull) {
        string iv = vstack[vstack.len() - 1]; vstack.pop();
        if (tstack.len() > 0) { tstack.pop(); }
        string c = "%" + string(reg); reg = reg + 1;
        out = out + "  " + c + " = icmp eq i64 " + iv + ", 0\n";
        string r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + r + " = zext i1 " + c + " to i64\n";
        vstack.push(r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::CastTo) {
        int ck = ins.operands[0];
        string cv = vstack[vstack.len() - 1]; vstack.pop();
        if (tstack.len() > 0) { tstack.pop(); }
        // All stack values are boxed i64 (floats included), so every cast takes
        // an i64 and returns the boxed result. kind: 0=int 1=float 2=string 3=char.
        string fn_name = "kl_cast_to_int";
        int res_ty = 0;
        if (ck == 1) { fn_name = "kl_cast_to_float"; res_ty = 1; }
        if (ck == 2) { fn_name = "kl_cast_to_string"; res_ty = 0; }
        if (ck == 3) { fn_name = "kl_cast_to_char"; res_ty = 0; }
        string r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + r + " = call i64 @" + fn_name + "(i64 " + cv + ")\n";
        vstack.push(r);
        tstack.push(res_ty);
      } else if (ins.op == KirOpcode::INeg || ins.op == KirOpcode::IBNot) {
        string a = vstack[vstack.len() - 1];
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        if (ins.result_type == KirType::Float && ins.op == KirOpcode::INeg) {
          // Float negation: unbox → fneg → box
          string fa = "%" + string(reg); reg = reg + 1;
          out = out + "  " + fa + " = call double @kl_float_get(i64 " + a + ")\n";
          string fng = "%" + string(reg); reg = reg + 1;
          out = out + "  " + fng + " = fneg double " + fa + "\n";
          string r = "%" + string(reg); reg = reg + 1;
          out = out + "  " + r + " = call i64 @kl_float_new(double " + fng + ")\n";
          vstack.push(r);
          tstack.push(1);
        } else {
          string r = "%" + string(reg);
          reg = reg + 1;
          if (ins.op == KirOpcode::INeg) {
            out = out + "  " + r + " = sub i64 0, " + a + "\n";
          } else {
            out = out + "  " + r + " = xor i64 " + a + ", -1\n";
          }
          vstack.push(r);
          tstack.push(0);
        }
      } else if (ins.op == KirOpcode::LNot) {
        string lna = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string lnc = "%" + string(reg); reg = reg + 1;
        out = out + "  " + lnc + " = icmp eq i64 " + lna + ", 0\n";
        string lnr = "%" + string(reg); reg = reg + 1;
        out = out + "  " + lnr + " = zext i1 " + lnc + " to i64\n";
        vstack.push(lnr);
        tstack.push(0);
      } else if (ins.op == KirOpcode::StoreLocal) {
        int slot = ins.operands[0];
        string v = vstack[vstack.len() - 1];
        int sty = 0; if (tstack.len() > 0) { sty = tstack[tstack.len() - 1]; }
        if (slot >= 0 && slot < local_types.len() && sty == 1) { local_types[slot] = 1; }
        out = out + "  store i64 " + v + ", i64* %slot" + string(slot) + "\n";
      } else if (ins.op == KirOpcode::LoadLocal) {
        int lslot = ins.operands[0];
        string r = "%" + string(reg);
        reg = reg + 1;
        out = out + "  " + r + " = load i64, i64* %slot" + string(lslot) + "\n";
        vstack.push(r);
        int lty = 0; if (lslot >= 0 && lslot < local_types.len()) { lty = local_types[lslot]; }
        tstack.push(lty);
      } else if (ins.op == KirOpcode::Pop) {
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
      } else if (ins.op == KirOpcode::Dup) {
        // SSA: a value can have many uses, so Dup just references the top again.
        if (vstack.len() > 0) { vstack.push(vstack[vstack.len() - 1]); }
        if (tstack.len() > 0) { tstack.push(tstack[tstack.len() - 1]); }
      } else if (ins.op == KirOpcode::Call) {
        int argc = ins.operands[0];
        int fn_idx = ins.operands[1];
        string[] args = [];
        for (int a = 0; a < argc; a = a + 1) {
          args.push(vstack[vstack.len() - 1]);
          vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        }
        string callstr = "";
        for (int a = argc - 1; a >= 0; a = a - 1) {
          if (a < argc - 1) { callstr = callstr + ", "; }
          callstr = callstr + "i64 " + args[a];
        }
        string r = "%" + string(reg);
        reg = reg + 1;
        out = out + "  " + r + " = call i64 @" + resolve_target(m, fn_idx) + "(" + callstr + ")\n";
        vstack.push(r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::StructNew) {
        // Operand packs (type_idx << 16) | field_count. Heap-allocate via
        // kl_struct_new so structs fit i64 locals/params/fields.
        int sn_packed = ins.operands[0];
        int sn_type = sn_packed >> 16;
        int sn_fc = sn_packed & 0xFFFF;
        string[] sn_fields = [];
        for (int sn_b = 0; sn_b < sn_fc; sn_b = sn_b + 1) { sn_fields.push(vstack[vstack.len() - 1]); vstack.pop(); if (tstack.len() > 0) { tstack.pop(); } }
        string sn_ptr = "null";
        if (sn_fc > 0) {
          string sn_buf = "%" + string(reg); reg = reg + 1;
          out = out + "  " + sn_buf + " = alloca i64, i32 " + string(sn_fc) + "\n";
          // sn_fields[0] is the topmost (last) field -> store at slot fc-1.
          for (int sn_j = 0; sn_j < sn_fc; sn_j = sn_j + 1) {
            int sn_slot = sn_fc - 1 - sn_j;
            string sn_gp = "%" + string(reg); reg = reg + 1;
            out = out + "  " + sn_gp + " = getelementptr i64, i64* " + sn_buf + ", i32 " + string(sn_slot) + "\n";
            out = out + "  store i64 " + sn_fields[sn_j] + ", i64* " + sn_gp + "\n";
          }
          sn_ptr = sn_buf;
        }
        string sn_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + sn_r + " = call i64 @kl_struct_new(i32 " + string(sn_type) + ", i32 " + string(sn_fc) + ", i64* " + sn_ptr + ")\n";
        vstack.push(sn_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::FieldGet) {
        int gidx = ins.operands[0];
        string gs = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string gr = "%" + string(reg); reg = reg + 1;
        out = out + "  " + gr + " = call i64 @kl_struct_field_at(i64 " + gs + ", i32 " + string(gidx) + ")\n";
        vstack.push(gr);
        tstack.push(0);
      } else if (ins.op == KirOpcode::FieldSet) {
        int sidx = ins.operands[0];
        string sval = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ss = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string sr = "%" + string(reg); reg = reg + 1;
        out = out + "  " + sr + " = call i64 @kl_struct_field_set(i64 " + ss + ", i32 " + string(sidx) + ", i64 " + sval + ")\n";
        vstack.push(sr);
        tstack.push(0);
      } else if (ins.op == KirOpcode::EnumPayloadNew) {
        int ep_packed = ins.operands[0];
        int ep_pc = ins.operands[1];
        int ep_type = ep_packed >> 16;
        int ep_var = ep_packed & 0xFFFF;
        // Pop payload values; ep_vals[0] is the topmost (last arg).
        string[] ep_vals = [];
        for (int ep_i = 0; ep_i < ep_pc; ep_i = ep_i + 1) {
          ep_vals.push(vstack[vstack.len() - 1]); vstack.pop();
          if (tstack.len() > 0) { tstack.pop(); }
        }
        string ep_ptr = "null";
        if (ep_pc > 0) {
          string ep_buf = "%" + string(reg); reg = reg + 1;
          out = out + "  " + ep_buf + " = alloca i64, i32 " + string(ep_pc) + "\n";
          // ep_vals[j] = arg(pc-1-j) -> store at slot (pc-1-j).
          for (int ep_j = 0; ep_j < ep_pc; ep_j = ep_j + 1) {
            int ep_slot = ep_pc - 1 - ep_j;
            string ep_gp = "%" + string(reg); reg = reg + 1;
            out = out + "  " + ep_gp + " = getelementptr i64, i64* " + ep_buf + ", i32 " + string(ep_slot) + "\n";
            out = out + "  store i64 " + ep_vals[ep_j] + ", i64* " + ep_gp + "\n";
          }
          ep_ptr = ep_buf;
        }
        string ep_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + ep_r + " = call i64 @kl_enum_new_payload(i32 " + string(ep_type) + ", i32 " + string(ep_var) + ", i32 " + string(ep_pc) + ", i64* " + ep_ptr + ")\n";
        vstack.push(ep_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::EnumPayloadGet) {
        int ep_idx = ins.operands[0];
        string ep_ev = vstack[vstack.len() - 1]; vstack.pop();
        if (tstack.len() > 0) { tstack.pop(); }
        string ep_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + ep_r + " = call i64 @kl_enum_payload_at(i64 " + ep_ev + ", i32 " + string(ep_idx) + ")\n";
        vstack.push(ep_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::ArrayNew) {
        int na_n = ins.operands[0];
        string[] na_flds = [];
        for (int na_p = 0; na_p < na_n; na_p = na_p + 1) { na_flds.push(vstack[vstack.len() - 1]); vstack.pop(); if (tstack.len() > 0) { tstack.pop(); } }
        // Heap-allocate via kl_array_new so arrays fit i64 locals/params.
        string na_ptr = "null";
        if (na_n > 0) {
          string na_buf = "%" + string(reg); reg = reg + 1;
          out = out + "  " + na_buf + " = alloca i64, i32 " + string(na_n) + "\n";
          // na_flds[0] is the topmost (last) element -> store at slot n-1.
          for (int na_j = 0; na_j < na_n; na_j = na_j + 1) {
            int na_slot = na_n - 1 - na_j;
            string na_gp = "%" + string(reg); reg = reg + 1;
            out = out + "  " + na_gp + " = getelementptr i64, i64* " + na_buf + ", i32 " + string(na_slot) + "\n";
            out = out + "  store i64 " + na_flds[na_j] + ", i64* " + na_gp + "\n";
          }
          na_ptr = na_buf;
        }
        string na_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + na_r + " = call i64 @kl_array_new(i32 " + string(na_n) + ", i64* " + na_ptr + ")\n";
        vstack.push(na_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::IndexGet) {
        string ni_idx = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ni_arr = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ni_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + ni_r + " = call i64 @kl_index_get(i64 " + ni_arr + ", i64 " + ni_idx + ")\n";
        vstack.push(ni_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::ArrayLen) {
        // kl_value_len is polymorphic across arrays and (now real) strings.
        string nl_s = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string nl_l = "%" + string(reg); reg = reg + 1;
        out = out + "  " + nl_l + " = call i32 @kl_value_len(i64 " + nl_s + ")\n";
        string nl_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + nl_r + " = sext i32 " + nl_l + " to i64\n";
        vstack.push(nl_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::IndexSet) {
        string is_val = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string is_idx = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string is_arr = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string is_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + is_r + " = call i64 @kl_index_set(i64 " + is_arr + ", i64 " + is_idx + ", i64 " + is_val + ")\n";
        vstack.push(is_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::ArrayPush) {
        string ap_val = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ap_arr = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ap_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + ap_r + " = call i64 @kl_array_push(i64 " + ap_arr + ", i64 " + ap_val + ")\n";
        vstack.push(ap_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::ArrayPop) {
        string po_arr = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string po_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + po_r + " = call i64 @kl_array_pop(i64 " + po_arr + ")\n";
        vstack.push(po_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::StrStartsWith || ins.op == KirOpcode::StrEndsWith) {
        string ss_needle = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ss_str = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ss_fn = "@kl_str_starts_with";
        if (ins.op == KirOpcode::StrEndsWith) { ss_fn = "@kl_str_ends_with"; }
        string ss_f = "%" + string(reg); reg = reg + 1;
        out = out + "  " + ss_f + " = call i32 " + ss_fn + "(i64 " + ss_str + ", i64 " + ss_needle + ")\n";
        string ss_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + ss_r + " = zext i32 " + ss_f + " to i64\n";
        vstack.push(ss_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::StrReplace) {
        string rp_new = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string rp_old = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string rp_str = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string rp_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + rp_r + " = call i64 @kl_str_replace(i64 " + rp_str + ", i64 " + rp_old + ", i64 " + rp_new + ")\n";
        vstack.push(rp_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::StrSplit) {
        string sp_delim = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string sp_str = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string sp_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + sp_r + " = call i64 @kl_str_split(i64 " + sp_str + ", i64 " + sp_delim + ")\n";
        vstack.push(sp_r);
        tstack.push(0);
      } else if (ins.op == KirOpcode::StrTrim || ins.op == KirOpcode::StrToUpper || ins.op == KirOpcode::StrToLower) {
        string tr_s = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string tr_fn = "@kl_str_trim";
        if (ins.op == KirOpcode::StrToUpper) { tr_fn = "@kl_str_to_upper"; }
        if (ins.op == KirOpcode::StrToLower) { tr_fn = "@kl_str_to_lower"; }
        string tr_r = "%" + string(reg); reg = reg + 1;
        out = out + "  " + tr_r + " = call i64 " + tr_fn + "(i64 " + tr_s + ")\n";
        vstack.push(tr_r);
        tstack.push(0);
      }
    }
    if (!terminated) {
      if (bi + 1 < nl) {
        out = out + "  br label %" + label_for(leaders, leaders[bi + 1]) + "\n";
      } else {
        out = out + "  ret i64 0\n";
      }
    }
    exit_stacks[bi] = vstack;
    exit_types[bi] = tstack;
  }
  return out;
}

string emit_function(KirFunction fn, KirModule m, Chunk ch) {
  KirInstr[] instrs = fn.blocks[0].instrs;
  string out = "define i64 @" + mangle(fn.name) + "(";
  for (int p = 0; p < fn.param_count; p = p + 1) {
    if (p > 0) { out = out + ", "; }
    out = out + "i64 %arg" + string(p);
  }
  out = out + ") {\n";
  out = out + "entry:\n";
  int lc = count_locals(instrs);
  for (int s = 0; s < lc; s = s + 1) {
    out = out + "  %slot" + string(s) + " = alloca i64\n";
  }
  for (int p = 0; p < fn.param_count; p = p + 1) {
    out = out + "  store i64 %arg" + string(p) + ", i64* %slot" + string(p) + "\n";
  }
  out = out + emit_function_body(fn, m, ch);
  out = out + "}\n\n";
  return out;
}

string emit_entry_shim() {
  string out = "define i32 @kinglet_main() {\n";
  out = out + "entry:\n";
  out = out + "  %0 = call i64 @kinglet_user_main()\n";
  out = out + "  %1 = call i32 @kl_exit_code(i64 %0)\n";
  out = out + "  ret i32 %1\n";
  out = out + "}\n";
  return out;
}

pub string emit_ll(KirModule m, Chunk ch) {
  string out = "declare i32 @kl_exit_code(i64)\n";
  out = out + "declare i64 @kl_float_new(double)\n";
  out = out + "declare double @kl_float_get(i64)\n";
  out = out + "declare i32 @kl_value_eq(i64, i64)\n";
  out = out + "declare i32 @kl_value_cmp(i64, i64)\n";
  out = out + "declare i32 @kl_value_is_err(i64)\n";
  out = out + "declare i32 @kl_str_starts_with(i64, i64)\n";
  out = out + "declare i32 @kl_str_ends_with(i64, i64)\n";
  out = out + "declare i64 @kl_str_replace(i64, i64, i64)\n";
  out = out + "declare i64 @kl_str_split(i64, i64)\n";
  out = out + "declare i64 @kl_str_trim(i64)\n";
  out = out + "declare i64 @kl_str_to_upper(i64)\n";
  out = out + "declare i64 @kl_str_to_lower(i64)\n";
  out = out + "declare i64 @kl_enum_new_payload(i32, i32, i32, i64*)\n";
  out = out + "declare i64 @kl_enum_payload_at(i64, i32)\n";
  out = out + "declare i64 @kl_array_new(i32, i64*)\n";
  out = out + "declare i64 @kl_index_get(i64, i64)\n";
  out = out + "declare i64 @kl_index_set(i64, i64, i64)\n";
  out = out + "declare i64 @kl_array_push(i64, i64)\n";
  out = out + "declare i64 @kl_array_pop(i64)\n";
  out = out + "declare i32 @kl_value_len(i64)\n";
  out = out + "declare i64 @kl_struct_new(i32, i32, i64*)\n";
  out = out + "declare i64 @kl_struct_field_at(i64, i32)\n";
  out = out + "declare i64 @kl_struct_field_set(i64, i32, i64)\n";
  out = out + "declare i64 @kl_string_new(i8*, i32)\n";
  out = out + "declare i64 @kl_value_add(i64, i64)\n";
  out = out + "declare i64 @kl_cast_to_int(i64)\n";
  out = out + "declare i64 @kl_cast_to_float(i64)\n";
  out = out + "declare i64 @kl_cast_to_string(i64)\n";
  out = out + "declare i64 @kl_cast_to_char(i64)\n\n";
  // String literal globals: one per string constant in the pool, escaped as
  // LLVM c"\HH" bytes. Byte access uses int(s[i]) (char -> code) per the
  // kinglet design (no `as int` on values).
  for (int sci = 0; sci < ch.constants.len(); sci = sci + 1) {
    Constant sck = ch.constants[sci];
    if (sck.kind == ConstKind::String_) {
      string svs = sck.string_value;
      out = out + "@.str." + string(sci) + " = private unnamed_addr constant [" + string(svs.len()) + " x i8] c\"" + llvm_str_escape(svs) + "\"\n";
    }
  }
  out = out + "\n";
  for (int i = 0; i < m.functions.len(); i = i + 1) {
    out = out + emit_function(m.functions[i], m, ch);
  }
  out = out + emit_entry_shim();
  return out;
}
