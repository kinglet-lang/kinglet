// KIR → textual LLVM IR emitter.

export module compiler.ll_emit;

import ir.ir;
import compiler.bytecode;
using namespace ir.ir;
using namespace compiler.bytecode;

// Concatenate a list of string pieces in O(total_len) work via divide and
// conquer, instead of the O(n^2) left-fold `out = out + piece` accumulator
// pattern (each `+` copies the whole prefix). Emitters push pieces into a
// string[] builder and call this once at the end. Splitting the range keeps
// each intermediate concatenation balanced, so total copying is O(L log k)
// rather than O(L^2).
string join_parts(string[] parts, int lo, int hi) {
  if (hi - lo <= 1) {
    if (lo < hi) { return parts[lo]; }
    return "";
  }
  int mid = lo + (hi - lo) / 2;
  return join_parts(parts, lo, mid) + join_parts(parts, mid, hi);
}

string join_all(string[] parts) {
  return join_parts(parts, 0, parts.len());
}

// --- IEEE 754 double → hex literal ---

// Exact IEEE-754 bits of a double, formatted as a 16-digit LLVM hex literal.
// The emitter runs on the VM, which has native floats, so int::bits(d) yields
// the precise i64 bit pattern (kl_float_to_bits) — no manual exponent/mantissa
// extraction. Nibbles are masked low-to-high; 16 iterations drain the value
// so the arithmetic >> never leaks sign bits into the result.
string double_to_hex(float d) {
  int bits = int::bits(d);
  string digits = "0123456789abcdef";
  string hex = "";
  for (int i = 0; i < 16; i = i + 1) {
    int nib = bits & 15;
    hex = digits.slice(nib, nib + 1) + hex;
    bits = bits >> 4;
  }
  return "0x" + hex;
}

// Two lowercase hex digits for a byte value 0..255.
string hex2(int b) {
  string d = "0123456789ABCDEF";
  int hi = (b >> 4) & 15;
  int lo = b & 15;
  return d.slice(hi, hi + 1) + d.slice(lo, lo + 1);
}

// Escape a kinglet string's bytes as LLVM c"..." content: every byte as \HH.
// Byte access uses int(s[i]) (string index -> char -> code), the kinglet design.
string llvm_str_escape(string s) {
  string[] out = [];
  for (int i = 0; i < s.len(); i = i + 1) {
    out.push("\\" + hex2(int(s[i])));
  }
  return join_all(out);
}

// --- KIR opcode helpers ---

bool is_bin_op(int op) {
  return op == kir_opcode_ord(KirOpcode::IAdd) || op == kir_opcode_ord(KirOpcode::ISub) || op == kir_opcode_ord(KirOpcode::IMul) || op == kir_opcode_ord(KirOpcode::IDiv) || op == kir_opcode_ord(KirOpcode::IMod)
      || op == kir_opcode_ord(KirOpcode::IAnd) || op == kir_opcode_ord(KirOpcode::IOr) || op == kir_opcode_ord(KirOpcode::IXor) || op == kir_opcode_ord(KirOpcode::IShl) || op == kir_opcode_ord(KirOpcode::IShr);
}

string ll_bin_op(int op) {
  if (op == kir_opcode_ord(KirOpcode::IAdd)) { return "add"; }
  if (op == kir_opcode_ord(KirOpcode::ISub)) { return "sub"; }
  if (op == kir_opcode_ord(KirOpcode::IMul)) { return "mul"; }
  if (op == kir_opcode_ord(KirOpcode::IDiv)) { return "sdiv"; }
  if (op == kir_opcode_ord(KirOpcode::IMod)) { return "srem"; }
  if (op == kir_opcode_ord(KirOpcode::IAnd)) { return "and"; }
  if (op == kir_opcode_ord(KirOpcode::IOr)) { return "or"; }
  if (op == kir_opcode_ord(KirOpcode::IXor)) { return "xor"; }
  if (op == kir_opcode_ord(KirOpcode::IShl)) { return "shl"; }
  if (op == kir_opcode_ord(KirOpcode::IShr)) { return "lshr"; }
  return "add";
}

bool is_cmp(int op) {
  return op == kir_opcode_ord(KirOpcode::IEq) || op == kir_opcode_ord(KirOpcode::INe) || op == kir_opcode_ord(KirOpcode::ILt) || op == kir_opcode_ord(KirOpcode::IGt) || op == kir_opcode_ord(KirOpcode::ILe) || op == kir_opcode_ord(KirOpcode::IGe);
}

// Build i64 wire from ConstInt lo/hi operand halves.
int wire_i64_from_parts(int lo, int hi) {
  int blo = lo & 0xFFFFFFFF;
  int bhi = hi & 0xFFFFFFFF;
  if (bhi == 0) {
    return blo;
  }
  return (bhi << 32) | blo;
}

// Inline enum wire (KL_INLINE_ENUM_MARK | packed), matches kir_to_llvm.cc EnumVariant.
int enum_inline_wire(int packed) {
  return wire_i64_from_parts(packed & 0xFFFFFFFF, 0xFFFD0000);
}

// Emit `sub`/`or` LLVM ops for an inline enum wire; returns the result reg name.
// sub operand is -mark as i64 where mark = 0xFFFD000000000000 (see kinglet_rt_value.h).
string emit_enum_wire_insn(string[] out, int packed, int reg) {
  string ew0 = "%" + string(reg);
  string ew = "%" + string(reg + 1);
  out.push("  " + ew0 + " = sub i64 0, 844424930131968\n");
  out.push("  " + ew + " = or i64 " + ew0 + ", " + string(packed) + "\n");
  return ew;
}

int[] compute_leaders(KirInstr[] instrs) {
  int n = instrs.len();
  bool[] marks = [];
  for (int i = 0; i < n; i = i + 1) { marks.push(false); }
  if (n > 0) { marks[0] = true; }
  for (int i = 0; i < n; i = i + 1) {
    int iop = kir_instr_op(instrs, i);
    int[] iops = kir_instr_operands(instrs, i);
    if (iop == kir_opcode_ord(KirOpcode::Br) || iop == kir_opcode_ord(KirOpcode::CondBr)) {
      int target = iops[0];
      if (target >= 0 && target < n) { marks[target] = true; }
      if (i + 1 < n) { marks[i + 1] = true; }
    }
    if (iop == kir_opcode_ord(KirOpcode::JmpIfErr)) {
      int target = iops[0];
      int err_t = i + 1 + target;
      if (err_t >= 0 && err_t < n) { marks[err_t] = true; }
      if (i + 1 < n) { marks[i + 1] = true; }
    }
    if (iop == kir_opcode_ord(KirOpcode::PropagateErr)) {
      if (i + 1 < n) { marks[i + 1] = true; }
    }
    if (iop == kir_opcode_ord(KirOpcode::PushHandler)) {
      int target = iops[0];
      int landing = i + 1 + target;
      if (landing >= 0 && landing < n) { marks[landing] = true; }
    }
    if (iop == kir_opcode_ord(KirOpcode::Ret)) {
      if (i + 1 < n) { marks[i + 1] = true; }
    }
  }
  int[] leaders = [];
  for (int i = 0; i < n; i = i + 1) {
    if (marks[i]) { leaders.push(i); }
  }
  return leaders;
}

string label_for(int[] leaders, int idx) {
  for (int k = 0; k < leaders.len(); k = k + 1) {
    if (leaders[k] == idx) {
      return "bb" + string(k);
    }
  }
  return "bb0";
}

int count_locals(KirInstr[] instrs) {
  int max_slot = -1;
  for (int i = 0; i < instrs.len(); i = i + 1) {
    int iop = kir_instr_op(instrs, i);
    int[] iops = kir_instr_operands(instrs, i);
    if (iop == kir_opcode_ord(KirOpcode::StoreLocal) || iop == kir_opcode_ord(KirOpcode::LoadLocal)) {
      if (iops[0] > max_slot) { max_slot = iops[0]; }
    }
  }
  return max_slot + 1;
}

string mangle(string name) {
  if (name == "main") { return "kinglet_user_main"; }
  return "kinglet_fn_" + name;
}

// Unique symbol for a function. Bare names collide across modules (e.g.
// `func_exists` exists in both checker.kl and compiler.kl), so non-main
// functions are disambiguated by their globally-unique fn_index. `main` keeps
// the fixed entry symbol the runtime shim calls.
string mangle_fn(string name, int fn_index) {
  if (name == "main") { return "kinglet_user_main"; }
  return "kinglet_fn_" + name + "_" + string(fn_index);
}

string resolve_target(KirModule m, int fn_idx) {
  for (int i = 0; i < m.functions.len(); i = i + 1) {
    if (m.functions[i].fn_index == fn_idx) { return mangle_fn(m.functions[i].name, m.functions[i].fn_index); }
  }
  return "kinglet_fn_unknown";
}

int leader_pos(int[] leaders, int idx) {
  for (int k = 0; k < leaders.len(); k = k + 1) {
    if (leaders[k] == idx) { return k; }
  }
  return 0;
}

string emit_function_body(KirFunction fn, KirModule m, Chunk ch) {
  KirInstr[] instrs = fn.blocks[0].instrs;
  int n = instrs.len();
  int[] leaders = compute_leaders(instrs);
  int nl = leaders.len();
  int bc_pc = 0;
  int bc_end = ch.instructions.len();
  if (fn.fn_index >= 0 && fn.fn_index < ch.functions.len()) {
    bc_pc = ch.functions[fn.fn_index].entry;
    if (fn.fn_index + 1 < ch.functions.len()) {
      bc_end = ch.functions[fn.fn_index + 1].entry;
    }
  }
  // Resolve each PropagateErr to its catch landing by simulating the
  // PushHandler/PopHandler stack in source order.
  int[] prop_idx = [];
  int[] prop_catch = [];
  int[] handler_landings = [];
  {
    int[] hstack = [];
    for (int i = 0; i < n; i = i + 1) {
      int hop = kir_instr_op(instrs, i);
      int[] hops = kir_instr_operands(instrs, i);
      if (hop == kir_opcode_ord(KirOpcode::PushHandler)) {
        int landing = i + 1 + hops[0];
        hstack.push(landing);
        handler_landings.push(landing);
      } else if (hop == kir_opcode_ord(KirOpcode::PopHandler)) {
        if (hstack.len() > 0) { hstack.pop(); }
      } else if (hop == kir_opcode_ord(KirOpcode::PropagateErr)) {
        int ct = 0;
        if (hstack.len() > 0) { ct = hstack[hstack.len() - 1]; }
        prop_idx.push(i);
        prop_catch.push(ct);
      }
    }
  }
  int[] edge_pred = [];
  int[] edge_succ = [];
  for (int k = 0; k < nl; k = k + 1) {
    int lend = n;
    if (k + 1 < nl) { lend = leaders[k + 1]; }
    KirInstr last = instrs[lend - 1];
    if (last.op == kir_opcode_ord(KirOpcode::Br)) {
      edge_pred.push(k);
      edge_succ.push(leader_pos(leaders, last.operands[0]));
    } else if (last.op == kir_opcode_ord(KirOpcode::CondBr)) {
      edge_pred.push(k);
      edge_succ.push(k + 1);
      edge_pred.push(k);
      edge_succ.push(leader_pos(leaders, last.operands[0]));
    } else if (last.op == kir_opcode_ord(KirOpcode::JmpIfErr)) {
      int jidx = lend - 1;
      edge_pred.push(k);
      edge_succ.push(k + 1);
      edge_pred.push(k);
      edge_succ.push(leader_pos(leaders, jidx + 1 + last.operands[0]));
    } else if (last.op == kir_opcode_ord(KirOpcode::PropagateErr)) {
      int pidx = lend - 1;
      int pcatch = 0;
      for (int qi = 0; qi < prop_idx.len(); qi = qi + 1) {
        if (prop_idx[qi] == pidx) { pcatch = prop_catch[qi]; }
      }
      edge_pred.push(k);
      edge_succ.push(k + 1);
      edge_pred.push(k);
      edge_succ.push(leader_pos(leaders, pcatch));
    } else if (last.op != KirOpcode::Ret) {
      if (k + 1 < nl) {
        edge_pred.push(k);
        edge_succ.push(k + 1);
      }
    }
  }
  string[][] exit_stacks = [];
  int[][] exit_types = [];
  for (int k = 0; k < nl; k = k + 1) { exit_stacks.push([]); exit_types.push([]); }
  // Track local slot types: 0=int, 1=float
  int[] local_types = [];
  for (int li = 0; li < 128; li = li + 1) { local_types.push(0); }
  string[] out = [];
  int reg = 0;
  for (int bi = 0; bi < nl; bi = bi + 1) {
    int lstart = leaders[bi];
    int lend = n;
    if (bi + 1 < nl) { lend = leaders[bi + 1]; }
    int[] pp = [];
    for (int e = 0; e < edge_pred.len(); e = e + 1) {
      if (edge_succ[e] == bi && edge_pred[e] < bi) { pp.push(edge_pred[e]); }
    }
    string[] vstack = [];
    int[] tstack = [];
    string[] phis = [];
    if (pp.len() == 0) {
      bool is_landing = false;
      for (int hi = 0; hi < handler_landings.len(); hi = hi + 1) {
        if (handler_landings[hi] == lstart) { is_landing = true; }
      }
      // Dead catch (no propagating op inside the try): synthesize the error
      // binding slot so the catch body's StoreLocal can pop.
      if (is_landing) { vstack.push("0"); tstack.push(0); }
    } else if (pp.len() == 1) {
      string[] src = exit_stacks[pp[0]];
      int[] tsrc = exit_types[pp[0]];
      for (int q = 0; q < src.len(); q = q + 1) { vstack.push(src[q]); }
      for (int q = 0; q < tsrc.len(); q = q + 1) { tstack.push(tsrc[q]); }
    } else if (pp.len() > 1) {
      int d = exit_stacks[pp[0]].len();
      for (int j = 0; j < d; j = j + 1) {
        string v = exit_stacks[pp[0]][j];
        int ty = 0;
        if (j < exit_types[pp[0]].len()) { ty = exit_types[pp[0]][j]; }
        bool same = true;
        for (int p = 1; p < pp.len(); p = p + 1) {
          if (exit_stacks[pp[p]][j] != v) { same = false; }
        }
        if (same) {
          vstack.push(v);
          tstack.push(ty);
        } else {
          string r = "%" + string(reg);
          reg = reg + 1;
          string ph = "  " + r + " = phi i64 ";
          for (int p = 0; p < pp.len(); p = p + 1) {
            if (p > 0) { ph = ph + ", "; }
            ph = ph + "[ " + exit_stacks[pp[p]][j] + ", %" + label_for(leaders, leaders[pp[p]]) + " ]";
          }
          phis.push(ph + "\n");
          vstack.push(r);
          // Merge types: if any pred is float, result is float
          int mty = ty;
          for (int p = 1; p < pp.len(); p = p + 1) {
            if (j < exit_types[pp[p]].len() && exit_types[pp[p]][j] == 1) { mty = 1; }
          }
          tstack.push(mty);
        }
      }
    }
    // Every block, including the first, gets an explicit label. The `entry`
    // block (allocas + param stores) branches into bb0, so a loop back-edge to
    // the function start targets %bb0 — never %entry, which LLVM forbids as a
    // branch target.
    out.push(label_for(leaders, lstart) + ":\n");
    out.push(join_all(phis));
    bool terminated = false;
    for (int i = lstart; i < lend; i = i + 1) {
      if (bc_pc < bc_end) {
        Instruction bcins = ch.instructions[bc_pc];
        if (bcins.op - vm_op_enum_variant() == 0) {
          string ew = emit_enum_wire_insn(out, bcins.operand, reg);
          reg = reg + 2;
          vstack.push(ew);
          tstack.push(0);
          bc_pc = bc_pc + 1;
          continue;
        }
      }
      int iop = kir_instr_op(instrs, i);
      int[] iops = kir_instr_operands(instrs, i);
      int ins_rt = kir_instr_result_type(instrs, i);
      if (iop == kir_opcode_ord(KirOpcode::Ret)) {
        if (vstack.len() > 0) {
          string v = vstack[vstack.len() - 1];
          out.push("  ret i64 " + v + "\n");
        } else {
          out.push("  ret i64 0\n");
        }
        terminated = true;
      } else if (iop == kir_opcode_ord(KirOpcode::Br)) {
        out.push("  br label %" + label_for(leaders, iops[0]) + "\n");
        terminated = true;
      } else if (iop == kir_opcode_ord(KirOpcode::CondBr)) {
        string cond = vstack[vstack.len() - 1];
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string t = "%" + string(reg);
        reg = reg + 1;
        out.push("  " + t + " = icmp ne i64 " + cond + ", 0\n");
        out.push("  br i1 " + t + ", label %" + label_for(leaders, i + 1) + ", label %" + label_for(leaders, iops[0]) + "\n");
        terminated = true;
      } else if (iop == kir_opcode_ord(KirOpcode::JmpIfErr)) {
        // Peek (no pop): both branches keep the value on the wire.
        string je_top = vstack[vstack.len() - 1];
        string je_is = "%" + string(reg); reg = reg + 1;
        out.push("  " + je_is + " = call i32 @kl_value_is_err(i64 " + je_top + ")\n");
        string je_c = "%" + string(reg); reg = reg + 1;
        out.push("  " + je_c + " = icmp ne i32 " + je_is + ", 0\n");
        int je_err = i + 1 + iops[0];
        out.push("  br i1 " + je_c + ", label %" + label_for(leaders, je_err) + ", label %" + label_for(leaders, i + 1) + "\n");
        terminated = true;
      } else if (iop == kir_opcode_ord(KirOpcode::PropagateErr)) {
        string pe_top = vstack[vstack.len() - 1];
        string pe_is = "%" + string(reg); reg = reg + 1;
        out.push("  " + pe_is + " = call i32 @kl_value_is_err(i64 " + pe_top + ")\n");
        string pe_c = "%" + string(reg); reg = reg + 1;
        out.push("  " + pe_c + " = icmp ne i32 " + pe_is + ", 0\n");
        int pe_catch = 0;
        for (int qi = 0; qi < prop_idx.len(); qi = qi + 1) {
          if (prop_idx[qi] == i) { pe_catch = prop_catch[qi]; }
        }
        out.push("  br i1 " + pe_c + ", label %" + label_for(leaders, pe_catch) + ", label %" + label_for(leaders, i + 1) + "\n");
        terminated = true;
      } else if (iop == kir_opcode_ord(KirOpcode::PushHandler) || iop == kir_opcode_ord(KirOpcode::PopHandler)) {
        // Compile-time handler markers: no IR, no stack effect.
      } else if (iop - kir_op_enum_variant() == 0) {
        int ev_packed = iops[0];
        string ev = emit_enum_wire_insn(out, ev_packed, reg);
        reg = reg + 2;
        vstack.push(ev);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::ConstInt)) {
        int clo = iops[0];
        int chi = iops.len() > 1 ? iops[1] : 0;
        if (chi == 1) {
          string ev = emit_enum_wire_insn(out, clo, reg);
          reg = reg + 2;
          vstack.push(ev);
          tstack.push(0);
        } else {
          vstack.push(string(wire_i64_from_parts(clo, chi)));
          tstack.push(0);
        }
      } else if (iop == kir_opcode_ord(KirOpcode::ConstNull)) {
        vstack.push("0");
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::ConstString)) {
        int cs_pool = iops[0];
        int cs_len = 0;
        string cs_global = "";
        if (cs_pool >= 0 && cs_pool < ch.constants.len()) {
          if (constant_kind_at(ch.constants, cs_pool) == ConstKind::String_) {
            string sv = constant_string_at(ch.constants, cs_pool);
            cs_len = sv.len();
            cs_global = "@.str." + string(cs_pool);
          }
        }
        string cs_gep = "%" + string(reg); reg = reg + 1;
        out.push("  " + cs_gep + " = bitcast [" + string(cs_len) + " x i8]* " + cs_global + " to i8*\n");
        string cs_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + cs_r + " = call i64 @kl_string_new(i8* " + cs_gep + ", i32 " + string(cs_len) + ")\n");
        vstack.push(cs_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::ConstFloat)) {
        int cidx = iops[0];
        float dbl = constant_double_at(ch.constants, cidx);
        string hex = double_to_hex(dbl);
        string r = "%" + string(reg); reg = reg + 1;
        out.push("  " + r + " = call i64 @kl_float_new(double " + hex + ")\n");
        vstack.push(r);
        tstack.push(1);
      } else if (is_bin_op(iop)) {
        string b = vstack[vstack.len() - 1];
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string a = vstack[vstack.len() - 1];
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        if (ins_rt == kir_type_ord(KirType::Float)) {
          // Float arithmetic: unbox → fop → box
          string la = "%" + string(reg); reg = reg + 1;
          out.push("  " + la + " = call double @kl_float_get(i64 " + a + ")\n");
          string rb = "%" + string(reg); reg = reg + 1;
          out.push("  " + rb + " = call double @kl_float_get(i64 " + b + ")\n");
          string fr = "%" + string(reg); reg = reg + 1;
          string fop = "fadd";
          if (iop == kir_opcode_ord(KirOpcode::ISub)) { fop = "fsub"; }
          if (iop == kir_opcode_ord(KirOpcode::IMul)) { fop = "fmul"; }
          if (iop == kir_opcode_ord(KirOpcode::IDiv)) { fop = "fdiv"; }
          if (iop == kir_opcode_ord(KirOpcode::IMod)) { fop = "frem"; }
          out.push("  " + fr + " = " + fop + " double " + la + ", " + rb + "\n");
          string r = "%" + string(reg); reg = reg + 1;
          out.push("  " + r + " = call i64 @kl_float_new(double " + fr + ")\n");
          vstack.push(r);
          tstack.push(1);
        } else if (ins_rt == kir_type_ord(KirType::String)) {
          // String concat via the runtime's polymorphic add.
          string r = "%" + string(reg); reg = reg + 1;
          out.push("  " + r + " = call i64 @kl_value_add(i64 " + a + ", i64 " + b + ")\n");
          vstack.push(r);
          tstack.push(0);
        } else {
          string r = "%" + string(reg);
          reg = reg + 1;
          out.push("  " + r + " = " + ll_bin_op(iop) + " i64 " + a + ", " + b + "\n");
          vstack.push(r);
          tstack.push(0);
        }
      } else if (is_cmp(iop)) {
        // Check operand types before popping
        int ty_b = 0; if (tstack.len() > 0) { ty_b = tstack[tstack.len() - 1]; }
        string b = vstack[vstack.len() - 1];
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        int ty_a = 0; if (tstack.len() > 0) { ty_a = tstack[tstack.len() - 1]; }
        string a = vstack[vstack.len() - 1];
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        bool is_float_cmp = ty_a == 1 || ty_b == 1;
        if (is_float_cmp) {
          // Float comparison: unbox → fcmp → zext → box
          string la = "%" + string(reg); reg = reg + 1;
          out.push("  " + la + " = call double @kl_float_get(i64 " + a + ")\n");
          string rb = "%" + string(reg); reg = reg + 1;
          out.push("  " + rb + " = call double @kl_float_get(i64 " + b + ")\n");
          string c = "%" + string(reg); reg = reg + 1;
          string pred = "oeq";
          if (iop == kir_opcode_ord(KirOpcode::INe)) { pred = "one"; }
          if (iop == kir_opcode_ord(KirOpcode::ILt)) { pred = "olt"; }
          if (iop == kir_opcode_ord(KirOpcode::IGt)) { pred = "ogt"; }
          if (iop == kir_opcode_ord(KirOpcode::ILe)) { pred = "ole"; }
          if (iop == kir_opcode_ord(KirOpcode::IGe)) { pred = "oge"; }
          out.push("  " + c + " = fcmp " + pred + " double " + la + ", " + rb + "\n");
          string z = "%" + string(reg); reg = reg + 1;
          out.push("  " + z + " = zext i1 " + c + " to i64\n");
          vstack.push(z);
          tstack.push(0);
        } else {
          // Non-float compares go through the runtime's polymorphic
          // kl_value_eq / kl_value_cmp so enums (inline-marked or heap) and
          // strings compare by value, not by raw bits. Result normalised to
          // i64 0/1 to match the stack convention. Temporaries are allocated
          // in emission order so LLVM instruction numbering stays sequential.
          if (iop == kir_opcode_ord(KirOpcode::IEq)) {
            string c = "%" + string(reg); reg = reg + 1;
            out.push("  " + c + " = call i32 @kl_value_eq(i64 " + a + ", i64 " + b + ")\n");
            string r = "%" + string(reg); reg = reg + 1;
            out.push("  " + r + " = zext i32 " + c + " to i64\n");
            vstack.push(r);
          } else if (iop == kir_opcode_ord(KirOpcode::INe)) {
            string c = "%" + string(reg); reg = reg + 1;
            out.push("  " + c + " = call i32 @kl_value_eq(i64 " + a + ", i64 " + b + ")\n");
            string z = "%" + string(reg); reg = reg + 1;
            out.push("  " + z + " = icmp eq i32 " + c + ", 0\n");
            string r = "%" + string(reg); reg = reg + 1;
            out.push("  " + r + " = zext i1 " + z + " to i64\n");
            vstack.push(r);
          } else {
            // Relational: kl_value_cmp returns -1/0/1; compare against 0.
            string c = "%" + string(reg); reg = reg + 1;
            out.push("  " + c + " = call i32 @kl_value_cmp(i64 " + a + ", i64 " + b + ")\n");
            string pred = "slt";
            if (iop == kir_opcode_ord(KirOpcode::IGt)) { pred = "sgt"; }
            if (iop == kir_opcode_ord(KirOpcode::ILe)) { pred = "sle"; }
            if (iop == kir_opcode_ord(KirOpcode::IGe)) { pred = "sge"; }
            string z = "%" + string(reg); reg = reg + 1;
            out.push("  " + z + " = icmp " + pred + " i32 " + c + ", 0\n");
            string r = "%" + string(reg); reg = reg + 1;
            out.push("  " + r + " = zext i1 " + z + " to i64\n");
            vstack.push(r);
          }
          tstack.push(0);
        }
      } else if (iop == kir_opcode_ord(KirOpcode::IsNull)) {
        string iv = vstack[vstack.len() - 1]; vstack.pop();
        if (tstack.len() > 0) { tstack.pop(); }
        string c = "%" + string(reg); reg = reg + 1;
        out.push("  " + c + " = icmp eq i64 " + iv + ", 0\n");
        string r = "%" + string(reg); reg = reg + 1;
        out.push("  " + r + " = zext i1 " + c + " to i64\n");
        vstack.push(r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::CastTo)) {
        int ck = iops[0];
        string cv = vstack[vstack.len() - 1]; vstack.pop();
        if (tstack.len() > 0) { tstack.pop(); }
        // All stack values are boxed i64 (floats included), so every cast takes
        // an i64 and returns the boxed result. kind: 0=int 1=float 2=string 3=char.
        string fn_name = "kl_cast_to_int";
        int res_ty = 0;
        if (ck == 1) { fn_name = "kl_cast_to_float"; res_ty = 1; }
        if (ck == 2) { fn_name = "kl_cast_to_string"; res_ty = 0; }
        if (ck == 3) { fn_name = "kl_cast_to_char"; res_ty = 0; }
        string r = "%" + string(reg); reg = reg + 1;
        out.push("  " + r + " = call i64 @" + fn_name + "(i64 " + cv + ")\n");
        vstack.push(r);
        tstack.push(res_ty);
      } else if (iop == kir_opcode_ord(KirOpcode::INeg) || iop == kir_opcode_ord(KirOpcode::IBNot)) {
        string a = vstack[vstack.len() - 1];
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        if (ins_rt == kir_type_ord(KirType::Float) && iop == kir_opcode_ord(KirOpcode::INeg)) {
          // Float negation: unbox → fneg → box
          string fa = "%" + string(reg); reg = reg + 1;
          out.push("  " + fa + " = call double @kl_float_get(i64 " + a + ")\n");
          string fng = "%" + string(reg); reg = reg + 1;
          out.push("  " + fng + " = fneg double " + fa + "\n");
          string r = "%" + string(reg); reg = reg + 1;
          out.push("  " + r + " = call i64 @kl_float_new(double " + fng + ")\n");
          vstack.push(r);
          tstack.push(1);
        } else {
          string r = "%" + string(reg);
          reg = reg + 1;
          if (iop == kir_opcode_ord(KirOpcode::INeg)) {
            out.push("  " + r + " = sub i64 0, " + a + "\n");
          } else {
            out.push("  " + r + " = xor i64 " + a + ", -1\n");
          }
          vstack.push(r);
          tstack.push(0);
        }
      } else if (iop == kir_opcode_ord(KirOpcode::LNot)) {
        string lna = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string lnc = "%" + string(reg); reg = reg + 1;
        out.push("  " + lnc + " = icmp eq i64 " + lna + ", 0\n");
        string lnr = "%" + string(reg); reg = reg + 1;
        out.push("  " + lnr + " = zext i1 " + lnc + " to i64\n");
        vstack.push(lnr);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::StoreLocal)) {
        int slot = iops[0];
        string v = vstack[vstack.len() - 1];
        int sty = 0; if (tstack.len() > 0) { sty = tstack[tstack.len() - 1]; }
        if (slot >= 0 && slot < local_types.len() && sty == 1) { local_types[slot] = 1; }
        out.push("  store i64 " + v + ", i64* %slot" + string(slot) + "\n");
      } else if (iop == kir_opcode_ord(KirOpcode::LoadLocal)) {
        int lslot = iops[0];
        string r = "%" + string(reg);
        reg = reg + 1;
        out.push("  " + r + " = load i64, i64* %slot" + string(lslot) + "\n");
        vstack.push(r);
        int lty = 0; if (lslot >= 0 && lslot < local_types.len()) { lty = local_types[lslot]; }
        tstack.push(lty);
      } else if (iop == kir_opcode_ord(KirOpcode::Pop)) {
        vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
      } else if (iop == kir_opcode_ord(KirOpcode::Dup)) {
        // SSA: a value can have many uses, so Dup just references the top again.
        if (vstack.len() > 0) { vstack.push(vstack[vstack.len() - 1]); }
        if (tstack.len() > 0) { tstack.push(tstack[tstack.len() - 1]); }
      } else if (iop == kir_opcode_ord(KirOpcode::Call)) {
        int argc = iops[0];
        int fn_idx = iops[1];
        string[] args = [];
        for (int a = 0; a < argc; a = a + 1) {
          args.push(vstack[vstack.len() - 1]);
          vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        }
        string callstr = "";
        for (int a = argc - 1; a >= 0; a = a - 1) {
          if (a < argc - 1) { callstr = callstr + ", "; }
          callstr = callstr + "i64 " + args[a];
        }
        string r = "%" + string(reg);
        reg = reg + 1;
        out.push("  " + r + " = call i64 @" + resolve_target(m, fn_idx) + "(" + callstr + ")\n");
        vstack.push(r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::StructNew)) {
        // Operand packs (type_idx << 16) | field_count. Heap-allocate via
        // kl_struct_new so structs fit i64 locals/params/fields.
        int sn_packed = iops[0];
        int sn_type = sn_packed >> 16;
        int sn_fc = sn_packed & 0xFFFF;
        string[] sn_fields = [];
        for (int sn_b = 0; sn_b < sn_fc; sn_b = sn_b + 1) { sn_fields.push(vstack[vstack.len() - 1]); vstack.pop(); if (tstack.len() > 0) { tstack.pop(); } }
        string sn_ptr = "null";
        if (sn_fc > 0) {
          string sn_buf = "%" + string(reg); reg = reg + 1;
          out.push("  " + sn_buf + " = alloca i64, i32 " + string(sn_fc) + "\n");
          // sn_fields[0] is the topmost (last) field -> store at slot fc-1.
          for (int sn_j = 0; sn_j < sn_fc; sn_j = sn_j + 1) {
            int sn_slot = sn_fc - 1 - sn_j;
            string sn_gp = "%" + string(reg); reg = reg + 1;
            out.push("  " + sn_gp + " = getelementptr i64, i64* " + sn_buf + ", i32 " + string(sn_slot) + "\n");
            out.push("  store i64 " + sn_fields[sn_j] + ", i64* " + sn_gp + "\n");
          }
          sn_ptr = sn_buf;
        }
        string sn_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + sn_r + " = call i64 @kl_struct_new(i32 " + string(sn_type) + ", i32 " + string(sn_fc) + ", i64* " + sn_ptr + ")\n");
        vstack.push(sn_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::FieldGet)) {
        int gidx = iops[0];
        string gs = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string gr = "%" + string(reg); reg = reg + 1;
        out.push("  " + gr + " = call i64 @kl_struct_field_at(i64 " + gs + ", i32 " + string(gidx) + ")\n");
        vstack.push(gr);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::FieldSet)) {
        int sidx = iops[0];
        string sval = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ss = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string sr = "%" + string(reg); reg = reg + 1;
        out.push("  " + sr + " = call i64 @kl_struct_field_set(i64 " + ss + ", i32 " + string(sidx) + ", i64 " + sval + ")\n");
        vstack.push(sr);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::EnumPayloadNew)) {
        int ep_packed = iops[0];
        int ep_pc = iops[1];
        int ep_type = ep_packed >> 16;
        int ep_var = ep_packed & 0xFFFF;
        // Pop payload values; ep_vals[0] is the topmost (last arg).
        string[] ep_vals = [];
        for (int ep_i = 0; ep_i < ep_pc; ep_i = ep_i + 1) {
          ep_vals.push(vstack[vstack.len() - 1]); vstack.pop();
          if (tstack.len() > 0) { tstack.pop(); }
        }
        string ep_ptr = "null";
        if (ep_pc > 0) {
          string ep_buf = "%" + string(reg); reg = reg + 1;
          out.push("  " + ep_buf + " = alloca i64, i32 " + string(ep_pc) + "\n");
          // ep_vals[j] = arg(pc-1-j) -> store at slot (pc-1-j).
          for (int ep_j = 0; ep_j < ep_pc; ep_j = ep_j + 1) {
            int ep_slot = ep_pc - 1 - ep_j;
            string ep_gp = "%" + string(reg); reg = reg + 1;
            out.push("  " + ep_gp + " = getelementptr i64, i64* " + ep_buf + ", i32 " + string(ep_slot) + "\n");
            out.push("  store i64 " + ep_vals[ep_j] + ", i64* " + ep_gp + "\n");
          }
          ep_ptr = ep_buf;
        }
        string ep_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + ep_r + " = call i64 @kl_enum_new_payload(i32 " + string(ep_type) + ", i32 " + string(ep_var) + ", i32 " + string(ep_pc) + ", i64* " + ep_ptr + ")\n");
        vstack.push(ep_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::EnumPayloadGet)) {
        int ep_idx = iops[0];
        string ep_ev = vstack[vstack.len() - 1]; vstack.pop();
        if (tstack.len() > 0) { tstack.pop(); }
        string ep_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + ep_r + " = call i64 @kl_enum_payload_at(i64 " + ep_ev + ", i32 " + string(ep_idx) + ")\n");
        vstack.push(ep_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::ArrayNew)) {
        int na_n = iops[0];
        string[] na_flds = [];
        for (int na_p = 0; na_p < na_n; na_p = na_p + 1) { na_flds.push(vstack[vstack.len() - 1]); vstack.pop(); if (tstack.len() > 0) { tstack.pop(); } }
        // Heap-allocate via kl_array_new so arrays fit i64 locals/params.
        string na_ptr = "null";
        if (na_n > 0) {
          string na_buf = "%" + string(reg); reg = reg + 1;
          out.push("  " + na_buf + " = alloca i64, i32 " + string(na_n) + "\n");
          // na_flds[0] is the topmost (last) element -> store at slot n-1.
          for (int na_j = 0; na_j < na_n; na_j = na_j + 1) {
            int na_slot = na_n - 1 - na_j;
            string na_gp = "%" + string(reg); reg = reg + 1;
            out.push("  " + na_gp + " = getelementptr i64, i64* " + na_buf + ", i32 " + string(na_slot) + "\n");
            out.push("  store i64 " + na_flds[na_j] + ", i64* " + na_gp + "\n");
          }
          na_ptr = na_buf;
        }
        string na_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + na_r + " = call i64 @kl_array_new(i32 " + string(na_n) + ", i64* " + na_ptr + ")\n");
        vstack.push(na_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::IndexGet)) {
        string ni_idx = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ni_arr = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ni_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + ni_r + " = call i64 @kl_index_get(i64 " + ni_arr + ", i64 " + ni_idx + ")\n");
        vstack.push(ni_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::ArrayLen)) {
        // kl_value_len is polymorphic across arrays and (now real) strings.
        string nl_s = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string nl_l = "%" + string(reg); reg = reg + 1;
        out.push("  " + nl_l + " = call i32 @kl_value_len(i64 " + nl_s + ")\n");
        string nl_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + nl_r + " = sext i32 " + nl_l + " to i64\n");
        vstack.push(nl_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::IndexSet)) {
        string is_val = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string is_idx = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string is_arr = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string is_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + is_r + " = call i64 @kl_index_set(i64 " + is_arr + ", i64 " + is_idx + ", i64 " + is_val + ")\n");
        vstack.push(is_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::ArrayPush)) {
        string ap_val = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ap_arr = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ap_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + ap_r + " = call i64 @kl_array_push(i64 " + ap_arr + ", i64 " + ap_val + ")\n");
        vstack.push(ap_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::ArrayPop)) {
        string po_arr = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string po_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + po_r + " = call i64 @kl_array_pop(i64 " + po_arr + ")\n");
        vstack.push(po_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::ArraySlice)) {
        string sl_end = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string sl_start = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string sl_obj = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string sl_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + sl_r + " = call i64 @kl_slice(i64 " + sl_obj + ", i64 " + sl_start + ", i64 " + sl_end + ")\n");
        vstack.push(sl_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::ArrayContains)) {
        string ct_n = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ct_o = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ct_f = "%" + string(reg); reg = reg + 1;
        out.push("  " + ct_f + " = call i32 @kl_contains(i64 " + ct_o + ", i64 " + ct_n + ")\n");
        string ct_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + ct_r + " = zext i32 " + ct_f + " to i64\n");
        vstack.push(ct_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::StrStartsWith) || iop == kir_opcode_ord(KirOpcode::StrEndsWith)) {
        string ss_needle = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ss_str = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string ss_fn = "@kl_str_starts_with";
        if (iop == kir_opcode_ord(KirOpcode::StrEndsWith)) { ss_fn = "@kl_str_ends_with"; }
        string ss_f = "%" + string(reg); reg = reg + 1;
        out.push("  " + ss_f + " = call i32 " + ss_fn + "(i64 " + ss_str + ", i64 " + ss_needle + ")\n");
        string ss_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + ss_r + " = zext i32 " + ss_f + " to i64\n");
        vstack.push(ss_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::StrReplace)) {
        string rp_new = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string rp_old = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string rp_str = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string rp_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + rp_r + " = call i64 @kl_str_replace(i64 " + rp_str + ", i64 " + rp_old + ", i64 " + rp_new + ")\n");
        vstack.push(rp_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::StrSplit)) {
        string sp_delim = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string sp_str = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string sp_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + sp_r + " = call i64 @kl_str_split(i64 " + sp_str + ", i64 " + sp_delim + ")\n");
        vstack.push(sp_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::StrTrim) || iop == kir_opcode_ord(KirOpcode::StrToUpper) || iop == kir_opcode_ord(KirOpcode::StrToLower)) {
        string tr_s = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string tr_fn = "@kl_str_trim";
        if (iop == kir_opcode_ord(KirOpcode::StrToUpper)) { tr_fn = "@kl_str_to_upper"; }
        if (iop == kir_opcode_ord(KirOpcode::StrToLower)) { tr_fn = "@kl_str_to_lower"; }
        string tr_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + tr_r + " = call i64 " + tr_fn + "(i64 " + tr_s + ")\n");
        vstack.push(tr_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::NativeOut) || iop == kir_opcode_ord(KirOpcode::NativeOutLn) || iop == kir_opcode_ord(KirOpcode::NativeErr) || iop == kir_opcode_ord(KirOpcode::NativeErrLn)) {
        int io_n = iops[0];
        string[] io_flds = [];
        for (int io_p = 0; io_p < io_n; io_p = io_p + 1) { io_flds.push(vstack[vstack.len() - 1]); vstack.pop(); if (tstack.len() > 0) { tstack.pop(); } }
        string io_ptr = "null";
        if (io_n > 0) {
          string io_buf = "%" + string(reg); reg = reg + 1;
          out.push("  " + io_buf + " = alloca i64, i32 " + string(io_n) + "\n");
          for (int io_j = 0; io_j < io_n; io_j = io_j + 1) {
            int io_slot = io_n - 1 - io_j;
            string io_gp = "%" + string(reg); reg = reg + 1;
            out.push("  " + io_gp + " = getelementptr i64, i64* " + io_buf + ", i32 " + string(io_slot) + "\n");
            out.push("  store i64 " + io_flds[io_j] + ", i64* " + io_gp + "\n");
          }
          io_ptr = io_buf;
        }
        string io_fn = "@kl_native_out";
        if (iop == kir_opcode_ord(KirOpcode::NativeOutLn)) { io_fn = "@kl_native_out_ln"; }
        if (iop == kir_opcode_ord(KirOpcode::NativeErr)) { io_fn = "@kl_native_err"; }
        if (iop == kir_opcode_ord(KirOpcode::NativeErrLn)) { io_fn = "@kl_native_err_ln"; }
        string io_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + io_r + " = call i64 " + io_fn + "(i32 " + string(io_n) + ", i64* " + io_ptr + ")\n");
        vstack.push(io_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::NativeIn) || iop == kir_opcode_ord(KirOpcode::NativeInSecret)) {
        int ni_n = iops[0];
        string[] ni_flds = [];
        for (int ni_p = 0; ni_p < ni_n; ni_p = ni_p + 1) { ni_flds.push(vstack[vstack.len() - 1]); vstack.pop(); if (tstack.len() > 0) { tstack.pop(); } }
        string ni_ptr = "null";
        if (ni_n > 0) {
          string ni_buf = "%" + string(reg); reg = reg + 1;
          out.push("  " + ni_buf + " = alloca i64, i32 " + string(ni_n) + "\n");
          for (int ni_j = 0; ni_j < ni_n; ni_j = ni_j + 1) {
            int ni_slot = ni_n - 1 - ni_j;
            string ni_gp = "%" + string(reg); reg = reg + 1;
            out.push("  " + ni_gp + " = getelementptr i64, i64* " + ni_buf + ", i32 " + string(ni_slot) + "\n");
            out.push("  store i64 " + ni_flds[ni_j] + ", i64* " + ni_gp + "\n");
          }
          ni_ptr = ni_buf;
        }
        int ni_secret = iop == kir_opcode_ord(KirOpcode::NativeInSecret) ? 1 : 0;
        string ni_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + ni_r + " = call i64 @kl_native_in(i32 " + string(ni_n) + ", i64* " + ni_ptr + ", i32 " + string(ni_secret) + ")\n");
        vstack.push(ni_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::NativeFsRead)) {
        string fr_p = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string fr_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + fr_r + " = call i64 @kl_native_fs_read(i64 " + fr_p + ")\n");
        vstack.push(fr_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::NativeFsWrite)) {
        string fw_c = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string fw_p = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string fw_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + fw_r + " = call i64 @kl_native_fs_write(i64 " + fw_p + ", i64 " + fw_c + ")\n");
        vstack.push(fw_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::NativeFsListdir)) {
        string fl_p = vstack[vstack.len() - 1]; vstack.pop(); if (tstack.len() > 0) { tstack.pop(); }
        string fl_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + fl_r + " = call i64 @kl_native_fs_listdir(i64 " + fl_p + ")\n");
        vstack.push(fl_r);
        tstack.push(0);
      } else if (iop == kir_opcode_ord(KirOpcode::NativeSysArgs)) {
        string sa_r = "%" + string(reg); reg = reg + 1;
        out.push("  " + sa_r + " = call i64 @kl_native_sys_args()\n");
        vstack.push(sa_r);
        tstack.push(0);
      }
      if (bc_pc < bc_end) { bc_pc = bc_pc + 1; }
    }
    if (!terminated) {
      if (bi + 1 < nl) {
        out.push("  br label %" + label_for(leaders, leaders[bi + 1]) + "\n");
      } else {
        out.push("  ret i64 0\n");
      }
    }
    exit_stacks[bi] = vstack;
    exit_types[bi] = tstack;
  }
  return join_all(out);
}

string emit_function(KirFunction fn, KirModule m, Chunk ch) {
  KirInstr[] instrs = fn.blocks[0].instrs;
  string[] out = [];
  out.push("define i64 @" + mangle_fn(fn.name, fn.fn_index) + "(");
  for (int p = 0; p < fn.param_count; p = p + 1) {
    if (p > 0) { out.push(", "); }
    out.push("i64 %arg" + string(p));
  }
  out.push(") {\n");
  out.push("entry:\n");
  // Slots must cover both the locals referenced by the body AND every
  // parameter: params are always stored into %slot0..%slot<param_count-1>
  // below, but an unused parameter never appears in a Load/StoreLocal so
  // count_locals() alone would under-allocate and the param store would
  // reference an undefined %slot (invalid LLVM IR).
  int lc = count_locals(instrs);
  if (fn.param_count > lc) { lc = fn.param_count; }
  for (int s = 0; s < lc; s = s + 1) {
    out.push("  %slot" + string(s) + " = alloca i64\n");
  }
  for (int p = 0; p < fn.param_count; p = p + 1) {
    out.push("  store i64 %arg" + string(p) + ", i64* %slot" + string(p) + "\n");
  }
  // Branch into the first body block so `entry` has no predecessors even when
  // the function body loops back to its start.
  out.push("  br label %bb0\n");
  out.push(emit_function_body(fn, m, ch));
  out.push("}\n\n");
  return join_all(out);
}

string emit_entry_shim() {
  string[] out = [];
  out.push("define i32 @kinglet_main() {\n");
  out.push("entry:\n");
  out.push("  %0 = call i64 @kinglet_user_main()\n");
  out.push("  %1 = call i32 @kl_exit_code(i64 %0)\n");
  out.push("  ret i32 %1\n");
  out.push("}\n");
  return join_all(out);
}

pub string emit_ll(KirModule m, Chunk ch) {
  string[] out = [];
  out.push("declare i32 @kl_exit_code(i64)\n");
  out.push("declare i64 @kl_float_new(double)\n");
  out.push("declare double @kl_float_get(i64)\n");
  out.push("declare i32 @kl_value_eq(i64, i64)\n");
  out.push("declare i32 @kl_value_cmp(i64, i64)\n");
  out.push("declare i32 @kl_value_is_err(i64)\n");
  out.push("declare i32 @kl_str_starts_with(i64, i64)\n");
  out.push("declare i32 @kl_str_ends_with(i64, i64)\n");
  out.push("declare i64 @kl_str_replace(i64, i64, i64)\n");
  out.push("declare i64 @kl_str_split(i64, i64)\n");
  out.push("declare i64 @kl_str_trim(i64)\n");
  out.push("declare i64 @kl_str_to_upper(i64)\n");
  out.push("declare i64 @kl_str_to_lower(i64)\n");
  out.push("declare i64 @kl_enum_new_payload(i32, i32, i32, i64*)\n");
  out.push("declare i64 @kl_enum_payload_at(i64, i32)\n");
  out.push("declare i64 @kl_array_new(i32, i64*)\n");
  out.push("declare i64 @kl_index_get(i64, i64)\n");
  out.push("declare i64 @kl_index_set(i64, i64, i64)\n");
  out.push("declare i64 @kl_array_push(i64, i64)\n");
  out.push("declare i64 @kl_array_pop(i64)\n");
  out.push("declare i64 @kl_slice(i64, i64, i64)\n");
  out.push("declare i32 @kl_contains(i64, i64)\n");
  out.push("declare i32 @kl_value_len(i64)\n");
  out.push("declare i64 @kl_struct_new(i32, i32, i64*)\n");
  out.push("declare i64 @kl_struct_field_at(i64, i32)\n");
  out.push("declare i64 @kl_struct_field_set(i64, i32, i64)\n");
  out.push("declare i64 @kl_string_new(i8*, i32)\n");
  out.push("declare i64 @kl_value_add(i64, i64)\n");
  out.push("declare i64 @kl_cast_to_int(i64)\n");
  out.push("declare i64 @kl_cast_to_float(i64)\n");
  out.push("declare i64 @kl_cast_to_string(i64)\n");
  out.push("declare i64 @kl_cast_to_char(i64)\n");
  out.push("declare i64 @kl_native_out(i32, i64*)\n");
  out.push("declare i64 @kl_native_out_ln(i32, i64*)\n");
  out.push("declare i64 @kl_native_err(i32, i64*)\n");
  out.push("declare i64 @kl_native_err_ln(i32, i64*)\n");
  out.push("declare i64 @kl_native_in(i32, i64*, i32)\n");
  out.push("declare i64 @kl_native_fs_read(i64)\n");
  out.push("declare i64 @kl_native_fs_write(i64, i64)\n");
  out.push("declare i64 @kl_native_fs_listdir(i64)\n");
  out.push("declare i64 @kl_native_sys_args()\n\n");
  // String literal globals: one per string constant in the pool, escaped as
  // LLVM c"\HH" bytes. Byte access uses int(s[i]) (char -> code) per the
  // kinglet design (no `as int` on values).
  for (int sci = 0; sci < ch.constants.len(); sci = sci + 1) {
    if (constant_kind_at(ch.constants, sci) == ConstKind::String_) {
      string svs = constant_string_at(ch.constants, sci);
      out.push("@.str." + string(sci) + " = private unnamed_addr constant [" + string(svs.len()) + " x i8] c\"" + llvm_str_escape(svs) + "\"\n");
    }
  }
  out.push("\n");
  for (int i = 0; i < m.functions.len(); i = i + 1) {
    out.push(emit_function(m.functions[i], m, ch));
  }
  out.push(emit_entry_shim());
  return join_all(out);
}
