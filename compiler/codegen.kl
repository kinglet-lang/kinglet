// Bytecode code generation: expression and statement compilation.
// Also includes native intrinsic dispatch (handle_ns_call etc.).

import {
  "bytecode.kl"
  "compiler_state.kl"
  "../parser/ast.kl"
}

using ast {
  Expr, Stmt, TypeExpr, BinaryOp, UnaryOp, AssignOp,
  MatchArm, FieldInit, CatchArm, Parameter
};
using compiler_state {
  Compiler,
  compile_error, emit_jump, patch_jump, patch_jump_to,
  compiler_push_scope, compiler_pop_scope,
  declare_local, resolve_local,
  resolve_function, resolve_struct, resolve_variant, resolve_enum,
  callee_ident_line, callee_ident_col,
  castError_type_idx, intResult_type_idx, floatResult_type_idx,
  castError_variant_NotANumber, result_variant_Ok, result_variant_Err,
  is_imported_ns
};

void compile_expr(Compiler co, Expr e) {
  e match {
    Expr::IntLit(let v, let l, let c)    => emit_int(co, v, l, c),
    Expr::CharLit(let v, let l, let c)   => emit_char(co, v, l, c),
    Expr::FloatLit(let v, let l, let c)  => emit_float(co, v, l, c),
    Expr::StringLit(let v, let l, let c) => emit_string(co, v, l, c),
    Expr::NullLit(let l, let c)          => bytecode::write_op(co.chunk, OpCode::Null_, l, c),
    Expr::BoolLit(let v, let l, let c)   => emit_bool(co, v, l, c),
    Expr::Ident(let n, let l, let c)     => emit_ident(co, n, l, c),
    Expr::Binary(let lhs, let op, let rhs, let l, let c) => emit_binary(co, lhs, op, rhs, l, c),
    Expr::Assign(let n, let op, let v, let l, let c) => emit_assign(co, n, op, v, l, c),
    Expr::Call(let callee, let _ta, let args, let l, let c) => emit_call(co, callee, args, l, c),
    Expr::Unary(let op, let r, let l, let c)  => emit_unary(co, op, r, l, c),
    Expr::ArrayLit(let elems, let l, let c)   => emit_array_lit(co, elems, l, c),
    Expr::MapLit(let keys, let vals, let l, let c) => emit_map_lit(co, keys, vals, l, c),
    Expr::Index(let obj, let idx, let l, let c) => emit_index_get(co, obj, idx, l, c),
    Expr::IndexAssign(let obj, let idx, let v, let l, let c) => emit_index_assign(co, obj, idx, v, l, c),
    Expr::FieldAccess(let obj, let field, let l, let c) => emit_field_get(co, obj, field, l, c),
    Expr::FieldAssign(let obj, let field, let v, let l, let c) => emit_field_assign(co, obj, field, v, l, c),
    Expr::StructLit(let t, let fields, let l, let c) => emit_struct_lit(co, t, fields, l, c),
    Expr::Cast(let t, let v, let l, let c) => emit_cast(co, t, v, l, c),
    Expr::NullCoalesce(let left, let eb, let right, let l, let c) => compile_coalesce(co, left, eb, right, l, c),
    Expr::Ternary(let cond, let then_e, let else_e, let l, let c) => emit_ternary(co, cond, then_e, else_e, l, c),
    Expr::Propagate(let value, let l, let c) => emit_propagate(co, value, l, c),
    Expr::TryExpr(let value, let l, let c) => compile_try(co, value, l, c),
    Expr::NsAccess(let ns, let member, let l, let c) => emit_ns_access(co, ns, member, l, c),
    Expr::Match(let val, let arms, let l, let c) => compile_match(co, val, arms, l, c),
    Expr::None                           => emit_null(co),
    _ => compile_error(co, 0, 0, "Unsupported expression in VM compiler."),
  };
}

void emit_int(Compiler co, int v, int line, int col) {
  bytecode::write_constant(co.chunk, bytecode::const_int(v), line, col);
}

void emit_char(Compiler co, int v, int line, int col) {
  bytecode::write_constant(co.chunk, bytecode::const_int(v), line, col);
}

void emit_float(Compiler co, float v, int line, int col) {
  bytecode::write_constant(co.chunk, bytecode::const_double(v), line, col);
}

void emit_string(Compiler co, string raw, int line, int col) {
  // Mirror compiler.cc:656-693 escape semantics exactly.
  string unescaped = "";
  int i = 0;
  while (i < raw.len()) {
    string c = raw.slice(i, i + 1);
    if (c == "\\" && i + 1 < raw.len()) {
      string next = raw.slice(i + 1, i + 2);
      if (next == "n")      { unescaped = unescaped + "\n"; i = i + 2; }
      else if (next == "t") { unescaped = unescaped + "\t"; i = i + 2; }
      else if (next == "r") { unescaped = unescaped + "\r"; i = i + 2; }
      else if (next == "\\") { unescaped = unescaped + "\\"; i = i + 2; }
      else if (next == "\"") { unescaped = unescaped + "\""; i = i + 2; }
      else                  { unescaped = unescaped + c; i = i + 1; }
    } else {
      unescaped = unescaped + c;
      i = i + 1;
    }
  }
  bytecode::write_constant(co.chunk, bytecode::const_string(unescaped), line, col);
}

void emit_null(Compiler co) {
  bytecode::write_op(co.chunk, OpCode::Null_, 0, 0);
}

void emit_unary(Compiler co, UnaryOp op, Expr r, int line, int col) {
  compile_expr(co, r);
  op match {
    UnaryOp::Neg    => bytecode::write_op(co.chunk, OpCode::Negate, line, col),
    UnaryOp::Not    => bytecode::write_op(co.chunk, OpCode::Not_, line, col),
    UnaryOp::BitNot => bytecode::write_op(co.chunk, OpCode::BitNot, line, col),
  };
}

void emit_bool(Compiler co, bool v, int line, int col) {
  if (v) {
    bytecode::write_op(co.chunk, OpCode::True_, line, col);
  } else {
    bytecode::write_op(co.chunk, OpCode::False_, line, col);
  }
}

void emit_ident(Compiler co, string name, int line, int col) {
  int slot = resolve_local(co, name);
  if (slot < 0) {
    compile_error(co, line, col, "Use of undeclared variable '" + name + "'.");
    return;
  }
  bytecode::write_operand(co.chunk, OpCode::LoadLocal, slot, line, col);
}

void emit_binary(Compiler co, Expr lhs, BinaryOp op, Expr rhs, int line, int col) {
  // Short-circuit logical operators (And / Or) need special handling
  // before the generic left-right-emit pattern.
  bool is_and = op match { BinaryOp::And => true, _ => false, };
  bool is_or  = op match { BinaryOp::Or  => true, _ => false, };
  if (is_and) { emit_logical_and(co, lhs, rhs, line, col); return; }
  if (is_or)  { emit_logical_or(co, lhs, rhs, line, col);  return; }
  compile_expr(co, lhs);
  compile_expr(co, rhs);
  op match {
    BinaryOp::Add => bytecode::write_op(co.chunk, OpCode::Add, line, col),
    BinaryOp::Sub => bytecode::write_op(co.chunk, OpCode::Subtract, line, col),
    BinaryOp::Mul => bytecode::write_op(co.chunk, OpCode::Multiply, line, col),
    BinaryOp::Div => bytecode::write_op(co.chunk, OpCode::Divide, line, col),
    BinaryOp::Mod => bytecode::write_op(co.chunk, OpCode::Modulo, line, col),
    BinaryOp::Eq  => bytecode::write_op(co.chunk, OpCode::Eq, line, col),
    BinaryOp::Neq => bytecode::write_op(co.chunk, OpCode::Neq, line, col),
    BinaryOp::Lt  => bytecode::write_op(co.chunk, OpCode::Lt, line, col),
    BinaryOp::Gt  => bytecode::write_op(co.chunk, OpCode::Gt, line, col),
    BinaryOp::Le  => bytecode::write_op(co.chunk, OpCode::Le, line, col),
    BinaryOp::Ge  => bytecode::write_op(co.chunk, OpCode::Ge, line, col),
    BinaryOp::BitAnd => bytecode::write_op(co.chunk, OpCode::BitAnd, line, col),
    BinaryOp::BitOr  => bytecode::write_op(co.chunk, OpCode::BitOr, line, col),
    BinaryOp::BitXor => bytecode::write_op(co.chunk, OpCode::BitXor, line, col),
    BinaryOp::Shl    => bytecode::write_op(co.chunk, OpCode::Shl, line, col),
    BinaryOp::Shr    => bytecode::write_op(co.chunk, OpCode::Shr, line, col),
    _ => compile_error(co, line, col, "Unsupported binary operator in VM compiler."),
  };
}

// a && b: compile a; JmpFalse past; compile b; Jmp past False; False; patch.
// Result is b's value if a is truthy, otherwise False.
void emit_logical_and(Compiler co, Expr lhs, Expr rhs, int line, int col) {
  compile_expr(co, lhs);
  int false_jump = emit_jump(co, OpCode::JmpFalse, line, col);
  compile_expr(co, rhs);
  int end_jump = emit_jump(co, OpCode::Jmp, line, col);
  patch_jump(co, false_jump);
  bytecode::write_op(co.chunk, OpCode::False_, line, col);
  patch_jump(co, end_jump);
}

// a || b: compile a; JmpFalse skip; True; Jmp end; skip: compile b; patch end.
// Result is True if a is truthy, otherwise b's value.
void emit_logical_or(Compiler co, Expr lhs, Expr rhs, int line, int col) {
  compile_expr(co, lhs);
  int false_jump = emit_jump(co, OpCode::JmpFalse, line, col);
  bytecode::write_op(co.chunk, OpCode::True_, line, col);
  int end_jump = emit_jump(co, OpCode::Jmp, line, col);
  patch_jump(co, false_jump);
  compile_expr(co, rhs);
  patch_jump(co, end_jump);
}

void emit_array_lit(Compiler co, Expr[] elems, int line, int col) {
  for (int i = 0; i < elems.len(); i = i + 1) {
    compile_expr(co, elems[i]);
  }
  bytecode::write_operand(co.chunk, OpCode::ArrayNew, elems.len(), line, col);
}

void emit_index_get(Compiler co, Expr obj, Expr idx, int line, int col) {
  compile_expr(co, obj);
  compile_expr(co, idx);
  bytecode::write_op(co.chunk, OpCode::IndexGet, line, col);
}

void emit_field_get(Compiler co, Expr obj, string field, int line, int col) {
  compile_expr(co, obj);
  int field_const = bytecode::add_constant(co.chunk, bytecode::const_string(field));
  bytecode::write_operand(co.chunk, OpCode::FieldGet, field_const, line, col);
}

void emit_struct_lit(Compiler co, TypeExpr t, FieldInit[] fields, int line, int col) {
  for (int i = 0; i < fields.len(); i = i + 1) {
    compile_expr(co, fields[i].value);
  }
  // Encode: (type_idx << 16) | field_count.
  int type_idx = resolve_struct(co, t.name);
  if (type_idx < 0) { type_idx = 0; }
  int operand = (type_idx << 16) | fields.len();
  bytecode::write_operand(co.chunk, OpCode::StructNew, operand, line, col);
}

void emit_cast(Compiler co, TypeExpr t, Expr v, int line, int col) {
  compile_expr(co, v);
  int target_kind = 0;
  if (t.name == "int")          { target_kind = 0; }
  if (t.name == "float")        { target_kind = 1; }
  if (t.name == "string")       { target_kind = 2; }
  if (t.name == "char")         { target_kind = 3; }
  if (t.name == "byte")         { target_kind = 3; }
  bytecode::write_operand(co.chunk, OpCode::CastTo, target_kind, line, col);
}

void emit_map_lit(Compiler co, Expr[] keys, Expr[] vals, int line, int col) {
  for (int i = 0; i < keys.len(); i = i + 1) {
    compile_expr(co, keys[i]);
    compile_expr(co, vals[i]);
  }
  bytecode::write_operand(co.chunk, OpCode::MapNew, keys.len(), line, col);
}

void emit_index_assign(Compiler co, Expr obj, Expr idx, Expr v, int line, int col) {
  compile_expr(co, obj);
  compile_expr(co, idx);
  compile_expr(co, v);
  bytecode::write_op(co.chunk, OpCode::IndexSet, line, col);
}

void emit_field_assign(Compiler co, Expr obj, string field, Expr v, int line, int col) {
  compile_expr(co, obj);
  compile_expr(co, v);
  int field_const = bytecode::add_constant(co.chunk, bytecode::const_string(field));
  bytecode::write_operand(co.chunk, OpCode::FieldSet, field_const, line, col);
}

void emit_ternary(Compiler co, Expr cond, Expr then_e, Expr else_e, int line, int col) {
  compile_expr(co, cond);
  int else_jump = emit_jump(co, OpCode::JmpFalse, line, col);
  compile_expr(co, then_e);
  int end_jump = emit_jump(co, OpCode::Jmp, line, col);
  int else_pc = co.chunk.instructions.len();
  co.chunk.instructions[else_jump].operand = else_pc - else_jump - 1;
  compile_expr(co, else_e);
  int end_pc = co.chunk.instructions.len();
  co.chunk.instructions[end_jump].operand = end_pc - end_jump - 1;
}

void emit_propagate(Compiler co, Expr value, int line, int col) {
  compile_expr(co, value);
  if (co.in_try) {
    bytecode::write_op(co.chunk, OpCode::PropagateErr, line, col);
  } else {
    int err_jump = emit_jump(co, OpCode::JmpIfErr, line, col);
    int end_jump = emit_jump(co, OpCode::Jmp, line, col);
    int err_pc = co.chunk.instructions.len();
    co.chunk.instructions[err_jump].operand = err_pc - err_jump - 1;
    bytecode::write_op(co.chunk, OpCode::Pop, line, col);
    bytecode::write_op(co.chunk, OpCode::Null_, line, col);
    bytecode::write_op(co.chunk, OpCode::Return_, line, col);
    int end_pc = co.chunk.instructions.len();
    co.chunk.instructions[end_jump].operand = end_pc - end_jump - 1;
  }
}

// match expression
// Mirrors compiler.cc:1202-1378.

void compile_match(Compiler co, Expr value, MatchArm[] arms, int line, int col) {
  // Compile the match value and store in a temp local.
  compile_expr(co, value);
  int temp_slot = co.locals.len();
  co.locals.push(Local { "<match_value>", temp_slot, co.scope_depth });
  bytecode::write_operand(co.chunk, OpCode::StoreLocal, temp_slot, line, col);

  int[] end_jumps = [];

  for (int arm_i = 0; arm_i < arms.len(); arm_i = arm_i + 1) {
    MatchArm arm = arms[arm_i];

    // Detect pattern type.
    bool is_wildcard = arm.pattern match {
      Expr::Ident(let n, let _l, let _c) => n == "_",
      _ => false,
    };
    bool is_binding = arm.pattern match {
      Expr::BindingPat(let _n, let _l, let _c) => true,
      _ => false,
    };
    bool is_enum_pat = arm.pattern match {
      Expr::EnumPat(let _en, let _vn, let _fs, let _l, let _c) => true,
      _ => false,
    };
    bool is_array_pat = arm.pattern match {
      Expr::ArrayPat(let _es, let _l, let _c) => true,
      _ => false,
    };

    if (is_wildcard) {
      // Wildcard _: pop the temp, compile body.
      if (arm.guard_expr match { Expr::None => false, _ => true, }) {
        // Guard on wildcard: check guard, JmpFalse to next arm.
        compile_expr(co, arm.guard_expr);
        int guard_jmp = emit_jump(co, OpCode::JmpFalse, line, col);
        bytecode::write_op(co.chunk, OpCode::Pop, line, col);
        compile_expr(co, arm.body);
        end_jumps.push(emit_jump(co, OpCode::Jmp, line, col));
        patch_jump(co, guard_jmp);
      } else {
        bytecode::write_op(co.chunk, OpCode::Pop, line, col);
        compile_expr(co, arm.body);
      }
    } else if (is_binding) {
      // BindingPat(let x): bind temp value to a new local.
      string bind_name = arm.pattern match {
        Expr::BindingPat(let n, let _l, let _c) => n,
        _ => "",
      };
      int bind_slot = co.locals.len();
      co.locals.push(Local { bind_name, bind_slot, co.scope_depth });
      bytecode::write_operand(co.chunk, OpCode::LoadLocal, temp_slot, line, col);
      bytecode::write_operand(co.chunk, OpCode::StoreLocal, bind_slot, line, col);
      bytecode::write_op(co.chunk, OpCode::Pop, line, col);
      if (arm.guard_expr match { Expr::None => false, _ => true, }) {
        compile_expr(co, arm.guard_expr);
        int guard_jmp = emit_jump(co, OpCode::JmpFalse, line, col);
        bytecode::write_op(co.chunk, OpCode::Pop, line, col);
        compile_expr(co, arm.body);
        end_jumps.push(emit_jump(co, OpCode::Jmp, line, col));
        patch_jump(co, guard_jmp);
      } else {
        compile_expr(co, arm.body);
      }
      // Pop the binding local after the arm.
      co.locals.pop();
    } else if (is_enum_pat) {
      // EnumPat: match variant, extract payloads, compile body.
      _compile_enum_arm(co, arm, temp_slot, line, col, end_jumps);
    } else if (is_array_pat) {
      // ArrayPat: destructure elements.
      _compile_array_arm(co, arm, temp_slot, line, col, end_jumps);
    } else {
      // Literal/default pattern: LoadLocal temp, compile pattern, Eq, JmpFalse.
      int[] fail_jumps = [];
      bytecode::write_operand(co.chunk, OpCode::LoadLocal, temp_slot, line, col);
      compile_expr(co, arm.pattern);
      bytecode::write_op(co.chunk, OpCode::Eq, line, col);
      fail_jumps.push(emit_jump(co, OpCode::JmpFalse, line, col));
      if (arm.guard_expr match { Expr::None => false, _ => true, }) {
        bytecode::write_op(co.chunk, OpCode::Pop, line, col);
        compile_expr(co, arm.guard_expr);
        fail_jumps.push(emit_jump(co, OpCode::JmpFalse, line, col));
      }
      bytecode::write_op(co.chunk, OpCode::Pop, line, col);
      compile_expr(co, arm.body);
      end_jumps.push(emit_jump(co, OpCode::Jmp, line, col));
      // Patch all fail jumps to here (next arm).
      for (int j = 0; j < fail_jumps.len(); j = j + 1) {
        patch_jump(co, fail_jumps[j]);
      }
    }
  }

  // Fallthrough: emit Null for "no match" at runtime.
  bytecode::write_op(co.chunk, OpCode::Null_, line, col);

  // Patch all end jumps.
  for (int j = 0; j < end_jumps.len(); j = j + 1) {
    patch_jump(co, end_jumps[j]);
  }

  // Pop the temp local.
  co.locals.pop();
}

void _compile_enum_arm(Compiler co, MatchArm arm, int temp_slot, int line, int col, int[] end_jumps) {
  Expr[] no_fields = [];
  string enum_name = arm.pattern match {
    Expr::EnumPat(let en, let _vn, let _fs, let _l, let _c) => en,
    _ => "",
  };
  string variant_name = arm.pattern match {
    Expr::EnumPat(let _en, let vn, let _fs, let _l, let _c) => vn,
    _ => "",
  };
  Expr[] fields = arm.pattern match {
    Expr::EnumPat(let _en, let _vn, let fs, let _l, let _c) => fs,
    _ => no_fields,
  };

  int[] fail_jumps = [];
  int[] bind_slots = [];

  int type_idx = resolve_enum(co, enum_name);
  if (type_idx < 0) {
    compile_error(co, line, col, "Unknown enum type '" + enum_name + "'.");
    return;
  }
  int variant_idx = resolve_variant(co, type_idx, variant_name);
  if (variant_idx < 0) {
    compile_error(co, line, col, "Unknown enum variant '" + variant_name + "'.");
    return;
  }

  // Check variant: LoadLocal temp, EnumVariant_ reference, Eq, JmpFalse.
  bytecode::write_operand(co.chunk, OpCode::LoadLocal, temp_slot, line, col);
  int operand = (type_idx << 16) | variant_idx;
  bytecode::write_operand(co.chunk, OpCode::EnumVariant_, operand, line, col);
  bytecode::write_op(co.chunk, OpCode::Eq, line, col);
  fail_jumps.push(emit_jump(co, OpCode::JmpFalse, line, col));

  // Extract payload bindings.
  for (int i = 0; i < fields.len(); i = i + 1) {
    bool is_field_binding = fields[i] match {
      Expr::BindingPat(let _n, let _l, let _c) => true,
      _ => false,
    };
    if (is_field_binding) {
      string field_name = fields[i] match {
        Expr::BindingPat(let n, let _l, let _c) => n,
        _ => "",
      };
      int slot = co.locals.len();
      co.locals.push(Local { field_name, slot, co.scope_depth });
      bytecode::write_operand(co.chunk, OpCode::LoadLocal, temp_slot, line, col);
      bytecode::write_operand(co.chunk, OpCode::EnumPayloadGet, i, line, col);
      bytecode::write_operand(co.chunk, OpCode::StoreLocal, slot, line, col);
      bytecode::write_op(co.chunk, OpCode::Pop, line, col);
      bind_slots.push(slot);
    }
  }

  // Guard check (if present).
  if (arm.guard_expr match { Expr::None => false, _ => true, }) {
    compile_expr(co, arm.guard_expr);
    fail_jumps.push(emit_jump(co, OpCode::JmpFalse, line, col));
  }

  // Pop temp value, compile body, jump to end.
  bytecode::write_op(co.chunk, OpCode::Pop, line, col);
  compile_expr(co, arm.body);
  end_jumps.push(emit_jump(co, OpCode::Jmp, line, col));

  // Patch all fail jumps to here (next arm).
  for (int j = 0; j < fail_jumps.len(); j = j + 1) {
    patch_jump(co, fail_jumps[j]);
  }

  // Pop binding locals.
  for (int j = 0; j < bind_slots.len(); j = j + 1) {
    co.locals.pop();
  }
}

void _compile_array_arm(Compiler co, MatchArm arm, int temp_slot, int line, int col, int[] end_jumps) {
  Expr[] no_elems = [];
  Expr[] elements = arm.pattern match {
    Expr::ArrayPat(let es, let _l, let _c) => es,
    _ => no_elems,
  };

  int[] fail_jumps = [];
  int[] bind_slots = [];

  for (int i = 0; i < elements.len(); i = i + 1) {
    bool is_elem_binding = elements[i] match {
      Expr::BindingPat(let _n, let _l, let _c) => true,
      _ => false,
    };
    bool is_elem_wildcard = elements[i] match {
      Expr::Ident(let n, let _l, let _c) => n == "_",
      _ => false,
    };
    if (is_elem_binding) {
      string elem_name = elements[i] match {
        Expr::BindingPat(let n, let _l, let _c) => n,
        _ => "",
      };
      int slot = co.locals.len();
      co.locals.push(Local { elem_name, slot, co.scope_depth });
      bytecode::write_operand(co.chunk, OpCode::LoadLocal, temp_slot, line, col);
      bytecode::write_constant(co.chunk, bytecode::const_int(i), line, col);
      bytecode::write_op(co.chunk, OpCode::IndexGet, line, col);
      bytecode::write_operand(co.chunk, OpCode::StoreLocal, slot, line, col);
      bytecode::write_op(co.chunk, OpCode::Pop, line, col);
      bind_slots.push(slot);
    } else if (!is_elem_wildcard) {
      // Literal element: compare.
      bytecode::write_operand(co.chunk, OpCode::LoadLocal, temp_slot, line, col);
      bytecode::write_constant(co.chunk, bytecode::const_int(i), line, col);
      bytecode::write_op(co.chunk, OpCode::IndexGet, line, col);
      compile_expr(co, elements[i]);
      bytecode::write_op(co.chunk, OpCode::Eq, line, col);
      fail_jumps.push(emit_jump(co, OpCode::JmpFalse, line, col));
    }
  }

  // Guard check.
  if (arm.guard_expr match { Expr::None => false, _ => true, }) {
    compile_expr(co, arm.guard_expr);
    fail_jumps.push(emit_jump(co, OpCode::JmpFalse, line, col));
  }

  bytecode::write_op(co.chunk, OpCode::Pop, line, col);
  compile_expr(co, arm.body);
  end_jumps.push(emit_jump(co, OpCode::Jmp, line, col));

  for (int j = 0; j < fail_jumps.len(); j = j + 1) {
    patch_jump(co, fail_jumps[j]);
  }
  for (int j = 0; j < bind_slots.len(); j = j + 1) {
    co.locals.pop();
  }
}

// lhs ?? rhs  or  lhs ?? |e| rhs
// If lhs is null (from Cast failure) or Result::Err, evaluate rhs.
// For now: null-based check only. Result-enum support deferred.
void compile_coalesce(Compiler co, Expr left, string err_binding, Expr right, int line, int col) {
  compile_expr(co, left);
  bytecode::write_op(co.chunk, OpCode::Dup, line, col);
  bytecode::write_op(co.chunk, OpCode::IsNull, line, col);
  int skip_fb = emit_jump(co, OpCode::JmpFalse, line, col);
  bytecode::write_op(co.chunk, OpCode::Pop, line, col);
  compile_expr(co, right);
  patch_jump(co, skip_fb);
}

// try expr — if expr is null (Cast failure), early-return null.
// For Result::Err propagation, return EnumVariant. Deferred.
void compile_try(Compiler co, Expr value, int line, int col) {
  compile_expr(co, value);
  bytecode::write_op(co.chunk, OpCode::Dup, line, col);
  bytecode::write_op(co.chunk, OpCode::IsNull, line, col);
  int skip_ret = emit_jump(co, OpCode::JmpFalse, line, col);
  bytecode::write_op(co.chunk, OpCode::Null_, line, col);
  bytecode::write_op(co.chunk, OpCode::Return_, line, col);
  patch_jump(co, skip_ret);
}

// Plain `x = expr` only — compound +=/-= etc. not yet supported. Value of
// the assignment expression is the new value (StoreLocal copies, doesn't pop),
// so callers in expression context get a value on stack.
// Helper: map compound AssignOp to the corresponding binary OpCode.
// Only called for non-plain compound ops; the wildcard is unreachable.
OpCode compound_op(AssignOp op) {
  return op match {
    AssignOp::AddAssign => OpCode::Add,
    AssignOp::SubAssign => OpCode::Subtract,
    AssignOp::MulAssign => OpCode::Multiply,
    AssignOp::DivAssign => OpCode::Divide,
    _ => OpCode::Add,
  };
}

void emit_assign(Compiler co, string name, AssignOp op, Expr v, int line, int col) {
  int slot = resolve_local(co, name);
  if (slot < 0) {
    compile_error(co, line, col, "Assignment to undeclared variable '" + name + "'.");
    return;
  }
  bool is_plain = op match {
    AssignOp::Assign => true,
    _ => false,
  };
  if (is_plain) {
    compile_expr(co, v);
  } else {
    // Compound: load old value, compile RHS, apply binary op.
    bytecode::write_operand(co.chunk, OpCode::LoadLocal, slot, line, col);
    compile_expr(co, v);
    bytecode::write_op(co.chunk, compound_op(op), line, col);
  }
  bytecode::write_operand(co.chunk, OpCode::StoreLocal, slot, line, col);
}

// Handle NsAccess callee in call position. Dispatches to either enum variant
// construction with payload, or native namespace calls (io, fs, sys).
void emit_ns_call(Compiler co, string ns, string m, Expr[] args, int nl, int nc) {
  int enum_ti = resolve_enum(co, ns);
  if (enum_ti >= 0) {
    int vi = resolve_variant(co, enum_ti, m);
    if (vi < 0) {
      compile_error(co, nl, nc, "Unknown enum variant '" + ns + "::" + m + "'.");
      return;
    }
    for (int i = 0; i < args.len(); i = i + 1) {
      compile_expr(co, args[i]);
    }
    int operand = (enum_ti << 16) | vi;
    bytecode::write_operand(co.chunk, OpCode::EnumVariantPayload, operand, nl, nc);
    return;
  }
  // Type-qualified methods: int::bits(float)
  if (ns == "int" && m == "bits") {
    for (int i = 0; i < args.len(); i = i + 1) {
      compile_expr(co, args[i]);
    }
    bytecode::write_operand(co.chunk, OpCode::FloatToBits, 0, nl, nc);
    return;
  }
  // Imported function call: scanner::scan(...), parser::parse_program(...), etc.
  if (is_imported_ns(co, ns)) {
    int fi = resolve_function(co, ns + "::" + m);
    if (fi >= 0) {
      for (int i = 0; i < args.len(); i = i + 1) {
        compile_expr(co, args[i]);
      }
      Constant fc = Constant {
        ConstKind::Function_,
        0, 0.0, false, "",
        co.funcs[fi].func_index, 0,
      };
      bytecode::write_constant(co.chunk, fc, nl, nc);
      bytecode::write_operand(co.chunk, OpCode::Call, args.len(), nl, nc);
      return;
    }
  }
  handle_ns_call(co, ns, m, args, nl, nc);
}

// Handle NsAccess in expression position: enum variant without payload,
// or imported function reference.
void emit_ns_access(Compiler co, string ns, string member, int line, int col) {
  int type_idx = resolve_enum(co, ns);
  if (type_idx >= 0) {
    int variant_idx = resolve_variant(co, type_idx, member);
    if (variant_idx < 0) {
      compile_error(co, line, col, "Unknown enum variant '" + ns + "::" + member + "'.");
      return;
    }
    EnumMeta meta = co.chunk.enum_metas[type_idx];
    if (meta.variant_param_counts[variant_idx] > 0) {
      compile_error(co, line, col, "Enum variant '" + member + "' requires arguments.");
      return;
    }
    int operand = (type_idx << 16) | variant_idx;
    bytecode::write_operand(co.chunk, OpCode::EnumVariant_, operand, line, col);
    return;
  }
  // Imported function reference
  if (is_imported_ns(co, ns)) {
    int fi = resolve_function(co, ns + "::" + member);
    if (fi >= 0) {
      Constant fc = Constant {
        ConstKind::Function_,
        0, 0.0, false, "",
        co.funcs[fi].func_index, 0,
      };
      bytecode::write_constant(co.chunk, fc, line, col);
      return;
    }
  }
  compile_error(co, line, col, "Unsupported namespace access in VM compiler.");
}

// Handle method calls: obj.method(args). Compiles the receiver first, then
// dispatches on method name to emit the appropriate array/string/map opcode.
// Mirrors compiler.cc:1015-1121.
void emit_method_call(Compiler co, Expr obj, string method, Expr[] args, int line, int col) {
  // Check for io::out.line(...), io::err.line(...), io::in.secret(...)
  bool obj_is_ns = obj match { Expr::NsAccess(let _ns, let _m, let _l, let _c) => true, _ => false, };
  if (obj_is_ns && has_using(co, "io")) {
    string ns = obj match { Expr::NsAccess(let ns, let _m, let _l, let _c) => ns, _ => "", };
    string member = obj match { Expr::NsAccess(let _ns, let m, let _l, let _c) => m, _ => "", };
    if (ns == "io" && member == "out" && method == "line") {
      for (int i = 0; i < args.len(); i = i + 1) { compile_expr(co, args[i]); }
      bytecode::write_operand(co.chunk, OpCode::NativeOutLn, args.len(), line, col);
      return;
    }
    if (ns == "io" && member == "err" && method == "line") {
      for (int i = 0; i < args.len(); i = i + 1) { compile_expr(co, args[i]); }
      bytecode::write_operand(co.chunk, OpCode::NativeErrLn, args.len(), line, col);
      return;
    }
    if (ns == "io" && member == "in" && method == "secret") {
      for (int i = 0; i < args.len(); i = i + 1) { compile_expr(co, args[i]); }
      bytecode::write_operand(co.chunk, OpCode::NativeInSecret, args.len(), line, col);
      return;
    }
  }
  // Compile receiver onto stack.
  compile_expr(co, obj);
  // Dispatch on method name. Matches compiler.cc:1025-1121 exactly.
  if (method == "len")      { bytecode::write_op(co.chunk, OpCode::ArrayLen, line, col); return; }
  if (method == "push")     { compile_expr(co, args[0]); bytecode::write_op(co.chunk, OpCode::ArrayPush, line, col); return; }
  if (method == "pop")      { bytecode::write_op(co.chunk, OpCode::ArrayPop, line, col); return; }
  if (method == "remove")   { compile_expr(co, args[0]); bytecode::write_op(co.chunk, OpCode::ArrayRemove, line, col); return; }
  if (method == "contains") { compile_expr(co, args[0]); bytecode::write_op(co.chunk, OpCode::ArrayContains, line, col); return; }
  if (method == "clear")    { bytecode::write_op(co.chunk, OpCode::ArrayClear, line, col); return; }
  if (method == "insert")   { compile_expr(co, args[0]); compile_expr(co, args[1]); bytecode::write_op(co.chunk, OpCode::ArrayInsert, line, col); return; }
  if (method == "index_of") { compile_expr(co, args[0]); bytecode::write_op(co.chunk, OpCode::ArrayIndexOf, line, col); return; }
  if (method == "slice")    { compile_expr(co, args[0]); compile_expr(co, args[1]); bytecode::write_op(co.chunk, OpCode::ArraySlice, line, col); return; }
  if (method == "reverse")  { bytecode::write_op(co.chunk, OpCode::ArrayReverse, line, col); return; }
  if (method == "resize")   { compile_expr(co, args[0]); compile_expr(co, args[1]); bytecode::write_op(co.chunk, OpCode::ArrayResize, line, col); return; }
  if (method == "has")      { compile_expr(co, args[0]); bytecode::write_op(co.chunk, OpCode::MapHas, line, col); return; }
  if (method == "keys")     { bytecode::write_op(co.chunk, OpCode::MapKeys, line, col); return; }
  if (method == "starts_with") { compile_expr(co, args[0]); bytecode::write_op(co.chunk, OpCode::StringStartsWith, line, col); return; }
  if (method == "ends_with")   { compile_expr(co, args[0]); bytecode::write_op(co.chunk, OpCode::StringEndsWith, line, col); return; }
  if (method == "replace")     { compile_expr(co, args[0]); compile_expr(co, args[1]); bytecode::write_op(co.chunk, OpCode::StringReplace, line, col); return; }
  if (method == "split")       { compile_expr(co, args[0]); bytecode::write_op(co.chunk, OpCode::StringSplit, line, col); return; }
  if (method == "trim")        { bytecode::write_op(co.chunk, OpCode::StringTrim, line, col); return; }
  if (method == "to_upper")    { bytecode::write_op(co.chunk, OpCode::StringToUpper, line, col); return; }
  if (method == "to_lower")    { bytecode::write_op(co.chunk, OpCode::StringToLower, line, col); return; }
  compile_error(co, line, col, "Unknown method '" + method + "' in VM compiler.");
}

void emit_call(Compiler co, Expr callee, Expr[] args, int line, int col) {
  // The C++ compiler stamps Call instructions with the callee's source
  // location, not the '('. Our parser puts '(' on the Call node, so patch
  // line/col from the callee Ident here.
  int cl = callee_ident_line(callee, line);
  int cc = callee_ident_col(callee, col);
  string callee_name = callee match {
    Expr::Ident(let n, let _l, let _c) => n,
    _ => "",
  };
  // Handle io::out / io::err / io::in native calls via NsAccess.
  // Also handle enum variant construction with payload: Shape::Circle(1.0).
  // Use sequential if instead of nested match to avoid parser bug with
  // match-arm bodies that start with '{' inside a match-in-if-condition.
  bool is_ns = callee match { Expr::NsAccess(let _ns, let _m, let _l, let _c) => true, _ => false, };
  if (is_ns) {
    callee match {
      Expr::NsAccess(let ns, let m, let nl, let nc) =>
        emit_ns_call(co, ns, m, args, nl, nc),
      _ => {},
    };
  }
  if (is_ns) { return; }
  // Handle method calls: obj.method(args).
  bool is_field = callee match { Expr::FieldAccess(let _o, let _f, let _l, let _c) => true, _ => false, };
  if (is_field) {
    callee match {
      Expr::FieldAccess(let obj, let method, let fl, let fc) =>
        emit_method_call(co, obj, method, args, fl, fc),
      _ => {},
    };
    return;
  }
  if (callee_name.len() == 0) {
    compile_error(co, cl, cc, "Only direct function calls supported in VM compiler.");
    return;
  }
  int fi = resolve_function(co, callee_name);
  if (fi < 0) {
    compile_error(co, cl, cc, "Use of undeclared variable '" + callee_name + "'.");
    return;
  }
  for (int i = 0; i < args.len(); i = i + 1) {
    compile_expr(co, args[i]);
  }
  // Mirror chunk_.add_constant(Value::function_value(idx)) + emit Constant —
  // a fresh pool entry every call site, no dedup (matches compiler.cc:1142).
  Constant fc = Constant {
    ConstKind::Function_,
    0, 0.0, false, "",
    co.funcs[fi].func_index, 0,
  };
  bytecode::write_constant(co.chunk, fc, cl, cc);
  bytecode::write_operand(co.chunk, OpCode::Call, args.len(), cl, cc);
}

// statement compilation

pub void compile_stmt(Compiler co, Stmt s) {
  s match {
    Stmt::Block(let stmts, let _l, let _c)         => compile_block(co, stmts),
    Stmt::ReturnStmt(let v, let l, let c)          => compile_return(co, v, l, c),
    Stmt::VarDecl(let _stor, let _t, let n, let init, let l, let c) => compile_var_decl(co, n, init, l, c),
    Stmt::ExprStmt(let e, let l, let c)            => compile_expr_stmt(co, e, l, c),
    Stmt::If(let cond, let th, let el, let l, let c) => compile_if(co, cond, th, el, l, c),
    Stmt::While(let cond, let body, let l, let c)     => compile_while(co, cond, body, l, c),
    Stmt::For(let init, let cond, let step, let body, let l, let c) => compile_for(co, init, cond, step, body, l, c),
    Stmt::Break(let l, let c)                          => compile_break(co, l, c),
    Stmt::Continue(let l, let c)                       => compile_continue(co, l, c),
    Stmt::Guard(let cond, let body, let l, let c)      => compile_guard(co, cond, body, l, c),
    Stmt::TryCatch(let body, let catches, let l, let c) => compile_try_catch(co, body, catches, l, c),
    _ => compile_error(co, 0, 0, "Unsupported statement in VM compiler."),
  };
}

void compile_block(Compiler co, Stmt[] stmts) {
  compiler_push_scope(co);
  bool returned = false;
  for (int i = 0; i < stmts.len(); i = i + 1) {
    if (returned) { i = stmts.len(); }
    if (!returned) {
      compile_stmt(co, stmts[i]);
      returned = stmts[i] match {
        Stmt::ReturnStmt(let _v, let _l, let _c) => true,
        _ => false,
      };
    }
  }
  compiler_pop_scope(co);
}

void compile_return(Compiler co, Expr v, int line, int col) {
  bool has_value = v match { Expr::None => false, _ => true, };
  if (has_value) {
    compile_expr(co, v);
  } else {
    bytecode::write_op(co.chunk, OpCode::Null_, line, col);
  }
  bytecode::write_op(co.chunk, OpCode::Return_, line, col);
}

void compile_var_decl(Compiler co, string name, Expr init, int line, int col) {
  int slot = declare_local(co, name);
  bool has_init = init match { Expr::None => false, _ => true, };
  if (has_init) {
    compile_expr(co, init);
  } else {
    bytecode::write_op(co.chunk, OpCode::Null_, line, col);
  }
  bytecode::write_operand(co.chunk, OpCode::StoreLocal, slot, line, col);
  bytecode::write_op(co.chunk, OpCode::Pop, line, col);
}

void compile_expr_stmt(Compiler co, Expr e, int line, int col) {
  compile_expr(co, e);
  bytecode::write_op(co.chunk, OpCode::Pop, line, col);
}

void compile_if(Compiler co, Expr cond, Stmt th, Stmt el, int line, int col) {
  compile_expr(co, cond);
  int then_jump = emit_jump(co, OpCode::JmpFalse, line, col);
  compile_stmt(co, th);
  bool has_else = el match { Stmt::None => false, _ => true, };
  if (has_else) {
    int else_jump = emit_jump(co, OpCode::Jmp, line, col);
    patch_jump(co, then_jump);
    compile_stmt(co, el);
    patch_jump(co, else_jump);
  } else {
    patch_jump(co, then_jump);
  }
}

void compile_while(Compiler co, Expr cond, Stmt body, int line, int col) {
  int loop_start = co.chunk.instructions.len();
  compile_expr(co, cond);
  int exit_jump = emit_jump(co, OpCode::JmpFalse, line, col);
  co.loop_depth = co.loop_depth + 1;
  compile_stmt(co, body);
  co.loop_depth = co.loop_depth - 1;
  // Patch continue jumps to loop_start
  while (co.loop_continues.len() > 0) {
    int idx = co.loop_continues.len() - 1;
    patch_jump_to(co, co.loop_continues[idx], loop_start);
    co.loop_continues.pop();
  }
  int loop_jump = emit_jump(co, OpCode::Jmp, line, col);
  patch_jump_to(co, loop_jump, loop_start);
  // Patch break to after loop
  while (co.loop_breaks.len() > 0) {
    int idx = co.loop_breaks.len() - 1;
    patch_jump(co, co.loop_breaks[idx]);
    co.loop_breaks.pop();
  }
  patch_jump(co, exit_jump);
}

void compile_for(Compiler co, Stmt init, Expr cond, Stmt step, Stmt body, int line, int col) {
  compiler_push_scope(co);
  bool has_init = init match { Stmt::None => false, _ => true, };
  if (has_init) { compile_stmt(co, init); }
  int loop_start = co.chunk.instructions.len();
  int exit_jump = -1;
  bool has_cond = cond match { Expr::None => false, _ => true, };
  if (has_cond) {
    compile_expr(co, cond);
    exit_jump = emit_jump(co, OpCode::JmpFalse, line, col);
  }
  co.loop_depth = co.loop_depth + 1;
  compile_stmt(co, body);
  co.loop_depth = co.loop_depth - 1;
  // Patch break/continue jumps
  int continue_target = co.chunk.instructions.len();
  while (co.loop_continues.len() > 0) {
    int idx = co.loop_continues.len() - 1;
    patch_jump_to(co, co.loop_continues[idx], continue_target);
    co.loop_continues.pop();
  }
  bool has_step = step match { Stmt::None => false, _ => true, };
  if (has_step) { compile_stmt(co, step); }
  int loop_jump = emit_jump(co, OpCode::Jmp, line, col);
  patch_jump_to(co, loop_jump, loop_start);
  // Patch break to after loop
  while (co.loop_breaks.len() > 0) {
    int idx = co.loop_breaks.len() - 1;
    patch_jump(co, co.loop_breaks[idx]);
    co.loop_breaks.pop();
  }
  if (exit_jump >= 0) { patch_jump(co, exit_jump); }
  compiler_pop_scope(co);
}

void compile_break(Compiler co, int line, int col) {
  if (co.loop_depth == 0) {
    compile_error(co, line, col, "break must be inside a loop.");
    return;
  }
  co.loop_breaks.push(emit_jump(co, OpCode::Jmp, line, col));
}

void compile_continue(Compiler co, int line, int col) {
  if (co.loop_depth == 0) {
    compile_error(co, line, col, "continue must be inside a loop.");
    return;
  }
  co.loop_continues.push(emit_jump(co, OpCode::Jmp, line, col));
}

// guard <cond> { <body> } => JmpFalse past body; body; patch.
void compile_guard(Compiler co, Expr cond, Stmt body, int line, int col) {
  compile_expr(co, cond);
  int exit_jump = emit_jump(co, OpCode::JmpFalse, line, col);
  compile_stmt(co, body);
  patch_jump(co, exit_jump);
}

void compile_try_catch(Compiler co, Stmt body, CatchArm[] catches, int line, int col) {
  // Placeholder PushHandler — patch operand after we know catch_pc.
  int handler_idx = co.chunk.instructions.len();
  bytecode::write_operand(co.chunk, OpCode::PushHandler, 0, line, col);

  // Compile try body with in_try flag set
  bool prev_in_try = co.in_try;
  co.in_try = true;
  compile_stmt(co, body);
  co.in_try = prev_in_try;

  bytecode::write_op(co.chunk, OpCode::PopHandler, line, col);
  int end_jump = emit_jump(co, OpCode::Jmp, line, col);

  // catch landing pad
  int catch_pc = co.chunk.instructions.len();
  co.chunk.instructions[handler_idx].operand = catch_pc - handler_idx - 1;

  // Single catch arm: bind error value, execute body.
  if (catches.len() > 0) {
    CatchArm arm = catches[0];
    int err_slot = co.locals.len();
    co.locals.push(Local { arm.binding_name, err_slot, co.scope_depth });
    bytecode::write_operand(co.chunk, OpCode::StoreLocal, err_slot, line, col);
    compile_stmt(co, arm.body);
    co.locals.pop();
  }

  patch_jump(co, end_jump);
}


// native intrinsic helpers

void handle_ns_call(Compiler co, string ns, string m, Expr[] args, int nl, int nc) {
  if (!has_using(co, ns)) {
    compile_error(co, nl, nc, "Namespace '" + ns + "' not in scope. Add `using " + ns + ";`.");
    return;
  }
  if (emit_native_call(co, ns, m, args, nl, nc)) { return; }
  compile_error(co, nl, nc, "Unknown native '" + ns + "::" + m + "'.");
}

bool has_using(Compiler co, string ns) {
  for (int i = 0; i < co.usings.len(); i = i + 1) {
    if (co.usings[i] == ns) { return true; }
  }
  return false;
}

bool emit_native_call(Compiler co, string ns, string member, Expr[] args, int line, int col) {
  if (ns == "io") {
    if (member == "out")      { return emit_native_io(co, OpCode::NativeOut, args, line, col); }
    if (member == "outln")    { return emit_native_io(co, OpCode::NativeOutLn, args, line, col); }
    if (member == "err")      { return emit_native_io(co, OpCode::NativeErr, args, line, col); }
    if (member == "errln")    { return emit_native_io(co, OpCode::NativeErrLn, args, line, col); }
    if (member == "in")       { return emit_native_io(co, OpCode::NativeIn, args, line, col); }
    return false;
  }
  if (ns == "fs") {
    if (member == "__read")   { return emit_native_io(co, OpCode::NativeFsRead, args, line, col); }
    if (member == "__write")  { return emit_native_io(co, OpCode::NativeFsWrite, args, line, col); }
    return false;
  }
  if (ns == "sys") {
    if (member == "args")     { return emit_native_io(co, OpCode::NativeSysArgs, args, line, col); }
    return false;
  }
  return false;
}

bool emit_native_io(Compiler co, OpCode op, Expr[] args, int line, int col) {
  for (int i = 0; i < args.len(); i = i + 1) {
    compile_expr(co, args[i]);
  }
  bytecode::write_operand(co.chunk, op, args.len(), line, col);
  return true;
}
