// Compiler state: Compiler struct definition and pure state-access helpers.
// No emit calls. Imported by both codegen.kl and compiler.kl.

export module compiler.compiler_state;

import compiler.bytecode;
import parser.ast;
import lexer.token;
import stdlib.manifest;
import ir.ir;
using namespace parser.ast;

pub struct Local {
  string name;
  int slot;
  int scope_depth;
  string type_name;
}

pub struct FuncEntry {
  string name;
  int func_index;     // index into chunk.functions[]
  int const_index;    // index into chunk.constants[] (Function_ value)
  int param_count;
  string first_param_type;
}

pub struct EnumEntry {
  string name;
  int type_idx;
}

pub struct StructEntry {
  string name;
  int type_idx;
}

pub struct CompileError {
  int line;
  int col;
  string message;
}

pub struct ImportedFunc {
  string ns;
  string qualified_name;
  string return_type;
  Parameter[] params;
  Stmt body;
  int line;
  int col;
}

pub struct ImportState {
  string[] loaded_paths;
  string[] loading_paths;
  ImportedFunc[] pending;
  string[] namespaces;
  string[] qualifiers;
  string project_root;
}

// Short name from `using namespace io;` → native io::out for method dispatch.
pub struct NativeUsingAlias {
  string short_name;
  string ns;
  string member;
}

pub struct GlobalConst {
  string name;
  Expr init;
}

pub struct LoopFrame {
  int[] break_jumps;
  int[] continue_jumps;
}

pub struct Compiler {
  Chunk chunk;
  Local[] locals;
  int[] scope_starts;
  int scope_depth;
  FuncEntry[] funcs;
  GlobalConst[] globals;
  string[] concepts;
  CompileError[] errors;
  LoopFrame[] loop_stack;
  int loop_depth;
  string[] usings;
  NativeUsingAlias[] native_usings;
  string[] module_alias_keys;
  string[] module_alias_values;
  EnumEntry[] enums;
  StructEntry[] structs;
  ImportState imports;
  bool in_try;
  bool fn_tail_return;
  string compiling_ns;
  KirModule kir;
}

pub Compiler make_compiler() {
  Chunk c = compiler::bytecode::make_chunk();
  compiler::bytecode::register_builtin_enums(c);
  return Compiler { c, [], [], 0, [], [], [], [], [], 0, [], [], [], [], [], [],
    ImportState { [], [], [], [], [], "" }, false, false, "", KirModule { [] } };
}

pub string module_id_to_qualifier(string module_id) {
  string out = "";
  int i = 0;
  while (i < module_id.len()) {
    string ch = module_id.slice(i, i + 1);
    if (ch == ".") {
      out = out + "::";
    } else {
      out = out + ch;
    }
    i = i + 1;
  }
  return out;
}

pub string qualify_module_symbol(string module_id, string symbol) {
  return module_id_to_qualifier(module_id) + "::" + symbol;
}

pub string lookup_module_alias(Compiler co, string alias) {
  for (int i = 0; i < co.module_alias_keys.len(); i = i + 1) {
    if (co.module_alias_keys[i] == alias) {
      return co.module_alias_values[i];
    }
  }
  return "";
}

pub void register_module_alias(Compiler co, string alias, string qualifier) {
  co.module_alias_keys.push(alias);
  co.module_alias_values.push(qualifier);
}

pub string resolve_module_qualified(Compiler co, string ns, string member) {
  string prefix = lookup_module_alias(co, ns);
  if (prefix.len() == 0) { prefix = ns; }
  return prefix + "::" + member;
}

pub string qualifier_prefix_of(string qualified) {
  int last = -1;
  int i = 0;
  while (i + 1 < qualified.len()) {
    if (qualified.slice(i, i + 2) == "::") { last = i; }
    i = i + 1;
  }
  if (last < 0) { return qualified; }
  return qualified.slice(0, last);
}

pub bool is_imported_qualified_name(Compiler co, string qualified) {
  return qualifier_prefix_imported(co, qualifier_prefix_of(qualified));
}

pub bool qualifier_prefix_imported(Compiler co, string prefix) {
  for (int i = 0; i < co.imports.qualifiers.len(); i = i + 1) {
    if (co.imports.qualifiers[i] == prefix) { return true; }
  }
  return false;
}

pub bool str_contains(string haystack, string needle) {
  int i = 0;
  while (i + needle.len() <= haystack.len()) {
    if (haystack.slice(i, i + needle.len()) == needle) { return true; }
    i = i + 1;
  }
  return false;
}

pub void open_imported_namespace(Compiler co, string module_id) {
  string prefix = module_id_to_qualifier(module_id) + "::";
  string[] qualified = [];
  int[] indices = [];
  for (int i = 0; i < co.funcs.len(); i = i + 1) {
    string name = co.funcs[i].name;
    if (name.len() <= prefix.len()) { continue; }
    if (name.slice(0, prefix.len()) != prefix) { continue; }
    string bare = name.slice(prefix.len(), name.len());
    if (bare.len() == 0) { continue; }
    if (str_contains(bare, "::")) { continue; }
    qualified.push(name);
    indices.push(i);
  }
  for (int i = 1; i < qualified.len(); i = i + 1) {
    string key = qualified[i];
    int key_i = indices[i];
    int j = i - 1;
    while (j >= 0 && str_less(key, qualified[j])) {
      qualified[j + 1] = qualified[j];
      indices[j + 1] = indices[j];
      j = j - 1;
    }
    qualified[j + 1] = key;
    indices[j + 1] = key_i;
  }
  for (int i = 0; i < qualified.len(); i = i + 1) {
    int fi = indices[i];
    string bare = qualified[i].slice(prefix.len(), qualified[i].len());
    co.funcs.push(FuncEntry { bare, co.funcs[fi].func_index, co.funcs[fi].const_index,
                                co.funcs[fi].param_count, co.funcs[fi].first_param_type });
  }
}

pub int declare_local_typed(Compiler co, string name, string type_name) {
  int slot = co.locals.len();
  Local l = Local { name, slot, co.scope_depth, type_name };
  co.locals.push(l);
  return slot;
}

// Field accessors must live in the same module as Local: cross-module
// `co.locals[i].name` misreads adjacent slots under ll_emit.
pub string local_name_at(Local[] arr, int idx) { return arr[idx].name; }
pub int local_slot_at(Local[] arr, int idx) { return arr[idx].slot; }
pub string local_type_name_at(Local[] arr, int idx) { return arr[idx].type_name; }

pub string lookup_local_type(Compiler co, string name) {
  int i = co.locals.len() - 1;
  while (i >= 0) {
    if (local_name_at(co.locals, i) == name) { return local_type_name_at(co.locals, i); }
    i = i - 1;
  }
  return "";
}

pub bool is_concept_ns(Compiler co, string ns) {
  for (int i = 0; i < co.concepts.len(); i = i + 1) {
    if (co.concepts[i] == ns) { return true; }
  }
  return false;
}

pub int resolve_global_const(Compiler co, string name) {
  for (int i = 0; i < co.globals.len(); i = i + 1) {
    if (co.globals[i].name == name) { return i; }
  }
  return -1;
}

pub int castError_type_idx() => 0;
pub int castError_variant_NotANumber() => 1;

// jump backpatching

pub int emit_jump(Compiler co, OpCode op, int line, int col) {
  compiler::bytecode::write_operand(co.chunk, op, 0, line, col);
  return co.chunk.instructions.len() - 1;
}

pub void patch_jump(Compiler co, int offset) {
  int jump = co.chunk.instructions.len() - offset - 1;
  co.chunk.instructions[offset].operand = jump;
}

pub void patch_jump_to(Compiler co, int offset, int target) {
  co.chunk.instructions[offset].operand = target - offset - 1;
}

pub void compile_error(Compiler co, int line, int col, string msg) {
  CompileError e = CompileError { line, col, msg };
  co.errors.push(e);
}

// scope / locals
// Renamed away from the obvious push_scope/pop_scope to avoid colliding with
// the typechecker's helpers in cli/main.kl — the bootstrap registers every
// function by bare name globally, last write wins, so a generic name from
// the entry module silently shadows ours.

pub void compiler_push_scope(Compiler co) {
  co.scope_starts.push(co.locals.len());
  co.scope_depth = co.scope_depth + 1;
}

pub void compiler_pop_scope(Compiler co) {
  if (co.scope_starts.len() == 0) { return; }
  int start = co.scope_starts[co.scope_starts.len() - 1];
  co.scope_starts.pop();
  while (co.locals.len() > start) {
    co.locals.pop();
  }
  co.scope_depth = co.scope_depth - 1;
}

pub int declare_local(Compiler co, string name) {
  return declare_local_typed(co, name, "");
}

pub int resolve_local(Compiler co, string name) {
  int i = co.locals.len() - 1;
  while (i >= 0) {
    if (local_name_at(co.locals, i) == name) { return local_slot_at(co.locals, i); }
    i = i - 1;
  }
  return -1;
}

pub int resolve_function(Compiler co, string name) {
  // Last registration wins for duplicate bare names (bootstrap
  // function_indices_ map overwrite semantics).
  int i = co.funcs.len() - 1;
  while (i >= 0) {
    if (func_entry_name(co.funcs, i) == name) { return i; }
    i = i - 1;
  }
  return -1;
}

pub string func_entry_name(FuncEntry[] arr, int idx) {
  return arr[idx].name;
}

// Register a function table slot; must live here so FuncEntry[] push is not cross-module.
pub void register_compiler_function(Compiler co, string chunk_name, string lookup_name, int param_count, string first_param_type) {
  FunctionInfo info = FunctionInfo { chunk_name, 0, param_count, "", [], [] };
  co.chunk.functions.push(info);
  int func_index = co.chunk.functions.len() - 1;
  co.chunk.constants.push(compiler::bytecode::const_function(func_index));
  int const_index = co.chunk.constants.len() - 1;
  FuncEntry fe = FuncEntry { lookup_name, func_index, const_index, param_count, first_param_type };
  co.funcs.push(fe);
}

pub bool str_less(string a, string b) {
  return a < b;
}

pub string module_ns_of_qualified(string qualified) {
  int i = 0;
  while (i + 1 < qualified.len()) {
    if (qualified.slice(i, i + 1) == ":" && qualified.slice(i + 1, i + 2) == ":") {
      return qualified.slice(0, i);
    }
    i = i + 1;
  }
  return "";
}

string[] sorted_import_namespaces(Compiler co) {
  string[] sorted = [];
  for (int i = 0; i < co.imports.namespaces.len(); i = i + 1) {
    sorted.push(co.imports.namespaces[i]);
  }
  for (int i = 1; i < sorted.len(); i = i + 1) {
    string key = sorted[i];
    int j = i - 1;
    while (j >= 0 && str_less(key, sorted[j])) {
      sorted[j + 1] = sorted[j];
      j = j - 1;
    }
    sorted[j + 1] = key;
  }
  return sorted;
}

pub int resolve_call_target(Compiler co, string callee_name) {
  if (co.compiling_ns.len() > 0) {
    int fi = resolve_function(co, co.compiling_ns + "::" + callee_name);
    if (fi >= 0) { return fi; }
  }
  int fi = resolve_function(co, callee_name);
  if (fi >= 0) { return fi; }
  string[] sorted = sorted_import_namespaces(co);
  for (int i = 0; i < sorted.len(); i = i + 1) {
    int qfi = resolve_function(co, module_id_to_qualifier(sorted[i]) + "::" + callee_name);
    if (qfi >= 0) { return qfi; }
  }
  return -1;
}

pub int resolve_enum(Compiler co, string name) {
  for (int i = 0; i < co.enums.len(); i = i + 1) {
    if (co.enums[i].name == name) { return co.enums[i].type_idx; }
  }
  return -1;
}

pub int resolve_struct(Compiler co, string name) {
  int i = co.structs.len() - 1;
  while (i >= 0) {
    if (co.structs[i].name == name) { return co.structs[i].type_idx; }
    i = i - 1;
  }
  return -1;
}

// Look up variant index within an enum type. Returns -1 if not found.
pub int resolve_variant(Compiler co, int type_idx, string variant_name) {
  return enum_variant_index_at(co.chunk.enum_metas, type_idx, variant_name);
}

pub bool enum_variant_has_payload(Compiler co, int type_idx, int variant_idx) {
  return enum_variant_param_count_at(co.chunk.enum_metas, type_idx, variant_idx) > 0;
}

pub int callee_ident_line(Expr callee, int fallback) {
  return callee match {
    Expr::Ident(let _n, let l, let _c) => l,
    _ => fallback,
  };
}

pub int callee_ident_col(Expr callee, int fallback) {
  return callee match {
    Expr::Ident(let _n, let _l, let c) => c,
    _ => fallback,
  };
}

pub bool is_imported_ns(Compiler co, string ns) {
  if (qualifier_prefix_imported(co, ns)) { return true; }
  for (int i = 0; i < co.imports.namespaces.len(); i = i + 1) {
    if (co.imports.namespaces[i] == ns) { return true; }
    if (module_id_to_qualifier(co.imports.namespaces[i]) == ns) { return true; }
  }
  return false;
}

pub bool is_native_namespace(string ns) {
  return stdlib::manifest::is_native_namespace(ns);
}

pub bool is_native_member(string ns, string member) {
  return stdlib::manifest::is_native_member(ns, member);
}

pub NativeUsingAlias no_native_alias() {
  return NativeUsingAlias { "", "", "" };
}

pub void register_native_using_alias(Compiler co, string short_name, string ns, string member) {
  co.native_usings.push(NativeUsingAlias { short_name, ns, member });
}

pub NativeUsingAlias resolve_native_using_alias(Compiler co, string short_name) {
  for (int i = 0; i < co.native_usings.len(); i = i + 1) {
    if (co.native_usings[i].short_name == short_name) {
      return co.native_usings[i];
    }
  }
  return no_native_alias();
}

pub void open_native_namespace(Compiler co, string ns) {
  string[] members = stdlib::manifest::native_members_of(ns);
  for (int i = 0; i < members.len(); i = i + 1) {
    register_native_using_alias(co, members[i], ns, members[i]);
  }
}
